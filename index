async function validerAjoutCotisation() {
  const structure = document.getElementById('cot-structure')?.value?.trim();
  if (!structure) { alert('Nom de structure requis'); return; }
  const mode = document.getElementById('cot-mode')?.value || 'Forfait annuel';
  const btn = document.getElementById('cot-btn-valider');
  btn.disabled = true; btn.textContent = '⏳';
  try {
    const res = await apiPost({ action: 'ajouterCotisationLogiciel', payload: {
      structure, mode,
      montant: document.getElementById('cot-montant')?.value || '',
      dernierPaiement: document.getElementById('cot-dernier')?.value || '',
      prochaineEcheance: document.getElementById('cot-echeance')?.value || '',
      commentaire: document.getElementById('cot-commentaire')?.value || '',
    }});
    if (res && res.success) {
      document.querySelector('[style*=fixed]')?.remove();
      loadDashboard();
    } else {
      alert('Erreur : ' + (res && (res.message || res.error) || 'inconnue'));
      btn.disabled = false; btn.textContent = '✓ Ajouter';
    }
  } catch(e) {
    alert('Erreur : ' + e.message);
    btn.disabled = false; btn.textContent = '✓ Ajouter';
  }
}

async function supprimerCotisation(rowIndex, structure) {
  if (!confirm('Supprimer "' + structure + '" des cotisations logiciel ?')) return;
  try {
    const res = await apiPost({ action: 'supprimerCotisationLogiciel', payload: { rowIndex } });
    if (res && res.success) {
      loadDashboard();
    } else {
      alert('Erreur : ' + (res && (res.message || res.error) || 'inconnue'));
