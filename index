async function validerImportReleve() {
  // Ne plus exiger l.compte ici : une ligne cochée sans compte identifié doit
  // quand même être importée (elle ressort en "à vérifier" côté Comptabilité,
  // cf. STATUT_VERIF=ORANGE), pas disparaître silencieusement du lot alors
  // qu'elle est bien cochée dans la modale.
  const lignesAImporter = (window._relevePropositions || []).filter(l => l.selectionne);
  if (lignesAImporter.length === 0) { alert('Aucune ligne sélectionnée.'); return; }

  // Vérifier s'il y a des lignes de salaires (421) sans ventilation
  const lignesSalaires = lignesAImporter.filter(l => (l.compte||'').startsWith('421') && !l._ventilations);
  if (lignesSalaires.length > 0) {
    window._ventLigneIdx = 0; // toujours commencer au premier virement
    ouvrirModaleVentilation(lignesSalaires, lignesAImporter);
    return;
  }

  await _importerLignesValidees(lignesAImporter);
}

// Verrou anti double-soumission : _importerLignesValidees peut être atteinte par
// deux chemins (import direct, ou fin du parcours de ventilation), et l'import
// peut prendre plusieurs secondes côté serveur (insertRowBefore ligne par ligne).
// Sans ce verrou, un second clic pendant ce délai — par ex. après avoir refermé
// une alerte d'erreur sans que l'aperçu ait été vidé — réimporte les mêmes
// lignes en double.
window._importReleveEnCours = false;

async function _importerLignesValidees(lignesAImporter) {
  console.log('[IMPORT] _importerLignesValidees appelée:', lignesAImporter.length, 'lignes');
  if (!lignesAImporter || lignesAImporter.length === 0) {
    alert('Aucune ligne à importer');
    return;
  }
  if (window._importReleveEnCours) {
    console.warn('[IMPORT] Import déjà en cours, clic ignoré');
    return;
  }
  window._importReleveEnCours = true;

  const btnImporter = document.getElementById('ir-btn-importer');
  const btnLabelOrig = btnImporter ? btnImporter.textContent : '';
  if (btnImporter) { btnImporter.disabled = true; btnImporter.textContent = '⏳ Import en cours…'; }

  // Pas de confirm() — on import directement après validation ventilation
  const payload = lignesAImporter.map(l => ({
    date:         l.date,
    libelle:      l.libelle_prop || l.libelle,
    spectacle:    l.spectacle || '',
    compte:       l.compte,
    operation:    l.operation || '',
    montant:      l.montant,
    piece_url:    l.piece_url || '',
    piece_nom:    l.piece_nom || '',
    _ventilations: l._ventilations || null,
    // Nécessaire pour que le serveur marque le lot de virement groupé NDF comme
    // "Rapproché" au moment de la validation (cf. appendLignesCompta) — sans ça
    // le lot reste indéfiniment "En attente rapprochement" même après import.
    matchMontant: l.matchMontant || null,
  }));
  console.log('[IMPORT] payload:', payload.length, 'lignes, ventilations:', payload.filter(l=>l._ventilations).length);

  try {
    const res = await apiPost({ action: 'appendLignesCompta', payload: { lignes: payload } });
    if (res && res.success) {
      toast('✓ ' + res.ajoutees + ' ligne(s) importée(s) dans COMPTA', 'success');
      // Vider l'aperçu pour qu'un clic résiduel (ou un second appel via un
      // chemin déjà en vol) ne puisse pas réimporter les mêmes lignes.
      window._relevePropositions = [];
      window._releveRaw = [];
      document.getElementById('import-releve-overlay')?.remove();
      loadCompta();
    } else {
      console.error('[IMPORT] Erreur:', res);
      alert('Erreur import : ' + (res && res.message ? res.message : JSON.stringify(res)));
      if (btnImporter) { btnImporter.disabled = false; btnImporter.textContent = btnLabelOrig; }
    }
  } catch(e) {
    console.error('[IMPORT] Exception:', e);
    alert('Erreur : ' + e.message);
    if (btnImporter) { btnImporter.disabled = false; btnImporter.textContent = btnLabelOrig; }
  } finally {
    window._importReleveEnCours = false;
  }
}

// ── Modale ventilation salaires ───────────────────────────────────────────────
async function chargerFDPDuMois(ligne) {
  console.log('[FDP] chargerFDPDuMois appelée, date:', ligne && ligne.date, 'ventLigne:', window._ventLigne && window._ventLigne.date);
  try {
    const res = await apiPost({ action: 'getFDPDuMois', payload: { dateVirement: ligne && ligne.date, extraireTexte: false } }); // OCR via bouton 🔍 Extraire
    console.log('[FDP] réponse:', res && res.success, 'fdps:', res && res.fdps && res.fdps.length);
    if (res && res.success && res.fdps && res.fdps.length > 0) {
      window._fdpsDuMois = res.fdps;
      window._moisFDP    = res.moisRecherche;
      // Un virement de paie nomme en général UN salarié précis (ex: "VIR PAYE MAI
      // BIJELJAC") — on ne pré-remplit que les FDP dont le code (3 lettres, sans le
      // préfixe "421") apparaît dans ce libellé, plutôt que toutes les FDP du mois.
      // Si rien ne matche (virement groupé, libellé générique...), on retombe sur la
      // liste complète pour ne rien cacher à l'utilisateur.
      const libelleLigne = ((ligne && ligne.libelle) || '').toUpperCase();
      const fdpsCorrespondantes = res.fdps.filter(function(fdp) {
        const code = (fdp.salarie || '').replace(/^421/, '');
        return code && libelleLigne.indexOf(code) >= 0;
      });
      const fdpsAAfficher = fdpsCorrespondantes.length > 0 ? fdpsCorrespondantes : res.fdps;
      // Pré-remplir le tableau de ventilation
      const tbody = document.getElementById('vent-body');
      if (tbody) {
        tbody.innerHTML = '';
        fdpsAAfficher.forEach(fdp => ajouterLigneVentilationFDP(fdp));
        const badge = document.getElementById('fdp-badge');
        let badgeHtml = fdpsCorrespondantes.length > 0
          ? '✓ ' + fdpsAAfficher.length + ' FDP de ' + libelleLigne.replace(/^VIR PAYE\s*/i,'').trim() + ' — ' + res.moisRecherche
          : '✓ ' + fdpsAAfficher.length + ' FDP — ' + res.moisRecherche + ' <span style="color:var(--orange)">(aucune ne correspond au libellé, toutes affichées)</span>';
        if (res.totalNetFDP > 0) {
          const netReleve = Math.abs(window._ventLigne ? (window._ventLigne.montant||0) : 0);
          const ecart = Math.abs(netReleve - res.totalNetFDP);
          if (ecart < 0.10) {
            badgeHtml += ' · <span style="color:var(--green)">✓ Net FDP = ' + res.totalNetFDP.toLocaleString('fr-FR') + ' € — équilibré</span>';
          } else {
            badgeHtml += ' · <span style="color:var(--orange)">⚠ Net FDP = ' + res.totalNetFDP.toLocaleString('fr-FR') + ' € (écart ' + (netReleve - res.totalNetFDP).toFixed(2) + ' €)</span>';
}
          }
          badgeHtml += ' &nbsp;<button class="btn btn-ghost btn-sm" style="font-size:10px;padding:2px 6px" onclick="extraireFDPOCR(this)">🔍 Extraire brut &amp; coût emp.</button>';
          if (badge) badge.innerHTML = badgeHtml;
          mettreAJourControle();
        }
      } else {
        const badge = document.getElementById('fdp-badge');
        window._lastFDPTrace = res && res.trace || [];
        if (badge) {
          badge.innerHTML = '⚠ Aucune FDP trouvée pour ce mois'
            + ' &nbsp;<button class="btn btn-ghost btn-sm" style="font-size:10px;padding:2px 6px" onclick="afficherTraceFDP()">🔍 Voir pourquoi</button>'
            + '<div id="fdp-trace" style="display:none;margin-top:8px;padding:8px;background:var(--bg);border-radius:6px;font-size:10px;font-family:monospace;white-space:pre-wrap;max-height:200px;overflow-y:auto"></div>';
        }
      }
    } catch(e) {
      console.log('FDP erreur:', e.message);
    }
}

