      if (res && res.success) { toast(res.count + ' salarié(s) importé(s) ✓', 'success'); loadConfigSalariesPaie(); }
      else toast('Erreur : ' + (res && res.error || 'inconnue'), 'error');
    } catch(e) { toast('Erreur : ' + e.message, 'error'); }
    input.value = '';
  });
}

