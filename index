            + r.cachetDetails.map(function(d) { return d.qte + ' × ' + d.montant + '€'; }).join(' | ')
            + '</span>'
          : (r.montantCachet ? '<br><span style="font-size:10px;color:var(--text-sec);font-weight:400">× ' + r.montantCachet + '€</span>' : ''))
        + '</td>'
      + (hasServices ? '<td style="text-align:center;font-weight:700;color:var(--blue)" title="' + (r.servicesStr||'') + '">'
        + (r.services4h || 0)
        + (r.montantService ? '<span style="font-size:10px;color:var(--text-sec);margin-left:2px">× ' + r.montantService + '€</span>' : '')
        + '</td>' : '')
      + (hasDefraiement ? '<td style="text-align:center;font-weight:700">'
        + (r.defraiement ? r.defraiement.toLocaleString('fr-FR') + ' €' : '—')
        + (r.nbDefraiements ? '<br><span style="font-size:10px;color:var(--text-sec);font-weight:400">' + r.nbDefraiements + ' défraiement' + (r.nbDefraiements > 1 ? 's' : '') + '</span>' : '')
        + '</td>' : '')
      + '<td><button class="btn btn-ghost btn-sm" data-action="exporter-contrat-paie" data-idx="' + idx + '" title="Génère un fichier .txt à importer dans le logiciel de paie (remplissage partiel — champs non connus laissés vides)">📤 Contrat</button></td>'
      + '<td><button class="btn btn-green btn-sm" data-action="valider-dpae" data-idx="' + idx + '">✓ Valider</button></td>'
