  document.getElementById('todo-panel')?.classList.toggle('minimized');
}

function fermerListeTravailDuJour() {
  document.getElementById('todo-panel')?.remove();
}

async function _chargerListeTravailDuJour() {
  const body = document.getElementById('todo-panel-body');
  if (!body) return;
  const entities = ALL_ENTITIES.filter(e => isEntityVisible(e.code));
  const parEntite = [];

  // Traiter les entités UNE PAR UNE (comme la Synchronisation), et dans
  // chaque entité une action à la fois : lancer tout en parallèle (5 actions
  // × N entités simultanément) sature le backend Apps Script et bloque
  // les autres requêtes de l'appli (bug observé : Configuration restait
  // bloquée sur "Chargement…" tant que ce panneau tournait).
  for (const e of entities) {
    const items = [];
    try {
      const dpaeRes   = await _fetchSyncWithTimeout({ action: 'dpae',           entity: e.code }, 15000).catch(() => ({ rows: [] }));
      const ndfRes    = await _fetchSyncWithTimeout({ action: 'ndf',            entity: e.code }, 15000).catch(() => ({ rows: [] }));
      const factRes   = await _fetchSyncWithTimeout({ action: 'getFacturation', entity: e.code }, 15000).catch(() => ({ rows: [] }));
      const declRes   = await _fetchSyncWithTimeout({ action: 'declarations',   entity: e.code }, 15000).catch(() => ({ rows: [] }));
      const comptaRes = await _fetchSyncWithTimeout({ action: 'getCompta', entity: e.code, year: '0' }, 25000).catch(() => ({ rows: [] }));

      const nbDpae = (dpaeRes.rows || []).length;
      if (nbDpae > 0) items.push({ label: nbDpae + ' DPAE à saisir', module: 'dpae' });

      const nbNdf = (ndfRes.rows || []).filter(r => r.statut !== 'Traitee').length;
      if (nbNdf > 0) items.push({ label: nbNdf + ' note' + (nbNdf>1?'s':'') + ' de frais non réglée' + (nbNdf>1?'s':''), module: 'ndf' });

      const nbFact = (factRes.rows || []).filter(r => r.statut === 'À facturer').length;
      if (nbFact > 0) items.push({ label: nbFact + ' facture' + (nbFact>1?'s':'') + ' à envoyer', module: 'facturation' });

      const nbContrats = (declRes.rows || []).filter(r => !r.contratSigne && !r.lienContratSigne).length;
      if (nbContrats > 0) items.push({ label: nbContrats + ' contrat' + (nbContrats>1?'s':'') + ' non fait' + (nbContrats>1?'s':''), module: 'declarations' });

      const comptaRows = comptaRes.rows || [];
      const nbOrange = comptaRows.filter(r => r.STATUT_VERIF === 'ORANGE').length;
      if (nbOrange > 0) items.push({ label: nbOrange + ' écriture' + (nbOrange>1?'s':'') + ' compta à vérifier', module: 'comptabilite' });

      const nbSansVent = comptaRows.filter(r => (r.COMPTE||'').startsWith('421') && (!r._ventilations || r._ventilations.length === 0)).length;
      if (nbSansVent > 0) items.push({ label: nbSansVent + ' salaire' + (nbSansVent>1?'s':'') + ' sans ventilation', module: 'comptabilite' });

      const dernieresCles = comptaRows.map(r => _cleDateTravail(r.DATE)).filter(Boolean).sort();
      const derniereCle = dernieresCles[dernieresCles.length - 1];
      if (derniereCle) {
        const deuxMoisAvant = new Date();
        deuxMoisAvant.setMonth(deuxMoisAvant.getMonth() - 2);
        const cleLimite = deuxMoisAvant.toISOString().slice(0,10);
        if (derniereCle < cleLimite) {
          items.push({ label: 'Compta non saisie depuis plus de 2 mois (dernière : ' + derniereCle.split('-').reverse().join('/') + ')', module: 'comptabilite' });
        }
      }
    } catch(err) { /* entité inaccessible ou en erreur — on l'ignore silencieusement */ }

    if (items.length > 0) {
      parEntite.push({ code: e.code, label: e.label, items });
      // Affichage progressif : on met à jour le panneau après chaque entité
      // plutôt que d'attendre que toutes soient passées, vu que ça peut
      // prendre plusieurs secondes en traitement séquentiel.
      _rendreListeTravailDuJour(parEntite, body);
    }
  }

  if (parEntite.length === 0) {
    body.innerHTML = '<div style="text-align:center;color:var(--text-sec);padding:24px 4px;font-size:12px">✓ Rien à traiter aujourd\'hui, tout est à jour.</div>';
  }
}

function _rendreListeTravailDuJour(parEntite, body) {
  const totalTaches = parEntite.reduce((s, e) => s + e.items.length, 0);
  const countEl = document.getElementById('todo-panel-count');
  if (countEl) { countEl.textContent = totalTaches; countEl.style.display = totalTaches > 0 ? '' : 'none'; }

  let html = '';
  parEntite.slice().sort((a,b) => b.items.length - a.items.length).forEach(e => {
    html += '<div class="todo-entity-tag">' + e.code + ' — ' + e.label + '</div>';
    e.items.forEach(it => {
      html += '<div class="todo-item" onclick="navigateAlert(\'' + it.module + '\',\'' + e.code + '\')">'
        + '<span class="todo-item-dot"></span><span>' + it.label + '</span>'
        + '</div>';
    });
  });
  body.innerHTML = html;
}

