function regrouperLignesReleve(lignes) {
  // Catégoriser chaque ligne
  const PATTERNS = [
    { re: /audiens/i,                     cat: 'charges_sociales', compte: '645', op: 'Charges sociales AUDIENS' },
    { re: /urssaf|d[ée]claration|dsn/i,   cat: 'charges_sociales', compte: '645', op: 'Charges sociales URSSAF' },
    { re: /france.travail|p[ôo]le.emploi/i, cat: 'charges_sociales', compte: '645', op: 'Charges sociales France Travail' },
    { re: /alpro|retraite|pr[ée]voyance|thalie/i, cat: 'charges_sociales', compte: '645', op: 'Charges sociales retraite/prévoyance' },
    { re: /virement.+paie|web.paie|web.sdb.salaire/i, cat: 'salaire', compte: '421', op: 'Salaires net versés' },
    { re: /livret.a|provision.livret/i,   cat: 'virement_interne', compte: '5121', op: 'Livret A' },
    { re: /retour.provision|retour.assoc/i, cat: 'virement_interne', compte: '512', op: 'Retour provision' },
    { re: /tenue.compte|frais.bancaires|int[ée]r[êe]ts.d[ée]biteurs|cotisation.bancaire/i, cat: 'frais_bancaires', compte: '627', op: 'Services bancaires' },
    { re: /paiement.carte|carte.x\d+/i,   cat: 'frais_cb', compte: '625', op: 'Paiement par carte' },
    { re: /remise.ch[èe]que|virement.en.votre.faveur|virement.recu|virement.entrant/i, cat: 'recette', compte: '706', op: 'Prestation de service' },
    { re: /subvention|drac|region|d[ée]partement|commune|mairie|agglom[ée]ration|fdva|drac/i, cat: 'subvention', compte: '74', op: 'Subvention' },
    { re: /remboursement|remb\.|ndf/i,    cat: 'ndf', compte: '625', op: 'Remboursement NDF' },
  ];

  function categoriser(l) {
    const lib = (l.libelle || '').toLowerCase();
    for (const p of PATTERNS) {
      if (p.re.test(lib)) return { ...p };
    }
    // Par montant si pas de pattern
    if (l.montant > 0) return { cat: 'recette',  compte: '706', op: 'Recette à identifier' };
    return { cat: 'autre', compte: '', op: 'À identifier' };
  }

  // Grouper par catégorie + mois
  const groupes = {};
  const individuel = []; // lignes qui restent individuelles

  lignes.forEach((l, i) => {
    const info = categoriser(l);
    l._cat    = info.cat;
    l._compte = info.compte;
    l._op     = info.op;

    // Certaines catégories restent individuelles (salaires, recettes, NDF)
    if (['salaire', 'recette', 'subvention', 'ndf', 'frais_cb', 'virement_interne'].includes(info.cat)) {
      individuel.push({ ...l, _original: [i] });
      return;
    }

    // Grouper charges sociales par organisme + mois
    const mois = (l.date || '').substring(3, 10); // MM/YYYY
    const key  = info.cat + '|' + info.op + '|' + mois;
    if (!groupes[key]) {
      groupes[key] = { date: l.date, libelle: info.op, montant: 0, _cat: info.cat, _compte: info.compte, _op: info.op, _original: [], _nb: 0 };
    }
    groupes[key].montant += l.montant;
    groupes[key]._original.push(i);
    groupes[key]._nb++;
  });

  // Fusionner groupes et individuels
  const grouped = Object.values(groupes).map(g => ({
    ...g,
    libelle: g._nb > 1 ? g.libelle + ' (' + g._nb + ' opérations)' : g.libelle,
  }));

  const result = [...individuel, ...grouped];
  // Trier par date
  result.sort((a, b) => {
    const da = (a.date||'').split('/').reverse().join('');
    const db = (b.date||'').split('/').reverse().join('');
    return db.localeCompare(da);
  });

  return result;
}

async function lancerAnalyseClaude() {
  const btn = document.getElementById('ir-btn-analyser');
  btn.textContent = '⏳ Analyse en cours…'; btn.disabled = true;

  const lignes = window._releveRaw;
  if (!lignes || lignes.length === 0) { btn.textContent = '⚡ Analyser et imputer'; btn.disabled = false; return; }

  try {
    const batch = lignes.slice(0, 100);
    const data = await apiPost({ action: 'analyserReleve', payload: { lignes: batch.map(l => ({ date: l.date, libelle: l.libelle, montant: l.montant })) } });

    if (data.error && !(data.propositions && data.propositions.length > 0)) { toast('Erreur API : ' + data.error, 'error'); btn.textContent = '⚡ Analyser et imputer'; btn.disabled = false; return; }
    if (data.fallback) { toast('⚠ Imputation automatique — imputation automatique par règles. Vérifiez chaque compte.', ''); }

    window._importListes = data.listesImport || { comptes: [], projets: [] };

    // Fusionner propositions avec lignes brutes
    const props = data.propositions || [];
    window._relevePropositions = batch.map((l, i) => {
      const p = props.find(p => p.index === i) || {};
      // Toutes les lignes sont sélectionnées par défaut, y compris en confiance
      // basse/sans compte identifié : une ligne laissée sans compte est importée
      // telle quelle et ressort automatiquement en statut "À vérifier" dans la
      // Comptabilité (STATUT_VERIF=ORANGE côté serveur), plutôt que de disparaître
      // silencieusement du lot si l'utilisateur oublie de la cocher à la main.
      return { ...l, compte: p.compte || '', libelle_prop: l.libelle, spectacle: p.spectacle || '', operation: p.operation || '', confiance: p.confiance || 'basse', piece_url: p.piece_url || '', piece_nom: p.piece_nom || '', selectionne: true };
    });

    afficherPropositions(window._relevePropositions);
    document.getElementById('ir-step2').style.display = 'none';
    document.getElementById('ir-step3').style.display = 'flex';
  } catch(e) {
    alert('Erreur : ' + e.message);
  }
  btn.textContent = '⚡ Analyser et imputer'; btn.disabled = false;
}

// ── Combobox générique avec filtre en tapant (remplace les <select> classiques,
//    qui ne filtrent pas correctement quand les options commencent par un chiffre) ──
function _labelPourValeurCombo(champ, valeur) {
  if (!valeur) return '';
  const options = _comboOptions(champ);
  const trouve = options.find(o => o.value === valeur);
  return trouve ? trouve.label : valeur;
}

function renderCombobox(champ, idx, valeurActuelle, labelActuel, largeur) {
  const id = 'combo-' + champ + '-' + idx;
  // Compte non renseigné (plus de valeur devinée par défaut type "512" — voir
  // fallbackImputationLocale) : bordure orange + placeholder d'alerte, comme
  // pour le combo compte du tableau principal, pour que ces lignes restent
  // visuellement repérables avant l'import.
  const estCompteVide = champ === 'compte' && !valeurActuelle;
  return '<div class="combo-wrap" style="position:relative;width:' + largeur + 'px">'
    + '<input type="text" id="' + id + '" class="combo-input" autocomplete="off"'
    + ' style="width:100%;padding:2px 4px;font-size:10px;border:1px solid ' + (estCompteVide ? 'var(--orange)' : 'var(--border)') + ';border-radius:4px;background:var(--bg);color:var(--text)"'
    + ' value="' + (labelActuel ? labelActuel.replace(/"/g,'&quot;') : '') + '"'
    + (estCompteVide ? ' placeholder="⚠ choisir un compte…"' : '')
    + ' data-champ="' + champ + '" data-idx="' + idx + '" data-value="' + (valeurActuelle||'') + '"'
    + ' oninput="comboFiltrer(this)" onfocus="comboOuvrir(this)">'
    + '<div class="combo-list" style="display:none;position:absolute;z-index:200;top:100%;left:0;min-width:220px;max-height:220px;overflow-y:auto;background:var(--surface);border:1px solid var(--border);border-radius:6px;box-shadow:0 4px 12px rgba(0,0,0,.4)"></div>'
    + '</div>';
}

function _comboOptions(champ) {
  const listes = window._importListes || { comptes: [], projets: [] };
  if (champ === 'compte') {
    return (listes.comptes || []).map(o => ({ value: o.code, label: o.code + ' — ' + (o.label || '') }));
  }
  // Projets : fusionne les codes courts de CODE COMPTA (utile pour MAN) avec les
  // noms de spectacles déjà utilisés dans les devis/contrats de l'entité en cours
  // (utile pour CLR et les autres, dont les "projets" sont des noms de production,
  // pas des codes courts).
  const options = [];
  const vus = new Set();
  (listes.projets || []).forEach(o => {
    if (vus.has(o.code)) return;
    vus.add(o.code);
    // Quand le code et le libellé sont identiques (ex: liste "Vrai nom" de CLR, une
    // simple liste de noms sans code court séparé), on n'affiche le texte qu'une fois.
    const label = (o.label && o.label !== o.code) ? (o.code + ' — ' + o.label) : o.code;
    options.push({ value: o.code, label });
  });
  (window._devisRows || []).forEach(r => {
    const nom = (r.spectacle || r.projet || '').toString().trim();
    if (!nom || vus.has(nom)) return;
    vus.add(nom);
    options.push({ value: nom, label: nom });
  });
  options.sort((a, b) => a.label.localeCompare(b.label));
  return options;
}

function comboOuvrir(input) {
  comboFiltrer(input);
}

function comboFiltrer(input) {
  // Fermer les autres listes ouvertes
  document.querySelectorAll('.combo-list').forEach(el => { if (el !== input.nextElementSibling) el.style.display = 'none'; });

  const champ  = input.dataset.champ;
  const idx    = parseInt(input.dataset.idx, 10);
  const requete = input.value.trim().toLowerCase();
  const options = _comboOptions(champ);
  const filtrees = requete
    ? options.filter(o => o.label.toLowerCase().includes(requete))
    : options;

  const listEl = input.nextElementSibling;
  let html = '';
  filtrees.slice(0, 60).forEach(o => {
    html += '<div class="combo-item" style="padding:5px 8px;font-size:11px;cursor:pointer" '
      + 'onmousedown="comboChoisir(\'' + champ + '\',' + idx + ',\'' + o.value.replace(/'/g,"\\'") + '\',\'' + o.label.replace(/'/g,"\\'") + '\')">'
      + o.label + '</div>';
  });
  html += '<div class="combo-item" style="padding:5px 8px;font-size:11px;cursor:pointer;color:var(--text-sec);border-top:1px solid var(--border)" '
    + 'onmousedown="comboSaisieLibre(\'' + champ + '\',' + idx + ')">✎ Saisie libre…</div>';
  if (filtrees.length === 0) {
    html = '<div style="padding:6px 8px;font-size:11px;color:var(--text-sec)">Aucun résultat</div>' + html;
  }
  listEl.innerHTML = html;
  listEl.style.display = 'block';
}

function comboChoisir(champ, idx, value, label) {
  const input = document.getElementById('combo-' + champ + '-' + idx);
  input.value = label;
  input.dataset.value = value;
  input.nextElementSibling.style.display = 'none';
  if (champ === 'compte') {
    window._relevePropositions[idx].compte = value;
    // Le libellé "Opération compta" (colonne C) doit rester cohérent avec le
    // compte choisi manuellement — sinon il garde l'ancienne valeur (ou reste
    // vide) et la ligne importée n'a pas d'opération. label est au format
    // "code — nom officiel" ; on ne garde que la partie nom.
    const nomOfficiel = label.includes(' — ') ? label.split(' — ').slice(1).join(' — ') : '';
    if (nomOfficiel) window._relevePropositions[idx].operation = nomOfficiel;
  } else {
    window._relevePropositions[idx].spectacle = value;
  }
}

function comboSaisieLibre(champ, idx) {
  const cible = champ === 'compte' ? 'Code comptable' : 'Code projet';
  const actuel = champ === 'compte' ? window._relevePropositions[idx].compte : window._relevePropositions[idx].spectacle;
  const v = prompt(cible + ' :', actuel || '');
  const input = document.getElementById('combo-' + champ + '-' + idx);
  if (v !== null) {
    input.value = v.trim();
    input.dataset.value = v.trim();
    if (champ === 'compte') window._relevePropositions[idx].compte = v.trim();
    else window._relevePropositions[idx].spectacle = v.trim();
  }
  input.nextElementSibling.style.display = 'none';
}

