// Rapport de vérification : compare pour chaque spectacle ce qui devrait être en
// caisse (20% après FCT/ADMIN/DIFF et coût employeur réel) à ce qui est
// actuellement écrit dans CAISSE FILLE — sert à repérer les montants écrits avec
// l'ancienne formule (qui ne déduisait jamais le coût employeur) et à les corriger
// directement via le bouton ✏️, pré-rempli avec le montant correct suggéré.
async function ouvrirVerificationCaisses() {
  const overlay = document.createElement('div');
  overlay.id = 'verif-caisses-overlay';
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:9000;display:flex;align-items:center;justify-content:center;padding:20px';
  overlay.innerHTML = '<div style="background:var(--surface);border-radius:14px;padding:28px;width:820px;max-width:96vw;max-height:88vh;overflow-y:auto">'
    + '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">'
    + '<h3 style="font-weight:800">🔍 Vérification caisses vs compta</h3>'
    + '<button class="btn btn-ghost btn-sm" onclick="this.closest(\'[style*=fixed]\').remove()">✕</button>'
    + '</div><div style="text-align:center;color:var(--text-sec);padding:30px">⏳ Calcul en cours…</div></div>';
  document.body.appendChild(overlay);
  overlay.addEventListener('click', e => { if (e.target === overlay) overlay.remove(); });

  try {
    const res = await apiGet({ action: 'verifierCaissesParSpectacle' });
    if (!res || !res.success) throw new Error((res && res.error) || 'inconnue');
    const resultats = res.resultats || [];
    const box = overlay.querySelector('div');

    let body = '<div style="font-size:11px;color:var(--text-sec);margin-bottom:14px">'
      + 'Attendu = (Recette − FCT ' + res.fct + '€ − ADMIN ' + res.admin + '€ − DIFF ' + res.diff + '€ − Coût employeur) × ' + res.pct + '%'
      + '</div>';

    if (resultats.length === 0) {
      body += '<div style="text-align:center;color:var(--text-sec);padding:30px">Rien à comparer (aucune recette ou aucune caisse trouvée).</div>';
    } else {
      body += '<div class="data-table-wrap"><table class="data-table"><thead><tr>'
        + '<th>Spectacle</th><th style="text-align:right">Recette</th><th style="text-align:right">Coût emp.</th>'
        + '<th style="text-align:right">Attendu</th><th style="text-align:right">Actuel</th><th style="text-align:right">Écart</th>'
        + '</tr></thead><tbody>';
      resultats.forEach(l => {
        const ok = Math.abs(l.ecart) <= 0.5;
        const couleurEcart = ok ? 'var(--text-sec)' : (l.ecart > 0 ? 'var(--red)' : 'var(--orange)');
        body += '<tr' + (ok ? '' : ' style="background:rgba(226,75,74,.06)"') + '>'
          + '<td><span class="status-badge status-grey">' + l.spectacle + '</span></td>'
          + '<td style="text-align:right">' + l.recette.toLocaleString('fr-FR') + ' €</td>'
          + '<td style="text-align:right">' + l.coutEmployeur.toLocaleString('fr-FR') + ' €</td>'
          + '<td style="text-align:right;font-weight:700">' + l.attendu.toLocaleString('fr-FR') + ' €</td>'
          + '<td style="text-align:right">' + l.actuel.toLocaleString('fr-FR') + ' €</td>'
          + '<td style="text-align:right;font-weight:800;color:' + couleurEcart + '">' + (l.ecart>0?'+':'') + l.ecart.toLocaleString('fr-FR') + ' €</td>'
          + '</tr>';
        if (!ok && l.beneficiaires.length > 0) {
          body += '<tr' + '><td colspan="6" style="padding:4px 8px 10px 24px">'
            + l.beneficiaires.map(p => {
                const actuelP = (l.parPersonneActuel[p] || 0);
                return '<span style="font-size:11px;color:var(--text-sec);margin-right:14px">' + p + ' — actuel ' + actuelP.toFixed(2) + '€, attendu ' + l.attenduParPersonne.toFixed(2) + '€ '
                  + '<button class="btn btn-ghost btn-sm" style="padding:1px 4px;font-size:10px" onclick="corrigerEntreeCaissePrompt(\'' + p + '\', \'' + l.spectacle.replace(/'/g,"\\'") + '\', ' + l.attenduParPersonne + ')" title="Corriger avec le montant attendu">✏️</button>'
                + '</span>';
              }).join('')
            + '</td></tr>';
        }
      });
      body += '</tbody></table></div>';
    }
    box.innerHTML = '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">'
      + '<h3 style="font-weight:800">🔍 Vérification caisses vs compta</h3>'
      + '<button class="btn btn-ghost btn-sm" onclick="this.closest(\'[style*=fixed]\').remove()">✕</button>'
      + '</div>' + body;
  } catch(e) {
    overlay.querySelector('div').innerHTML = '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">'
      + '<h3 style="font-weight:800">🔍 Vérification caisses vs compta</h3>'
      + '<button class="btn btn-ghost btn-sm" onclick="this.closest(\'[style*=fixed]\').remove()">✕</button>'
      + '</div><div style="color:var(--red);padding:20px;text-align:center">Erreur : ' + e.message + '</div>';
  }
}

