async function chercherFDP(idx) {
  const r = window._declRows[idx];
  if (!r) return;
  const parts = (r.debut || '').split('/');
  const mois  = parts[1] || '';
  const annee = parts[2] || String(state.currentYear);
  toast('Recherche FDP dans Drive...', '');
  try {
    const data = await apiGet({
      action:   'chercherFichesPaie',
      salarie:  r.salarie  || '',
      nomComplet: r.nomComplet || r.salarie || '',  // nom complet si disponible
      projet:   r.projet   || '',
      mois,
      annee
    });
    if (data.trace) console.log('🔍 Détail recherche FDP :\n' + data.trace.join('\n'));
    if (data.error || !data.candidats || data.candidats.length === 0) {
      toast(data.error ? 'Erreur : ' + data.error : 'Aucune fiche de paie trouvée', 'error');
      if (data.trace) _afficherDetailRechercheFDP(data.trace);
      return;
    }
    window._fdpCandidats   = data.candidats;
    window._fdpRowIndex    = r._rowIndex;
    window._fdpDeclIdx     = idx;
    window._fdpSourceSheet = r._sourceSheet || 'Contrats';

    // Auto-lier quand la correspondance est évidente (même règle que le
    // classement en masse "📄 Classer FDP") : un vrai match salarié (pas
    // seulement projet) et soit le seul candidat, soit une avance nette sur
    // le suivant — sinon on laisse choisir manuellement pour éviter d'attacher
    // la mauvaise fiche.
    const top    = data.candidats[0];
    const second = data.candidats[1];
    const confiant = (top.scoreSal || 0) >= 4
      && (data.candidats.length === 1 || (top.score - second.score) >= 3);
    if (confiant) {
      await confirmerFDP(0);
    } else {
      _ouvrirModalFDP(r, data.candidats, false);
    }
  } catch(e) { toast('Erreur : ' + e.message, 'error'); }
}

