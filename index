// Supprime la ligne de recette (d'origine ou ajoutée manuellement) dont fait
// partie ce bouton, puis relance le recalcul — la recette supprimée sort donc
// aussi du total et les dépenses sont réajustées en conséquence.
function supprimerLignePrevi(btn) {
  const tr = btn.closest('tr');
  if (tr) tr.remove();
  recalculerPrevi();
}

// Recalcule le total des recettes puis réajuste PROPORTIONNELLEMENT toutes les
// lignes de dépenses (à partir du montant d'origine fixe EX base +10%, jamais
// cumulé d'un recalcul sur l'autre) pour que TOTAL DES CHARGES == TOTAL DES
// PRODUITS exactement à la fin (demande explicite : le prévi doit toujours finir
// à l'équilibre, pas seulement en être proche).
function recalculerPrevi() {
  const overlay = document.getElementById('previ-overlay');
  if (!overlay) return;
  const totalChargesBase = parseFloat(overlay.dataset.totalCharges) || 0;
  // Lu en direct depuis le DOM (et non depuis un total figé au premier rendu) pour
  // que la suppression d'une ligne de recette (supprimerLignePrevi) réduise bien
  // le total — une ligne retirée du DOM n'est plus comptée.
  const totalLignesProduits = Array.from(overlay.querySelectorAll('tr[data-montant]')).reduce((s, tr) => s + (parseFloat(tr.dataset.montant) || 0), 0);
  const ajouts = Array.from(document.querySelectorAll('.previ-ajout-montant')).reduce((s, inp) => s + (parseFloat(inp.value) || 0), 0);
  const totalProduits = Math.round((totalLignesProduits + ajouts) * 100) / 100;
  const montantEl = document.getElementById('previ-total-produits-montant');
  if (montantEl) montantEl.textContent = totalProduits.toLocaleString('fr-FR', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €';

  const originaux = window._previChargeOriginaux || [];
  const facteur = totalChargesBase > 0 ? (totalProduits / totalChargesBase) : 0;
  const valeurs = originaux.map(m => Math.round(m * facteur * 100) / 100);
  let sommeValeurs = Math.round(valeurs.reduce((s, v) => s + v, 0) * 100) / 100;
  if (valeurs.length) {
    const reste = Math.round((totalProduits - sommeValeurs) * 100) / 100;
    valeurs[valeurs.length - 1] = Math.round((valeurs[valeurs.length - 1] + reste) * 100) / 100;
  }
  valeurs.forEach((v, i) => {
    const td = document.getElementById('previ-charge-' + i);
    if (td) td.textContent = v.toLocaleString('fr-FR', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €';
  });
  const totalChargesEl = document.getElementById('previ-total-charges-montant');
  if (totalChargesEl) totalChargesEl.textContent = totalProduits.toLocaleString('fr-FR', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €';

  const ecartEl = document.getElementById('previ-ecart');
  if (!ecartEl) return;
  ecartEl.style.background = 'rgba(52,152,219,.15)';
  ecartEl.style.color = '#1b5a8a';
  const variation = ((facteur - 1) * 100);
  ecartEl.textContent = '✓ Prévisionnel à l\'équilibre — dépenses ajustées automatiquement de ' + (variation >= 0 ? '+' : '') + variation.toLocaleString('fr-FR',{minimumFractionDigits:1,maximumFractionDigits:1}) + ' % par rapport à la base EX +10% pour correspondre exactement aux recettes.';
}

// État filtres compta
const comptaState = { filtre: 'Tous', spectacle: 'Tous', compte: [], vue: 'liste', annee: 'Tous', moisOuverts: {} };
// Ferme le menu à cases à cocher "Compte(s)" au clic ailleurs sur la page —
// les clics à l'intérieur du bouton/panneau font stopPropagation() donc ne
// remontent jamais jusqu'ici.
document.addEventListener('click', () => {
  if (comptaState.compteDropdownOuvert) {
    comptaState.compteDropdownOuvert = false;
    renderCompta(window._comptaAllRows || []);
  }
});
window._comptaAllRows = [];
window._comptaRows = [];

function renderCompta(allHistoRows) {
  window._comptaAllRows = allHistoRows;

  // ── Filtre année (côté client sur ANNEE de chaque ligne) ──
  const filtreAnnee = comptaState.annee || 'Tous';
  let rows = filtreAnnee === 'Tous'
    ? allHistoRows
    : allHistoRows.filter(r => {
        // Normaliser l'année de la ligne → "26", "21", etc.
        const a = (r.ANNEE || '').toString().trim()
          .replace(/^EX\s*/i, '').trim()
          .replace(/^20(\d{2})$/, '$1'); // "2026" → "26"
        return a === filtreAnnee;
      });
  window._comptaRows = rows;

  const content = document.getElementById('content');

  // ── Années disponibles — normaliser "EX 21", "EX 21 ", "EX 2021"... → "21" ──
  const anneesRaw = allHistoRows
    .map(r => (r.ANNEE||'').toString().trim())
    .filter(Boolean)
    .map(a => a.replace(/^EX\s*/i, '').trim())  // "EX 21" → "21", "EX 2026" → "2026"
    .map(a => a.length === 4 ? a.slice(2) : a)  // "2026" → "26"
    .filter(a => /^\d{2}$/.test(a));             // garder seulement "21","22"...
  const annees = [...new Set(anneesRaw)].sort();

  // ── KPIs globaux ──
  // Recettes = comptes 7xx uniquement (prestations, subventions, dons, cotisations...)
  // Exclure trésorerie (512, 5121), comptes de tiers (401, 411, 421, 467), etc.
  // ── Fonctions de classification ──
  function isRecette(compte) {
    const c = (compte || '').toString().replace(/\./g,'');
    return c.startsWith('7');
  }
  function isCharge(compte) {
    const c = (compte || '').toString().replace(/\./g,'');
    return c.startsWith('6');
  }
  function isTresorerie(compte) {
    const c = (compte || '').toString().replace(/\./g,'');
    return c.startsWith('5');
  }
  function isVirementInterne(r) {
    const c   = (r.COMPTE  || '').toString().replace(/\./g,'');
    const lib = (r.LIBELLE || '').toUpperCase();
    if (!c.startsWith('5')) return false;
    return lib.includes('LIVRET') || lib.includes('PROVISION') || lib.includes('RETOUR PROV') || c === '5121';
  }

  // ── Séparer virements internes ──
  const virementsInternes = rows.filter(r => isVirementInterne(r));

  // Salaires et classifications
  // 641 (bruts) n'est quasiment jamais utilisé dans la pratique réelle de saisie
  // (les paies passent par 421 + ventilation, pas par une écriture 641 séparée) :
  // le compter comme charge du personnel laissait donc le vrai coût salarial
  // (net versé) totalement absent du Résultat chaque année. On utilise 421 (net
  // versé) à la place de 641, en accord explicite avec l'utilisateur.
  function isCoutSalarial(compte) {
    const c = (compte || '').toString();
    return c.startsWith('421') || c.startsWith('645') || c.startsWith('442');
  }
  function isVersementNet(compte) {
    return (compte || '').toString().startsWith('421');
  }

  // Source KPIs : si filtre spectacle actif → lignes filtrées, sinon tout
  const filtreSpec= comptaState.spectacle || 'Tous';
  const filtreComp= Array.isArray(comptaState.compte) ? comptaState.compte : [];

  const kpiSourceRows = (filtreSpec !== 'Tous' || filtreComp.length > 0)
    ? rows.filter(r => {
        if (filtreSpec !== 'Tous') {
          if ((r.SPECTACLE||'') !== filtreSpec) {
            if (!r._ventilations || !r._ventilations.some(v => (v.spectacle||'') === filtreSpec)) return false;
          }
        }
        if (filtreComp.length > 0 && !filtreComp.includes(r.COMPTE||'')) return false;
        return true;
      })
    : rows;

  function getVentCout(r) {
    // Le coût employeur ventilé par projet n'est qu'une répartition analytique (pour
    // savoir combien un spectacle a coûté), pas un montant à additionner en plus des
    // charges déjà comptées ailleurs (645/442 = cotisations réellement prélevées) —
    // sans filtre spectacle actif, on ne l'ajoute donc pas au total (évite un double
    // comptage). Confirmé explicitement par l'utilisateur.
    if (!r._ventilations || filtreSpec === 'Tous') return 0;
    return r._ventilations.filter(v => (v.spectacle||'') === filtreSpec).reduce((s,v) => s + (v.coutEmp||0), 0);
  }

  const totalCredit = kpiSourceRows.filter(r => r.COMPTE && isRecette(r.COMPTE) && !isVirementInterne(r)).reduce((s,r) => s + (r.CREDIT||0), 0);

  const totalChSoc  = kpiSourceRows.filter(r => ((r.COMPTE||'').startsWith('442') || (r.COMPTE||'').startsWith('645')) && !isVirementInterne(r)).reduce((s,r) => s + (r.DEBIT||0), 0);
  const totalSalVent = kpiSourceRows.filter(r => isVersementNet(r.COMPTE)).reduce((s,r) => s + getVentCout(r), 0);
  // 421 (net versé) : le compte 641 (bruts) n'étant quasiment jamais alimenté dans la
  // pratique réelle de saisie (paies passées par 421 + ventilation, jamais par une
  // écriture 641 séparée), l'exclure comme "compte de tiers déjà dans 641" laissait le
  // vrai coût salarial totalement absent du Résultat chaque année. On compte donc le
  // net versé comme la vraie charge de personnel, à la place de 641 — mais seulement
  // en vue "Tous" : sur un projet précis, sa part est déjà comptée via totalSalVent
  // (ventilation employeur par spectacle), l'ajouter aussi ferait un double comptage.
  const total421 = filtreSpec === 'Tous'
    ? kpiSourceRows.filter(r => isVersementNet(r.COMPTE) && !isVirementInterne(r)).reduce((s,r) => s + (r.DEBIT||0), 0)
    : 0;
  // Coût salarial réel = 421 (net versé) + 645/442 (charges sociales) + ventilations
  // EMPLOYEUR des 421 (vue par projet)
  const totalSal = totalChSoc + total421 + totalSalVent;

  // Charges totales = charges 6xx + 442 + 421 (net versé) + ventilations
  const totalCharges6xx = kpiSourceRows.filter(r => r.COMPTE && isCharge(r.COMPTE) && !isVirementInterne(r)).reduce((s,r) => s + (r.DEBIT||0), 0);
  // 442 (organismes sociaux, ex: PAS-DSN, cotisations patronales via DGFIP/URSSAF) ne commence
  // pas par "6" donc n'est pas compté par isCharge() — sans cet ajout, ces charges bien réelles
  // apparaissaient dans le libellé "Coût salarial (421+645+442)" mais n'étaient jamais déduites
  // du Résultat, ce qui le gonflait artificiellement.
  const total442 = kpiSourceRows.filter(r => (r.COMPTE||'').startsWith('442') && !isVirementInterne(r)).reduce((s,r) => s + (r.DEBIT||0), 0);
  const totalDebit = totalCharges6xx + total442 + total421 + totalSalVent;
  const totalNet421 = filtreSpec === 'Tous'
    ? rows.filter(r => isVersementNet(r.COMPTE) && !isVirementInterne(r)).reduce((s,r) => s + (r.DEBIT||0), 0)
    : kpiSourceRows.filter(r => isVersementNet(r.COMPTE)).reduce((s,r) => s + getVentCout(r), 0);
  const totalFrais  = kpiSourceRows.filter(r => ((r.COMPTE||'').startsWith('625') || (r.COMPTE||'').startsWith('606')) && !isVirementInterne(r)).reduce((s,r) => s + (r.DEBIT||0), 0);
  const nbOrange    = kpiSourceRows.filter(r => r.STATUT_VERIF === 'ORANGE' && !isVirementInterne(r)).length;

  // ── Spectacles et comptes uniques pour filtres ──
  const spectacles = ['Tous', ...new Set(rows.map(r => r.SPECTACLE||'').filter(Boolean).filter(s => s !== 'GENERAL'))].sort();
  const comptes    = ['Tous', ...new Set(rows.map(r => r.COMPTE||'').filter(Boolean))].sort();

  // ── Appliquer filtres ──
  const filtreSt  = comptaState.filtre    || 'Tous';
  let rowsFilt = rows;
  if (filtreSt   !== 'Tous') rowsFilt = rowsFilt.filter(r => {
    if (filtreSt === 'Recettes')  return isRecette(r.COMPTE) && (r.CREDIT||0) > 0;
    if (filtreSt === 'Charges')   return isCharge(r.COMPTE)  && (r.DEBIT||0) > 0;
    if (filtreSt === 'Salaires')  return isCoutSalarial(r.COMPTE); // 421+645+442
    if (filtreSt === 'Frais')     return (r.COMPTE||'').startsWith('625') || (r.COMPTE||'').startsWith('606');
    if (filtreSt === 'À vérifier') return r.STATUT_VERIF === 'ORANGE';
    if (filtreSt === 'Trésorerie') return isTresorerie(r.COMPTE);
    if (filtreSt === 'Tous') return filtreSpec !== 'Tous' || !isVirementInterne(r);
    return true;
  });
  if (filtreSpec !== 'Tous') {
    rowsFilt = rowsFilt.filter(r => {
      // Ligne 421 (net versé) : ne montrer que si elle a des ventilations pour ce projet
      // mais masquer le montant principal 421 (il concerne tous les projets)
      if (isVersementNet(r.COMPTE)) {
        return r._ventilations && r._ventilations.some(v => (v.spectacle||'') === filtreSpec && (v.coutEmp||0) > 0);
      }
      // Autres lignes : montrer si spectacle correspond
      if ((r.SPECTACLE||'') === filtreSpec) return true;
      return false;
    });
  }
  if (filtreComp.length > 0) rowsFilt = rowsFilt.filter(r => filtreComp.includes(r.COMPTE||''));
  // Filtrer les lignes vraiment vides (garder celles avec ventilations matchantes)
  const rowsFiltClean = rowsFilt.filter(r => {
    if (r.COMPTE || r.DATE !== '—' || r.LIBELLE || (r.CREDIT||0) > 0 || (r.DEBIT||0) > 0) return true;
    // Garder si a des ventilations pertinentes
    if (r._ventilations && r._ventilations.some(v => (v.coutEmp||0) > 0)) return true;
    return false;
  });

  const titreCompta = filtreSpec !== 'Tous'
    ? '📚 Comptabilité — ' + state.currentEntity + ' · ' + filtreSpec
    : '📚 Comptabilité — ' + state.currentEntity + ' ' + state.currentYear;

  let html = '<div class="module-header"><h2>' + titreCompta + '</h2>'
    + '<div style="display:flex;gap:8px">'
    + (filtreSpec !== 'Tous' ? '<button class="btn btn-green btn-sm" onclick="genererRapportProjet()">📊 Rapport ' + filtreSpec + '</button>' : '')
    + '<button class="btn btn-ghost btn-sm" onclick="ouvrirBilanFinancier()">📄 Bilan financier</button>'
    + '<button class="btn btn-ghost btn-sm" onclick="ouvrirBilanPourSub()">📊 Bilan pour sub</button>'
    + '<button class="btn btn-ghost btn-sm" onclick="ouvrirPreviNPlus1()">📈 Prévi N+1</button>'
    + '<button class="btn btn-ghost btn-sm" id="btn-recherche-fdp" onclick="rechercherFDPLignesRouges()" title="Cherche dans le Drive une FDP correspondante (mois + code salarié) pour chaque ligne 421 en rouge, et l\'attache automatiquement">🔍 Rechercher FDP</button>'
    + '<button class="btn btn-blue btn-sm" onclick="ouvrirImportReleve()">📤 Import relevé</button>'
    + '<button class="btn btn-orange btn-sm" data-action="compta-saisir">+ Saisir</button>'
    + '<button class="btn btn-ghost btn-sm" onclick="loadCompta()">🔄 Sync</button>'
    + '</div></div>';

  // KPIs — cliquables pour ouvrir une petite fenêtre avec le détail par
  // compte et le total (pas un changement d'onglet). On calcule ici le
  // détail groupé par compte pour chaque carte et on le stocke pour que
  // ouvrirDetailKpi() puisse l'afficher au clic.
  function grouperParCompte(liste, montantFn) {
    const groupes = {};
    liste.forEach(r => {
      const m = montantFn(r);
      if (!m) return;
      const c = r.COMPTE || '(sans compte)';
      groupes[c] = (groupes[c] || 0) + m;
    });
    return Object.entries(groupes).map(([compte, montant]) => ({ compte, montant })).sort((a,b) => b.montant - a.montant);
  }
  window._comptaKpiDetail = {
    'Recettes': grouperParCompte(kpiSourceRows.filter(r => r.COMPTE && isRecette(r.COMPTE) && !isVirementInterne(r)), r => r.CREDIT||0),
    'Charges':  grouperParCompte(kpiSourceRows.filter(r => r.COMPTE && isCharge(r.COMPTE) && !isVirementInterne(r)), r => r.DEBIT||0),
    'Salaires': grouperParCompte(kpiSourceRows.filter(r => isCoutSalarial(r.COMPTE) && !isVirementInterne(r)), r => r.DEBIT||0),
    'Frais':    grouperParCompte(kpiSourceRows.filter(r => ((r.COMPTE||'').startsWith('625') || (r.COMPTE||'').startsWith('606')) && !isVirementInterne(r)), r => r.DEBIT||0),
  };
  if (totalSalVent > 0) {
    window._comptaKpiDetail['Charges'].push({ compte: '421 (coût employeur ventilé)', montant: totalSalVent });
    window._comptaKpiDetail['Salaires'].push({ compte: '421 (coût employeur ventilé)', montant: totalSalVent });
  }
  // "À vérifier" n'a pas de compte à grouper : on liste les lignes elles-mêmes
  window._comptaKpiDetailAVerifier = kpiSourceRows
    .filter(r => r.STATUT_VERIF === 'ORANGE' && !isVirementInterne(r))
    .map(r => ({ date: r.DATE, libelle: r.LIBELLE, montant: Math.max(r.DEBIT||0, r.CREDIT||0) }));

  // Solde bancaire réel — ancré sur un solde d'ouverture saisi manuellement
  // (relevé bancaire au 01/01 en main) pour l'année civile affichée, plus la
  // somme de TOUTES les recettes/charges réelles dont la DATE réelle tombe
  // dans cette même année, quel que soit leur compte comptable (645, 706,
  // 625, 421...) : dans ce classeur, chaque ligne COMPTA correspond à un
  // vrai mouvement du compte courant, sauf les lignes "5121" (Livret A) qui
  // ne sont qu'un doublon du montant pour connaître le solde du Livret A
  // séparément, et ne doivent pas être comptées ici. On filtre volontairement
  // par DATE réelle et non par la colonne ANNEE (exercice comptable) : une
  // charge de décembre payée en janvier peut être rattachée comptablement à
  // l'exercice précédent ("EX 25") tout en ayant un vrai impact sur le solde
  // bancaire de janvier ("EX 26" au sens calendaire) — filtrer par ANNEE
  // exclurait à tort ce mouvement réel du calcul. On ne reconstitue plus un
  // cumul depuis le tout début de l'historique : trop fragile (dépend de ce
  // qu'un vieux "report de solde" ambigu représente vraiment). Si "Tous" est
  // sélectionné, on se rattache à la dernière année connue (celle qui
  // représente "le solde actuel"). Le détail (liste triée chronologiquement,
  // avec solde cumulé ligne à ligne) est stocké pour que le clic sur la
  // carte permette de vérifier chaque montant.
  // Une éventuelle ligne "SOLDE AU ..." / "Solde Bancaire N-1" laissée dans
  // l'historique de cette année reste exclue par sécurité (ce n'est pas une
  // vraie transaction, juste un repère manuel qui doublerait le calcul).
  function estLigneSoldeReporte(libelle) {
    return (libelle || '').toString().trim().toLowerCase()
      .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
      .startsWith('solde');
  }

  const exerciceCibleBanque = filtreAnnee !== 'Tous' ? filtreAnnee : (annees.length ? annees[annees.length - 1] : null);
  const rowsPourSolde = exerciceCibleBanque === null ? [] : allHistoRows.filter(r => {
    const m = (r.DATE || '').toString().trim().match(/^(\d{2})\/(\d{2})\/(\d{2,4})$/);
    if (!m) return false;
    const yy = m[3].length === 4 ? m[3].slice(2) : m[3];
    return yy === exerciceCibleBanque;
  });
  const cleOuverture = exerciceCibleBanque !== null ? 'EX ' + exerciceCibleBanque : null;
  const soldesOuverture = window._comptaSoldesOuverture || {};
  const soldeOuverture = cleOuverture !== null && soldesOuverture[cleOuverture] !== undefined ? soldesOuverture[cleOuverture] : null;

  let soldeBancaire = soldeOuverture || 0;
  let dernierMvtDate = '—', dernierMvtCle = '';
  const mouvementsBanque = [];
  if (soldeOuverture !== null) {
    mouvementsBanque.push({ date: '01/01', libelle: 'Solde d\'ouverture (saisi)', montant: soldeOuverture, exclu: false, ouverture: true, cle: '' });
  }
  rowsPourSolde.forEach(r => {
    const c = (r.COMPTE || '').toString().replace(/\./g,'');
    if (c.startsWith('5121')) return; // Livret A : doublon du montant, pas un mouvement du compte courant
    const montant = (r.CREDIT||0) - (r.DEBIT||0);
    if (montant === 0) return; // pas de vrai mouvement bancaire (ex: ligne de ventilation coût employeur)
    const exclu = estLigneSoldeReporte(r.LIBELLE);
    if (!exclu) soldeBancaire += montant;
    mouvementsBanque.push({ date: r.DATE, libelle: r.LIBELLE, compte: r.COMPTE, montant, exclu, cle: (r.DATE && r.DATE !== '—') ? r.DATE.split('/').reverse().join('') : '' });
    if (!exclu && r.DATE && r.DATE !== '—') {
      const cle = r.DATE.split('/').reverse().join('');
      if (cle > dernierMvtCle) { dernierMvtCle = cle; dernierMvtDate = r.DATE; }
    }
  });
  window._comptaKpiDetailBanque = mouvementsBanque.slice().sort((a,b) => a.cle.localeCompare(b.cle));

  const kpiClic = 'style="cursor:pointer" data-action="compta-detail-kpi" data-type="';
  const soldeOuvertureLabel = soldeOuverture !== null
    ? '<div style="font-size:10px;color:var(--text-sec);margin-top:2px">Dernier mouvement : ' + dernierMvtDate
