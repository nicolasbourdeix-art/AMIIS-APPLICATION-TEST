      apiGet({ action: 'getInfoSalariesPaie' }),
      apiGet({ action: 'getInfoComptesAnalytiques' }),
      apiGet({ action: 'getInfoSocietesPaie' })
    ]);
    const dernierSal = sal.dernierImport ? new Date(sal.dernierImport).toLocaleString('fr-FR') : 'jamais';
    const dernierAna = ana.dernierImport ? new Date(ana.dernierImport).toLocaleString('fr-FR') : 'jamais';
    const dernierSoc = soc.dernierImport ? new Date(soc.dernierImport).toLocaleString('fr-FR') : 'jamais';
    c.innerHTML = '<div class="card" style="margin-bottom:16px">'
      + '<div class="card-title" style="margin-bottom:14px">Salariés paie — matricules sPAIEctacle</div>'
      + '<p style="font-size:11px;color:var(--text-sec);margin-bottom:14px">Importe le fichier "Salariés de l\'année" exporté du logiciel de paie (colonnes Code société / Matricule / Nom / Prénom) — idéalement une fois par mois, pour que les contrats générés depuis les DPAE utilisent le vrai matricule au lieu d\'en deviner un. Chaque import remplace entièrement la table précédente.</p>'
      + '<div style="display:flex;gap:16px;align-items:center;margin-bottom:16px">'
      + '<span class="status-badge status-ok">' + (sal.count||0) + ' salarié(s) en table</span>'
      + '<span style="font-size:11px;color:var(--text-sec)">Dernier import : ' + dernierSal + '</span>'
      + '</div>'
      + '<input type="file" id="sp-file" accept=".txt,.csv" style="display:none" onchange="importerFichierSalariesPaie(this)">'
      + '<button class="btn btn-orange" onclick="document.getElementById(\'sp-file\').click()">📤 Importer le fichier salariés</button>'
      + '</div>'
      + '<div class="card" style="margin-bottom:16px">'
      + '<div class="card-title" style="margin-bottom:14px">Comptes analytiques — projets sPAIEctacle</div>'
      + '<p style="font-size:11px;color:var(--text-sec);margin-bottom:14px">Importe la liste des comptes analytiques exportée du logiciel de paie (colonnes Code société / Libellé analytique / Compte analytique) — pour que les contrats générés utilisent le vrai code du projet au lieu du nom interne AMIIS, qui n\'est pas toujours reconnu par le logiciel. Chaque import remplace entièrement la table précédente.</p>'
      + '<div style="display:flex;gap:16px;align-items:center;margin-bottom:16px">'
      + '<span class="status-badge status-ok">' + (ana.count||0) + ' compte(s) en table</span>'
      + '<span style="font-size:11px;color:var(--text-sec)">Dernier import : ' + dernierAna + '</span>'
      + '</div>'
      + '<input type="file" id="ap-file" accept=".txt,.csv" style="display:none" onchange="importerFichierComptesAnalytiques(this)">'
      + '<button class="btn btn-orange" onclick="document.getElementById(\'ap-file\').click()">📤 Importer le fichier comptes analytiques</button>'
      + '</div>'
      + '<div class="card">'
      + '<div class="card-title" style="margin-bottom:14px">Sociétés — codes sPAIEctacle</div>'
      + '<p style="font-size:11px;color:var(--text-sec);margin-bottom:14px">Importe la liste des sociétés exportée du logiciel de paie (colonnes Code société / Raison sociale / Nom abrégé) — pour retrouver le vrai Code société à partir du nom de structure affiché sur Paie AMIIS ("LES PAILLETTES", "CEKO"...), qui n\'est ni le code ni toujours identique à la raison sociale. Chaque import remplace entièrement la table précédente.</p>'
      + '<div style="display:flex;gap:16px;align-items:center;margin-bottom:16px">'
      + '<span class="status-badge status-ok">' + (soc.count||0) + ' société(s) en table</span>'
      + '<span style="font-size:11px;color:var(--text-sec)">Dernier import : ' + dernierSoc + '</span>'
      + '</div>'
      + '<input type="file" id="so-file" accept=".txt,.csv" style="display:none" onchange="importerFichierSocietesPaie(this)">'
      + '<button class="btn btn-orange" onclick="document.getElementById(\'so-file\').click()">📤 Importer le fichier sociétés</button>'
      + '</div>';
  } catch(e) { c.innerHTML = renderError('Erreur chargement de l\'import paie : ' + e.message); }
}

