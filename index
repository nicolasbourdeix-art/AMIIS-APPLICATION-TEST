  50%      { transform: scale(1.045); filter: drop-shadow(0 0 20px rgba(245,166,35,.45)); }
}
#app-loading-overlay .app-loading-title-big { font-family: 'Abril Fatface', serif; font-weight: 400; font-size: 46px; color: var(--text); letter-spacing: .5px; }
