      + 'onclick="declencherUploadCompteGroupe(\'' + projet.replace(/'/g,"\\'") + '\',' + r._rowIndex + ',\'' + champFichier + '\')">📤 Importer</button>';
  }
  html += '</div>';
  return html;
}

const COMPTE_GROUPE_TAILLE_MAX_MO = 15;

// Crée un input file volant (jamais inséré dans le DOM visible), le déclenche,
// et envoie le fichier choisi au backend dès la sélection — évite d'avoir un
// <input type=file> par cellule en permanence dans la table.
function declencherUploadCompteGroupe(projet, rowIndex, champ) {
  const input = document.createElement('input');
  input.type = 'file';
  input.accept = '.pdf,.doc,.docx,.jpg,.jpeg,.png';
  input.style.display = 'none';
  input.addEventListener('change', () => {
    const file = input.files && input.files[0];
    if (file) uploaderFichierCompteGroupeUI(projet, rowIndex, champ, file);
    input.remove();
  });
  document.body.appendChild(input);
  input.click();
}

async function uploaderFichierCompteGroupeUI(projet, rowIndex, champ, file) {
  if (file.size > COMPTE_GROUPE_TAILLE_MAX_MO * 1024 * 1024) {
    toast('Fichier trop volumineux (max ' + COMPTE_GROUPE_TAILLE_MAX_MO + ' Mo)', 'error');
    return;
  }
  toast('Envoi de "' + file.name + '"…', '');
  try {
    const base64Data = await new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve((reader.result || '').toString().split(',')[1] || '');
      reader.onerror = () => reject(new Error('Lecture du fichier impossible'));
      reader.readAsDataURL(file);
    });
    const res = await apiPost({ action: 'uploaderFichierCompteGroupe', payload: {
      projet, rowIndex, champ, nomFichier: file.name, mimeType: file.type || 'application/octet-stream', base64Data
    }});
    if (!res || res.error) { toast('Erreur : ' + (res && (res.message||res.error) || 'inconnue'), 'error'); return; }
    toast('✓ Fichier importé dans le Drive du projet', 'success');
    const nom = (window._cgNomActuel && window._cgNomActuel[projet]) || projet;
    afficherCompteGroupe(projet, nom);
  } catch(e) {
    toast('Erreur : ' + e.message, 'error');
  }
}

