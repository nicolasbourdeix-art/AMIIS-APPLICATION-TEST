// Barre de progression en pourcentage de l'écran de chargement plein écran —
// simulée (on ne connaît pas l'avancement réel des appels réseau), avance
// vite au début puis ralentit sans jamais atteindre 100% tant que le vrai
// chargement n'est pas terminé, pour rester honnête sur le fait que ça
// charge encore. _finirAppLoaderPct() saute directement à 100% une fois les
// données effectivement arrivées.
let _appLoaderInterval = null;
let _appLoaderPct = 0;

function _demarrerAppLoaderPct() {
  const sec = document.getElementById('app-progress-section');
  if (sec) sec.style.display = 'flex';
  _appLoaderPct = 0;
  _majAppLoaderPct(0);
  if (_appLoaderInterval) clearInterval(_appLoaderInterval);
  _appLoaderInterval = setInterval(() => {
    const increment = _appLoaderPct < 50 ? 7 : _appLoaderPct < 80 ? 2.5 : 0.6;
    _appLoaderPct = Math.min(_appLoaderPct + increment, 92);
    _majAppLoaderPct(_appLoaderPct);
  }, 180);
}

function _majAppLoaderPct(pct) {
  const fill  = document.getElementById('app-loader-fill');
  const label = document.getElementById('app-loader-pct');
  if (fill)  fill.style.width = pct + '%';
  if (label) label.textContent = Math.round(pct) + '%';
}

function _finirAppLoaderPct() {
  if (_appLoaderInterval) { clearInterval(_appLoaderInterval); _appLoaderInterval = null; }
  _majAppLoaderPct(100);
}

// Masque l'écran de chargement plein écran (logo + barre) une fois que le
// Dashboard (ou le portail / une erreur d'init / un changement d'entité) a
// effectivement pris le relais. On masque (display:none) plutôt que de
// retirer l'élément du DOM, pour pouvoir le réafficher tel quel — avec son
// image déjà en mémoire — au prochain changement d'entité, sans avoir à
// réinjecter le logo encodé en base64 à chaque fois.
function _removeAppLoadingOverlay() {
  const el = document.getElementById('app-loading-overlay');
  if (!el || el.style.display === 'none') return;
  _finirAppLoaderPct();
  setTimeout(() => { el.style.display = 'none'; }, 300);
}

// Réaffiche l'écran de chargement plein écran, avec un sous-texte indiquant
// le changement d'entité en cours (ex: "CLR → AMIIS") au lieu du message
// générique du tout premier chargement.
function _showAppLoadingOverlay(sousTexte) {
  const el = document.getElementById('app-loading-overlay');
  if (!el) return;
  const sub = el.querySelector('.app-loading-sub');
  if (sub) sub.textContent = sousTexte || 'Chargement des données…';
  el.style.display = 'flex';
  _demarrerAppLoaderPct();
}

// Identification simple avant l'entrée dans l'appli — pas une vraie sécurité
// (Google contrôle déjà l'accès au fichier), juste pour savoir quelle
// personne physique utilise l'outil. Si une identité valide est déjà
// mémorisée (localStorage), on passe directement ; sinon on affiche le
// formulaire et on attend une saisie correcte avant de continuer.
function _assurerConnexionApp() {
  return new Promise(resolve => {
    let dejaIdentifie = null, dejaEntites = null;
    try {
      dejaIdentifie = localStorage.getItem('amiis_identite');
      dejaEntites   = JSON.parse(localStorage.getItem('amiis_identite_entites') || '[]');
    } catch(e) {}
    if (dejaIdentifie) {
      state.identifiedUser = dejaIdentifie;
      state.identifiedUserEntites = dejaEntites || [];
      resolve();
      return;
    }

    const section  = document.getElementById('app-login-section');
    const userIn   = document.getElementById('app-login-user');
    const passIn   = document.getElementById('app-login-pass');
    const errorEl  = document.getElementById('app-login-error');
    const btn      = document.getElementById('app-login-btn');
    if (!section || !userIn || !passIn || !errorEl || !btn) { resolve(); return; }
    section.style.display = 'flex';
    userIn.focus();

    async function tenterConnexion() {
      const nom = (userIn.value || '').trim();
      const mdp = (passIn.value || '').trim();
      if (!nom || !mdp) return;
      errorEl.style.display = 'none';
      btn.disabled = true;
      const btnLabelOrig = btn.textContent;
      btn.textContent = '…';
      try {
        const res = await apiPost({ action: 'verifierIdentiteApp', payload: { nom, motDePasse: mdp } });
        if (!res || !res.success) {
          errorEl.textContent = (res && res.error) || 'Identifiants incorrects';
          errorEl.style.display = 'block';
          passIn.value = '';
          passIn.focus();
          btn.disabled = false;
          btn.textContent = btnLabelOrig;
          return;
        }
        try {
          localStorage.setItem('amiis_identite', res.nom);
          localStorage.setItem('amiis_identite_entites', JSON.stringify(res.entites || []));
        } catch(e) {}
        state.identifiedUser = res.nom;
        state.identifiedUserEntites = res.entites || [];
        section.style.display = 'none';
        resolve();
      } catch(e) {
        errorEl.textContent = 'Erreur de connexion : ' + e.message;
        errorEl.style.display = 'block';
        btn.disabled = false;
        btn.textContent = btnLabelOrig;
      }
    }
    btn.addEventListener('click', tenterConnexion);
    passIn.addEventListener('keydown', e => { if (e.key === 'Enter') tenterConnexion(); });
    userIn.addEventListener('keydown', e => { if (e.key === 'Enter') passIn.focus(); });
  });
}

