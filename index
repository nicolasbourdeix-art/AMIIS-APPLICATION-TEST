      });
    }
  });
  });

  if (rowsFiltClean.length > 500) {
    html += '<tr><td colspan="10" style="text-align:center;color:var(--text-sec);padding:10px;font-size:11px">… ' + (rowsFiltClean.length - 500) + ' lignes supplémentaires (affiner le filtre)</td></tr>';
  }

  html += '</tbody></table></div></div>';
  content.innerHTML = html;
  attachContentListeners();
}

// Champ de recherche filtrant (au lieu d'un simple <select>) pour changer le
// compte comptable directement depuis la ligne, sans passer par la modale
// d'édition complète. Un <select> natif ne filtre qu'au tout début du texte
// visible ; ici on peut taper le code OU un mot du libellé et la liste se
// filtre en direct. Même mécanique que les comboboxes déjà utilisées pour
// l'import de relevé et les devis (classes combo-wrap/combo-input/combo-list).
// Options construites depuis window._comptaPlanListe : la liste COMPLÈTE des
// paires {code, label} (plan standard + CODE COMPTA + historique COMPTA), SANS
// dédoublonner par code — un même code peut avoir plusieurs libellés valides
// (ex: chez CLR, 625.6 sert à la fois pour "Frais de dépla", "Frais de repas"
// et "Hébergement" : seul le libellé distingue les trois usages).
// operationActuelle permet de présélectionner le LIBELLÉ exact déjà enregistré
// sur cette ligne (et pas juste le premier trouvé pour ce code).
// Un compte est "à préciser" quand un code est saisi mais que son libellé
// exact reste ambigu (plusieurs usages possibles pour ce code, ex: 442 chez
// CLR) et qu'aucun libellé n'a encore été choisi sur cette ligne précise —
// même logique que l'affichage du combo compte, extraite pour être réutilisée
// dans le comptage des lignes "en attente" par mois.
function compteEstAPreciser(compteActuel, operationActuelle) {
  if (!compteActuel || operationActuelle) return false;
  const candidats = (window._comptaPlanListe || []).filter(o => o.code === compteActuel);
  return candidats.length !== 1;
}

function renderComboComptePourLigne(compteActuel, rowIndex, operationActuelle) {
  const liste = window._comptaPlanListe || [];
  let labelActuel = '';
  if (compteActuel) {
    if (operationActuelle) {
      // Un libellé a réellement été saisi sur cette ligne : on l'affiche tel
      // quel, qu'il figure ou non dans le plan chargé (ex: texte historique).
      labelActuel = compteActuel + ' — ' + operationActuelle;
    } else {
      // Aucun libellé saisi : on ne présélectionne un libellé du plan QUE s'il
      // est le seul possible pour ce compte — sinon on ne devine pas lequel
      // s'applique (ex: 442 a plusieurs usages distincts chez CLR), et on
      // affiche juste le code, à préciser par l'utilisateur.
      const candidats = liste.filter(o => o.code === compteActuel);
      labelActuel = candidats.length === 1 ? (compteActuel + ' — ' + candidats[0].label) : (compteActuel + ' — (à préciser)');
    }
  }
  return '<div class="combo-wrap" style="position:relative;width:210px">'
    + '<input type="text" id="cpt-combo-' + rowIndex + '" class="combo-input" autocomplete="off"'
    + ' style="width:100%;padding:2px 4px;font-size:11px;font-family:monospace;font-weight:700;border-radius:4px;'
    + 'border:1px solid ' + (compteActuel ? 'var(--border)' : 'var(--orange)') + ';background:var(--surface);color:var(--text)"'
    + ' value="' + (labelActuel ? labelActuel.replace(/"/g,'&quot;') : '') + '"'
    + ' placeholder="⚠ choisir un compte…"'
    + ' data-rowindex="' + rowIndex + '" data-value="' + (compteActuel||'') + '"'
    + ' oninput="comptaComboFiltrer(this)" onfocus="comptaComboOuvrir(this)">'
    + '<div class="combo-list" style="display:none;position:absolute;z-index:300;top:100%;left:0;min-width:280px;max-height:240px;overflow-y:auto;background:var(--surface);border:1px solid var(--border);border-radius:6px;box-shadow:0 4px 12px rgba(0,0,0,.4)"></div>'
    + '</div>';
}

// Au focus, affiche la liste COMPLÈTE (jamais filtrée par le texte déjà affiché
// dans le champ, du type "645 — (à préciser)" ou "625 — Déplacements" — ce texte
// ne correspond littéralement à aucun code/libellé pris isolément, donc filtrer
// avec faisait toujours ressortir "Aucun résultat" dès l'ouverture). Sélectionne
// aussi le texte existant pour que la première frappe le remplace directement.
function comptaComboOuvrir(input) {
  input.select();
  _rendreListeComptaCombo(input, '');
}

function comptaComboFiltrer(input) {
  _rendreListeComptaCombo(input, input.value.trim().toLowerCase());
}

function _rendreListeComptaCombo(input, requete) {
  document.querySelectorAll('.combo-list').forEach(el => { if (el !== input.nextElementSibling) el.style.display = 'none'; });
  const liste = window._comptaPlanListe || [];
  const entries = liste.slice().sort((a, b) => {
    const na = parseFloat(a.code), nb = parseFloat(b.code);
    if (!isNaN(na) && !isNaN(nb) && na !== nb) return na - nb;
    if (a.code !== b.code) return a.code.localeCompare(b.code);
    return a.label.localeCompare(b.label);
  });
  // Le code comptable qui COMMENCE par la requête passe en premier (recherche
  // "645" ou "64"), sinon on cherche aussi dans le texte du libellé ("charges",
  // "repas", "dépla"...) — ce qui permet justement de distinguer "Frais de
  // repas" de "Frais de dépla" même s'ils partagent le même code.
  let filtrees = entries;
  if (requete) {
    const parCode  = entries.filter(o => o.code.toLowerCase().startsWith(requete));
    const parLabel = entries.filter(o => !o.code.toLowerCase().startsWith(requete) && o.label.toLowerCase().includes(requete));
    filtrees = parCode.concat(parLabel);
  }
  const listEl = input.nextElementSibling;
  let html = '';
  filtrees.slice(0, 100).forEach(o => {
    html += '<div class="combo-item" style="padding:5px 8px;font-size:11px;cursor:pointer" '
      + 'onmousedown="comptaComboChoisir(\'' + input.getAttribute('data-rowindex') + '\',\'' + o.code.replace(/'/g,"\\'") + '\',\'' + o.label.replace(/'/g,"\\'").replace(/"/g,'&quot;') + '\')">'
      + '<span style="font-family:monospace;font-weight:700">' + o.code + '</span> — ' + o.label + '</div>';
  });
  if (filtrees.length === 0) html = '<div style="padding:6px 8px;font-size:11px;color:var(--text-sec)">Aucun résultat pour ce code — utilisez la saisie libre ci-dessous</div>';
  // Toujours proposer la saisie libre : un code comptable/analytique tout neuf,
  // absent du plan actuel, doit quand même pouvoir être enregistré tel quel —
  // sans ça, taper un code inconnu et cliquer ailleurs ne sauvegardait rien.
  html += '<div class="combo-item" style="padding:5px 8px;font-size:11px;cursor:pointer;color:var(--text-sec);border-top:1px solid var(--border)" '
    + 'onmousedown="comptaComboSaisieLibre(\'' + input.getAttribute('data-rowindex') + '\')">✎ Saisie libre…</div>';
  listEl.innerHTML = html;
  listEl.style.display = 'block';
}

// Enregistre le texte tapé tel quel comme code comptable, même s'il n'existe pas
// (encore) dans le plan chargé — utile pour un nouveau code analytique/projet.
// Ne touche pas au libellé "Opération compta" existant dans ce cas (on ne connaît
// pas de libellé officiel pour un code tout neuf).
function comptaComboSaisieLibre(rowIndex) {
  const input = document.getElementById('cpt-combo-' + rowIndex);
  if (!input) return;
  const saisieActuelle = input.value.trim();
  const code = prompt('Code comptable :', saisieActuelle);
  if (!code || !code.trim()) return;
  const codeFinal = code.trim();
  const valeurPrecedente = input.value;
  const dataValuePrecedent = input.dataset.value;
  input.value = codeFinal;
  input.dataset.value = codeFinal;
  input.nextElementSibling.style.display = 'none';
  changerCompteLigne(parseInt(rowIndex, 10), codeFinal, '', input, valeurPrecedente, dataValuePrecedent);
}

function comptaComboChoisir(rowIndex, code, label) {
  const input = document.getElementById('cpt-combo-' + rowIndex);
  let valeurPrecedente = null, dataValuePrecedent = null;
  if (input) {
    valeurPrecedente = input.value;
    dataValuePrecedent = input.dataset.value;
    input.value = code + ' — ' + label;
    input.dataset.value = code;
    input.nextElementSibling.style.display = 'none';
  }
  changerCompteLigne(parseInt(rowIndex, 10), code, label, input || { disabled: false }, valeurPrecedente, dataValuePrecedent);
}

// nouvelleOperation : le libellé associé au choix fait dans la liste — écrit en
// même temps que le code, car pour un code partagé par plusieurs libellés (ex:
// 625.6), le code seul ne suffit pas à distinguer "Frais de dépla" de "Frais de
// repas" ; les deux colonnes doivent être mises à jour ensemble. Vide = ne pas
// toucher au libellé déjà présent (cas de la saisie libre d'un code inconnu).
// valeurPrecedente/dataValuePrecedent : état du champ AVANT la sélection —
// l'affichage est mis à jour immédiatement pour la réactivité (avant même la
// réponse du serveur), donc en cas d'échec on doit pouvoir revenir en arrière
// plutôt que de laisser un changement visible qui n'a pas été réellement
// enregistré dans le Sheet.
async function changerCompteLigne(rowIndex, nouveauCompte, nouvelleOperation, selectEl, valeurPrecedente, dataValuePrecedent) {
  if (!nouveauCompte) return;
  selectEl.disabled = true;
  function annulerChangement() {
    if (selectEl && valeurPrecedente !== undefined && valeurPrecedente !== null && typeof selectEl.value !== 'undefined') {
      selectEl.value = valeurPrecedente;
      if (selectEl.dataset) selectEl.dataset.value = dataValuePrecedent || '';
    }
  }
  try {
    const corrections = { 'Numéro comptable': nouveauCompte };
    if (nouvelleOperation) corrections['Opération compta'] = nouvelleOperation;
    const res = await apiPost({ action: 'editerLigneCompta', payload: { rowIndex, corrections } });
    if (!res || res.success !== true) {
      toast('Erreur (non enregistré) : ' + (res && (res.message || res.error) || 'inconnue'), 'error');
      annulerChangement();
      selectEl.disabled = false;
      return;
    }
    const row = (window._comptaAllRows || []).find(r => r._rowIndex === rowIndex);
    if (row) {
      row.COMPTE = nouveauCompte;
      row.STATUT_VERIF = 'VERT';
      if (nouvelleOperation) row.OP_TYPE = nouvelleOperation;
    }
    toast('✓ Compte mis à jour', 'success');
    renderCompta(window._comptaAllRows || []);
  } catch(e) {
    toast('Erreur (non enregistré) : ' + e.message, 'error');
    annulerChangement();
    selectEl.disabled = false;
  }
}

