    + '<div class="kpi-card" style="border-color:var(--green)"><div class="kpi-label">Marge AMIIS nette</div><div class="kpi-value" style="color:' + (margeNette >= 0 ? 'var(--green)' : 'var(--red)') + '">' + margeNette.toFixed(2) + ' €</div></div>'
