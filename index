function renderSelectGestionnaireCession(projet, r, options) {
  let html = '<select onchange="changerGestionnaireCession(\'' + projet + '\', ' + r._rowIndex + ', this.value, this)" '
    + 'style="padding:3px 6px;border-radius:6px;border:1px solid var(--border);background:var(--surface);color:var(--text);font-size:11px">';
  html += '<option value=""' + (!r.gestionnaire ? ' selected' : '') + '>—</option>';
  options.forEach(g => {
    html += '<option value="' + g + '"' + (r.gestionnaire === g ? ' selected' : '') + '>' + g + '</option>';
  });
  html += '</select>';
  return html;
}

async function changerGestionnaireCession(projet, rowIndex, gestionnaire, selectEl) {
  if (selectEl) selectEl.disabled = true;
  try {
    const res = await apiPost({ action: 'setGestionnaireCompteGroupe', payload: { projet, rowIndex, gestionnaire } });
    if (!res || res.error) {
      const msg = (res && (res.message || res.code)) || (res && res.error) || 'inconnue';
      alert('Erreur : ' + msg);
      if (selectEl) selectEl.disabled = false;
      return;
    }
    const nom = (window._cgNomActuel && window._cgNomActuel[projet]) || '';
    afficherCompteGroupe(projet, nom);
  } catch(e) {
    alert('Erreur : ' + e.message);
