// Saisie/correction du solde bancaire réel au 01/01 d'un exercice (relevé
// bancaire en main) — sert d'ancrage fiable au KPI "Solde bancaire", plutôt
// que de reconstituer un cumul depuis le tout début de l'historique compta.
// Tolère les formats FR courants : "3 386,95", "3.386,95", "3386,95",
// "3386.95"... parseFloat seul s'arrête au premier caractère invalide (un
// espace milliers tronquait "3 386,95" en 3 tout court).
function parserMontantSaisiFR(str) {
  let s = (str || '').toString().trim();
  s = s.replace(/[\s  ]/g, ''); // espaces normaux et insécables (séparateur milliers)
  if (s.indexOf(',') >= 0 && s.indexOf('.') >= 0) s = s.replace(/\./g, ''); // point = séparateur milliers si une virgule décimale est aussi présente
  s = s.replace(',', '.');
  return parseFloat(s);
}

async function saisirSoldeOuvertureBancaire(exerciceCle) {
  if (!exerciceCle) { toast('Choisis un exercice précis (pas "Tous") pour saisir son solde d\'ouverture.', 'error'); return; }
  const actuel = (window._comptaSoldesOuverture || {})[exerciceCle];
  const saisie = prompt('Solde bancaire réel au 01/01 pour ' + exerciceCle + ' (relevé bancaire en main) :', actuel !== undefined ? actuel : '');
  if (saisie === null) return;
  const solde = parserMontantSaisiFR(saisie);
  if (isNaN(solde)) { toast('Montant invalide', 'error'); return; }
  try {
    const res = await apiPost({ action: 'setSoldeOuvertureBancaire', payload: { exercice: exerciceCle, solde } });
    if (!res || res.error) { toast('Erreur : ' + (res && (res.message||res.error) || 'inconnue'), 'error'); return; }
    window._comptaSoldesOuverture = window._comptaSoldesOuverture || {};
    window._comptaSoldesOuverture[exerciceCle] = solde;
    toast('✓ Solde d\'ouverture ' + exerciceCle + ' enregistré', 'success');
    renderCompta(window._comptaAllRows);
  } catch(e) {
    toast('Erreur : ' + e.message, 'error');
  }
}

// ============================================================
// BILAN FINANCIER — compte de résultat charges/produits par exercice,
// construit automatiquement à partir des écritures COMPTA de l'exercice
// choisi (aucune valeur codée en dur : chaque ligne du bilan correspond au
// libellé "Opération compta" réellement utilisé, regroupé sous sa classe de
// compte 60-68 / 70-79 — s'adapte donc chaque année aux subventions/postes
// réellement obtenus, sans maintenance du code).
// ============================================================
const BILAN_CLASSES_CHARGES = [
  ['60', 'Achats'],
  ['61', 'Services extérieurs'],
  ['62', 'Autres services extérieurs'],
  ['63', 'Impôts et taxes'],
  ['64', 'Charges du personnel'],
  ['65', 'Autres charges de gestion courante'],
  ['66', 'Charges financières'],
  ['67', 'Charges exceptionnelles'],
  ['68', 'Dotation aux amortissements'],
];
const BILAN_CLASSES_PRODUITS = [
  ['70', 'Vente de produits finis, de marchandises, prestations de services'],
  ['74', "Subventions d'exploitation"],
  ['75', 'Autre produit de gestion courante'],
  ['76', 'Produits financiers'],
  ['77', 'Produits exceptionnels'],
  ['78', 'Reprise sur amortissement et provisions'],
  ['79', 'Transfert de charges'],
];

function bilanNormaliserExercice(v) {
  const a = (v || '').toString().trim().replace(/^EX\s*/i, '').trim();
  return a.length === 4 ? a.slice(2) : a;
}
function bilanClasseCompte(compte) {
  return (compte || '').toString().replace(/\./g, '').replace(/[^0-9]/g, '').substring(0, 2);
}

// Agrège les lignes COMPTA de l'exercice donné en structure de bilan
// {charges:[{code,label,lignes:[{libelle,montant}],total}], produits:[...], totalCharges, totalProduits, nonClassees}
function calculerBilanFinancier(exercice) {
  const allRows = window._comptaAllRows || [];
  const rowsEx = allRows.filter(r => !r._isVentilation && bilanNormaliserExercice(r.ANNEE) === exercice);
  const rowsAvecCompte = rowsEx.filter(r => r.COMPTE);
  const nonClassees = rowsEx.filter(r => !r.COMPTE && ((r.DEBIT||0) > 0 || (r.CREDIT||0) > 0));
  const montantNonClasse = nonClassees.reduce((s, r) => s + Math.max(r.DEBIT||0, r.CREDIT||0), 0);

  // Montant brut DEBIT (charges) / CREDIT (produits) — jamais un net
  // DEBIT-CREDIT — pour rester exactement aligné avec le calcul des KPI du
  // tableau de bord (totalCharges6xx / totalCredit dans renderCompta), qui
  // somment eux aussi la colonne brute sans compensation entre les deux.
  function agreger(classesDef, isCharge) {
    return classesDef.map(([code, label]) => {
      const groupes = {};
      rowsAvecCompte.filter(r => bilanClasseCompte(r.COMPTE) === code).forEach(r => {
        const montant = isCharge ? (r.DEBIT||0) : (r.CREDIT||0);
        if (!montant) return;
        const lib = r.OP_TYPE || r.COMPTE_LABEL || '(sans libellé)';
        groupes[lib] = (groupes[lib] || 0) + montant;
      });
      const lignes = Object.entries(groupes).map(([libelle, montant]) => ({ libelle, montant })).sort((a,b) => b.montant - a.montant);
      const total = lignes.reduce((s, l) => s + l.montant, 0);
      return { code, label, lignes, total };
    });
  }

  // NB : le coût employeur ventilé sous les écritures 421 (paie) n'est PAS
  // ajouté ici — c'est une clé de répartition analytique par projet, pas une
  // charge réelle distincte. L'ajouter en plus ferait doublon.
  const charges = agreger(BILAN_CLASSES_CHARGES, true);
  const produits = agreger(BILAN_CLASSES_PRODUITS, false);

  // Les comptes 421 (net versé aux salariés, classe 42) et 442 (organismes
  // sociaux/PAS-DSN, classe 44) sont des comptes de tiers, donc hors des classes
  // 60-68 balayées par agreger() — ils n'apparaissaient donc jamais dans le bilan.
  // En pratique, 641 (bruts) n'est quasiment jamais alimenté (les paies passent
  // par 421 + ventilation), donc sans cet ajout la vraie charge de personnel
  // restait partiellement ou totalement absente. On les rattache ici à la classe
  // 64 (Charges du personnel), cohérent avec le calcul du Résultat du tableau de
  // bord (isCoutSalarial/total442 dans renderCompta).
  // Préfixe exact du compte (pas la classe à 2 chiffres, trop large : "44" attraperait
  // aussi le compte 447 "impôts", sans lien avec le personnel) — même logique que
  // isVersementNet()/total442 dans renderCompta.
  function ajouterCompteDansBucket64(prefixeCompte, libelleParDefaut) {
    const lignesTiers = {};
    rowsAvecCompte.filter(r => (r.COMPTE||'').toString().replace(/\./g,'').startsWith(prefixeCompte)).forEach(r => {
      const montant = r.DEBIT||0;
      if (!montant) return;
      const lib = r.OP_TYPE || r.COMPTE_LABEL || libelleParDefaut;
      lignesTiers[lib] = (lignesTiers[lib] || 0) + montant;
    });
    if (!Object.keys(lignesTiers).length) return;
    let bucket64 = charges.find(c => c.code === '64');
    if (!bucket64) {
      bucket64 = { code: '64', label: 'Charges du personnel', lignes: [], total: 0 };
      charges.push(bucket64);
    }
    Object.entries(lignesTiers).forEach(([libelle, montant]) => bucket64.lignes.push({ libelle, montant }));
    bucket64.lignes.sort((a,b) => b.montant - a.montant);
    bucket64.total = bucket64.lignes.reduce((s,l) => s+l.montant, 0);
  }
  ajouterCompteDansBucket64('421', 'Rémunération nette du personnel');
  ajouterCompteDansBucket64('442', 'Prélèvements à la source / organismes sociaux');

  const chargesFiltrees  = charges.filter(c => c.lignes.length > 0);
  const produitsFiltrees = produits.filter(c => c.lignes.length > 0);
  return {
    charges: chargesFiltrees, produits: produitsFiltrees,
    totalCharges: chargesFiltrees.reduce((s,c) => s+c.total, 0),
    totalProduits: produitsFiltrees.reduce((s,c) => s+c.total, 0),
    nonClassees, montantNonClasse,
  };
}

function ouvrirBilanFinancier() {
  const allRows = window._comptaAllRows || [];
  const annees = [...new Set(
    allRows.map(r => bilanNormaliserExercice(r.ANNEE)).filter(a => /^\d{2}$/.test(a))
  )].sort();
  if (!annees.length) { toast('Aucune écriture avec exercice renseigné', 'error'); return; }
  const exerciceDefaut = (comptaState.annee && comptaState.annee !== 'Tous' && annees.includes(comptaState.annee))
    ? comptaState.annee
    : annees[annees.length - 1];
  renderBilanFinancier(exerciceDefaut, annees);
}

function bilanChangerExercice(exercice) {
  const allRows = window._comptaAllRows || [];
  const annees = [...new Set(
    allRows.map(r => bilanNormaliserExercice(r.ANNEE)).filter(a => /^\d{2}$/.test(a))
  )].sort();
  renderBilanFinancier(exercice, annees);
}

// Feuille de style d'impression partagée par Bilan financier et Bilan pour
// sub (classe .bilan-print-area) — insérée une seule fois dans le head.
// Force le format A4 avec des marges raisonnables et une taille de police
// un peu plus grande qu'à l'écran, pour que le bilan remplisse une page A4
// au lieu de paraître petit/perdu dans la page à l'impression.
function ensureBilanPrintStyle() {
  if (document.getElementById('bilan-print-style')) return;
  const style = document.createElement('style');
  style.id = 'bilan-print-style';
  style.textContent = '@page { size: A4; margin: 14mm; } '
    // Chrome/PDF n'imprime pas les couleurs de fond par défaut (case "Graphiques
    // d'arrière-plan" décochée) — ces propriétés forcent l'impression des couleurs
    // sans dépendre de ce réglage.
    + '.bilan-print-area, .bilan-print-area * { -webkit-print-color-adjust: exact; print-color-adjust: exact; color-adjust: exact; } '
    + '@media print { body * { visibility: hidden; } '
    + '.bilan-print-area, .bilan-print-area * { visibility: visible; } '
    + '.bilan-print-area { position: absolute; left: 0; top: 0; width: 100%; font-size: 13px; } '
    + '.bilan-no-print { display: none !important; } }';
  document.head.appendChild(style);
}

function renderBilanFinancier(exercice, annees) {
  document.getElementById('bilan-financier-overlay')?.remove();
  ensureBilanPrintStyle();

  const data = calculerBilanFinancier(exercice);
  const entity = state.currentEntity || '';

  function colonneHtml(classes, teteBg) {
    if (!classes.length) return '<div style="padding:20px;text-align:center;color:var(--text-sec);font-size:12px">Aucune écriture classée pour cet exercice.</div>';
    let h = '<table style="width:100%;border-collapse:collapse;font-size:12px">';
    classes.forEach(c => {
      h += '<tr style="background:' + teteBg + '"><td colspan="2" style="padding:5px 8px;font-weight:800">' + c.code + ' - ' + c.label + '</td></tr>';
      c.lignes.forEach(l => {
        h += '<tr><td style="padding:4px 8px 4px 18px;border-bottom:1px solid var(--border)">' + l.libelle.replace(/</g,'&lt;') + '</td>'
          + '<td style="padding:4px 8px;text-align:right;border-bottom:1px solid var(--border);white-space:nowrap">' + l.montant.toLocaleString('fr-FR', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €</td></tr>';
      });
    });
    h += '</table>';
    return h;
  }

  const resultat = data.totalProduits - data.totalCharges;
  const alerteNonClassees = data.montantNonClasse > 0
    ? '<div class="bilan-no-print" style="margin-top:10px;padding:8px 12px;background:rgba(245,166,35,.12);border-radius:6px;font-size:11px;color:var(--text)">⚠️ ' + data.nonClassees.length + ' ligne(s) non classée(s) (sans compte) ignorée(s) — ' + data.montantNonClasse.toLocaleString('fr-FR') + ' € non compté(s). Classez-les dans Comptabilité pour qu\'elles apparaissent ici.</div>'
    : '';

  const overlay = document.createElement('div');
  overlay.id = 'bilan-financier-overlay';
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:3200;display:flex;align-items:center;justify-content:center;padding:20px';
  overlay.innerHTML = '<div style="background:var(--surface);border-radius:12px;padding:20px;width:1000px;max-width:100%;max-height:92vh;overflow-y:auto;box-shadow:0 8px 40px rgba(0,0,0,.3)">'
    + '<div class="bilan-no-print" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;gap:10px;flex-wrap:wrap">'
    + '<div style="display:flex;align-items:center;gap:8px">'
    + '<h3 style="font-size:16px;font-weight:800">📄 Bilan financier — ' + entity + '</h3>'
    + '<select style="padding:5px 8px;border:1px solid var(--border);border-radius:6px;background:var(--bg);color:var(--text);font-size:12px" onchange="bilanChangerExercice(this.value)">'
    + annees.map(a => '<option value="' + a + '"' + (a===exercice?' selected':'') + '>EX ' + a + '</option>').join('')
    + '</select></div>'
