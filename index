async function saveDriveIds() {
  const fiches    = document.getElementById('drive-fiches')?.value.trim();
  const contrats  = document.getElementById('drive-contrats')?.value.trim();
  const virements = document.getElementById('drive-virements')?.value.trim();
  try {
    const ndf         = document.getElementById('drive-ndf')?.value.trim()          || '';
    const piecesCompta= document.getElementById('drive-pieces-compta')?.value.trim() || '';
    await apiPost({ action: 'saveConfigDriveIds', payload: { fiches, contrats, virements, ndf, piecesCompta } });
