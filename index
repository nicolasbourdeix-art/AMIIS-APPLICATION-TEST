// Formulaire de création d'un nouveau compte groupe. Le back-end duplique le Sheet
// modèle (KELTAS), le range dans le dossier Drive commun, vide ses données et
// enregistre la config — l'utilisateur n'a qu'à saisir le nom (et un contact).
function ouvrirCreationCompteGroupe() {
  const overlay = document.createElement('div');
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:9000;display:flex;align-items:center;justify-content:center';
  overlay.innerHTML = `
  <div style="background:var(--surface);border-radius:14px;padding:28px;width:460px;max-width:96vw">
    <h3 style="font-weight:800;margin-bottom:8px">📊 Nouveau compte groupe</h3>
    <p style="font-size:12px;color:var(--text-sec);margin-bottom:18px">Un fichier Google Sheet identique aux autres (mêmes formules) sera créé automatiquement dans le dossier Drive des comptes groupe, puis lié.</p>
    <div style="display:grid;gap:12px">
      <div><label style="font-size:11px;color:var(--text-sec)">Nom du projet *</label>
        <input type="text" id="cg-new-nom" placeholder="Ex: Terre de feu" style="width:100%;padding:8px;border:1px solid var(--border);border-radius:6px;background:var(--bg);color:var(--text);margin-top:4px"></div>
      <div><label style="font-size:11px;color:var(--text-sec)">Contact (optionnel)</label>
        <input type="text" id="cg-new-contact" placeholder="email ou nom du référent" style="width:100%;padding:8px;border:1px solid var(--border);border-radius:6px;background:var(--bg);color:var(--text);margin-top:4px"></div>
    </div>
    <div id="cg-new-msg" style="min-height:18px;font-size:12px;margin-top:12px"></div>
    <div style="display:flex;gap:8px;margin-top:8px;justify-content:flex-end">
      <button class="btn btn-ghost" onclick="this.closest('[style*=fixed]').remove()">Annuler</button>
      <button class="btn btn-orange" id="cg-new-valider">✓ Créer</button>
    </div>
  </div>`;
  document.body.appendChild(overlay);
  overlay.addEventListener('click', e => { if (e.target === overlay) overlay.remove(); });
  document.getElementById('cg-new-valider').onclick = validerCreationCompteGroupe;
