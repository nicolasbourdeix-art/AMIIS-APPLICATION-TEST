    + '</div></div>';

  content.innerHTML = html;
  attachContentListeners();
}

// Génère et télécharge le .txt d'import contrat pour le logiciel de paie
// spectacle, à partir d'une ligne DPAE — remplissage partiel volontaire (voir
// genererFichierContratPaie côté backend) : les champs qu'on ne connaît pas
// avec certitude restent vides plutôt que d'être devinés.
// Le backend encode déjà le contenu en Windows-1252 (attendu par le
// logiciel de paie) et le renvoie en base64 — on décode en octets bruts
// sans repasser par un encodage texte JS (qui forcerait de l'UTF-16/UTF-8).
function _telechargerFichierPaie(res) {
  const binaire = atob(res.contenuBase64);
  const octets  = new Uint8Array(binaire.length);
  for (let i = 0; i < binaire.length; i++) octets[i] = binaire.charCodeAt(i);
  const blob = new Blob([octets], { type: 'text/plain' });
  const url  = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = res.nomFichier;
  document.body.appendChild(a); a.click(); a.remove();
  URL.revokeObjectURL(url);
}

function _ligneContratPourExport(r) {
  return {
    salarie: r.salarie || '', fonction: r.fonction || '', projet: r.projet || '',
    debut: r.debut || '', fin: r.fin || '',
    cachets: r.cachets || 0, montantCachet: r.montantCachet || 0,
    // Plusieurs cachets à des tarifs différents sur la même ligne (ex: "T1 :
    // 200€ × 4 | T2 : 500€ × 4") — une ligne de rubrique par tarif au lieu
    // de tout fusionner sur un seul montant.
    cachetDetails: r.cachetDetails || [],
    services4h: r.services4h || 0, montantService: r.montantService || 0,
    // Code société réel à écrire dans le contrat — pour les lignes Paie AMIIS
    // (structures clientes comme "LES PAILLETTES"), différent de l'entité de
    // session (toujours AMIIS) utilisée pour l'autorisation. Absent/vide pour
    // les lignes DPAE classiques, où l'entité de session EST déjà le bon code.
    codeSociete: r.structure || ''
  };
}

async function exporterContratPaie(idx) {
  const r = window._dpaeRows[idx];
  if (!r) return;
  try {
    const res = await apiPost({ action: 'genererFichierContratPaie', payload: _ligneContratPourExport(r) });
    if (!res || !res.success) { toast('Erreur : ' + (res && res.error || 'inconnue'), 'error'); return; }
    _telechargerFichierPaie(res);
    if (res.avertissements && res.avertissements.length) {
      toast('⚠️ ' + res.avertissements.join(' — '), '');
    } else {
      toast('Fichier contrat généré ✓', 'success');
    }
  } catch(e) { toast('Erreur : ' + e.message, 'error'); }
}

// Regroupe l'export de toutes les lignes DPAE actuellement affichées (celles
// à valider) dans un seul fichier .txt — évite de télécharger un fichier par
// salarié quand on veut tout importer d'un coup dans le logiciel de paie.
async function exporterTousLesContrats() {
  const rows = window._dpaeRows || [];
  if (!rows.length) { toast('Aucune ligne à exporter', 'error'); return; }
  try {
    const res = await apiPost({ action: 'genererFichiersContratsPaie', payload: {
      lignes: rows.map(_ligneContratPourExport)
    }});
    if (!res || !res.success) { toast('Erreur : ' + (res && res.error || 'inconnue'), 'error'); return; }
    _telechargerFichierPaie(res);
    if (res.avertissements && res.avertissements.length) {
      toast(res.count + ' contrat(s) exportés — ⚠️ ' + res.avertissements.length + ' avertissement(s), voir la console', '');
      console.log('Avertissements export groupé des contrats :', res.avertissements);
    } else {
      toast(res.count + ' contrat(s) exportés dans un seul fichier ✓', 'success');
    }
  } catch(e) { toast('Erreur : ' + e.message, 'error'); }
}

async function validerDPAELigne(idx) {
  const r = window._dpaeRows[idx];
  if (!r) return;

  // Désactiver le bouton immédiatement pour éviter les double-clics
  const btn = document.querySelector('#dpae-row-' + idx + ' button');
  if (btn) { btn.disabled = true; btn.textContent = '⏳'; }

  const today = new Date().toLocaleDateString('fr-FR');
  try {
    const res = await apiPost({
      action:  'marquerDPAEEnvoyee',
      payload: { rowIndex: r._rowIndex, date: today, sourceSheet: r._sourceSheet || 'DPAE_CLR' }
    });
    if (res && res.success) {
      if (window._syncCache[state.currentEntity]) {
        delete window._syncCache[state.currentEntity]['dpae'];
        delete window._syncCache[state.currentEntity]['declarations'];
      }
      toast('✓ ' + (r.salarie || '') + ' — DPAE validée → visible dans Déclarations', 'success');
      loadDPAE();
    } else {
      toast('Erreur : ' + (res && res.error ? res.error : 'Inconnue'), 'error');
      if (btn) { btn.disabled = false; btn.textContent = '✓ Valider'; }
    }
  } catch(e) {
    toast('Erreur : ' + e.message, 'error');
    if (btn) { btn.disabled = false; btn.textContent = '✓ Valider'; }
  }
}

async function validerToutesDPAE() {
  const rows = window._dpaeRows;
  if (!rows || rows.length === 0) return;

  // Désactiver le bouton
  const btnTout = document.getElementById('btn-valider-toutes');
  if (btnTout) { btnTout.disabled = true; btnTout.textContent = '⏳ Validation en cours…'; }

  let ok = 0, err = 0;
  const today = new Date().toLocaleDateString('fr-FR');
  for (const r of rows) {
    try {
      await apiPost({
        action:  'marquerDPAEEnvoyee',
        payload: { rowIndex: r._rowIndex, date: today, sourceSheet: r._sourceSheet || 'DPAE_CLR' }
      });
      ok++;
      // Feedback visuel progressif
      if (btnTout) btnTout.textContent = '⏳ ' + ok + '/' + rows.length + ' validées…';
    } catch(e) { err++; }
    await new Promise(res => setTimeout(res, 250));
  }
  if (window._syncCache[state.currentEntity]) {
    delete window._syncCache[state.currentEntity]['dpae'];
    delete window._syncCache[state.currentEntity]['declarations'];
  }
  toast('✓ ' + ok + ' DPAE validées' + (err > 0 ? ' · ' + err + ' erreur(s)' : ''), ok > 0 ? 'success' : 'error');
  loadDPAE();
}

async function loadNDF() {
  const cached = _getCachedRows(state.currentEntity, 'ndf');
  if (cached) { renderNDF(cached.rows || []); _showCacheBadge(cached.fetchedAt); return; }
  try {
    const data = await apiGet({ action: 'ndf' });
    renderNDF(data.rows || []);
  } catch(e) {
    document.getElementById('content').innerHTML = renderError('Erreur NDF');
  }
}

function renderNDF(rows) {
  window._ndfRows = rows;  // stocker pour les filtres
  const content = document.getElementById('content');

  // KPIs
  const total       = rows.reduce((s,r) => s + (r.montant||0), 0);
  const nbTraitees  = rows.filter(r => r.statut === 'Traitee').length;
  const nbEnAttente = rows.length - nbTraitees;
  const totalAttente = rows.filter(r => r.statut !== 'Traitee').reduce((s,r) => s + (r.montant||0), 0);

  // Filtres statut
  const ndfState = window._ndfState || { filtre: 'Tous' };
  window._ndfState = ndfState;
  const rowsFiltrees = ndfState.filtre === 'Tous' ? rows
    : ndfState.filtre === 'Traitee' ? rows.filter(r => r.statut === 'Traitee')
    : rows.filter(r => r.statut !== 'Traitee');

  // Déterminer colonnes optionnelles
  const hasPeriode  = rows.some(r => r.periode  && r.periode.trim());
  const hasIBAN     = rows.some(r => r.iban     && r.iban.trim());
  const hasCaisse   = rows.some(r => r.caisseDeduction === 'Oui' || r.nomCaisse);
  const hasMoyen    = rows.some(r => r.categorie && r.categorie.trim());

  let html = '<div class="module-header"><h2>🧾 Notes de frais — ' + state.currentEntity + ' ' + state.currentYear + '</h2>'
    + '<button class="btn btn-orange btn-sm" data-action="generer-virement">💸 Virement groupé</button>'
    + '<button class="btn btn-ghost btn-sm" onclick="lancerSync()">🔄 Sync</button></div>';

  // KPIs
  html += '<div class="kpi-grid" style="margin-bottom:16px">'
    + '<div class="kpi-card kpi-blue"><div class="kpi-label">Total NDF</div><div class="kpi-value">' + rows.length + '</div><div class="kpi-sub">' + total.toFixed(2) + ' €</div></div>'
    + '<div class="kpi-card kpi-green"><div class="kpi-label">Traitées</div><div class="kpi-value">' + nbTraitees + '</div></div>'
    + '<div class="kpi-card kpi-orange"><div class="kpi-label">En attente</div><div class="kpi-value">' + nbEnAttente + '</div><div class="kpi-sub">' + totalAttente.toFixed(2) + ' €</div></div>'
    + '</div>';

  // Filtres
  html += '<div style="display:flex;gap:8px;margin-bottom:14px">'
    + ['Tous','En attente','Traitee'].map(f => {
        const label = f === 'Tous' ? 'Toutes' : f === 'Traitee' ? '✓ Traitées' : '⏳ En attente';
        return '<button class="btn ' + (ndfState.filtre===f?'btn-orange':'btn-ghost') + ' btn-sm" data-action="ndf-filtre" data-filtre="' + f + '">' + label + '</button>';
      }).join('')
    + '</div>';

  // Tableau
  html += '<div class="card"><div class="data-table-wrap"><table class="data-table"><thead><tr>'
    + '<th>Réf.</th><th>Salarié</th><th>Date</th><th>Spectacle</th>'
    + (hasPeriode ? '<th>Période</th>' : '')
    + (hasMoyen   ? '<th>Moyen</th>'   : '')
    + '<th style="text-align:right">Montant</th>'
    + (hasIBAN    ? '<th>IBAN</th>'    : '')
    + (hasCaisse  ? '<th>Caisse</th>'  : '')
    + '<th>Statut</th><th>PDF</th><th>Action</th><th></th>'
    + '</tr></thead><tbody>';

  if (rowsFiltrees.length === 0) {
    html += '<tr><td colspan="10" style="text-align:center;color:var(--text-sec);padding:30px">Aucune NDF</td></tr>';
  }

  rowsFiltrees.forEach(r => {
    const traitee  = r.statut === 'Traitee';
    const stBadge  = traitee
      ? '<span class="status-badge status-ok">✓ Traitée</span>'
      : '<span class="status-badge status-err">⏳ En attente</span>';

    let pdfBadge;
    if (!r.pdfUrl) {
      pdfBadge = '<span style="color:var(--text-sec)">—</span>';
    } else if (r.pdfUrl.startsWith('http')) {
      pdfBadge = '<a href="' + r.pdfUrl + '" target="_blank" class="status-badge status-ok" style="text-decoration:none" title="Ouvrir le PDF">📄 Voir</a>';
    } else {
      // Nom de fichier → bouton qui résout l'URL via Drive
      const pdfIdx = window._ndfRows ? window._ndfRows.indexOf(r) : -1;
      pdfBadge = '<button class="status-badge status-grey" style="cursor:pointer;border:none" '
        + 'data-action="ouvrir-ndf-pdf" data-pdf="' + r.pdfUrl.replace(/"/g,'&quot;') + '" '
        + 'title="' + r.pdfUrl + '">📄 Ouvrir</button>';
    }

    const ibanShort = r.iban ? r.iban.slice(-4) : '';

    html += '<tr>'
      + '<td style="font-size:10px;color:var(--text-sec)">' + (r.id||'') + '</td>'
      + '<td><strong>' + (r.salarie||'') + '</strong>'
      +   (r.commentaires ? '<div style="font-size:10px;color:var(--text-sec);margin-top:2px">' + r.commentaires.substring(0,50) + '</div>' : '')
      + '</td>'
      + '<td style="white-space:nowrap">' + (r.date||'—') + '</td>'
      + '<td>' + (r.spectacle||'—') + '</td>'
      + (hasPeriode ? '<td style="font-size:11px;color:var(--text-sec)">' + (r.periode||'—') + '</td>' : '')
      + (hasMoyen   ? '<td>' + (r.categorie||'—') + '</td>' : '')
      + '<td style="text-align:right;font-weight:700;white-space:nowrap">' + (r.montant||0).toFixed(2) + ' €</td>'
      + (hasIBAN    ? '<td style="font-size:11px;font-family:monospace">' + (ibanShort ? '…' + ibanShort : '—') + '</td>' : '')
      + (hasCaisse  ? '<td style="font-size:11px">' + (r.nomCaisse || (r.caisseDeduction==='Oui'?'✓':'—')) + '</td>' : '')
      + '<td>' + stBadge + '</td>'
      + '<td>' + pdfBadge + '</td>'
      + '<td>' + (!traitee ? '<button class="btn btn-green btn-sm" data-action="traiter-ndf" data-id="' + r.id + '">✓ Traiter</button>' : '') + '</td>'
      + '<td><button class="btn btn-ghost btn-sm" style="color:var(--red);padding:2px 6px" data-action="supprimer-ndf" data-id="' + r.id + '" data-rowindex="' + (r._rowIndex||'') + '" title="Supprimer cette ligne">🗑</button></td>'
      + '</tr>';
  });

  html += '</tbody></table></div></div>';
  content.innerHTML = html;
  attachContentListeners();
}

function setNDFFiltre(f) {
  if (!window._ndfState) window._ndfState = {};
  window._ndfState.filtre = f;
  // Utiliser les rows déjà en mémoire (plus fiable que le cache TTL)
  if (window._ndfRows && window._ndfRows.length >= 0) {
    renderNDF(window._ndfRows);
  } else {
    const cached = _getCachedRows(state.currentEntity, 'ndf');
    if (cached) renderNDF(cached.rows || []);
    else loadNDF();
  }
}

async function supprimerNDF(id, rowIndex, btn) {
  if (!confirm('Supprimer la note de frais ' + (id || rowIndex) + ' ?\nCette action est irréversible.')) return;
  try {
    if (btn) { btn.disabled = true; btn.textContent = '⏳'; }
    const res = await apiPost({ action: 'supprimerNDF', payload: { id: id, rowIndex: parseInt(rowIndex) } });
    if (res && res.success) {
      toast('✓ Note de frais supprimée', 'success');
      loadNDF();
    } else {
      if (btn) { btn.disabled = false; btn.textContent = '🗑'; }
      alert('Erreur : ' + (res && res.error || 'inconnue'));
    }
  } catch(e) {
    if (btn) { btn.disabled = false; btn.textContent = '🗑'; }
    alert('Erreur : ' + e.message);
  }
}

function traiterNDF(id) {
  apiPost({ action: 'updateNDF', id, statut: 'Traitée' }).then(res => {
    if (res && res.success !== false) {
      toast('NDF traitée ✓', 'success');
      // Mettre à jour localement
      const cached = _getCachedRows(state.currentEntity, 'ndf');
      if (cached) {
        const row = cached.rows.find(r => r.id === id || r.id == id);
        if (row) row.statut = 'Traitee';
        renderNDF(cached.rows);
      } else { loadNDF(); }
    } else { toast('Erreur : ' + JSON.stringify(res), 'error'); }
  }).catch(e => toast('Erreur : ' + e.message, 'error'));
}

async function genererVirement() {
  const rows      = window._ndfRows || [];
  const enAttente = rows.filter(r => r.statut !== 'Traitee');

  if (enAttente.length === 0) {
    toast('Aucune NDF en attente à rembourser', '');
    return;
  }

  // Séparer carte entreprise (pas à rembourser) des autres
  const isCarteEntreprise = r => {
    const m = (r.categorie || r.moyen || '').toLowerCase();
    return m.includes('entreprise') || m.includes('société') || m.includes('societe');
  };

  const aRembourser    = enAttente.filter(r => !isCarteEntreprise(r));
  const carteEntreprise = enAttente.filter(r => isCarteEntreprise(r));

  // Grouper par salarié — seulement celles à rembourser
  const parSalarie = {};
  aRembourser.forEach(r => {
    const nom = r.salarie || '?';
    if (!parSalarie[nom]) parSalarie[nom] = { nom, total: 0, iban: r.iban || '', ndf: [] };
    parSalarie[nom].total += r.montant || 0;
    parSalarie[nom].ndf.push(r);
    if (!parSalarie[nom].iban && r.iban) parSalarie[nom].iban = r.iban;
  });
  const salaries    = Object.values(parSalarie).sort((a,b) => b.total - a.total);
  const totalGlobal = aRembourser.reduce((s,r) => s + (r.montant||0), 0);

  const overlay = document.createElement('div');
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:5000;display:flex;align-items:center;justify-content:center;padding:20px';

  const box = document.createElement('div');
  box.style.cssText = 'background:var(--surface);border-radius:12px;padding:28px;width:560px;max-width:95vw;max-height:85vh;overflow-y:auto;box-shadow:0 8px 40px rgba(0,0,0,.25)';

  // Titre
  const h3 = document.createElement('h3');
  h3.style.cssText = 'font-size:16px;font-weight:800;margin-bottom:6px';
  h3.textContent = '💸 Virement groupé — ' + enAttente.length + ' NDF';

  const sub = document.createElement('div');
  sub.style.cssText = 'font-size:13px;color:var(--text-sec);margin-bottom:20px';
  let subText = salaries.length + ' salarié(s) — Total à rembourser : ' + totalGlobal.toFixed(2) + ' €';
  if (carteEntreprise.length > 0) {
    const totalCE = carteEntreprise.reduce((s,r) => s + (r.montant||0), 0);
    subText += ' · ' + carteEntreprise.length + ' NDF carte entreprise (' + totalCE.toFixed(2) + ' €) exclues du virement';
  }
  sub.textContent = subText;

  // Tableau par salarié
  const tblWrap = document.createElement('div');
  let tbl = '<table style="width:100%;border-collapse:collapse;font-size:13px">'
    + '<thead><tr style="border-bottom:2px solid var(--border)">'
    + '<th style="padding:8px 6px;text-align:left">Salarié</th>'
    + '<th style="padding:8px 6px;text-align:center">NDF</th>'
    + '<th style="padding:8px 6px;text-align:right">Total à rembourser</th>'
    + '<th style="padding:8px 6px;text-align:left;font-family:monospace">IBAN</th>'
    + '</tr></thead><tbody>';

  salaries.forEach(s => {
    tbl += '<tr style="border-bottom:1px solid var(--border)">'
      + '<td style="padding:10px 6px;font-weight:700;font-size:14px">' + s.nom + '</td>'
      + '<td style="padding:10px 6px;text-align:center;color:var(--text-sec)">' + s.ndf.length + '</td>'
      + '<td style="padding:10px 6px;text-align:right;font-weight:800;font-size:15px;color:var(--orange)">' + s.total.toFixed(2) + ' €</td>'
      + '<td style="padding:10px 6px;font-family:monospace;font-size:11px;color:var(--text-sec)">' + (s.iban ? s.iban : '—') + '</td>'
      + '</tr>';
  });

  tbl += '<tr style="border-top:2px solid var(--border);background:var(--bg)">'
    + '<td style="padding:10px 6px;font-weight:800">TOTAL</td>'
    + '<td style="padding:10px 6px;text-align:center;font-weight:800">' + enAttente.length + '</td>'
    + '<td style="padding:10px 6px;text-align:right;font-weight:800;font-size:16px">' + totalGlobal.toFixed(2) + ' €</td>'
    + '<td></td></tr></tbody></table>';
  tblWrap.innerHTML = tbl;

  // Footer
  const footer = document.createElement('div');
  footer.style.cssText = 'margin-top:20px;display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap';

  const btnFermer = document.createElement('button');
  btnFermer.className = 'btn btn-ghost';
  btnFermer.textContent = 'Fermer';
  btnFermer.addEventListener('click', () => overlay.remove());

  const btnTraiter = document.createElement('button');
  btnTraiter.className = 'btn btn-green';
  btnTraiter.textContent = '✓ Tout marquer Traitée';
  btnTraiter.addEventListener('click', async () => {
    btnTraiter.disabled = true;
    btnTraiter.textContent = '⏳ En cours…';
    let ok = 0;
    // Traiter toutes : celles à rembourser + cartes entreprise
    const toutesATraiter = [...(aRembourser || enAttente), ...(carteEntreprise || [])];
    for (const r of toutesATraiter) {
      try {
        await apiPost({ action: 'updateNDF', payload: { id: r.id, statut: 'Traitée' } });
        // Mettre à jour localement
        r.statut = 'Traitee';
        ok++;
        btnTraiter.textContent = '⏳ ' + ok + '/' + toutesATraiter.length + '…';
      } catch(e) {}
      await new Promise(res => setTimeout(res, 150));
    }
    // Créer un lot "en attente de rapprochement" pour le virement groupé (hors
    // NDF carte entreprise, qui n'a pas besoin de remboursement bancaire) — sert
    // à retrouver automatiquement le débit correspondant au prochain import de
    // relevé, quel que soit le nombre de NDF regroupées dans ce virement.
    if (aRembourser.length > 0) {
      try {
        await apiPost({ action: 'creerLotVirementNDF', payload: {
          ndfIds: aRembourser.map(r => r.id),
          montantTotal: totalGlobal,
        } });
      } catch(e) { console.warn('[VIREMENT NDF] création du lot échouée:', e); }
    }
    overlay.remove();
    toast('✓ ' + ok + ' NDF marquées Traitées', 'success');
    renderNDF(window._ndfRows);
  });

  footer.appendChild(btnFermer);
  footer.appendChild(btnTraiter);

  box.appendChild(h3);
  box.appendChild(sub);
  box.appendChild(tblWrap);
  box.appendChild(footer);
  overlay.appendChild(box);
  overlay.addEventListener('click', e => { if (e.target === overlay) overlay.remove(); });
  document.body.appendChild(overlay);
}

async function loadDevis() {
  const cached = _getCachedRows(state.currentEntity, 'devis');
  if (cached) { renderDevis(cached.rows || []); _showCacheBadge(cached.fetchedAt); return; }
  try {
    const data = await apiGet({ action: 'getDevis', year: state.currentYear });
    if (data.debugAncien) console.log('[DEVIS ANCIEN — diagnostic]', state.currentEntity, data.debugAncien);
    renderDevis(data.rows || []);
  } catch(e) { renderDevis([]); }
}

const devisState = { statut: 'Tous' };
window._devisRows = [];

function renderDevis(allRows) {
  allRows = (allRows || []).filter(r => r !== null);
  window._devisRows = allRows;
  const content = document.getElementById('content');

  const isDiffuseur = allRows.some(r => r.type === 'DIFFUSEUR');
  const isSalarie   = allRows.some(r => r.type === 'SALARIE');

  // Filtre statut
  const filtreSt   = devisState.statut   || 'Tous';
  const filtreType = devisState.typeFact || 'Tous';

  const rowsFilt = allRows
    .filter(r => filtreSt === 'Tous' || r.statutContrat === filtreSt)
    .filter(r => filtreType === 'Tous' || r.typeFacturation === filtreType);

  const nbEnAttente = allRows.filter(r => r.statutContrat === 'En attente').length;
  const nbEnvoye    = allRows.filter(r => r.statutContrat === 'Envoyé').length;
  const nbSigne     = allRows.filter(r => r.statutContrat === 'Signé').length;
  const rowsDiff        = allRows.filter(r => r.type === 'DIFFUSEUR');
  const totalCession    = rowsDiff.reduce((s,r) => s + (r.montantPrincipal||r.montantHT||0), 0);
  const totalHT         = rowsDiff.reduce((s,r) => s + (r.montantTotal||0), 0);
  const nbMediations    = rowsDiff.filter(r => r.typeFacturation === 'Médiation' || r.typeFacturation === 'Mixte').length;
  const nbSpectacles    = rowsDiff.filter(r => r.typeFacturation === 'Cession'   || r.typeFacturation === 'Mixte').length;

  let html = '<div class="module-header"><h2>📊 ' + (isDiffuseur ? 'Devis' : 'Contrats') + ' — ' + state.currentEntity + ' ' + state.currentYear + '</h2>'
    + (state.currentEntity === 'CLR' && isDiffuseur ? '<button class="btn btn-orange btn-sm" onclick="ouvrirAjoutLigneDevisCLR()">+ Ajouter une ligne</button>' : '')
    + '<button class="btn btn-ghost btn-sm" onclick="lancerSync()">🔄 Sync</button></div>';

  html += '<div class="kpi-grid" style="margin-bottom:16px">'
    + '<div class="kpi-card kpi-orange"><div class="kpi-label">En attente</div><div class="kpi-value">' + nbEnAttente + '</div></div>'
    + (nbEnvoye > 0 ? '<div class="kpi-card kpi-blue"><div class="kpi-label">Envoyé</div><div class="kpi-value">' + nbEnvoye + '</div></div>' : '')
    + '<div class="kpi-card kpi-green"><div class="kpi-label">Signé</div><div class="kpi-value">' + nbSigne + '</div></div>'
    + (isDiffuseur && nbSpectacles > 0 ? '<div class="kpi-card kpi-blue"><div class="kpi-label">Cessions</div><div class="kpi-value">' + nbSpectacles + '</div></div>' : '')
    + (isDiffuseur && nbMediations > 0 ? '<div class="kpi-card kpi-orange"><div class="kpi-label">Médiations</div><div class="kpi-value">' + nbMediations + '</div></div>' : '')
    + (isDiffuseur ? '<div class="kpi-card kpi-blue"><div class="kpi-label">Total HT</div><div class="kpi-value kpi-small">' + totalCession.toLocaleString('fr-FR') + ' €</div></div>' : '')
    + (isDiffuseur && totalHT !== totalCession ? '<div class="kpi-card kpi-green"><div class="kpi-label">Total + frais</div><div class="kpi-value kpi-small">' + totalHT.toLocaleString('fr-FR') + ' €</div></div>' : '')
    + '</div>';

  // Filtres statut contrat
  const statutsFiltres = ['Tous','En attente','Signé','Envoyé'].filter(s => s === 'Tous' || allRows.some(r => r.statutContrat === s));
  html += '<div style="display:flex;gap:8px;margin-bottom:8px;flex-wrap:wrap">'
    + '<span style="font-size:11px;color:var(--text-sec);align-self:center;min-width:50px">Statut :</span>'
    + statutsFiltres.map(s => '<button class="btn ' + (filtreSt===s?'btn-orange':'btn-ghost') + ' btn-sm" data-action="devis-filtre" data-statut="' + s + '">' + s + '</button>').join('')
    + '</div>';

  // Filtres type facturation (diffuseur uniquement)
  if (isDiffuseur) {
    const typesFiltres = ['Cession','Médiation','Mixte'].filter(t => allRows.some(r => r.typeFacturation === t));
    if (typesFiltres.length > 1) {
      html += '<div style="display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap">'
        + '<span style="font-size:11px;color:var(--text-sec);align-self:center;min-width:50px">Type :</span>'
        + '<button class="btn ' + (filtreType==='Tous'?'btn-blue':'btn-ghost') + ' btn-sm" data-action="devis-type" data-type="Tous">Tous</button>'
        + typesFiltres.map(t => {
            const col = t==='Cession' ? 'btn-green' : t==='Médiation' ? 'btn-orange' : 'btn-blue';
            return '<button class="btn ' + (filtreType===t?col:'btn-ghost') + ' btn-sm" data-action="devis-type" data-type="' + t + '">' + t + '</button>';
          }).join('')
        + '</div>';
    } else {
      html += '<div style="margin-bottom:14px"></div>';
    }
  }

  if (rowsFilt.length === 0) {
    html += '<div class="card" style="text-align:center;color:var(--text-sec);padding:40px">Aucun résultat pour ce filtre</div>';
    content.innerHTML = html; attachContentListeners(); return;
  }


  if (isDiffuseur) {
    html += '<div class="card"><div class="data-table-wrap"><table class="data-table"><thead><tr>'
      + '<th>Réf.</th><th>Diffuseur</th><th>Ville</th><th>Spectacle</th><th>Type</th>'
      + '<th>Début</th><th>Fin</th><th style="text-align:center">Repr.</th>'
      + '<th style="text-align:right">Cession HT</th><th style="text-align:right">Frais</th>'
      + '<th>Statut</th><th>Récap</th><th>Contrat</th>'
      + '</tr></thead><tbody>';

    // Vérifier si des colonnes prévi existent
    const hasPrevi = allRows.some(r => r.type === 'DIFFUSEUR' && ((r.cachetPrevi||0) > 0 || (r.servicePrevi||0) > 0 || (r.techPrevi||0) > 0));
    const hasFrais = allRows.some(r => r.type === 'DIFFUSEUR' && ((r.fraisHeberg||0) + (r.fraisRest||0) + (r.fraisDeplac||0) + (r.fraisMat||0)) > 0);

    html = html.replace(
      '<th style="text-align:right">Cession HT</th><th style="text-align:right">Frais</th>',
      '<th style="text-align:right">Cession HT</th>'
        + (hasFrais ? '<th style="text-align:right">Frais</th>' : '')
        + '<th style="text-align:right" title="Cession + médiation + frais : le montant total qui sera facturé pour ce devis">Total</th>'
        + (hasPrevi ? '<th style="text-align:center">Cachets</th><th style="text-align:center">SR 4h</th><th style="text-align:center">Tech</th>' : '')
    );

    rowsFilt.filter(r => r.type === 'DIFFUSEUR').forEach(r => {
      const fraisTotal = (r.fraisHeberg||0) + (r.fraisRest||0) + (r.fraisDeplac||0) + (r.fraisMat||0);
      const fraisStr = fraisTotal > 0
        ? '<span title="Héberg: '  + (r.fraisHeberg||0) + ' €&#10;Rest: '    + (r.fraisRest||0)   + ' €&#10;Déplac: ' + (r.fraisDeplac||0) + ' €&#10;Matériel: ' + (r.fraisMat||0) + ' €" style="cursor:help">' + fraisTotal.toLocaleString('fr-FR') + ' €</span>'
        : '<span style="color:var(--text-sec)">—</span>';

      // Badge récap devis
      const recapBadge = r.pdfRecap
        ? '<a href="' + r.pdfRecap + '" target="_blank" class="status-badge status-blue" style="text-decoration:none" title="Récap devis">📋 Récap</a>'
        : '<span style="color:var(--text-sec)">—</span>';

      // Badge contrat généré
      const contratBadge2 = r.pdfContrat
        ? '<a href="' + r.pdfContrat + '" target="_blank" class="status-badge status-ok" style="text-decoration:none" title="Contrat signé">📄 Contrat</a>'
        : '<span style="color:var(--text-sec)">—</span>';

      // Cellule prévi avec badge coloré si > 0
      function previCell(val, color) {
        if (!val || val === 0) return '<td style="text-align:center;color:var(--text-sec)">—</td>';
        return '<td style="text-align:center;font-weight:700;color:' + color + '">' + val + '</td>';
      }

      html += '<tr>'
        + '<td style="font-size:10px;color:var(--text-sec)">' + (r.id||'')
          + (r.source === 'MANUEL' ? '<div><span class="status-badge status-blue" style="font-size:9px">✎ Manuel</span></div>' : '')
          + (r._ancien ? '<div><span class="status-badge status-grey" style="font-size:9px" title="Provient de l\'ancienne feuille DEVIS">🗂 Ancien</span></div>' : '')
        + '</td>'
        + '<td><strong>' + (r.diffuseur||'—') + '</strong>'
        +   (r.signataire ? '<div style="font-size:10px;color:var(--text-sec)">' + r.signataire + (r.qualite ? ' (' + r.qualite + ')' : '') + '</div>' : '')
        + '</td>'
        + '<td style="font-size:11px">' + [(r.ville||''),(r.codePostal||'')].filter(Boolean).join(' ') + '</td>'
        + '<td><span class="status-badge status-grey">' + (r.spectacle||'—') + '</span></td>'
        + '<td style="font-size:11px;color:var(--text-sec)">' + (r.typeDevis||'—') + '</td>'
        + '<td style="white-space:nowrap;font-size:11px">' + (r.dateDebut||'—') + '</td>'
        + '<td style="white-space:nowrap;font-size:11px">' + (r.dateFin||'—') + '</td>'
        + '<td style="text-align:center">' + (r.nbRepresent||'—') + '</td>'
        + '<td style="text-align:right">'
          // Cession (si présente)
          + (r.hasCession
              ? '<div style="font-weight:700">' + (r.montantHT||0).toLocaleString('fr-FR') + ' € <span style="font-size:10px;color:var(--text-sec);font-weight:400">cession</span></div>'
              : '')
          // Médiation (si présente)
          + (r.hasMediation
              ? '<div style="color:var(--orange);font-weight:700">'
                  + (r.nbHeures||0) + 'h × ' + (r.tauxHoraire||0).toLocaleString('fr-FR') + ' €'
                  + ' <span style="font-size:10px;font-weight:400">= ' + (r.montantHeures||0).toLocaleString('fr-FR') + ' €</span>'
                  + (r.represLiee === 'Oui' ? ' <span style="font-size:10px;color:var(--blue)">+ repr.</span>' : '')
                + '</div>'
              : '')
          // Badge type
          + '<div style="margin-top:3px">'
          +   (r.typeFacturation === 'Cession'   ? '<span class="status-badge status-ok" style="font-size:9px">Cession</span>'    : '')
          +   (r.typeFacturation === 'Médiation'  ? '<span class="status-badge status-warn" style="font-size:9px">Médiation</span>' : '')
          +   (r.typeFacturation === 'Mixte'      ? '<span class="status-badge status-blue" style="font-size:9px">Mixte</span>'     : '')
          + '</div>'
        + '</td>'
        + (hasFrais ? '<td style="text-align:right">' + fraisStr + '</td>' : '')
        + '<td style="text-align:right;font-weight:800">' + (r.montantTotal||0).toLocaleString('fr-FR') + ' €</td>'
        + (hasPrevi ? previCell(r.cachetPrevi, 'var(--blue)') + previCell(r.servicePrevi, 'var(--orange)') + previCell(r.techPrevi, 'var(--text-sec)') : '')
        + '<td>' + contratBadge(r.statutContrat) + ' <button class="btn btn-ghost btn-sm" style="padding:1px 4px" onclick="ouvrirEditStatutDevis(' + (r._rowIndex||0) + ', \'' + (r._sourceSheet||'').replace(/'/g,"\\'") + '\')" title="Modifier statut/récap/contrat">✏️</button></td>'
        + '<td>' + recapBadge + '</td>'
        + '<td>' + contratBadge2 + '</td>'
        + '<td><button class="btn btn-ghost btn-sm" style="padding:2px 5px;color:var(--red)" data-action="supprimer-devis" data-rowindex="' + (r._rowIndex||0) + '" data-source="' + (r._sourceSheet||'').replace(/"/g,'&quot;') + '" data-ref="' + (r.reference||'') + '" title="Supprimer">🗑</button>'
          + (r.source === 'MANUEL' ? '<button class="btn btn-ghost btn-sm" style="padding:2px 5px" onclick="ouvrirEditLigneDevisCLR(' + (r._rowIndex||0) + ', \'' + (r._sourceSheet||'').replace(/'/g,"\\'") + '\')" title="Modifier">✏️</button>' : '')
          + '</td>'
        + '</tr>';
    });
    html += '</tbody></table></div></div>';
  } else if (isSalarie) {
    html += '<div class="card"><div class="data-table-wrap"><table class="data-table"><thead><tr>'
      + '<th>Réf.</th><th>Salarié</th><th>Projet</th><th>Fonction</th>'
      + '<th>Début</th><th>Fin</th><th>Détail montants</th><th>Contrat</th><th>FDP</th>'
      + '</tr></thead><tbody>';

    rowsFilt.filter(r => r.type === 'SALARIE').forEach(r => {
      const fdpBadge = r.fdpUrl && r.fdpUrl.startsWith('http')
        ? '<a href="' + r.fdpUrl + '" target="_blank" class="status-badge status-ok" style="text-decoration:none">✓ FDP</a>'
        : '<span style="color:var(--text-sec)">—</span>';
      const pdfBadge = r.pdfUrl
        ? '<a href="' + r.pdfUrl + '" target="_blank" class="status-badge status-ok" style="text-decoration:none">📄</a>'
        : '—';

      // Parser Detail montants : "T1 : 160€ × 1 | T2 : 130€ × 2" ou "Cachet : 160€ × 1"
      function parseDetail(detail) {
        if (!detail) return '';
        // Séparer par " | "
        const parts = detail.split(/\s*\|\s*/);
        return parts.map(p => {
          // Extraire montant × quantité
          const m = p.match(/([^:]+):\s*([^×]+)(?:×\s*(\d+))?/);
          if (m) {
            const type    = m[1].trim();
            const montant = m[2].trim();
            const qte     = m[3] ? ' × ' + m[3] : '';
            const isCachet  = type.toLowerCase().includes('cachet') || type.startsWith('T');
            const isService = type.toLowerCase().includes('service') || type.toLowerCase().includes('sr');
            const color = isCachet ? 'var(--blue)' : isService ? 'var(--orange)' : 'var(--text)';
            return '<span style="white-space:nowrap;color:' + color + ';font-size:11px;margin-right:6px">'
              + '<strong>' + type + '</strong> ' + montant + qte
              + '</span>';
          }
          return '<span style="font-size:11px">' + p + '</span>';
        }).join('');
      }

      html += '<tr>'
        + '<td style="font-size:10px;color:var(--text-sec)">' + (r.id||'')
          + (r._ancien ? '<div><span class="status-badge status-grey" style="font-size:9px" title="Provient de l\'ancienne feuille DEVIS">🗂 Ancien</span></div>' : '')
        + '</td>'
        + '<td><strong>' + (r.salarie||'—') + '</strong>'
        +   (r.artTech ? '<div style="font-size:10px;color:var(--text-sec)">' + r.artTech + '</div>' : '')
        + '</td>'
        + '<td><span class="status-badge status-grey">' + (r.spectacle||'—') + '</span></td>'
        + '<td style="font-size:11px">' + (r.fonction||'—') + '</td>'
        + '<td style="white-space:nowrap;font-size:11px">' + (r.dateDebut||'—') + '</td>'
        + '<td style="white-space:nowrap;font-size:11px">' + (r.dateFin||'—') + '</td>'
        + '<td style="font-size:11px">' + (parseDetail(r.detail) || (r.detail||'—')) + '</td>'
        + '<td>' + contratBadge(r.statutContrat) + ' ' + pdfBadge + '</td>'
        + '<td>' + fdpBadge + '</td>'
        + '<td><button class="btn btn-ghost btn-sm" style="padding:2px 5px;color:var(--red)" data-action="supprimer-devis" data-rowindex="' + (r._rowIndex||0) + '" data-source="' + (r._sourceSheet||'').replace(/"/g,'&quot;') + '" data-ref="' + (r.reference||'') + '" title="Supprimer">🗑</button></td>'
        + '</tr>';
    });
    html += '</tbody></table></div></div>';
  }

  content.innerHTML = html;
  attachContentListeners();
}

