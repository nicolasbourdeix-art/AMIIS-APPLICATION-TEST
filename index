    });
    return h + '</table></div></div>';
  }

  window._paieContratRows = [];
  return renderSection(filtrer(presta), 'presta', '📋 Prestations de paie')
       + renderSection(filtrer(prod),   'prod',   '🎭 Productions AMIIS');
}

function togglePaieGroupe(grpId, headerRow) {
  const tbody = document.getElementById(grpId);
  if (!tbody) return;
  const collapsed = tbody.style.display === 'none';
  tbody.style.display = collapsed ? '' : 'none';
  const chevron = headerRow.querySelector('.paie-grp-chevron');
  if (chevron) chevron.style.transform = collapsed ? '' : 'rotate(-90deg)';
  window._paieGroupesReduits = window._paieGroupesReduits || {};
  window._paieGroupesReduits[grpId] = !collapsed; // true = réduit, false = déplié
}

async function exporterContratPaieLigne(idx) {
  const r = (window._paieContratRows || [])[idx];
  if (!r) return;
  try {
    const res = await apiPost({ action: 'genererFichierContratPaie', payload: _ligneContratPourExport(r) });
    if (!res || !res.success) { toast('Erreur : ' + (res && res.error || 'inconnue'), 'error'); return; }
    _telechargerFichierPaie(res);
    if (res.avertissements && res.avertissements.length) {
      toast('⚠️ ' + res.avertissements.join(' — '), '');
    } else {
      toast('Fichier contrat généré ✓', 'success');
    }
  } catch(e) { toast('Erreur : ' + e.message, 'error'); }
}

function supprimerLignePaie(idx) {
  const r = (window._paieContratRows || [])[idx];
  if (!r) return;
  const sourceSheet = r._type === 'prod' ? 'contrat salarié prod AMIIS' : 'Contrats';
  confirm_action('Supprimer cette ligne ?', (r.salarie || '') + ' — ' + (r.projet || '') + '. Cette action est définitive.', async () => {
    try {
      const res = await apiPost({ action: 'supprimerLigneDeclaration', payload: { sourceSheet, rowIndex: r._rowIndex } });
      if (res && res.success) { toast('Ligne supprimée', 'success'); if (r._type === 'prod') loadProd(); else loadPaie(); }
      else toast('Erreur : ' + (res && res.error || ''), 'error');
    } catch(e) { toast('Erreur : ' + e.message, 'error'); }
  });
}

