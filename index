    + '<div class="kpi-card kpi-green"><div class="kpi-label">Facturés</div><div class="kpi-value">' + nbTermines + '</div></div>'
    + '<div class="kpi-card" style="border-color:var(--red)"><div class="kpi-label">En cours</div><div class="kpi-value" style="color:var(--red)">' + nbEnCours + '</div></div>'
    + '</div>';

  html += '<div id="pp-tables">' + renderPaieTables(presta, prod, '') + '</div>';
