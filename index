#app-loading-overlay .app-loading-pct { font-size: 16px; font-weight: 700; color: var(--orange); margin-top: -10px; }
#app-login-section { display: flex; flex-direction: column; align-items: stretch; gap: 12px; width: 280px; margin-top: 6px; }
.app-login-input { width: 100%; padding: 12px 14px; border: 2px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--text); font-size: 15px; box-sizing: border-box; }
.app-login-input:focus { border-color: var(--orange); outline: none; }
.app-login-btn { width: 100%; height: 44px; border-radius: 8px; background: var(--orange); color: #fff; font-weight: 700; font-size: 15px; border: none; cursor: pointer; }
.app-login-btn:hover { background: var(--orange-d); }
