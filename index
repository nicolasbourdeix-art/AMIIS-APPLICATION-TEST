// ─────────────────────────────────────────────────────────────────
// EVENT DELEGATION GLOBALE — intercepte tous les data-action
// Remplace tous les onclick inline dans les tableaux (compatibilité CSP Apps Script)
// ─────────────────────────────────────────────────────────────────
function attachContentListeners() {
  const content = document.getElementById('content');
  if (!content) return;
  // Supprimer l'ancien listener s'il existe
  if (content._delegationListener) content.removeEventListener('click', content._delegationListener);

  content._delegationListener = async function(e) {
    const btn = e.target.closest('[data-action]');
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();

    const action = btn.getAttribute('data-action');
    const idx    = parseInt(btn.getAttribute('data-idx') ?? '-1');
    const rowindex = parseInt(btn.getAttribute('data-rowindex') ?? '-1');

    switch(action) {
      // ── Déclarations ──
      case 'chercher-contrat':   chercherContrat(idx); break;
      case 'chercher-fdp':       chercherFDP(idx); break;
      case 'ouvrir-fdp':         ouvrirSelectionFDP(idx); break;
      case 'marquer-dpae':       marquerDPAE(idx); break;

      case 'exporter-contrat-paie': exporterContratPaie(idx); break;
      case 'exporter-tous-contrats': exporterTousLesContrats(); break;
      case 'exporter-contrat-paie-ligne': exporterContratPaieLigne(idx); break;
      case 'supprimer-ligne-paie': supprimerLignePaie(idx); break;

      // ── DPAE CLR ──
      case 'valider-dpae':
        btn.disabled = true; btn.textContent = '⏳';
        await validerDPAELigne(idx);
        break;
      case 'valider-toutes-dpae':
        btn.disabled = true; btn.textContent = '⏳ Validation…';
        await validerToutesDPAE();
        break;

      // ── Compta ──
      case 'edit-compta':
        ouvrirModalEditionCompta(rowindex);
        break;
      case 'compta-saisir':
        renderComptaSaisie();
        break;
      case 'toggle-mois': {
        const mois = btn.getAttribute('data-mois');
        const etaitOuvert = !!comptaState.moisOuverts[mois];
        comptaState.moisOuverts[mois] = !etaitOuvert;
        const cle = mois.replace(/[^a-zA-Z0-9]/g, '-');
        document.querySelectorAll('.mois-row-' + cle).forEach(tr => {
          tr.style.display = etaitOuvert ? 'none' : '';
        });
        const icon = btn.querySelector('.mois-toggle-icon');
        if (icon) icon.textContent = etaitOuvert ? '+' : '−';
        break;
      }
      case 'supprimer-devis': {
        const rowIndex = parseInt(btn.getAttribute('data-rowindex'));
        const sourceSheet = btn.getAttribute('data-source') || '';
        const ref = btn.getAttribute('data-ref') || '?';
        if (!confirm('Supprimer le devis ' + ref + ' ?\nCette action est irréversible.')) break;
        btn.textContent = '⏳'; btn.disabled = true;
        apiPost({ action: 'supprimerLigneDevis', payload: { rowIndex, sourceSheet } }).then(res => {
          if (res && res.success) {
            toast('✓ Devis ' + ref + ' supprimé', 'success');
            // Supprimer du cache local — désambiguïser par feuille source, car
            // l'onglet actuel et l'ancien peuvent partager les mêmes numéros de ligne
            if (window._devisRows) window._devisRows = window._devisRows.filter(r => !(r._rowIndex === rowIndex && (r._sourceSheet||'') === sourceSheet));
            renderDevis(window._devisRows || []);
            // Vider aussi le cache de synchronisation — sinon revenir sur Devis après
            // être passé sur un autre module réaffiche la liste d'avant suppression.
            if (window._syncCache[state.currentEntity]) delete window._syncCache[state.currentEntity]['devis'];
          } else {
            btn.textContent = '🗑'; btn.disabled = false;
            toast('Erreur : ' + (res && res.error || 'inconnue'), 'error');
          }
        });
        break;
      }

      case 'ouvrir-piece-compta': {
        const nomF = btn.getAttribute('data-nom');
        btn.textContent = '⏳';
        btn.disabled = true;
        apiGet({ action: 'getPieceComptaUrl', nomFichier: nomF }).then(res => {
          if (res && res.url) {
            // Remplacer le bouton par un lien permanent
            const a = document.createElement('a');
            a.href = res.url; a.target = '_blank';
            a.className = 'status-badge status-ok';
            a.style.textDecoration = 'none';
            a.title = nomF;
            a.textContent = '📄';
            btn.replaceWith(a);
            window.open(res.url, '_blank');
            // Mettre à jour le cache pour éviter de re-résoudre
            const row = (window._comptaAllRows||[]).find(r => String(r._rowIndex) === btn.getAttribute('data-rowindex'));
            if (row) row.PIECE_PDF = res.url;
          } else {
            btn.textContent = '❌';
            btn.title = (res && res.error) || 'Introuvable — configurez DRIVE_PIECES_COMPTA';
            setTimeout(() => {
              const ext = nomF.split('.').pop().toLowerCase();
              btn.textContent = (['jpg','jpeg','png','heic'].includes(ext) ? '🖼' : '📄') + ' ' + nomF.substring(0,15);
              btn.disabled = false;
            }, 2500);
          }
        }).catch(e => {
          btn.textContent = '❌';
          btn.title = 'Erreur : ' + e.message;
          setTimeout(() => {
            const ext = nomF.split('.').pop().toLowerCase();
            btn.textContent = (['jpg','jpeg','png','heic'].includes(ext) ? '🖼' : '📄') + ' ' + nomF.substring(0,15);
            btn.disabled = false;
          }, 2500);
        });
        break;
      }

      case 'attacher-piece': {
        const ri = btn.getAttribute('data-rowindex');
        const overlay = document.createElement('div');
        overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:5000;display:flex;align-items:center;justify-content:center';
        const box = document.createElement('div');
        box.style.cssText = 'background:var(--surface);border-radius:12px;padding:24px;width:480px;max-width:95vw';
        box.innerHTML = '<h3 style="font-weight:800;margin-bottom:16px">📎 Attacher une pièce comptable</h3>'
          + '<p style="font-size:12px;color:var(--text-sec);margin-bottom:12px">Colle l\'URL Google Drive du document (facture, reçu, relevé...)</p>'
          + '<input type="url" id="piece-url" placeholder="https://drive.google.com/file/d/..." style="width:100%;padding:8px;border:1px solid var(--border);border-radius:6px;background:var(--bg);color:var(--text);font-size:13px;margin-bottom:16px">'
          + '<div style="display:flex;gap:8px;justify-content:flex-end">'
          + '<button class="btn btn-ghost" id="piece-cancel">Annuler</button>'
          + '<button class="btn btn-orange" id="piece-save">💾 Attacher</button>'
          + '</div>';
        overlay.appendChild(box);
        document.body.appendChild(overlay);
        overlay.addEventListener('click', e => { if (e.target===overlay) overlay.remove(); });
        box.querySelector('#piece-cancel').addEventListener('click', () => overlay.remove());
        box.querySelector('#piece-save').addEventListener('click', async () => {
          const url = box.querySelector('#piece-url').value.trim();
          if (!url.startsWith('http')) { alert('URL invalide'); return; }
          const res = await apiPost({ action: 'editerLigneCompta', payload: { rowIndex: parseInt(ri), corrections: { 'LIEN DRIVE': url } } });
          overlay.remove();
          if (res && res.success) { toast('✓ Pièce attachée', 'success'); loadCompta(); }
          else toast('Erreur : ' + JSON.stringify(res), 'error');
        });
        break;
      }
      case 'compta-filtre':
        comptaState.filtre = btn.getAttribute('data-filtre');
        renderCompta(window._comptaAllRows || []);
        break;
      case 'compta-detail-kpi':
        ouvrirDetailKpi(btn.getAttribute('data-type'));
        break;
      case 'compta-spec':
        comptaState.spectacle = btn.getAttribute('data-spec');
        renderCompta(window._comptaAllRows || []);
        break;
      case 'compta-compte':
        comptaState.compte = btn.getAttribute('data-compte');
        renderCompta(window._comptaAllRows || []);
        break;
      case 'compta-annee':
        comptaState.annee = btn.getAttribute('data-annee');
        comptaState.filtre = 'Tous'; comptaState.spectacle = 'Tous'; comptaState.compte = 'Tous';
        renderCompta(window._comptaAllRows || []);
        break;
      // compta-annee-sel / compta-spec-sel / compta-compte-sel → gérés par onchange direct

      // ── NDF ──
      case 'traiter-ndf':   traiterNDF(btn.getAttribute('data-id')); break;
      case 'supprimer-ndf': supprimerNDF(btn.getAttribute('data-id'), btn.getAttribute('data-rowindex'), btn); break;

      // ── Facturation ──
      case 'marquer-payee': marquerPayee(btn.getAttribute('data-id'), rowindex); break;
      case 'fact-filtre':
        factState.statut = btn.getAttribute('data-statut');
        renderFacturation(window._factRows || []);
        break;
      case 'fact-annee':
        factState.annee = btn.getAttribute('data-annee');
        renderFacturation(window._factRows || []);
        break;
      case 'ouvrir-projet':
        ouvrirSuiviProjet(parseInt(btn.getAttribute('data-idx')));
        break;

      // ── Fermeture de modales ──
      case 'ndf-filtre':
        setNDFFiltre(btn.getAttribute('data-filtre'));
        break;

      case 'ouvrir-ndf-pdf': {
        const nomFichier = btn.getAttribute('data-pdf');
        btn.textContent = '⏳';
        btn.disabled = true;
        apiGet({ action: 'getNDFPdfUrl', nomFichier }).then(res => {
          if (res && res.url) {
            // Mettre à jour le badge avec le vrai lien
            const a = document.createElement('a');
            a.href = res.url; a.target = '_blank';
            a.className = 'status-badge status-ok';
            a.style.textDecoration = 'none';
            a.title = 'Ouvrir le PDF';
            a.textContent = '📄 Voir';
            btn.replaceWith(a);
            window.open(res.url, '_blank');
            // Mettre à jour dans _ndfRows pour les prochains rendus
            const row = (window._ndfRows || []).find(r => r.pdfUrl === nomFichier);
            if (row) row.pdfUrl = res.url;
          } else {
            btn.textContent = '❌';
            btn.title = res && res.error ? res.error : 'Introuvable';
            setTimeout(() => { btn.textContent = '📄 Ouvrir'; btn.disabled = false; }, 2000);
          }
        }).catch(() => {
          btn.textContent = '📄 Ouvrir'; btn.disabled = false;
        });
        break;
      }
      case 'generer-virement': genererVirement(); break;
      case 'devis-filtre':
        devisState.statut = btn.getAttribute('data-statut');
        renderDevis(window._devisRows || []);
        break;
      case 'devis-type':
        devisState.typeFact = btn.getAttribute('data-type');
        renderDevis(window._devisRows || []);
        break;

      case 'close-modal': {
        const modalId = btn.getAttribute('data-modal-id');
        if (modalId) document.getElementById(modalId)?.remove();
        break;
      }
    }
  };

  content.addEventListener('click', content._delegationListener);
}
// Listener global pour data-action="close-modal" hors #content (modales config, DSN, etc.)
document.addEventListener('click', function(e) {
  const btn = e.target.closest('[data-action="close-modal"]');
