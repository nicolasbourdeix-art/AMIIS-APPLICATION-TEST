      + '<div style="background:var(--bg);border-radius:6px;padding:8px"><div style="color:var(--text-sec);font-size:10px">Heures dues</div><div style="font-weight:700;font-size:18px;color:var(--orange)">' + s.heures.toFixed(1) + 'h</div>'
      + '<div style="color:var(--text-sec);font-size:9px;margin-top:2px">' + s.heuresPaie.toFixed(1) + 'h paie + ' + s.heuresProd.toFixed(1) + 'h prod (' + s.nbProd + ')</div></div>'
      + '<div style="background:var(--bg);border-radius:6px;padding:8px"><div style="color:var(--text-sec);font-size:10px">Total facturé</div><div style="font-weight:700;font-size:16px;color:var(--green)">' + s.total.toFixed(2) + ' €</div></div>'
