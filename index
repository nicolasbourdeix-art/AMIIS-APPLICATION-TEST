async function validerNouveauCession(projet, btn) {
  const date    = document.getElementById('cg-date')?.value;
  const lieu    = document.getElementById('cg-lieu')?.value?.trim();
  if (!date || !lieu) { alert('Date et lieu requis'); return; }

  btn.disabled = true; btn.textContent = '⏳';
  const ligne = {
    date:         date.split('-').reverse().join('/'), // YYYY-MM-DD → DD/MM/YYYY
    lieu,
    tariVente:    parseFloat(document.getElementById('cg-tarif')?.value)   || 0,
    salaireEmp:   parseFloat(document.getElementById('cg-salaire')?.value) || 0,
    partJohann:   parseFloat(document.getElementById('cg-johann')?.value)  || 0,
    deplacements: parseFloat(document.getElementById('cg-depla')?.value)   || 0,
    autres:       parseFloat(document.getElementById('cg-autres')?.value)  || 0,
  };
  try {
    const res = await apiPost({ action: 'ajouterLigneCompteGroupe', payload: { projet, ligne } });
    if (res && res.success) {
      toast('✓ Cession ajoutée dans le compte groupe ' + projet, 'success');
      document.querySelector('[style*=fixed]')?.remove();
      const nomProjet = (window._cgNomActuel && window._cgNomActuel[projet]) || projet;
      afficherCompteGroupe(projet, nomProjet);
    } else {
      alert('Erreur : ' + (res && res.error || 'inconnue'));
      btn.disabled = false; btn.textContent = '✓ Ajouter';
    }
  } catch(e) {
    alert('Erreur : ' + e.message);
    btn.disabled = false; btn.textContent = '✓ Ajouter';
  }
}

