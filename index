// Retire une FDP ou un contrat signé lié à tort sur une ligne de Déclarations
// (ex: auto-classement qui s'est trompé) — vide la/les colonne(s) concernée(s)
// via l'action générique updateField, sans toucher au reste de la ligne.
async function detacherPieceDeclaration(declIdx, type) {
  const r = window._declRows[declIdx];
  if (!r) return;
  if (!window.confirm('Retirer ce fichier de cette ligne ?')) return;
  const tab = r._sourceSheet || 'Contrats';
  const cols = type === 'fdp'
    ? ['Fiche de paie', 'FDP_Statut', 'FDP_Candidats']
    : [tab === 'Contrats' ? 'Lien PDF' : 'CONTRAT SIGNEE'];
  try {
    for (const colName of cols) {
      await apiPost({ action: 'updateField', payload: { tab, rowIndex: r._rowIndex, colName, value: '' } });
    }
    if (type === 'fdp') { r.fdpUrl = ''; r.fdpStatut = ''; r.fdpCandidats = ''; r.paieOK = false; }
    else { r.lienContratSigne = ''; r.contratSigne = false; }
    if (window._syncCache[state.currentEntity]) delete window._syncCache[state.currentEntity]['declarations'];
    document.getElementById('apercu-piece-overlay')?.remove();
    renderDeclarations(window._declRows);
    toast('Retiré ✓', 'success');
  } catch(e) { toast('Erreur : ' + e.message, 'error'); }
}

