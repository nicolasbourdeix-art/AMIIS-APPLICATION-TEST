  const compteurG     = data.compteurGestionnaires || {};

  window._cgNomActuel = window._cgNomActuel || {};
  window._cgNomActuel[projet] = data.projet;

  // KPIs
  const totalVente   = rows.reduce((s,r) => s + (r.tariVente||0), 0);
  const totalBalance = rows.reduce((s,r) => s + (r.balance||0), 0);
  const totalAmiis   = rows.reduce((s,r) => s + (r.partAmiis||0), 0);
  const nbFact       = rows.filter(r => r.facture).length;
  const coutCompteur = tot.coutCompteur    != null ? tot.coutCompteur    : 0;
  const margeNette   = tot.margeAmiisNette != null ? tot.margeAmiisNette : (totalAmiis - coutCompteur);

  let html = '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">'
    + '<h3 style="font-weight:700;font-size:15px">📁 ' + data.projet + '</h3>'
