async function loadDeclarations() {
  // Essayer le cache sync d'abord
  const cached = _getCachedRows(state.currentEntity, 'declarations');
  if (cached) {
    renderDeclarations(cached.rows || []);
    _showCacheBadge(cached.fetchedAt);
    return;
  }
  try {
    const data = await apiGet({ action: 'declarations' });
    renderDeclarations(data.rows || []);
  } catch(e) {
    document.getElementById('content').innerHTML = renderError('Erreur chargement déclarations : ' + e.message);
  }
}

function renderDeclarations(rows) {
  // Trier par date croissante (gère DD/MM/YYYY et YYYY-MM-DD)
  function toSortKey(r) {
    var d = r.debut || r.date || '';
    if (!d) return '';
    if (/^\d{4}-\d{2}-\d{2}/.test(d)) return d.substring(0,10); // ISO → déjà triable
    var parts = d.split('/');
    if (parts.length === 3) return parts[2] + '-' + parts[1] + '-' + parts[0]; // DD/MM/YYYY → YYYY-MM-DD
    return d;
  }
  rows = (rows || []).slice().sort(function(a, b) {
    return toSortKey(a).localeCompare(toSortKey(b));
  });
  window._declRows = rows;
  const content = document.getElementById('content');
  if (rows.length === 0) {
    content.innerHTML = '<div class="module-header"><h2>📋 Declarations — ' + state.currentEntity + ' ' + state.currentYear + '</h2></div>'
      + '<div class="card" style="text-align:center;color:var(--text-sec);padding:40px">Aucune declaration pour ' + state.currentYear + '</div>';
    return;
  }
  const hasServices    = rows.some(r => (r.services4h || 0) > 0);
  const hasJours       = rows.some(r => r.joursTravailles && r.joursTravailles.toString().trim());
  const hasProjet      = rows.some(r => r.projet && r.projet.trim());
  const hasCommentaire = rows.some(r => r.commentaire && r.commentaire.trim());
  const totalCachets   = rows.reduce((s,r) => s + (r.cachets||0), 0);
  const totalServices  = rows.reduce((s,r) => s + (r.services4h||0), 0);
  const nbSalaries     = new Set(rows.map(r => r.salarie).filter(Boolean)).size;

  const ajoutManuelDispo = ENTITES_DECLARATION_VIA_CONTRATS.includes(state.currentEntity);
  let html = '<div class="module-header"><h2>📋 Declarations — ' + state.currentEntity + ' ' + state.currentYear + '</h2>'
    + (ajoutManuelDispo ? '<button class="btn btn-orange btn-sm" onclick="ouvrirAjoutLigneDeclaration()">+ Ajouter une ligne</button>' : '')
    + '<a href="' + NOUVEAU_CONTRAT_AMIIS_URL + '" target="_blank" class="btn btn-ghost btn-sm">+ Nouveau contrat</a>'
    + '<button class="btn btn-ghost btn-sm" onclick="lancerClassementFDP()">📄 Classer FDP</button>'
    + '<button class="btn btn-ghost btn-sm" onclick="lancerClassementContrats()">📝 Classer Contrats</button>'
    + '<button class="btn btn-ghost btn-sm" onclick="lancerSync()" title="Re-synchroniser depuis les Sheets">🔄 Sync</button>'
    + '</div>';
  if (!ajoutManuelDispo) {
    html += '<p style="font-size:11px;color:var(--text-sec);margin:-8px 0 12px">Ajout manuel non disponible pour cette structure (déclarations via formulaire Google). Suppression toujours possible ligne par ligne.</p>';
  }

  const facturationActive = ENTITES_FACTURATION_FDP.includes(state.currentEntity);
  const montantDu = facturationActive ? rows.filter(r => !r.facture).reduce((s,r) => s + (r.tarifFacture||12), 0) : 0;

  html += '<div class="kpi-grid" style="margin-bottom:16px">'
    + '<div class="kpi-card kpi-blue"><div class="kpi-label">Declarations</div><div class="kpi-value">' + rows.length + '</div><div class="kpi-sub">' + nbSalaries + ' salarie(s)</div></div>'
    + '<div class="kpi-card kpi-orange"><div class="kpi-label">Cachets</div><div class="kpi-value">' + totalCachets + '</div><div class="kpi-sub">total declares</div></div>'
    + (hasServices ? '<div class="kpi-card kpi-green"><div class="kpi-label">Services 4h</div><div class="kpi-value">' + totalServices + '</div><div class="kpi-sub">repetitions</div></div>' : '')
    + (facturationActive ? '<div class="kpi-card" style="border-color:var(--orange)"><div class="kpi-label">Montant à facturer</div><div class="kpi-value" style="color:var(--orange)">' + montantDu.toFixed(2) + ' €</div></div>' : '')
    + '</div>';

  html += '<div class="card"><div class="data-table-wrap"><table class="data-table"><thead><tr>'
    + '<th>Salarie</th><th>Fonction</th>'
    + (hasProjet ? '<th>Projet</th>' : '')
    + '<th>Debut</th><th>Fin</th>'
    + '<th style="text-align:center">Cachets</th>'
    + (hasServices ? '<th style="text-align:center">SR 4h</th>' : '')
    + (hasJours ? '<th>Jours</th>' : '')
    + (hasCommentaire ? '<th>Commentaire</th>' : '')
    + '<th>Paie/FDP</th><th>Contrat</th><th>DPAE</th>'
    + (facturationActive ? '<th style="text-align:center">Facturée</th>' : '')
    + '<th></th>'
    + '</tr></thead><tbody>';

  html += insererSeparateurMois(rows, (r, idx) => {
    let rowHtml = '';
    const isCTR  = r.id && r.id.toString().startsWith('CTR-');
    const dpaeKey = 'dpae_' + state.currentEntity + '_' + r._rowIndex;
    const dpaeOk  = r.dpaeEnvoyee || sessionStorage.getItem(dpaeKey);
    rowHtml += '<tr' + (facturationActive && r._sourceSheet === 'Contrats' && r.facture ? ' style="background:rgba(39,174,96,.08)"' : '') + '>'
      + '<td><strong>' + (r.salarie || '-') + '</strong>' + (isCTR ? '<div style="font-size:10px;color:var(--text-sec);font-family:monospace">' + r.id + '</div>' : '') + '</td>'
      + '<td>' + (r.fonction || '-') + '</td>'
      + (hasProjet ? '<td><span class="status-badge status-grey">' + (r.projet || '-') + '</span></td>' : '')
      + '<td style="white-space:nowrap">' + (r.debut || '-') + '</td>'
      + '<td style="white-space:nowrap">' + (r.fin || '-') + '</td>'
      + '<td style="text-align:center;font-weight:700" title="' + (r.detailMontants||'') + '">'
        + (r.cachets || 0)
        + (r.cachetDetails && r.cachetDetails.length > 0
          ? '<br><span style="font-size:10px;color:var(--text-sec);font-weight:400">'
            + r.cachetDetails.map(function(d) { return d.qte + ' × ' + d.montant + '€'; }).join(' | ')
            + '</span>'
          : (r.montantCachet ? '<br><span style="font-size:10px;color:var(--text-sec);font-weight:400">× ' + r.montantCachet + '€</span>' : ''))
        + '</td>'
      + (hasServices ? '<td style="text-align:center;font-weight:700;color:var(--blue)" title="' + (r.servicesStr||'') + '">'
        + (r.services4h || 0)
        + (r.montantService ? '<span style="font-size:10px;color:var(--text-sec);margin-left:2px">× ' + r.montantService + '€</span>' : '')
        + '</td>' : '')
      + (hasJours ? '<td style="font-size:11px;color:var(--text-sec)">' + (r.joursTravailles || '-') + '</td>' : '')
      + (hasCommentaire ? '<td style="font-size:11px;color:var(--text-sec);max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + (r.commentaire || '') + '</td>' : '')
      + '<td>' + renderFDPouPaie(r, idx) + '</td>'
      + '<td>' + renderContratBadge(r, isCTR, idx) + '</td>'
      + '<td>' + renderDPAEBadge(r, isCTR, idx, dpaeOk) + '</td>'
      + (facturationActive ? '<td style="text-align:center">'
          + '<input type="checkbox" ' + (r.facture ? 'checked' : '') + ' onchange="toggleFactureDeclaration(' + r._rowIndex + ', \'' + (r._sourceSheet||'').replace(/'/g,"\\'") + '\', this.checked, this)">'
          + '</td>' : '')
      + '<td><button class="btn btn-ghost btn-sm" style="padding:2px 5px;color:var(--red)" onclick="supprimerLigneDeclarationUI(' + r._rowIndex + ', \'' + (r._sourceSheet||'').replace(/'/g,"\\'") + '\', \'' + (r.salarie||'').replace(/'/g,"\\'") + '\')" title="Supprimer">🗑</button></td>'
      + '</tr>';
    return rowHtml;
  });
  html += '</tbody></table></div></div>';
  content.innerHTML = html;
  attachContentListeners();
}

async function toggleFactureDeclaration(rowIndex, sourceSheet, valeur, checkboxEl) {
  if (checkboxEl) checkboxEl.disabled = true;
  try {
    const res = await apiPost({ action: 'toggleFactureEntite', payload: { rowIndex, sourceSheet, valeur } });
    if (!res || res.error) {
      alert('Erreur : ' + (res && (res.message || res.error) || 'inconnue'));
      if (checkboxEl) { checkboxEl.checked = !valeur; checkboxEl.disabled = false; }
      return;
    }
    const r = (window._declRows || []).find(x => x._rowIndex === rowIndex && x._sourceSheet === sourceSheet);
    if (r) r.facture = valeur;
    renderDeclarations(window._declRows || []);
  } catch(e) {
    alert('Erreur : ' + e.message);
    if (checkboxEl) { checkboxEl.checked = !valeur; checkboxEl.disabled = false; }
  }
}

async function supprimerLigneDeclarationUI(rowIndex, sourceSheet, salarie) {
  if (!confirm('Supprimer la déclaration de "' + salarie + '" ? Cette action est irréversible.')) return;
  try {
    const res = await apiPost({ action: 'supprimerLigneDeclaration', payload: { rowIndex, sourceSheet } });
    if (!res || res.success !== true) {
      alert('Erreur : ' + (res && (res.message || res.error) || 'inconnue'));
      return;
    }
    if (window._syncCache[state.currentEntity]) delete window._syncCache[state.currentEntity]['declarations'];
    loadDeclarations();
  } catch(e) {
    alert('Erreur : ' + e.message);
  }
}

