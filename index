// Clé de tri chronologique à partir d'une date DD/MM/YYYY — même
// convention que le reste de l'appli (reverse des segments).
function _cleDateTravail(d) {
  if (!d) return '';
  const p = (d || '').toString().split('/');
  return p.length === 3 ? p[2] + '-' + p[1].padStart(2,'0') + '-' + p[0].padStart(2,'0') : '';
}

function ouvrirListeTravailDuJour() {
  let panel = document.getElementById('todo-panel');
  if (!panel) {
    panel = document.createElement('div');
    panel.id = 'todo-panel';
    panel.className = 'todo-panel';
    panel.innerHTML = '<div class="todo-panel-header" onclick="toggleMinimiserListeTravail()">'
      + '<span>📋</span><span>Liste de travail du jour</span>'
      + '<span class="todo-panel-count" id="todo-panel-count" style="display:none">0</span>'
      + '<span class="todo-panel-chevron" id="todo-panel-chevron">▾</span>'
