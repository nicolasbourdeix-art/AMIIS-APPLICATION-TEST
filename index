          + '<td style="font-size:11px">' + (v.spectacle ? '<span class="status-badge status-blue" style="font-size:10px">' + v.spectacle + '</span>' : '—') + '</td>'
          + '<td></td>'
          + '<td></td>'
          + '<td style="text-align:right;font-size:11px;font-weight:600;color:var(--blue)">' + (v.coutEmp).toLocaleString('fr-FR') + ' €</td>'
          + '<td style="white-space:nowrap">' + fdpCell + '</td>'
          + '<td></td>'
