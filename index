            + ' data-action="ouvrir-piece-compta" data-nom="' + v.fdpNom.replace(/"/g,'&quot;') + '" data-rowindex="' + r._rowIndex + '"'
            + ' title="' + v.fdpNom + '">📄 ' + nomCourt + '</button>';
