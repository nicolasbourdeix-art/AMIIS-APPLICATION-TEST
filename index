    + '<div class="kpi-card" style="border-color:var(--green)"><div class="kpi-label">Balance totale</div><div class="kpi-value" style="color:' + (totalBalance >= 0 ? 'var(--green)' : 'var(--red)') + '">' + totalBalance.toFixed(2) + ' €</div></div>'
