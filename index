// Lignes brutes parsées du CSV
window._releveRaw = [];
window._relevePropositions = [];

function importerFichierReleve(input) {
  const file = input.files[0];
  if (!file) return;
  lireCSVAvecEncodage(file, text => {
    const lignes = parserCSVReleve(text);
