async function loadPaieProduction() {
  const cached = _getCachedRows(state.currentEntity, 'paie-prod');
  if (cached) { renderPaieProduction(cached); return; }
  try {
    const data = await apiPost({ action: 'getPaieProduction', payload: {} });
    if (data && data.success) {
      window._syncCache[state.currentEntity] = window._syncCache[state.currentEntity] || {};
      window._syncCache[state.currentEntity]['paie-prod'] = { rows: data, fetchedAt: new Date().toISOString() };
      renderPaieProduction(data);
    } else {
      document.getElementById('content').innerHTML = '<div class="card"><p style="color:var(--red)">' + (data && data.error || 'Erreur') + '</p></div>';
    }
  } catch(e) {
    document.getElementById('content').innerHTML = '<div class="card"><p style="color:var(--red)">Erreur : ' + e.message + '</p></div>';
  }
}

function renderPaieProduction(data) {
  const content = document.getElementById('content');
  const presta  = data.presta || [];
  const prod    = data.prod   || [];

  // Filtres
  const tous    = [...presta.map(r => ({...r, _section:'presta'})), ...prod.map(r => ({...r, _section:'prod'}))];
  const gestionnaires = [...new Set(tous.map(r => r.qui).filter(Boolean))].sort();

