async function validerAjoutLigneDeclaration() {
  const salarie    = document.getElementById('decl-salarie')?.value?.trim();
  const dateDebut  = document.getElementById('decl-datedebut')?.value?.trim();
  if (!salarie)   { alert('Le salarié est requis'); return; }
  if (!dateDebut) { alert('La date de début est requise'); return; }

  const ligne = {
    salarie, dateDebut,
    fonction:       document.getElementById('decl-fonction')?.value?.trim() || '',
    projet:         document.getElementById('decl-projet')?.value?.trim() || '',
    dateFin:        document.getElementById('decl-datefin')?.value?.trim() || '',
    nbCachets:      document.getElementById('decl-nbcachets')?.value || 0,
    montantCachet:  document.getElementById('decl-montantcachet')?.value || 0,
    nbServices:     document.getElementById('decl-nbservices')?.value || 0,
    montantService: document.getElementById('decl-montantservice')?.value || 0,
    joursTravailles:document.getElementById('decl-jours')?.value?.trim() || '',
    commentaire:    document.getElementById('decl-commentaire')?.value?.trim() || '',
  };

  const btn = document.getElementById('decl-btn-valider');
  btn.disabled = true; btn.textContent = '⏳';
  try {
    const res = await apiPost({ action: 'ajouterLigneDeclarationContrats', payload: { ligne } });
    if (res && res.success) {
      document.querySelector('[style*=fixed]')?.remove();
      if (window._syncCache[state.currentEntity]) delete window._syncCache[state.currentEntity]['declarations'];
      loadDeclarations();
    } else {
      alert('Erreur : ' + (res && (res.message || res.error) || 'inconnue'));
      btn.disabled = false; btn.textContent = '✓ Ajouter';
    }
  } catch(e) {
    alert('Erreur : ' + e.message);
    btn.disabled = false; btn.textContent = '✓ Ajouter';
  }
}

function renderContratBadge(r, isCTR, idx) {
  if (r.lienContratSigne && r.lienContratSigne.trim()) {
    return '<span class="status-badge status-ok" style="cursor:pointer" data-piece-url="' + r.lienContratSigne.replace(/"/g,'&quot;') + '" data-piece-nom="Contrat signé — ' + (r.salarie||'').toString().replace(/"/g,'&quot;') + '" onclick="ouvrirApercuPiece(this.dataset.pieceUrl,this.dataset.pieceNom,' + idx + ',\'contrat\')">&#10003; Signé &#128196;</span>';
  }
  if (r.contratSigne) {
    return '<span class="status-badge status-ok" style="cursor:pointer" data-action="chercher-contrat" data-idx="' + idx + '" title="Retrouver le fichier Drive">&#10003; Signé</span>';
  }
  return '<button class="btn btn-ghost btn-sm" style="font-size:11px" data-action="chercher-contrat" data-idx="' + idx + '">&#128269; Chercher</button>';
}

function renderFDPouPaie(r, idx) {
  const statut = r.fdpStatut || '';
  const url    = r.fdpUrl   || '';
  const candidats = r.fdpCandidats || '';
  if ((statut === 'AUTO' || statut === 'CONFIRME') && url) return '<span class="status-badge status-ok" style="cursor:pointer" data-piece-url="' + url.replace(/"/g,'&quot;') + '" data-piece-nom="Fiche de paie" onclick="ouvrirApercuPiece(this.dataset.pieceUrl,this.dataset.pieceNom,' + idx + ',\'fdp\')">&#10003; FDP &#128196;</span>';
  if (statut === 'A_VERIFIER' && candidats) return '<button class="btn btn-ghost btn-sm" style="font-size:11px" data-action="ouvrir-fdp" data-idx="' + idx + '">&#9888; FDP</button>';
  if (statut === 'NON_TROUVE') return '<button class="btn btn-ghost btn-sm" style="font-size:11px" data-action="chercher-fdp" data-idx="' + idx + '">&#128269; FDP</button>';
  if (r.paieOK) return '<span class="status-badge status-ok">&#10003; Paie OK</span>';
  return '<button class="btn btn-ghost btn-sm" style="font-size:11px" data-action="chercher-fdp" data-idx="' + idx + '">&#128269; FDP</button>';
}

function renderDPAEBadge(r, isCTR, idx, dpaeOk) {
  if (isCTR) {
    let h = '';
    if (r.pdfUrl && r.pdfUrl.toString().trim().startsWith('http')) h += '<span class="status-badge status-ok" style="cursor:pointer;margin-right:4px" data-piece-url="' + r.pdfUrl.toString().replace(/"/g,'&quot;') + '" data-piece-nom="Récapitulatif" onclick="ouvrirApercuPiece(this.dataset.pieceUrl,this.dataset.pieceNom)">&#10003; Recap</span>';
    if (dpaeOk || r.dpaeEnvoyee) h += '<span class="status-badge status-ok">&#10003; Envoyee</span>';
    else h += '<button class="btn btn-ghost btn-sm" style="font-size:11px" data-action="marquer-dpae" data-idx="' + idx + '">&#10003; Marquer</button>';
    return h;
  }
  if (dpaeOk) return '<span class="status-badge status-ok">&#10003; Envoyee</span>';
  return '<button class="btn btn-ghost btn-sm" style="font-size:11px" data-action="marquer-dpae" data-idx="' + idx + '">&#10003; Marquer</button>';
}

