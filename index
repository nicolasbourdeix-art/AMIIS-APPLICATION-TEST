      + '<td style="white-space:nowrap">' + (r.debut || '—') + '</td>'
      + '<td style="white-space:nowrap">' + (r.fin   || '—') + '</td>'
  + (hasJours ? '<td style="font-size:11px;color:var(--text-sec)">' + (r.joursTravailles || '-') + '</td>' : '')
      + '<td style="text-align:center;font-weight:700" title="' + (r.detailMontants||'') + '">'
        + (r.cachets || 0)
        + (r.cachetDetails && r.cachetDetails.length > 0
