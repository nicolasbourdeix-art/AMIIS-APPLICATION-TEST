async function soumettreDeduction() {
  const porteur = document.getElementById('ded-porteur')?.value?.trim();
  const montant = parseFloat(document.getElementById('ded-montant')?.value);
  const libelle = document.getElementById('ded-libelle')?.value?.trim();
  if (!porteur || !montant || montant <= 0 || !libelle) { toast('Tous les champs sont requis', 'error'); return; }
  confirm_action('Confirmer la déduction ?', libelle + ' — ' + montant.toFixed(2) + ' € sur ' + porteur, async () => {
    try {
      await apiPost({ action: 'deduireCaisse', payload: { porteur, montant, libelle, spectacle: 'GENERAL' } });
      document.getElementById('deduction-overlay')?.remove();
      toast('Déduction enregistrée ✓', 'success');
      loadCaisses();
    } catch(e) { toast('Erreur : ' + e.message, 'error'); }
  });
}

