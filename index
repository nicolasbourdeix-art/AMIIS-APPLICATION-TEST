function validerVentilation(lignesSalaires, toutesLignes) {
  const tbody = document.getElementById('vent-body');
  if (!tbody) return;

  const ventilations = [];
  Array.from(tbody.children).forEach(tr => {
    const sal  = tr.querySelector('.vent-sal')?.value?.trim();
    const proj = tr.querySelector('.vent-proj')?.value?.trim();
    const fdp  = tr.querySelector('.vent-fdp')?.value?.trim();
    const fdpUrl = tr.querySelector('.vent-fdp-url')?.value?.trim();
    const cout = parseFloat(tr.querySelector('.vent-cout')?.value) || 0;
    const brut = parseFloat(tr.querySelector('.vent-brut')?.value) || 0;
    const net  = parseFloat(tr.querySelector('.vent-net')?.value)  || 0;
    if (sal || proj || cout > 0) ventilations.push({ salarie: sal, spectacle: proj, fdp, fdpUrl, coutEmp: cout, brut, netVerse: net });
  });

  // Attacher les ventilations à la ligne courante
  const idxCourant = window._ventLigneIdx || 0;
  const ligneSal = lignesSalaires[idxCourant];
  if (ligneSal) {
    ligneSal._ventilations = ventilations;
    // Répercuter aussi dans toutesLignes (même référence ou recherche par rowIndex)
    const idxInTout = toutesLignes.findIndex(l =>
      l === ligneSal ||
      (l.date === ligneSal.date && l.montant === ligneSal.montant && (l.compte||'').startsWith('421'))
    );
    if (idxInTout >= 0) toutesLignes[idxInTout]._ventilations = ventilations;
  }

  document.getElementById('vent-overlay')?.remove();

  // Passer à la ligne suivante ou importer
  const suivant = idxCourant + 1;
  if (suivant < lignesSalaires.length) {
    window._ventLigneIdx = suivant;
    ouvrirModaleVentilation(lignesSalaires, toutesLignes);
  } else {
    window._ventLigneIdx = 0; // reset
    console.log('[VENT] Toutes ventilations OK, import de', toutesLignes.length, 'lignes');
    console.log('[VENT] Ventilations:', lignesSalaires.map(l => ({date:l.date, vent: l._ventilations?.length})));
    _importerLignesValidees(toutesLignes);
  }
}

// Traite en une fois tous les virements de paie restants : pour chacun, retrouve
// la FDP du salarié nommé dans le libellé (même filtrage que chargerFDPDuMois),
// lance l'OCR pour en extraire coût employeur/brut/net, et remplit directement
// _ventilations — sans passer par l'écran de vérification virement par virement.
// Les virements dont AUCUNE FDP ne matche le libellé (cas ambigu, virement
// groupé...) sont mis de côté et repassent par le flux manuel habituel, pour ne
// jamais deviner silencieusement une ventilation.
async function traiterVentilationAutomatique() {
  const lignesSalaires = window._ventLignesSalaires || [];
  const toutesLignes   = window._toutesLignesImport  || [];
  if (lignesSalaires.length === 0) return;

  const btn = document.getElementById('vent-btn-auto');
  if (btn) { btn.disabled = true; }

  const fdpParDate = {}; // cache par date de virement — évite de refaire l'OCR du même mois à chaque ligne
  const lignesAmbigues = [];
  let nbTraitees = 0;

  for (let i = 0; i < lignesSalaires.length; i++) {
    const ligne = lignesSalaires[i];
    if (btn) btn.textContent = '⏳ Traitement ' + (i + 1) + '/' + lignesSalaires.length + '…';

    if (!fdpParDate[ligne.date]) {
      try {
        const res = await apiPost({ action: 'getFDPDuMois', payload: { dateVirement: ligne.date, extraireTexte: true } });
        fdpParDate[ligne.date] = (res && res.success && res.fdps) ? res.fdps : [];
      } catch (e) {
        console.log('[VENT-AUTO] erreur FDP mois pour', ligne.date, ':', e.message);
        fdpParDate[ligne.date] = [];
      }
    }

    const libelleLigne = (ligne.libelle || '').toUpperCase();
    const fdpsMatch = (fdpParDate[ligne.date] || []).filter(fdp => {
      const code = (fdp.salarie || '').replace(/^421/, '');
      return code && libelleLigne.indexOf(code) >= 0;
    });

    if (fdpsMatch.length === 0) {
      lignesAmbigues.push(ligne);
      continue;
    }

    ligne._ventilations = fdpsMatch.map(fdp => ({
      salarie:   fdp.salarie   || '',
      spectacle: fdp.projetNom || fdp.projet || '',
      fdp:       fdp.nom       || '',
      fdpUrl:    fdp.url       || '',
      coutEmp:   fdp.coutEmp   || 0,
      brut:      fdp.brut      || 0,
      netVerse:  fdp.netVerse  || 0,
    }));
    nbTraitees++;
  }

  document.getElementById('vent-overlay')?.remove();
  window._ventLigneIdx = 0;

  if (lignesAmbigues.length > 0) {
    toast('⚡ ' + nbTraitees + ' virement(s) ventilé(s) automatiquement — ' + lignesAmbigues.length + ' à vérifier manuellement (aucune FDP reconnue dans le libellé)', '');
    ouvrirModaleVentilation(lignesAmbigues, toutesLignes);
  } else {
    toast('⚡ ' + nbTraitees + ' virement(s) ventilé(s) automatiquement', '');
    _importerLignesValidees(toutesLignes);
  }
}

// Pour chaque ligne 421 (rémunération) déjà en Sheet et affichée en rouge — c'est-à-dire
// sans aucune ventilation associée, la vraie condition utilisée par le tableau (voir
// "sansVentilation" dans le rendu des lignes ; STATUT_VERIF='ROUGE' n'existe pas dans les
// données réelles, seuls VERT/ORANGE sont utilisés) — cherche la/les FDP du mois
// correspondant dans le Drive (même mécanisme que l'import de relevé : chercherFDPDuMois
// + OCR via getFDPDuMois), les apparie par code salarié trouvé dans le libellé/la colonne
// Salarié, puis enregistre directement la ventilation (coût employeur/brut/net + projet)
// et le lien Drive sur la ligne. Les lignes sans correspondance (aucune FDP trouvée)
// restent inchangées — jamais de ventilation devinée à l'aveugle.
async function rechercherFDPLignesRouges() {
  // Traiter du bas vers le haut : sauvegarderVentilationLigne insère des lignes
  // sous la ligne traitée (insertRowBefore), ce qui décale tout ce qui est en
  // dessous dans la feuille. En traitant les _rowIndex décroissants, les lignes
  // pas encore traitées sont toujours au-dessus du point d'insertion et ne
  // bougent donc jamais — sinon leur _rowIndex devient obsolète et pointe sur
  // une autre ligne (bug constaté : ventilations et corrections appliquées à de
  // mauvaises lignes, compte écrasé).
  const rows = (window._comptaAllRows || []).filter(r =>
    (r.COMPTE||'').startsWith('421') && (!r._ventilations || r._ventilations.length === 0) && r.DATE && r.DATE !== '—'
  ).sort((a, b) => (b._rowIndex||0) - (a._rowIndex||0));
  if (rows.length === 0) { toast('Aucune ligne 421 sans ventilation pour ' + state.currentEntity, ''); return; }

  const btn = document.getElementById('btn-recherche-fdp');
  const btnLabel = btn ? btn.textContent : '';
  if (btn) btn.disabled = true;

  const fdpParDate = {}; // cache par date de virement — évite de refaire l'OCR du même mois plusieurs fois
  let nbTraitees = 0;
  const nonTraitees = [];
  const debug = []; // diagnostic — pour comprendre pourquoi une ligne n'est pas appariée (console)

  for (let i = 0; i < rows.length; i++) {
    const ligne = rows[i];
    if (btn) btn.textContent = '⏳ Recherche ' + (i + 1) + '/' + rows.length + '…';

    if (!fdpParDate[ligne.DATE]) {
      try {
        const res = await apiPost({ action: 'getFDPDuMois', payload: { dateVirement: ligne.DATE, extraireTexte: true } });
        fdpParDate[ligne.DATE] = (res && res.success && res.fdps) ? res.fdps : [];
        debug.push({
          date: ligne.DATE, moisRecherche: res && res.moisRecherche, error: res && res.error,
          source: res && res.source,
          nbFdps: (res && res.fdps) ? res.fdps.length : 0,
          fdpsCodes: (res && res.fdps) ? res.fdps.map(f => f.salarie) : [],
          trace: res && res.trace,
        });
      } catch(e) {
        fdpParDate[ligne.DATE] = [];
        debug.push({ date: ligne.DATE, error: 'exception: ' + e.message });
      }
    }

    const libelleLigne = (ligne.LIBELLE || '').toUpperCase();
    const salarieLigne = (ligne.SALARIE || '').toUpperCase();
    const fdpsMatch = (fdpParDate[ligne.DATE] || []).filter(fdp => {
      const code = (fdp.salarie || '').replace(/^421/, '');
      return code && (libelleLigne.indexOf(code) >= 0 || salarieLigne.indexOf(code) >= 0);
    });

    if (fdpsMatch.length === 0) { nonTraitees.push(ligne); continue; }

    const ventilations = fdpsMatch.map(fdp => ({
      salarie:   fdp.salarie   || '',
      spectacle: fdp.projetNom || fdp.projet || '',
      fdp:       fdp.nom       || '',
      fdpUrl:    fdp.url       || '',
      coutEmp:   fdp.coutEmp   || 0,
      brut:      fdp.brut      || 0,
      netVerse:  fdp.netVerse  || 0,
    }));

    try {
      // Enregistrer la ventilation suffit à faire disparaître le fond rouge (la
      // condition d'affichage est l'absence de ventilation, pas STATUT_VERIF) —
      // on met aussi à jour LIEN DRIVE pour que la pièce soit visible/cliquable.
      await apiPost({ action: 'sauvegarderVentilationLigne', payload: { rowIndex: ligne._rowIndex, ventilations } });
      await apiPost({ action: 'editerLigneCompta', payload: { rowIndex: ligne._rowIndex, corrections: {
        'LIEN DRIVE': ventilations[0].fdpUrl,
      } } });
      nbTraitees++;
    } catch(e) {
      nonTraitees.push(ligne);
    }
  }

  if (btn) { btn.disabled = false; btn.textContent = btnLabel; }
  toast('✓ ' + nbTraitees + ' ligne(s) corrigée(s)'
    + (nonTraitees.length ? ' — ' + nonTraitees.length + ' toujours sans FDP (aucune correspondance trouvée)' : ''),
    nbTraitees > 0 ? 'success' : '');

  // Diagnostic console — utile tant que l'appariement FDP n'est pas fiable sur
  // toutes les entités : montre, pour chaque date recherchée, l'erreur backend
  // éventuelle (dossier Drive introuvable) ou les codes salarié trouvés dans le
  // Drive (à comparer avec la colonne Salarié/le libellé des lignes 421).
  console.group('🔍 Diagnostic Rechercher FDP — ' + state.currentEntity);
  debug.forEach(d => {
    if (d.error) console.warn('Date ' + d.date + ' → ERREUR: ' + d.error);
    else console.log('Date ' + d.date + ' → source=' + d.source + ' mois recherché ' + d.moisRecherche + ' — ' + d.nbFdps + ' FDP trouvée(s) : ' + JSON.stringify(d.fdpsCodes));
  });
  const erreursBackend = debug.filter(d => d.error);
  if (erreursBackend.length > 0) {
    toast('⚠️ Erreur Drive pour ' + erreursBackend.length + ' date(s) : ' + erreursBackend[0].error + ' (détails en console)', '');
  } else if (nbTraitees === 0 && debug.every(d => d.nbFdps === 0)) {
    toast('⚠️ Aucune FDP trouvée dans le Drive pour ces dates (dossier mois manquant ou vide ?) — détails en console', '');
  } else if (nbTraitees === 0) {
    toast('⚠️ Des FDP existent dans le Drive mais aucune ne correspond au code salarié des lignes (voir console)', '');
  }
  console.groupEnd();

  if (nbTraitees > 0) loadCompta();
}

function genererRapportProjet() {
  const projet   = comptaState.spectacle || 'Tous';
  const exercice = comptaState.annee || 'Tous';
  const entity   = state.currentEntity;
  if (projet === 'Tous') { toast('Sélectionnez un projet pour générer le rapport', ''); return; }

  const rows = window._comptaAllRows || [];

  // Filtrer les lignes du projet
  const lignes = rows.filter(r => {
    if ((r.SPECTACLE||'') === projet) return true;
    if (r._ventilations && r._ventilations.some(v => (v.spectacle||'') === projet && (v.coutEmp||0) > 0)) return true;
    return false;
  });

  // Recalculer les totaux du projet
  function isRecette(c) { return (c||'').startsWith('7'); }
  function isCharge(c)  { return (c||'').startsWith('6'); }
  function isVersNet(c) { return (c||'').toString().startsWith('421'); }
  function isVirInt(r)  {
    const c = (r.COMPTE||'').replace(/\./g,'');
    const l = (r.LIBELLE||'').toUpperCase();
    return c.startsWith('5') && (l.includes('LIVRET') || l.includes('PROVISION') || c === '5121');
  }

  const totalRecettes = lignes.filter(r => isRecette(r.COMPTE) && !isVirInt(r)).reduce((s,r) => s+(r.CREDIT||0), 0);
  const totalFrais    = lignes.filter(r => isCharge(r.COMPTE) && !isVirInt(r)).reduce((s,r) => s+(r.DEBIT||0), 0);
  const ventilations  = lignes.filter(r => isVersNet(r.COMPTE)).flatMap(r =>
    (r._ventilations||[]).filter(v => (v.spectacle||'') === projet && (v.coutEmp||0) > 0)
  );
  const totalSalarial = ventilations.reduce((s,v) => s+(v.coutEmp||0), 0);
  const totalCharges  = totalFrais + totalSalarial;
  const resultat      = totalRecettes - totalCharges;

  // Générer le HTML du rapport
  const dateRapport = new Date().toLocaleDateString('fr-FR');
  const coulRes = resultat >= 0 ? '#1c6b3a' : '#9b2626';
  const plan = window._comptaPlan || {};

  const recettes   = lignes.filter(r => isRecette(r.COMPTE) && !isVirInt(r));
  const charges    = lignes.filter(r => isCharge(r.COMPTE)  && !isVirInt(r));

  const fmtEur = v => (v||0).toLocaleString('fr-FR') + ' €';
  const piece  = r => r.PIECE_PDF ? r.PIECE_PDF : (r.LIEN_CAT && r.LIEN_CAT.includes('.') ? r.LIEN_CAT : '');
  const pieceLabel = r => { const p = piece(r); return p ? '<a href="'+p+'" style="color:#1a4f8a;text-decoration:none;font-size:10px">'+(p.startsWith('http') ? 'Voir' : p.substring(0,22))+'</a>' : ''; };

