    + '<option value="">Tous</option>'
    + gestionnaires.map(g => '<option value="'+g+'">'+g+'</option>').join('')
    + '</select>'
    + '</div></div>';

  window._paieData = data;

  // KPIs
  const nbPresta = presta.length, nbProd = prod.length;
  const nbEnCours = tous.filter(r => !r.facture).length;
  const nbTermines = tous.filter(r => r.facture).length;
  html += '<div class="kpi-grid" style="margin-bottom:20px">'
