}

async function confirmerDSN(entity, year, mois) {
  const date = document.getElementById('dsn-date')?.value;
  document.getElementById('dsn-modal')?.remove();
  try {
    const savedEntity = state.currentEntity;
    state.currentEntity = entity;
    await apiPost({ action: 'validerDSNMensuelle', payload: { year, mois, date } });
    state.currentEntity = savedEntity;
    toast('DSN ' + entity + ' validée ✓', 'success');
    loadConsolidee();
  } catch(e) { toast('Erreur : ' + e.message, 'error'); }
}

