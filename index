#app-loading-overlay .app-loading-sub { font-size: 22px; font-weight: 600; color: var(--text-sec); }
/* ---- Liste de travail du jour (panneau flottant) ---- */
.todo-panel { position: fixed; top: 66px; right: 20px; width: 380px; max-width: calc(100vw - 32px); background: var(--surface); border: 1px solid var(--border); border-radius: 12px; box-shadow: var(--shadow-m); z-index: 3500; overflow: hidden; animation: app-loader-fadein .3s ease; }
.todo-panel-header { display: flex; align-items: center; gap: 8px; padding: 12px 14px; cursor: pointer; user-select: none; font-size: 13px; font-weight: 700; color: var(--text); }
