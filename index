  const btn = event.target;
  const orig = btn.textContent;
  btn.textContent = '⏳'; btn.disabled = true;
  try {
    const res = await apiGet({ action: 'testSheetConnection', targetEntity: entityCode });
    toast(res.success ? '✓ ' + entityCode + ' : ' + res.name : '✗ ' + entityCode + ' : ' + res.error, res.success ? 'success' : 'error');
