    + ' | Charges : <strong>' + debitFilt.toLocaleString('fr-FR') + ' €</strong>'
    + '</div>';

  // Tableau
  html += '<div class="card"><div class="data-table-wrap"><table class="data-table"><thead><tr>'
    + '<th>N°</th><th>Date</th><th>Compte</th><th>Libellé</th><th>Spectacle</th><th>Salarié / De qui</th>'
    + '<th style="text-align:right">Recettes</th><th style="text-align:right">Charges</th>'
