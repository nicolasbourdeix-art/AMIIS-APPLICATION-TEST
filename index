    return rowHtml;
  });

  html += '</tbody></table></div>'
    + '<div style="padding:12px 20px;border-top:1px solid var(--border);display:flex;gap:10px;align-items:center">'
    + '<span style="font-size:12px;color:var(--text-sec)">Tout valider :</span>'
