async function loadConsolidee() {
  try {
    const data = await apiGet({ action: 'getConsolidated' });
    const year = state.currentYear;
    const mois = String(new Date().getMonth()+1).padStart(2,'0');
    const rows = Object.entries(data.consolidated||{}).map(([code,d]) => {
      const dsn = d.dsn || {};
      return { entity: code, dsn: dsn.valide?('✓ '+(dsn.value||'')):'Non envoyée', dsn_ok: dsn.valide, dsn_alerte: dsn.alerte, dpae: '—', dpae_ok: true, ndf: '—', ndf_ok: true, configured: d.status !== 'NOT_CONFIGURED' };
    });
    renderConsolidee(rows, year, mois);
  } catch(e) {
    renderConsolidee([], state.currentYear, String(new Date().getMonth()+1).padStart(2,'0'));
  }
}

function renderConsolidee(rows, year, mois) {
  const moisLabel = new Date(year, parseInt(mois)-1, 1).toLocaleDateString('fr-FR',{month:'long',year:'numeric'});
  const content = document.getElementById('content');
  let html = '<div class="module-header"><h2>🌐 Vue consolidée — ' + moisLabel + '</h2>'
    + '<button class="btn btn-ghost btn-sm" onclick="loadConsolidee()">↺ Actualiser</button>'
    + '<button class="btn btn-orange btn-sm" onclick="lancerSync()">🔄 Sync toutes entités</button></div>';
  html += '<div class="card"><div class="data-table-wrap"><table class="consolidated-table"><thead><tr>'
    + '<th>Structure</th><th>DSN</th><th>DPAE</th><th>NDF</th><th>Actions</th></tr></thead><tbody>';
  if (rows.length === 0) html += '<tr><td colspan="5" style="text-align:center;color:var(--text-sec);padding:30px">Aucune donnée consolidée.</td></tr>';
  rows.forEach(r => {
    html += '<tr><td><strong>' + r.entity + '</strong>'
      + '<button class="btn btn-ghost btn-sm" style="margin-left:8px;font-size:10px" onclick="navigateToEntity(\'' + r.entity + '\',\'dashboard\')">→</button></td>'
      + '<td>' + (r.dsn_ok?'<span class="status-badge status-ok">✓ '+r.dsn+'</span>':'<span class="status-badge status-err">✗ '+r.dsn+'</span>') + '</td>'
      + '<td>' + (r.dpae_ok?'<span class="status-badge status-ok">✓</span>':'<span class="status-badge status-warn">⚠</span>') + '</td>'
      + '<td>' + (r.ndf_ok?'<span class="status-badge status-ok">✓</span>':'<span class="status-badge status-warn">⚠</span>') + '</td>'
      + '<td>' + (!r.dsn_ok?'<button class="btn btn-green btn-sm" onclick="ouvrirModalDSN(\'' + r.entity + '\',\'' + year + '\',\'' + mois + '\')">✓ DSN</button>':'') + '</td></tr>';
  });
  html += '</tbody></table></div></div>';
  content.innerHTML = html;
}

function navigateToEntity(entityCode, moduleId) {
  state.currentEntity = entityCode;
  document.getElementById('entity-select').value = entityCode;
  navigateTo(moduleId);
}

async function ouvrirModalDSN(entity, year, mois) {
  const moisLabel = new Date(year, parseInt(mois)-1, 1).toLocaleDateString('fr-FR',{month:'long',year:'numeric'});
  const overlay = document.createElement('div');
  overlay.id = 'dsn-modal';
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:2600;display:flex;align-items:center;justify-content:center;padding:20px';
  overlay.innerHTML = '<div style="background:var(--surface);border-radius:12px;padding:28px;width:400px;max-width:100%;box-shadow:0 8px 40px rgba(0,0,0,.25)">'
    + '<h3 style="font-size:16px;font-weight:800;margin-bottom:16px">📤 Valider DSN — ' + entity + ' — ' + moisLabel + '</h3>'
    + '<div><label class="field-label">Date d\'envoi DSN</label>'
    + '<input type="date" id="dsn-date" value="' + new Date().toISOString().split('T')[0] + '" style="width:100%;padding:8px;border:1px solid var(--border);border-radius:6px;background:var(--bg);color:var(--text)"></div>'
    + '<div style="display:flex;gap:10px;justify-content:flex-end;margin-top:16px">'
    + '<button class="btn btn-ghost" data-action="close-modal" data-modal-id="dsn-modal">Annuler</button>'
