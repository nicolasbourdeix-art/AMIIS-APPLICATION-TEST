// "Bilan pour sub" — même données que Bilan financier (calculerBilanFinancier,
// classes 60-68/70/74-79 déjà alignées sur le formulaire officiel de budget
// prévisionnel de demande de subvention), mais avec une mise en page calquée
// sur ce formulaire (bandeau rouge, en-têtes de classe grisés, totaux orange)
// plutôt que les cartes du thème de l'appli. Les intitulés de ligne viennent
// de l'"Opération compta" saisie (pas des libellés officiels du formulaire,
// ex: "Achats matières fournitures (non stockés)"), donc modifiables à la
// main juste avant impression/export — décision explicite : on ne devine pas
// à quel financeur (État/Région/Département...) correspond chaque subvention,
// contrairement au formulaire officiel qui détaille la classe 74 par financeur.
function ouvrirBilanPourSub() {
  const allRows = window._comptaAllRows || [];
  const annees = [...new Set(
    allRows.map(r => bilanNormaliserExercice(r.ANNEE)).filter(a => /^\d{2}$/.test(a))
  )].sort();
  if (!annees.length) { toast('Aucune écriture avec exercice renseigné', 'error'); return; }
  const exerciceDefaut = (comptaState.annee && comptaState.annee !== 'Tous' && annees.includes(comptaState.annee))
    ? comptaState.annee
    : annees[annees.length - 1];
  renderBilanPourSub(exerciceDefaut, annees);
}

function bilanSubChangerExercice(exercice) {
  const allRows = window._comptaAllRows || [];
  const annees = [...new Set(
    allRows.map(r => bilanNormaliserExercice(r.ANNEE)).filter(a => /^\d{2}$/.test(a))
  )].sort();
  renderBilanPourSub(exercice, annees);
}

// Affiche TOUJOURS toutes les classes officielles (60-68 / 70, 74-79), même
// sans aucune écriture — avec une ligne vide à la place — pour que la page
// ressemble au formulaire papier (qui affiche systématiquement toutes les
// classes à 0,00 €) au lieu de ne montrer que celles ayant des écritures.
// Partagé par Bilan pour sub et Prévi N+1.
function completerClasses(classesDef, classesAvecDonnees) {
  return classesDef.map(([code, label]) => classesAvecDonnees.find(c => c.code === code) || { code, label, lignes: [], total: 0 });
}

function renderBilanPourSub(exercice, annees) {
  document.getElementById('bilan-sub-overlay')?.remove();
  ensureBilanPrintStyle();

  const data = calculerBilanFinancier(exercice);
  const entity = state.currentEntity || '';
  const entiteLabel = (ALL_ENTITIES.find(e => e.code === entity) || {}).label || entity;

  const chargesCompletes  = completerClasses(BILAN_CLASSES_CHARGES,  data.charges);
  const produitsCompletes = completerClasses(BILAN_CLASSES_PRODUITS, data.produits);

  // Attestation sur l'honneur (texte à trous) pour un dossier de subvention —
  // masquée par défaut, ajoutée au clic sur "Ajouter l'attestation". Les
  // champs sont modifiables (contenteditable) : nom du/de la président(e) et
  // dates ne sont connus de personne ici, seul le nom de l'association est
  // pré-rempli à partir de l'entité (ALL_ENTITIES), à corriger si besoin.
  function champ(valeur) {
    return '<span contenteditable="true" style="display:inline-block;min-width:240px;padding:0 4px">' + (valeur || '&nbsp;') + '</span>';
  }
  function attestationHtml(nomAssociation) {
    return '<div id="bilan-sub-attestation" style="display:none;margin-top:22px;padding-top:16px;border-top:1px solid #999;font-size:12px;line-height:2">'
      + '<p>Je soussigné(e), ' + champ() + ' Président(e) de l\'association ' + champ(nomAssociation)
      + ' certifie que les comptes annuels de l\'association pour l\'exercice clos le ' + champ()
      + ' ont été examinés et approuvés par le bureau du ' + champ()
      + ' et qu\'ils reflètent fidèlement la situation financière de l\'association à cette date.</p>'
      + '<p style="margin-top:14px">Fait à ' + champ() + ', le ' + champ() + '</p>'
      + '<p style="margin-top:22px">Le Président(e) ' + champ() + '<br>de l\'association ' + champ(nomAssociation) + '</p>'
      + '</div>';
  }

  // Couleurs calquées sur le formulaire officiel plutôt que le thème de
  // l'appli, pour un rendu fidèle à l'impression/export PDF vers un financeur.
  const COULEUR_TITRE      = '#e8a7a7';
  const COULEUR_ENTETE     = '#bfbfbf';
  const COULEUR_CLASSE     = '#d9d9d9';
  const COULEUR_MONTANT_BG = '#e6e6e6';
  const COULEUR_TOTAL      = '#f5a623';

  function colonneHtml(classes, titre) {
    let h = '<table style="width:100%;border-collapse:collapse;font-size:11px;table-layout:fixed">'
      + '<colgroup><col style="width:70%"><col style="width:30%"></colgroup>'
      + '<tr style="background:' + COULEUR_ENTETE + '">'
      + '<td style="padding:5px 8px;font-weight:800;border:1px solid #999">' + titre + '</td>'
      + '<td style="padding:5px 8px;font-weight:800;border:1px solid #999;text-align:center">MONTANT EN EUROS</td>'
      + '</tr>';
    classes.forEach(c => {
      h += '<tr style="background:' + COULEUR_CLASSE + '"><td colspan="2" style="padding:4px 8px;font-weight:800;border:1px solid #999">' + c.code + ' - ' + c.label + '</td></tr>';
      if (c.lignes.length === 0) {
        // Classe sans écriture cette année : ligne vide plutôt que masquer la
        // classe entière — modifiable à la main (libellé et montant), comme
        // sur le formulaire papier officiel qui affiche systématiquement
        // toutes les classes.
        h += '<tr>'
          + '<td contenteditable="true" style="padding:3px 8px;border:1px solid #ccc">&nbsp;</td>'
          + '<td contenteditable="true" style="padding:3px 8px;text-align:right;border:1px solid #ccc;background:' + COULEUR_MONTANT_BG + '">&nbsp;</td>'
          + '</tr>';
        return;
      }
      c.lignes.forEach(l => {
        h += '<tr>'
          + '<td contenteditable="true" style="padding:3px 8px;border:1px solid #ccc" title="Cliquer pour modifier l\'intitulé avant impression">' + l.libelle.replace(/</g,'&lt;') + '</td>'
          + '<td style="padding:3px 8px;text-align:right;border:1px solid #ccc;background:' + COULEUR_MONTANT_BG + ';white-space:nowrap">' + l.montant.toLocaleString('fr-FR', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €</td>'
          + '</tr>';
      });
    });
    h += '</table>';
    return h;
  }

  function totalHtml(label, montant) {
    return '<div style="display:flex;justify-content:space-between;padding:6px 8px;background:' + COULEUR_TOTAL + ';font-weight:800;border:1px solid #999">'
      + '<span>' + label + '</span><span>' + montant.toLocaleString('fr-FR', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €</span></div>';
  }

  const alerteNonClassees = data.montantNonClasse > 0
    ? '<div class="bilan-no-print" style="margin-top:10px;padding:8px 12px;background:rgba(245,166,35,.12);border-radius:6px;font-size:11px;color:var(--text)">⚠️ ' + data.nonClassees.length + ' ligne(s) non classée(s) (sans compte) ignorée(s) — ' + data.montantNonClasse.toLocaleString('fr-FR') + ' € non compté(s).</div>'
    : '';

  const overlay = document.createElement('div');
  overlay.id = 'bilan-sub-overlay';
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:3200;display:flex;align-items:center;justify-content:center;padding:20px';
  overlay.innerHTML = '<div style="background:#fff;color:#111;border-radius:12px;padding:20px;width:1000px;max-width:100%;max-height:92vh;overflow-y:auto;box-shadow:0 8px 40px rgba(0,0,0,.3)">'
    + '<div class="bilan-no-print" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;gap:10px;flex-wrap:wrap">'
    + '<div style="display:flex;align-items:center;gap:8px">'
    + '<h3 style="font-size:16px;font-weight:800;color:#111">📊 Bilan pour sub — ' + entity + '</h3>'
    + '<select style="padding:5px 8px;border:1px solid #999;border-radius:6px;background:#fff;color:#111;font-size:12px" onchange="bilanSubChangerExercice(this.value)">'
    + annees.map(a => '<option value="' + a + '"' + (a===exercice?' selected':'') + '>EX ' + a + '</option>').join('')
    + '</select></div>'
    + '<div style="display:flex;gap:8px">'
    + '<button class="btn btn-ghost btn-sm" onclick="toggleAttestationBilanSub(this)">📝 Ajouter l\'attestation</button>'
    + '<button class="btn btn-ghost btn-sm" onclick="window.print()">🖨️ Imprimer / PDF</button>'
    + '<button class="btn btn-ghost btn-sm" onclick="document.getElementById(\'bilan-sub-overlay\').remove()">✕</button>'
    + '</div></div>'
    + '<p class="bilan-no-print" style="font-size:11px;color:#666;margin:-8px 0 12px">Clique sur un intitulé ou un champ de l\'attestation pour le modifier avant impression/export — les montants viennent de la comptabilité et ne se modifient pas ici.</p>'
    + '<div class="bilan-print-area" style="font-family:Arial,sans-serif;color:#111">'
    + '<div style="background:' + COULEUR_TITRE + ';padding:10px;text-align:center;border:1px solid #999">'
    + '<div style="font-size:18px;font-weight:800">BILAN FINANCIER</div>'
    + '<div style="font-size:14px;font-weight:700">EX ' + exercice + '</div>'
    + '</div>'
    + '<div style="display:grid;grid-template-columns:1fr 1fr">'
    + '<div>' + colonneHtml(chargesCompletes, 'DEPENSES') + '</div>'
    + '<div>' + colonneHtml(produitsCompletes, 'RECETTES') + '</div>'
    + '</div>'
    + '<div style="display:grid;grid-template-columns:1fr 1fr;margin-top:-1px">'
    + '<div>' + totalHtml('TOTAL DES CHARGES', data.totalCharges) + '</div>'
    + '<div>' + totalHtml('TOTAL DES PRODUITS', data.totalProduits) + '</div>'
    + '</div>'
    + attestationHtml(entiteLabel)
    + '</div>'
    + alerteNonClassees
    + '</div>';
  document.body.appendChild(overlay);
  overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.remove(); });
}

function toggleAttestationBilanSub(btn) {
  const el = document.getElementById('bilan-sub-attestation');
  if (!el) return;
  const visible = el.style.display !== 'none';
  el.style.display = visible ? 'none' : 'block';
  btn.textContent = visible ? '📝 Ajouter l\'attestation' : '📝 Masquer l\'attestation';
}

// "Prévi N+1" — budget prévisionnel pour l'exercice N+1, construit à partir
// du dernier exercice CLOS disponible (appelé ici "exercice base" : l'exercice
// courant N n'est pas terminé et ne donnerait pas une image annuelle fiable
// à extrapoler, donc on saute par-dessus). Charges ET produits de la base
// sont augmentés de 10%. Le prévisionnel n'est PAS mis à l'équilibre
// automatiquement — on ne fabrique pas un chiffre : un écart est affiché en
// direct, et l'utilisateur ajoute lui-même des lignes de recette
// prévisionnelles (subventions en cours de demande) jusqu'à l'atteindre.
const PREVI_AUGMENTATION = 1.10;

function ouvrirPreviNPlus1() {
  const allRows = window._comptaAllRows || [];
  const annees = [...new Set(
    allRows.map(r => bilanNormaliserExercice(r.ANNEE)).filter(a => /^\d{2}$/.test(a))
  )].sort();
  if (!annees.length) { toast('Aucune écriture avec exercice renseigné', 'error'); return; }
  renderPreviNPlus1(annees[annees.length - 1], annees);
}

function previChangerExerciceBase(exerciceBase) {
  const allRows = window._comptaAllRows || [];
  const annees = [...new Set(
    allRows.map(r => bilanNormaliserExercice(r.ANNEE)).filter(a => /^\d{2}$/.test(a))
  )].sort();
  renderPreviNPlus1(exerciceBase, annees);
}

// Multiplie tous les montants de lignes (et retotalise chaque classe) par le
// facteur d'augmentation, sur une copie — jamais sur les données réelles.
function appliquerAugmentationPrevi(classesCompletes, facteur) {
  return classesCompletes.map(c => {
    const lignes = c.lignes.map(l => ({ libelle: l.libelle, montant: Math.round(l.montant * facteur * 100) / 100 }));
    return { code: c.code, label: c.label, lignes, total: Math.round(lignes.reduce((s,l) => s+l.montant, 0) * 100) / 100 };
  });
}

function renderPreviNPlus1(exerciceBase, annees) {
  document.getElementById('previ-overlay')?.remove();
  ensureBilanPrintStyle();

  const exerciceCible = (parseInt(exerciceBase, 10) + 2).toString().padStart(2, '0');
  const data = calculerBilanFinancier(exerciceBase);
  const entity = state.currentEntity || '';

  const chargesCompletes  = appliquerAugmentationPrevi(completerClasses(BILAN_CLASSES_CHARGES,  data.charges),  PREVI_AUGMENTATION);
  const produitsCompletes = appliquerAugmentationPrevi(completerClasses(BILAN_CLASSES_PRODUITS, data.produits), PREVI_AUGMENTATION);
  const totalChargesPrevi = Math.round(chargesCompletes.reduce((s,c) => s+c.total, 0) * 100) / 100;
  const totalProduitsBase = Math.round(produitsCompletes.reduce((s,c) => s+c.total, 0) * 100) / 100;

  const COULEUR_TITRE      = '#9fc5e8';
  const COULEUR_ENTETE     = '#bfbfbf';
  const COULEUR_CLASSE     = '#d9d9d9';
  const COULEUR_MONTANT_BG = '#e6e6e6';
  const COULEUR_TOTAL      = '#f5a623';

  // Montants d'origine (dépenses base EX +10%, jamais remutés) dans l'ordre
  // d'affichage des <td> — sert de référence fixe pour le recalcul proportionnel
  // de recalculerPrevi() (pas de cumul d'un recalcul sur l'autre).
  let chargeIdx = 0;
  const chargeOriginaux = [];

  function colonneHtml(classes, titre, kind) {
    let h = '<table style="width:100%;border-collapse:collapse;font-size:11px;table-layout:fixed">'
      + '<colgroup><col style="width:70%"><col style="width:30%"></colgroup>'
      + '<tr style="background:' + COULEUR_ENTETE + '">'
      + '<td style="padding:5px 8px;font-weight:800;border:1px solid #999">' + titre + '</td>'
      + '<td style="padding:5px 8px;font-weight:800;border:1px solid #999;text-align:center">MONTANT EN EUROS</td>'
      + '</tr>';
    classes.forEach(c => {
      h += '<tr style="background:' + COULEUR_CLASSE + '"><td colspan="2" style="padding:4px 8px;font-weight:800;border:1px solid #999">' + c.code + ' - ' + c.label + '</td></tr>';
      if (c.lignes.length === 0) {
        if (kind === 'charges') {
          const id = 'previ-charge-' + (chargeIdx++);
          chargeOriginaux.push(0);
          h += '<tr><td style="padding:3px 8px;border:1px solid #ccc">&nbsp;</td><td id="' + id + '" style="padding:3px 8px;text-align:right;border:1px solid #ccc;background:' + COULEUR_MONTANT_BG + '">0,00 €</td></tr>';
        } else {
          h += '<tr><td style="padding:3px 8px;border:1px solid #ccc">&nbsp;</td><td style="padding:3px 8px;text-align:right;border:1px solid #ccc;background:' + COULEUR_MONTANT_BG + '">0,00 €</td></tr>';
        }
      } else {
        c.lignes.forEach(l => {
          if (kind === 'charges') {
            const id = 'previ-charge-' + (chargeIdx++);
            chargeOriginaux.push(l.montant);
            h += '<tr>'
              + '<td style="padding:3px 8px;border:1px solid #ccc">' + l.libelle.replace(/</g,'&lt;') + '</td>'
              + '<td id="' + id + '" style="padding:3px 8px;text-align:right;border:1px solid #ccc;background:' + COULEUR_MONTANT_BG + ';white-space:nowrap">' + l.montant.toLocaleString('fr-FR', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €</td>'
              + '</tr>';
          } else {
            h += '<tr data-montant="' + l.montant + '">'
              + '<td style="padding:3px 8px;border:1px solid #ccc"><button class="btn btn-ghost btn-sm bilan-no-print" style="font-size:9px;padding:0 5px;margin-right:5px;color:#c0392b" onclick="supprimerLignePrevi(this)" title="Supprimer cette ligne">✕</button>' + l.libelle.replace(/</g,'&lt;') + '</td>'
              + '<td style="padding:3px 8px;text-align:right;border:1px solid #ccc;background:' + COULEUR_MONTANT_BG + ';white-space:nowrap">' + l.montant.toLocaleString('fr-FR', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €</td>'
              + '</tr>';
          }
        });
      }
      if (kind === 'produits') {
        h += '<tr id="previ-addrow-' + c.code + '"><td colspan="2" style="padding:2px 8px;border:1px solid #ccc;background:#fff">'
          + '<button class="btn btn-ghost btn-sm bilan-no-print" style="font-size:10px;padding:2px 10px" onclick="ajouterLignePrevi(\'' + c.code + '\')">+ ligne ' + c.code + '</button>'
          + '</td></tr>';
      }
    });
    return h + '</table>';
  }

  function totalHtml(label, montant, id) {
    return '<div style="display:flex;justify-content:space-between;padding:6px 8px;background:' + COULEUR_TOTAL + ';font-weight:800;border:1px solid #999">'
      + '<span>' + label + '</span><span' + (id ? ' id="' + id + '"' : '') + '>' + montant.toLocaleString('fr-FR', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €</span></div>';
  }

  const overlay = document.createElement('div');
  overlay.id = 'previ-overlay';
  overlay.dataset.totalCharges = totalChargesPrevi;
  overlay.dataset.totalProduitsBase = totalProduitsBase;
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:3200;display:flex;align-items:center;justify-content:center;padding:20px';
  overlay.innerHTML = '<div style="background:#fff;color:#111;border-radius:12px;padding:20px;width:1000px;max-width:100%;max-height:92vh;overflow-y:auto;box-shadow:0 8px 40px rgba(0,0,0,.3)">'
    + '<div class="bilan-no-print" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;gap:10px;flex-wrap:wrap">'
    + '<div style="display:flex;align-items:center;gap:8px">'
    + '<h3 style="font-size:16px;font-weight:800;color:#111">📈 Prévi N+1 — ' + entity + '</h3>'
    + '<span style="font-size:11px;color:#666">Base :</span>'
    + '<select style="padding:5px 8px;border:1px solid #999;border-radius:6px;background:#fff;color:#111;font-size:12px" onchange="previChangerExerciceBase(this.value)">'
    + annees.map(a => '<option value="' + a + '"' + (a===exerciceBase?' selected':'') + '>EX ' + a + '</option>').join('')
    + '</select></div>'
    + '<div style="display:flex;gap:8px">'
    + '<button class="btn btn-ghost btn-sm" onclick="window.print()">🖨️ Imprimer / PDF</button>'
    + '<button class="btn btn-ghost btn-sm" onclick="document.getElementById(\'previ-overlay\').remove()">✕</button>'
    + '</div></div>'
    + '<p class="bilan-no-print" style="font-size:11px;color:#666;margin:-8px 0 12px">Dépenses et recettes de l\'exercice EX ' + exerciceBase + ' augmentées de 10% chacune. Ajoute dans chaque classe de recette concernée (74, 75, 76...) les subventions en cours de demande — les dépenses sont alors réajustées automatiquement pour que le prévisionnel reste exactement à l\'équilibre.</p>'
    + '<div class="bilan-print-area" style="font-family:Arial,sans-serif;color:#111">'
    + '<div style="background:' + COULEUR_TITRE + ';padding:10px;text-align:center;border:1px solid #999">'
    + '<div style="font-size:18px;font-weight:800">BUDGET PRÉVISIONNEL</div>'
    + '<div style="font-size:14px;font-weight:700">EX ' + exerciceCible + '</div>'
    + '</div>'
    + '<div style="display:grid;grid-template-columns:1fr 1fr">'
    + '<div>' + colonneHtml(chargesCompletes, 'DEPENSES', 'charges') + '</div>'
    + '<div>' + colonneHtml(produitsCompletes, 'RECETTES', 'produits') + '</div>'
    + '</div>'
    + '<div style="display:grid;grid-template-columns:1fr 1fr;margin-top:-1px">'
    + '<div>' + totalHtml('TOTAL DES CHARGES', totalChargesPrevi, 'previ-total-charges-montant') + '</div>'
    + '<div><div style="display:flex;justify-content:space-between;padding:6px 8px;background:' + COULEUR_TOTAL + ';font-weight:800;border:1px solid #999">'
      + '<span>TOTAL DES PRODUITS</span><span id="previ-total-produits-montant">' + totalProduitsBase.toLocaleString('fr-FR', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €</span></div></div>'
    + '</div>'
    + '<div id="previ-ecart" class="bilan-no-print" style="margin-top:12px;padding:10px;border-radius:6px;font-weight:800;text-align:center"></div>'
    + '</div>'
    + '</div>';
  document.body.appendChild(overlay);
  overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.remove(); });
  window._previChargeOriginaux = chargeOriginaux;
  recalculerPrevi();
}

