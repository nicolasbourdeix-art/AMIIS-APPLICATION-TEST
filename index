    recettes.forEach(r => {
      html += `<tr><td class="num">${r.NUM_OP||''}</td><td class="num">${r.DATE||'—'}</td><td>${r.LIBELLE||''}</td><td class="pc">${pieceLabel(r)}</td><td class="g">${fmtEur(r.CREDIT)}</td></tr>`;
    });
    html += `<tr class="tot"><td colspan="4">Total recettes</td><td class="g">${fmtEur(totalRecettes)}</td></tr></table></div>`;
  }

  // Charges
  if (charges.length > 0) {
    html += `<div class="sec"><div class="sec-hd">Charges</div><table>
    <tr><th>N°</th><th>Date</th><th>Compte · Libellé</th><th>Pièce</th><th class="r">Montant</th></tr>`;
    charges.forEach(r => {
      const lbl = plan[r.COMPTE] || plan[(r.COMPTE||'').split('.')[0]] || '';
      html += `<tr><td class="num">${r.NUM_OP||''}</td><td class="num">${r.DATE||'—'}</td><td>${r.COMPTE}${lbl?' · '+lbl:''}<br><span style="color:#aaa;font-size:10px">${r.LIBELLE||''}</span></td><td class="pc">${pieceLabel(r)}</td><td class="r">${fmtEur(r.DEBIT)}</td></tr>`;
    });
    html += `<tr class="tot"><td colspan="4">Total charges</td><td class="r">${fmtEur(totalFrais)}</td></tr></table></div>`;
  }

  // Coût salarial
  if (ventilations.length > 0) {
    html += `<div class="sec"><div class="sec-hd">Coût salarial ventilé — employeur</div><table>
    <tr><th>Référence paie</th><th>Salarié</th><th>Projet</th><th class="r">Coût employeur</th></tr>`;
    // Regrouper par ligne 421 parente
    const groupes = {};
    lignes.filter(r => isVersNet(r.COMPTE)).forEach(r => {
      const ref = 'N°' + (r.NUM_OP||'?') + ' · ' + (r.DATE||'');
      (r._ventilations||[]).filter(v => (v.spectacle||'') === projet && (v.coutEmp||0) > 0).forEach(v => {
        html += `<tr class="vent"><td>${ref}</td><td>${(v.salarie||'').replace(/^421/,'')}</td><td>${v.spectacle||''}</td><td class="b">${fmtEur(v.coutEmp)}</td></tr>`;
      });
    });
    html += `<tr class="tot"><td colspan="3">Total coût salarial</td><td class="b">${fmtEur(totalSalarial)}</td></tr></table></div>`;
  }

  html += `<div class="result">
    <div>
      <div class="ttl">Résultat net · ${projet} · EX ${exercice}</div>
      <div class="eq">${fmtEur(totalRecettes)} recettes − ${fmtEur(totalCharges)} charges totales (${fmtEur(totalFrais)} charges + ${fmtEur(totalSalarial)} salarial)</div>
    </div>
    <div class="rhs">${resultat>=0?'+':''}${fmtEur(resultat)}</div>
  </div>
  </div>
  <div class="foot"><span>AMIIS Dashboard V2 · ${entity}</span><span>Confidentiel · ${dateRapport}</span></div>
  </body></html>`;

  // Ouvrir dans un nouvel onglet et lancer l'impression
  const w = window.open('', '_blank');
  w.document.write(html);
  w.document.close();
  setTimeout(() => w.print(), 500);
}

