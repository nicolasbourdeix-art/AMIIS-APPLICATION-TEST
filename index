      if (Object.keys(parSal).length > 4) bHtml += '<span style="font-size:11px;color:var(--text-sec)">…</span>';
      bHtml += '</div>';
    }
    bHtml += '</div>';
    bulles.push(bHtml);
  }

  if (bulles.length > 0) {
    html += '<div style="display:flex;gap:10px;margin-bottom:12px;flex-wrap:wrap">' + bulles.join('') + '</div>';
  }

  // Boutons type (gardés car peu nombreux)
  const filtresBtns = ['Tous','Recettes','Charges','Salaires','Frais','Trésorerie','À vérifier'];
  html += '<div style="display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap">'
    + filtresBtns.map(f => '<button class="btn ' + (filtreSt===f?'btn-orange':'btn-ghost') + ' btn-sm" data-action="compta-filtre" data-filtre="' + f + '">' + f + '</button>').join('')
    + '</div>';

  // Résumé filtre
  const creditFilt = rowsFiltClean.reduce((s,r) => s + (r.CREDIT||0), 0);
  const debitFilt  = rowsFiltClean.reduce((s,r) => s + (r.DEBIT||0), 0);
  html += '<div style="font-size:12px;color:var(--text-sec);margin-bottom:10px">'
