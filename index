  + (hasJours ? '<th>Jours</th>' : '')
    + '<th style="text-align:center">Cachets</th>'
    + (hasServices ? '<th style="text-align:center">SR 4h</th>' : '')
    + (hasDefraiement ? '<th style="text-align:center">Défraiement</th>' : '')
