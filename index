    const sansVentilation = isVersementNet(r.COMPTE) && (!r._ventilations || r._ventilations.length === 0);
    const rowBg    = 'style="' + (sansVentilation ? 'background:rgba(231,76,60,.08);' : (isOrange || isAPreciser) ? 'background:rgba(245,166,35,.06);' : '') + (moisEstOuvert ? '' : 'display:none;') + '"';
    const orangeTip = sansVentilation ? ' title="⚠ Rémunération sans ventilation associée — à compléter via ✏️ Éditer"'
