// Aperçu d'une pièce jointe (Drive) directement dans l'interface, sans ouvrir
// un nouvel onglet — via l'iframe de prévisualisation Drive quand l'URL
// correspond à un fichier Drive standard, avec repli sur un lien "ouvrir dans
// un onglet" sinon (URL externe, format non reconnu).
// declIdx/type (optionnels) : quand fournis (depuis les badges "✓ FDP"/"✓ Signé"
// des Déclarations), affiche un bouton "🗑 Retirer" pour défaire une liaison
// erronée (ex: mauvais fichier auto-lié) sans avoir à modifier le Sheet à la main.
function ouvrirApercuPiece(url, nom, declIdx, type) {
  if (!url) return;
  const m = url.match(/\/d\/([a-zA-Z0-9_-]+)/) || url.match(/[?&]id=([a-zA-Z0-9_-]+)/);
  const fileId = m ? m[1] : null;
  document.getElementById('apercu-piece-overlay')?.remove();
  const overlay = document.createElement('div');
