    html += '<div class="card" style="padding:16px">'
      + '<div style="font-weight:700;font-size:13px;margin-bottom:10px">👤 ' + g + '</div>'
      + '<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:12px">'
