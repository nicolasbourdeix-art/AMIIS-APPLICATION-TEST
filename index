    + ALL_ENTITIES.map(e =>
        '<label style="display:flex;align-items:center;gap:6px;font-size:12px;cursor:pointer">'
        + '<input type="checkbox" class="' + idPrefix + '-entite" value="' + e.code + '"' + (sel.includes(e.code) ? ' checked' : '') + '> '
        + e.code
        + '</label>'
      ).join('')
    + '</div>'
    + '<p style="font-size:10px;color:var(--text-sec);margin-top:4px">Aucune case cochée = accès à toutes les entités.</p>';
}
function _lireCasesEntitesApp(idPrefix) {
  return Array.from(document.querySelectorAll('.' + idPrefix + '-entite:checked')).map(cb => cb.value);
