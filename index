/* ── Fetch avec timeout ── */
async function _fetchSyncWithTimeout(params, timeoutMs) {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), timeoutMs);
  try {
    const url = new URL(APPS_SCRIPT_URL);
    url.searchParams.set('entity', params.entity || state.currentEntity);
    url.searchParams.set('year',   params.year   || state.currentYear);
    if (state.user && state.user.email) url.searchParams.set('email', state.user.email);
    Object.entries(params).forEach(([k, v]) => {
      if (k !== 'entity' && k !== 'year' && v !== undefined && v !== null) url.searchParams.set(k, v);
    });
    const resp = await fetch(url.toString(), { signal: controller.signal });
    clearTimeout(timer);
    if (!resp.ok) throw new Error('HTTP ' + resp.status);
    const data = await resp.json();
    if (data && data.error) throw new Error(data.message || data.code || 'Erreur API');
    return data;
  } catch(e) {
    clearTimeout(timer);
    if (e.name === 'AbortError') throw new Error('timeout');
    throw e;
  }
}

/* ── Utiliser le cache dans les loaders ── */
function _getCachedRows(entity, moduleId, maxAgeMs) {
  maxAgeMs = maxAgeMs || 60 * 60 * 1000; // 60 min — valide toute la session
  const cache = (window._syncCache[entity] || {})[moduleId];
  if (!cache || !cache.fetchedAt) return null;
  if (Date.now() - new Date(cache.fetchedAt).getTime() > maxAgeMs) return null;
  // Ne retourner null que si la sync n'a pas encore eu lieu pour cet élément
  // rows vide = réponse valide du serveur (pas de données pour cette année)
  return cache;
}

