      + '</div>'
      + '<div class="sync-entity-bar-wrap">'
      + '<div class="sync-entity-bar"><div class="sync-entity-bar-fill" id="sync-ent-bar-' + e.code + '"></div></div>'
      + '<div class="sync-steps" id="sync-steps-' + e.code + '">'
      + SYNC_MODULES.map(m =>
          '<div class="sync-step step-pending" id="sync-step-' + e.code + '-' + m.id + '">'
          + '<div class="step-icon">·</div>'
          + '<span class="step-label">' + m.icon + ' ' + m.label + '</span>'
