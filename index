        + '</div></div>';
    });
    html += '</div>';
  }

  window._paieData = window._paieData || {};
  window._paieData._presta = rows;
  html += '<div id="pp-tables">' + renderPaieTables(rows, [], '') + '</div>';
  content.innerHTML = html;
  attachContentListeners();
