        + '<td style="white-space:nowrap;font-size:11px">' + (s.date||'—') + '</td>'
        + '<td style="font-size:11px">' + (s.spectacle||'—') + '</td>'
        + '<td>' + (s.intitule||'—') + '</td>'
        + '<td><span class="status-badge status-grey">' + s.porteur + '</span></td>'
        + '<td style="text-align:right;font-weight:700;color:var(--orange)">' + (s.montant||0).toFixed(2) + ' €</td>'
        + '</tr>';
    });
    html += '</tbody></table></div></div>';
  }

  window._caissesData = data;
  content.innerHTML = html;
}

// Détail des entrées ET des sorties d'un porteur, ouvert au clic sur sa carte.
// Les entrées viennent de CAISSE FILLE (porteurs[p].entreesDetail) : ce sont les
// montants RÉELS déjà répartis, exacts au centime. CAISSE FILLE les stocke agrégés
// par spectacle et sans date, donc on affiche les entrées regroupées par spectacle.
// Les sorties viennent de data.sorties filtrées sur ce porteur (avec date).
function ouvrirDetailCaissePorteur(prenom) {
  const data = window._caissesData;
  if (!data) return;
  const port = (data.porteurs || {})[prenom] || {};
  const entrees = (port.entreesDetail || []).slice();
  const sorties = (data.sorties || []).filter(s => s.porteur === prenom);

  const totalEntrees = port.entrees || entrees.reduce((s, e) => s + (e.montant || 0), 0);
  const totalSorties = sorties.reduce((s, e) => s + (e.montant || 0), 0);
  const solde = (data.balance && data.balance[prenom] != null) ? data.balance[prenom] : (port.solde || 0);

  // Regrouper les entrées par spectacle (d'où vient l'argent).
  const parSpectacle = {};
  entrees.forEach(e => {
    const sp = e.spectacle || '—';
    parSpectacle[sp] = (parSpectacle[sp] || 0) + (e.montant || 0);
  });
  const spectaclesTries = Object.keys(parSpectacle).sort((a, b) => parSpectacle[b] - parSpectacle[a]);

  const overlay = document.createElement('div');
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:9000;display:flex;align-items:center;justify-content:center;padding:20px';

  let inner = '<div style="background:var(--surface);border-radius:14px;padding:28px;width:680px;max-width:96vw;max-height:88vh;overflow-y:auto">'
    + '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">'
    + '<h3 style="font-weight:800">👤 ' + prenom + ' — détail de la caisse</h3>'
    + '<button class="btn btn-ghost btn-sm" onclick="this.closest(\'[style*=fixed]\').remove()">✕</button>'
    + '</div>'
    + '<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:18px">'
    + '<div style="background:var(--bg);border-radius:8px;padding:10px"><div style="font-size:10px;color:var(--text-sec)">↑ Entrées</div><div style="font-weight:800;font-size:16px;color:var(--green)">' + totalEntrees.toFixed(2) + ' €</div></div>'
    + '<div style="background:var(--bg);border-radius:8px;padding:10px"><div style="font-size:10px;color:var(--text-sec)">↓ Sorties</div><div style="font-weight:800;font-size:16px;color:var(--orange)">' + totalSorties.toFixed(2) + ' €</div></div>'
    + '<div style="background:var(--bg);border-radius:8px;padding:10px"><div style="font-size:10px;color:var(--text-sec)">Solde</div><div style="font-weight:800;font-size:16px;color:' + (solde >= 0 ? 'var(--green)' : 'var(--red)') + '">' + solde.toFixed(2) + ' €</div></div>'
    + '</div>';

  // ── Entrées, regroupées par spectacle (montants réels de CAISSE FILLE) ──
  inner += '<div style="font-weight:700;font-size:12px;margin-bottom:8px;color:var(--green)">↑ Entrées par spectacle</div>';
  if (spectaclesTries.length === 0) {
    inner += '<div style="font-size:12px;color:var(--text-sec);margin-bottom:16px">Aucune entrée.</div>';
  } else {
    inner += '<div class="data-table-wrap" style="margin-bottom:18px"><table class="data-table"><thead><tr>'
      + '<th>Spectacle</th><th style="text-align:right">Montant</th><th></th></tr></thead><tbody>';
    spectaclesTries.forEach(sp => {
      inner += '<tr><td>' + sp + '</td><td style="text-align:right;font-weight:700;color:var(--green)">' + parSpectacle[sp].toFixed(2) + ' €</td>'
        + '<td><button class="btn btn-ghost btn-sm" style="padding:1px 4px;font-size:10px" onclick="corrigerEntreeCaissePrompt(\'' + prenom.replace(/'/g,"\\'") + '\', \'' + sp.replace(/'/g,"\\'") + '\', ' + parSpectacle[sp] + ')" title="Corriger ce montant">✏️</button></td>'
        + '</tr>';
    });
    inner += '<tr style="border-top:2px solid var(--border)"><td style="font-weight:800">TOTAL</td>'
      + '<td style="text-align:right;font-weight:800;color:var(--green)">' + totalEntrees.toFixed(2) + ' €</td><td></td></tr>';
    inner += '</tbody></table></div>';
  }

  // ── Sorties, ligne par ligne ──
  inner += '<div style="font-weight:700;font-size:12px;margin-bottom:8px;color:var(--orange)">↓ Sorties</div>';
  if (sorties.length === 0) {
    inner += '<div style="font-size:12px;color:var(--text-sec)">Aucune sortie.</div>';
  } else {
    inner += '<div class="data-table-wrap"><table class="data-table"><thead><tr>'
      + '<th>Date</th><th>Spectacle</th><th>Intitulé</th><th style="text-align:right">Montant</th></tr></thead><tbody>';
    sorties.slice().sort((a, b) => {
      function key(s) { const p = (s.date || '').split('/'); return p.length === 3 ? p[2] + p[1] + p[0] : ''; }
      return key(b).localeCompare(key(a));
    }).forEach(s => {
      inner += '<tr>'
        + '<td style="white-space:nowrap;font-size:11px">' + (s.date || '—') + '</td>'
        + '<td style="font-size:11px">' + (s.spectacle || '—') + '</td>'
        + '<td>' + (s.intitule || '—') + '</td>'
        + '<td style="text-align:right;font-weight:700;color:var(--orange)">' + (s.montant || 0).toFixed(2) + ' €</td>'
        + '</tr>';
    });
    inner += '</tbody></table></div>';
  }

  inner += '</div>';
  overlay.innerHTML = inner;
  overlay.addEventListener('click', e => { if (e.target === overlay) overlay.remove(); });
  document.body.appendChild(overlay);
}

// Corrige à la main le montant "Entrée" d'un porteur pour un spectacle — sert à
// rattraper les montants faux écrits avant le correctif du coût employeur dans la
// répartition automatique, ou toute autre erreur de saisie dans CAISSE FILLE.
async function corrigerEntreeCaissePrompt(porteur, spectacle, montantActuel) {
  const saisie = prompt('Nouveau montant "Entrée" pour ' + porteur + ' — ' + spectacle + ' (€) :', montantActuel.toFixed(2));
  if (saisie === null) return;
  const montant = parseFloat(saisie.replace(',', '.'));
  if (isNaN(montant) || montant < 0) { alert('Montant invalide'); return; }
  try {
    const res = await apiPost({ action: 'corrigerEntreeCaisse', payload: { spectacle, porteur, montant } });
    if (res && res.success) {
      toast('✓ Montant corrigé', 'success');
      document.querySelectorAll('[style*="position:fixed"]').forEach(el => el.remove());
      loadCaisses();
    } else {
      toast('Erreur : ' + (res && res.error || 'inconnue'), 'error');
    }
  } catch(e) { toast('Erreur : ' + e.message, 'error'); }
}

