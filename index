.todo-panel-chevron { font-size: 12px; color: var(--text-sec); transition: transform .2s; }
.todo-panel-close { background: none; border: none; color: var(--text-sec); font-size: 15px; cursor: pointer; padding: 0 2px; line-height: 1; }
.todo-panel-body { max-height: 62vh; overflow-y: auto; padding: 4px 14px 14px; border-top: 1px solid var(--border); }
.todo-panel.minimized .todo-panel-body { display: none; }
