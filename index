/* ============================================================
   CONFIRM MODAL
   ============================================================ */
let _confirmCallback = null;
function confirm_action(title, msg, callback) {
  // Créer une modale inline avec addEventListener (compatible CSP Apps Script)
  const existing = document.getElementById('confirm-inline');
  if (existing) existing.remove();

  const overlay = document.createElement('div');
  overlay.id = 'confirm-inline';
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:5000;display:flex;align-items:center;justify-content:center;padding:20px';

  const box = document.createElement('div');
  box.style.cssText = 'background:var(--surface);border-radius:10px;box-shadow:0 8px 32px rgba(0,0,0,.25);padding:28px 28px 20px;width:340px;max-width:95vw';

  const h3 = document.createElement('h3');
  h3.style.cssText = 'font-size:16px;font-weight:700;margin-bottom:10px;color:var(--text)';
  h3.textContent = title;

  const p = document.createElement('p');
  p.style.cssText = 'font-size:13px;color:var(--text-sec);margin-bottom:20px;line-height:1.5';
  p.textContent = msg;

  const actions = document.createElement('div');
  actions.style.cssText = 'display:flex;gap:10px;justify-content:flex-end';

  const btnAnnuler = document.createElement('button');
  btnAnnuler.className = 'btn btn-ghost';
  btnAnnuler.textContent = 'Annuler';
  btnAnnuler.addEventListener('click', () => overlay.remove());

  const btnOk = document.createElement('button');
  btnOk.className = 'btn btn-danger';
  btnOk.textContent = 'Confirmer';
  btnOk.addEventListener('click', async () => {
    overlay.remove();
    if (callback) {
      try { await callback(); }
      catch(e) { toast('Erreur : ' + e.message, 'error'); }
    }
  });

  actions.appendChild(btnAnnuler);
  actions.appendChild(btnOk);
  box.appendChild(h3);
  box.appendChild(p);
  box.appendChild(actions);
  overlay.appendChild(box);
  document.body.appendChild(overlay);

  // Fermer en cliquant en dehors
  overlay.addEventListener('click', e => { if (e.target === overlay) overlay.remove(); });
}
function closeConfirm() {
  const el = document.getElementById('confirm-inline');
  if (el) el.remove();
  // Compatibilité avec l'ancien système
  const old = document.getElementById('confirm-overlay');
  if (old) old.classList.remove('open');
  _confirmCallback = null;
}

/* ============================================================
