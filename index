function parserCSVReleve(text) {
  // Nettoyer BOM
  text = text.replace(/^\uFEFF/, '');

  // Détecter séparateur
  const lines = text.split(/\r?\n/);
  const sep = lines.slice(0,15).some(l => l.split(';').length > 2) ? ';' : ',';

  // Parser CSV multiline : les libellés CA s'étendent sur plusieurs lignes entre guillemets
  // On reconstitue d'abord les enregistrements complets
  const records = [];
  let current = '';
  let inQuotes = false;
  for (let i = 0; i < text.length; i++) {
    const c = text[i];
    if (c === '"') {
      inQuotes = !inQuotes;
      current += c;
    } else if ((c === '\n' || c === '\r') && !inQuotes) {
      if (current.trim()) records.push(current.trim());
      current = '';
      if (c === '\r' && text[i+1] === '\n') i++; // CRLF
    } else {
      // Newline dans les guillemets → remplacer par espace
      if (inQuotes && (c === '\n' || c === '\r')) current += ' ';
      else current += c;
    }
  }
  if (current.trim()) records.push(current.trim());

  // Parser une ligne CSV (gère les guillemets)
  function parseCols(line) {
    const cols = [];
    let cur = '', inQ = false;
    for (let i = 0; i < line.length; i++) {
      const c = line[i];
      if (c === '"') {
        if (inQ && line[i+1] === '"') { cur += '"'; i++; }
        else inQ = !inQ;
      } else if (c === sep && !inQ) {
        cols.push(cur.trim()); cur = '';
      } else cur += c;
    }
    cols.push(cur.trim());
    return cols;
  }

  // Parser montant CA : "2 518,53" → -2518.53 (débit) ou 5000.20 (crédit)
  function parseMontant(v) {
    if (!v || !v.trim()) return null;
    const s = v.trim().replace(/\s|\u00a0/g, '').replace(',', '.');
    const n = parseFloat(s);
    return isNaN(n) ? null : n;
  }

  // Trouver la ligne d'en-tête
  let headerIdx = -1, iDate = -1, iLib = -1, iDebit = -1, iCredit = -1;
  for (let i = 0; i < records.length; i++) {
    const lower = records[i].toLowerCase().replace(/é/g,'e').replace(/è/g,'e');
    if (lower.includes('date') && (lower.includes('libell') || lower.includes('debit') || lower.includes('credit'))) {
      headerIdx = i;
      const cols = parseCols(records[i]).map(c => c.toLowerCase().replace(/[éè]/g,'e').replace(/[àâ]/g,'a'));
      cols.forEach((c, j) => {
        if (c.includes('date') && !c.includes('valeur') && iDate < 0) iDate = j;
        if ((c.includes('libell') || c.includes('intitul') || c.includes('operat')) && iLib < 0) iLib = j;
        if ((c.includes('debit') || c.includes('sortie')) && iDebit < 0) iDebit = j;
        if ((c.includes('credit') || c.includes('entree')) && !c.includes('debit') && iCredit < 0) iCredit = j;
      });
      break;
    }
  }

  // Fallback si pas d'en-tête détecté : format CA standard connu
  if (headerIdx < 0 || iDate < 0) { iDate=0; iLib=1; iDebit=2; iCredit=3; headerIdx=0; }

  const results = [];
  records.slice(headerIdx + 1).forEach(record => {
    if (!record.trim()) return;
    const cols = parseCols(record);
    if (cols.length < 2) return;

    const date    = (cols[iDate]   || '').trim();
    let   libelle = (cols[iLib]    || '').trim();
    const debitV  = iDebit  >= 0 ? parseMontant(cols[iDebit])  : null;
    const creditV = iCredit >= 0 ? parseMontant(cols[iCredit]) : null;

    // Ignorer les lignes sans date valide
    if (!/\d{2}[\/.\-]\d{2}[\/.\-]\d{2,4}/.test(date)) return;

    // Nettoyer le libellé : souvent "Type DETAILS DETAILS" → garder tout
    // Tronquer à 80 chars pour l'affichage
    if (libelle.length > 80) libelle = libelle.substring(0, 80);

    const montant = (creditV !== null && creditV !== 0) ? creditV
                  : (debitV  !== null && debitV  !== 0) ? -Math.abs(debitV)
                  : 0;

    results.push({ date, libelle, montant, _raw: record });
  });

  return results;
}


// Lecteur avec encodage Latin-1 (CA, BNP...)
function lireCSVAvecEncodage(file, callback) {
  // Essayer UTF-8 d'abord, puis Latin-1
  const reader = new FileReader();
  reader.onload = e => {
    let text = e.target.result;
    // Détecter si mal encodé (présence de \uFFFD)
    if (text.includes('\uFFFD')) {
      const reader2 = new FileReader();
      reader2.onload = e2 => callback(e2.target.result);
      reader2.readAsText(file, 'ISO-8859-1');
    } else {
      callback(text);
    }
  };
  reader.readAsText(file, 'UTF-8');
}

