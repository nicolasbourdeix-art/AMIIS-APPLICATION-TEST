  inner += '<div style="font-weight:700;font-size:12px;margin-bottom:8px">💳 Paie — ' + detailPaie.length + ' fiches de paie (' + c.heuresPaie.toFixed(1) + 'h)</div>';
  if (detailPaie.length === 0) {
    inner += '<div style="font-size:12px;color:var(--text-sec);margin-bottom:16px">Aucune fiche de paie.</div>';
  } else {
    inner += '<div style="max-height:220px;overflow-y:auto;margin-bottom:16px">';
    detailPaie.forEach(r => {
      inner += '<div style="font-size:11px;padding:6px 0;border-bottom:1px solid var(--border)">'
        + '<strong>' + (r.salarie || '—') + '</strong> — ' + (r.projet || '—')
        + '<div style="color:var(--text-sec)">' + (r.structure || '') + (r.debut ? ' · ' + r.debut : '') + '</div>'
        + '</div>';
    });
    inner += '</div>';
  }

  inner += '<div style="font-weight:700;font-size:12px;margin-bottom:8px">📊 Comptes groupe — ' + detailProd.length + ' productions (' + c.heuresProdGroupe.toFixed(1) + 'h, forfait 3h chacune)</div>';
  if (detailProd.length === 0) {
    inner += '<div style="font-size:12px;color:var(--text-sec)">Aucune production attribuée.</div>';
  } else {
    inner += '<div style="max-height:220px;overflow-y:auto">';
    detailProd.forEach(r => {
      inner += '<div style="font-size:11px;padding:6px 0;border-bottom:1px solid var(--border)">'
        + '<strong>' + (r.lieu || '—') + '</strong> — ' + (r.projet || '—')
        + '<div style="color:var(--text-sec)">' + (r.date ? r.date + ' · ' : '') + r.heures + 'h</div>'
        + '</div>';
    });
    inner += '</div>';
  }

  inner += '</div>';
  overlay.innerHTML = inner;
  overlay.addEventListener('click', e => { if (e.target === overlay) overlay.remove(); });
  document.body.appendChild(overlay);
}

