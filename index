// Helper : extraire mois/année d'une date JJ/MM/AAAA
function getMoisLabel(dateStr) {
  if (!dateStr || dateStr === '—') return '';
  const parts = dateStr.split('/');
  if (parts.length < 3) return '';
  const mois = ['Jan','Fév','Mar','Avr','Mai','Jun','Jul','Aoû','Sep','Oct','Nov','Déc'];
  const m = parseInt(parts[1]) - 1;
  const y = parts[2];
  return (mois[m] || parts[1]) + ' ' + y;
}

// Helper : insérer séparateur de mois dans un rendu HTML
function insererSeparateurMois(rows, renderFn) {
  let html = '';
  let dernierMois = null;
  rows.forEach((r, idx) => {
    const mois = getMoisLabel(r.debut || r.date || '');
    if (mois && mois !== dernierMois) {
      dernierMois = mois;
      html += '<tr><td colspan="20" style="background:var(--bg);padding:6px 12px;font-size:11px;font-weight:700;color:var(--text-sec);border-top:2px solid var(--border);border-bottom:1px solid var(--border);letter-spacing:.5px">'
            + '📅 ' + mois.toUpperCase()
            + '</td></tr>';
    }
    html += renderFn(r, idx);
  });
  return html;
}

function renderDPAE(rows) {
  // Trier par date croissante (gère DD/MM/YYYY et YYYY-MM-DD)
  function toSortKeyDpae(r) {
    var d = r.debut || r.date || '';
    if (!d) return '';
    if (/^\d{4}-\d{2}-\d{2}/.test(d)) return d.substring(0,10);
    var parts = d.split('/');
    if (parts.length === 3) return parts[2] + '-' + parts[1] + '-' + parts[0];
    return d;
  }
  rows = (rows || []).slice().sort(function(a, b) {
    return toSortKeyDpae(a).localeCompare(toSortKeyDpae(b));
  });
  window._dpaeRows = rows;
  const content = document.getElementById('content');
  const isCLR = state.currentEntity === 'CLR';

  let html = '<div class="module-header">'
    + '<h2>🔔 DPAE' + (isCLR ? ' — à valider' : '') + ' — ' + state.currentEntity + ' ' + state.currentYear + '</h2>'
    + '<button class="btn btn-ghost btn-sm" onclick="lancerSync()">🔄 Sync</button>'
    + '</div>';

  if (isCLR && rows.length > 0) {
    html += '<div style="background:var(--orange-l);border:1px solid var(--orange);border-radius:var(--radius);padding:10px 16px;margin-bottom:16px;font-size:12px;color:var(--orange-d)">'
      + '<strong>⚠ ' + rows.length + ' déclaration(s) en attente de validation.</strong> '
      + 'Une fois validées, elles apparaîtront dans le module Déclarations.'
      + '</div>';
  }

  if (rows.length === 0) {
