const portalState = { role: null, code: null, data: null };

function detectPortalRole() {
  try {
    const search = (window.location && window.location.search) ? window.location.search : '';
    if (!search) return false;
    const params = new URLSearchParams(search);
    const role = params.get('role');
    const code = params.get('code');
    if (role && code) { openPortal(role, code); return true; }
  } catch(e) {}
  return false;
}

function openPortal(role, code) {
  _removeAppLoadingOverlay();
  portalState.role = role;
  portalState.code = code;
  const screen = document.getElementById('portal-screen');
  screen.classList.add('open');
  const loginBox = document.getElementById('portal-login-box');
  loginBox.style.display    = '';
  loginBox.style.opacity    = '1';
  document.getElementById('portal-porteur-content').style.display   = 'none';
  document.getElementById('portal-diffuseur-content').style.display = 'none';
  document.getElementById('portal-login-error').style.display = 'none';
  document.getElementById('portal-code-input').value = code || '';
  const titles = { porteur: 'Portail porteur de projet', diffuseur: 'Portail diffuseur' };
  document.getElementById('portal-login-title').textContent = titles[role] || 'Accès portail AMIIS';
  if (code && code.length >= 6) portalLogin();
}

function exitPortal() {
  document.getElementById('portal-screen').classList.remove('open');
  try { window.history.replaceState({}, '', window.location.pathname); } catch(e) {}
}

async function portalLogin() {
  const code = document.getElementById('portal-code-input').value.trim().toUpperCase();
  if (!code || code.length < 6) { showPortalError('Code invalide — minimum 6 caractères'); return; }
  const loginBox = document.getElementById('portal-login-box');
  loginBox.style.opacity = '0.6';
  try {
    const urlPorteur = new URL(APPS_SCRIPT_URL);
    urlPorteur.searchParams.set('action', 'porteurAcces');
    urlPorteur.searchParams.set('code', code);
    let res = await fetch(urlPorteur.toString()).then(r => r.json());
    if (res.success) { loginBox.style.display = 'none'; showPorteurPortal(res); return; }
    const urlDif = new URL(APPS_SCRIPT_URL);
    urlDif.searchParams.set('action', 'diffuseurAcces');
    urlDif.searchParams.set('code', code);
    res = await fetch(urlDif.toString()).then(r => r.json());
    if (res.success) { loginBox.style.display = 'none'; showDiffuseurPortal(res); return; }
    showPortalError('Code invalide ou révoqué.');
    loginBox.style.opacity = '1';
  } catch(e) {
    if (code === 'DEMO1234') {
      loginBox.style.display = 'none';
      showPorteurPortal({ success:true, porteur:'Fanny Bourdeix', entity:'CLR', solde:724.20, spectacles:{'Le Rouge Gorge':542.50}, historique:[], config:{pct:20} });
      return;
    }
    showPortalError('Pas de connexion (démo: DEMO1234)');
    loginBox.style.opacity = '1';
  }
}

function showPortalError(msg) {
  const el = document.getElementById('portal-login-error');
  el.textContent = msg; el.style.display = 'block';
}

