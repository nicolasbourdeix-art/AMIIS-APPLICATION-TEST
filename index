async function extraireFDPOCR(btn) {
  const fdps = window._fdpsDuMois || [];
  if (fdps.length === 0) { toast('Aucune FDP chargée', ''); return; }
  btn.textContent = '⏳ OCR en cours…'; btn.disabled = true;

  try {
    const ligne = window._ventLigne;
    const res = await apiPost({ action: 'getFDPDuMois', payload: { dateVirement: ligne.date, extraireTexte: true } });
    if (res && res.success && res.fdps) {
      window._texteOCRParFichier = res.texteOCR || {};
      // Mettre à jour les lignes existantes avec les valeurs extraites
      const tbody = document.getElementById('vent-body');
      if (tbody) {
        // Apparier par nom de fichier plutôt que par position : depuis le filtrage
        // par salarié du libellé, le tableau peut n'afficher qu'un sous-ensemble des
        // FDP du mois, donc res.fdps[i] ne correspond plus forcément à la i-ème ligne.
        const fdpParNom = {};
        res.fdps.forEach(fdp => { if (fdp.nom) fdpParNom[fdp.nom] = fdp; });
        Array.from(tbody.children).forEach((tr) => {
          const nomFichierLigne = tr.querySelector('.vent-fdp');
          const fdp = nomFichierLigne ? fdpParNom[nomFichierLigne.value] : null;
          if (!fdp) return;
          const coutInput  = tr.querySelector('.vent-cout');
          const brutInput  = tr.querySelector('.vent-brut');
          const netInput   = tr.querySelector('.vent-net');
          if (coutInput && fdp.coutEmp && !coutInput.value) coutInput.value = fdp.coutEmp;
          if (brutInput && fdp.brut && !brutInput.value) brutInput.value = fdp.brut;
          if (netInput && fdp.netVerse && !netInput.value) netInput.value = fdp.netVerse;
          const projInput = tr.querySelector('.vent-proj');
          if (projInput && fdp.projetsExtraits && fdp.projetsExtraits.length > 0 && !projInput.value) {
            projInput.value = fdp.projetsExtraits[0];
          }
          // Ajouter un bouton "Voir texte OCR" à côté du nom du fichier, pour
          // diagnostiquer sans avoir à aller chercher dans les logs Apps Script.
          const fdpNomInput = tr.querySelector('.vent-fdp');
          const nomFichier = fdpNomInput ? fdpNomInput.value : '';
