// le bouton "Sauvegarder", donc la sélection se contente de mettre à jour le
// champ (data-code/data-label), lus ensuite par sauvegarderEditionCompta.
function renderComboComptePourModale(compteActuel, operationActuelle) {
  const liste = window._comptaPlanListe || [];
