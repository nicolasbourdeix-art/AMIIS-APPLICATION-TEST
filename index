async function validerCreationCompteGroupe() {
  const nom = document.getElementById('cg-new-nom')?.value?.trim();
  const contact = document.getElementById('cg-new-contact')?.value?.trim() || '';
  const msg = document.getElementById('cg-new-msg');
  if (!nom) { if (msg) { msg.style.color = 'var(--red)'; msg.textContent = '⚠ Le nom du projet est requis'; } return; }

  const btn = document.getElementById('cg-new-valider');
  btn.disabled = true; btn.textContent = '⏳ Création…';
  if (msg) { msg.style.color = 'var(--text-sec)'; msg.textContent = 'Copie du modèle et création du fichier…'; }
  try {
    const res = await apiPost({ action: 'creerCompteGroupe', payload: { nom, contact } });
    if (res && res.success) {
      if (msg) { msg.style.color = 'var(--green)'; msg.innerHTML = '✓ Créé — <a href="' + res.url + '" target="_blank" style="color:var(--blue)">ouvrir le Sheet</a>'; }
      setTimeout(() => { document.querySelector('[style*=fixed]')?.remove(); loadComptesGroupe(); }, 1400);
    } else {
      if (msg) { msg.style.color = 'var(--red)'; msg.textContent = 'Erreur : ' + (res && (res.message || res.error) || 'inconnue'); }
      btn.disabled = false; btn.textContent = '✓ Créer';
    }
  } catch(e) {
    if (msg) { msg.style.color = 'var(--red)'; msg.textContent = 'Erreur : ' + e.message; }
    btn.disabled = false; btn.textContent = '✓ Créer';
  }
}

