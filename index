  // Bulle salaires net versés (421) — filtrée par spectacle si actif
  if (totalNet421 > 0) {
    const parSal = {};
    if (filtreSpec !== 'Tous') {
      // Montrer les salariés dont les ventilations correspondent au spectacle
      kpiSourceRows.filter(r => isVersementNet(r.COMPTE)).forEach(r => {
        if (!r._ventilations) return;
        r._ventilations.filter(v => (v.spectacle||'') === filtreSpec && (v.coutEmp||0) > 0).forEach(v => {
          const sal = (v.salarie || '?').toString().replace(/^421/,'').trim().substring(0,20);
          parSal[sal] = (parSal[sal]||0) + (v.coutEmp||0);
        });
      });
    } else {
      rows.filter(r => isVersementNet(r.COMPTE)).forEach(r => {
        const sal = (r.SALARIE || r.DE_QUI || r.LIBELLE || '?').toString().trim().substring(0,20);
        parSal[sal] = (parSal[sal]||0) + (r.DEBIT||0);
      });
    }
    const topSal = Object.entries(parSal).sort((a,b) => b[1]-a[1]).slice(0,4);
    let bHtml = '<div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:10px 16px;font-size:12px;flex:1;min-width:220px">';
    bHtml += '<div style="font-weight:700;color:var(--text-sec);font-size:10px;margin-bottom:6px;letter-spacing:.5px">💸 SALAIRES NET VERSÉS (421)</div>';
    bHtml += '<div style="display:flex;gap:8px;flex-wrap:wrap;align-items:baseline">';
    bHtml += '<span style="font-size:16px;font-weight:800;color:var(--text)">' + totalNet421.toLocaleString('fr-FR') + ' €</span>';
    bHtml += '<span style="color:var(--text-sec);font-size:11px">(' + rows.filter(r => isVersementNet(r.COMPTE)).length + ' virements)</span>';
    bHtml += '</div>';
    if (topSal.length > 0) {
      bHtml += '<div style="margin-top:6px;display:flex;gap:8px;flex-wrap:wrap">';
      topSal.forEach(([sal, mnt]) => {
        bHtml += '<span style="font-size:11px;color:var(--text-sec)">' + sal + ' : <strong>' + mnt.toLocaleString('fr-FR') + ' €</strong></span>';
