async function loadFacturation() {
  const cached = _getCachedRows(state.currentEntity, 'facturation');
  if (cached) { renderFacturation(cached.rows || []); _showCacheBadge(cached.fetchedAt); return; }
  try { const data = await apiGet({ action: 'getFacturation', year: state.currentYear }); renderFacturation(data.rows || []); }
  catch(e) { renderFacturation([]); }
}

const factState = { statut: 'Tous' };

window._factRows = [];

function renderFacturation(allRows) {
  window._factRows = allRows;

  allRows.sort((a,b) => {
    const rank = r => r.statut === 'Payée' ? 3 : r.statut === 'À facturer' ? 0 : (r.joursRetard||0) > 30 ? 1 : 2;
    return rank(a) - rank(b);
  });

  // Filtre année : FACTURATION contient toutes les années
  const filtreAnnee = factState.annee || String(state.currentYear);
  const rowsAnnee = filtreAnnee === 'Toutes'
    ? allRows
    : allRows.filter(r => {
        if (r.statut === 'À facturer') return true; // toujours afficher les à facturer
        const d = r.emise || r.dateDebut || '';
        if (!d) return true;
        const parts = d.split('/');
        return parts.length === 3 ? parts[2] === filtreAnnee : d.startsWith(filtreAnnee);
      });

  const nbAFacturer = rowsAnnee.filter(r => r.statut === 'À facturer').length;
  const nbImpayees  = rowsAnnee.filter(r => r.statut === 'Impayée').length;
  const nbPayees    = rowsAnnee.filter(r => r.statut === 'Payée').length;
  const totalImpaye = rowsAnnee.filter(r => r.statut === 'Impayée').reduce((s,r) => s + (r.montantHT||0), 0);
  const totalAFact  = rowsAnnee.filter(r => r.statut === 'À facturer').reduce((s,r) => s + (r.montantHT||0), 0);
  const totalPayees = rowsAnnee.filter(r => r.statut === 'Payée').reduce((s,r) => s + (r.montantHT||0), 0);

  const filtreFact = factState.statut || 'Tous';
  const rows = filtreFact === 'Tous' ? rowsAnnee : rowsAnnee.filter(r => r.statut === filtreFact);

  // Années disponibles pour le filtre
  const anneesDispos = [...new Set(allRows.map(r => {
    const d = r.emise || r.dateDebut || '';
    if (!d) return null;
    const parts = d.split('/');
    return parts.length === 3 ? parts[2] : (d.length >= 4 ? d.substring(0,4) : null);
  }).filter(Boolean))].sort().reverse();

  const content = document.getElementById('content');
  let html = '<div class="module-header"><h2>💰 Facturation — ' + state.currentEntity + ' ' + state.currentYear + '</h2>'
    + '<button class="btn btn-ghost btn-sm" onclick="lancerSync()">🔄 Sync</button></div>';

  html += '<div class="kpi-grid" style="margin-bottom:16px">'
    + (nbAFacturer > 0 ? '<div class="kpi-card kpi-orange"><div class="kpi-label">À facturer</div><div class="kpi-value">' + nbAFacturer + '</div><div class="kpi-sub">' + totalAFact.toLocaleString('fr-FR') + ' €</div></div>' : '')
    + '<div class="kpi-card kpi-red"><div class="kpi-label">Impayées</div><div class="kpi-value">' + nbImpayees + '</div><div class="kpi-sub">' + totalImpaye.toLocaleString('fr-FR') + ' €</div></div>'
    + '<div class="kpi-card kpi-green"><div class="kpi-label">Payées</div><div class="kpi-value">' + nbPayees + '</div><div class="kpi-sub">' + totalPayees.toLocaleString('fr-FR') + ' €</div></div>'
    + '</div>';

  // Sélecteur d'année
  if (anneesDispos.length > 1) {
    html += '<div style="display:flex;gap:8px;margin-bottom:8px;flex-wrap:wrap;align-items:center">'
      + '<span style="font-size:11px;color:var(--text-sec)">Année :</span>'
      + '<button class="btn ' + (filtreAnnee==='Toutes'?'btn-blue':'btn-ghost') + ' btn-sm" data-action="fact-annee" data-annee="Toutes">Toutes</button>'
      + anneesDispos.map(a => '<button class="btn ' + (filtreAnnee===a?'btn-blue':'btn-ghost') + ' btn-sm" data-action="fact-annee" data-annee="' + a + '">' + a + '</button>').join('')
      + '</div>';
  }

  const statutsFact = ['Tous','À facturer','Impayée','Payée'].filter(s => s === 'Tous' || rowsAnnee.some(r => r.statut === s));
  html += '<div style="display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap">'
    + statutsFact.map(s => '<button class="btn ' + (filtreFact===s?'btn-orange':'btn-ghost') + ' btn-sm" data-action="fact-filtre" data-statut="' + s + '">' + s + '</button>').join('')
    + '</div>';

  html += '<div class="card"><div class="data-table-wrap"><table class="data-table"><thead><tr>'
    + '<th>Réf.</th><th>Diffuseur</th><th>Spectacle</th><th>Période</th>'
    + '<th style="text-align:right">Montant HT</th>'
    + '<th>Récap</th><th>Contrat</th>'
    + '<th>Statut</th><th>Action</th>'
    + '</tr></thead><tbody>';

  if (rows.length === 0) {
    html += '<tr><td colspan="9" style="text-align:center;color:var(--text-sec);padding:30px">Aucune ligne.</td></tr>';
  }

  rows.forEach(r => {
    const isDanger    = r.statut === 'Impayée' && (r.joursRetard||0) > 30;
    const isAFacturer = r.statut === 'À facturer';
    const rowBg = isDanger    ? 'style="background:rgba(231,76,60,.06)"'
                : isAFacturer ? 'style="background:rgba(245,166,35,.06)"' : '';

    let statutBadge;
    if (r.statut === 'Payée')  statutBadge = '<span class="status-badge status-ok">✓ Payée</span>';
    else if (isAFacturer)      statutBadge = '<span class="status-badge status-warn">🧾 À facturer</span>';
    else if (isDanger)         statutBadge = '<span class="status-badge status-err">⚠ ' + (r.joursRetard||0) + 'j retard</span>';
    else                       statutBadge = '<span class="status-badge status-warn">⏳ Impayée</span>';

    let montantCell = '<td style="text-align:right;font-weight:700">';
    if (r.montantCession > 0) montantCell += '<div>' + r.montantCession.toLocaleString('fr-FR') + ' € <span style="font-size:10px;color:var(--text-sec);font-weight:400">cession</span></div>';
    if (r.montantHeures  > 0) montantCell += '<div style="color:var(--orange)">' + r.montantHeures.toLocaleString('fr-FR') + ' € <span style="font-size:10px;font-weight:400">médiation</span></div>';
    if (r.fraisTotal     > 0) montantCell += '<div style="font-size:11px;color:var(--text-sec)">+ ' + r.fraisTotal.toLocaleString('fr-FR') + ' € frais</div>';
    if (!r.montantCession && !r.montantHeures) montantCell += (r.montantHT||0).toLocaleString('fr-FR') + ' €';
    montantCell += '</td>';

    const periode = (r.dateDebut || r.dateFin)
      ? (r.dateDebut||'?') + (r.dateFin && r.dateFin !== r.dateDebut ? ' → ' + r.dateFin : '')
      : (r.emise || '—');

    const recapLink   = r.pdfRecap   ? '<a href="' + r.pdfRecap   + '" target="_blank" class="status-badge status-blue" style="text-decoration:none">📋</a>' : '—';
    const contratLink = r.pdfContrat ? '<a href="' + r.pdfContrat + '" target="_blank" class="status-badge status-ok"   style="text-decoration:none">📄</a>'
                      : r.lienDrive  ? '<a href="' + r.lienDrive  + '" target="_blank" class="status-badge status-ok"   style="text-decoration:none">📄</a>' : '—';

    const action = isAFacturer
      ? '<span style="font-size:11px;color:var(--text-sec)">→ Émettre facture</span>'
      : (r.statut !== 'Payée' ? '<button class="btn btn-green btn-sm" data-action="marquer-payee" data-id="' + r.id + '" data-rowindex="' + (r.rowIndex||0) + '">✓ Payée</button>' : '');

    // N° facture + Chorus
    const numCell = r.num
      ? '<strong>' + r.num + '</strong>' + (r.chorus ? '<div style="font-size:10px;color:var(--text-sec)">Chorus: ' + r.chorus + '</div>' : '')
      : (r.refDevis ? '<span style="font-size:10px;color:var(--text-sec)">' + r.refDevis + '</span>' : '—');

    html += '<tr ' + rowBg + '>'
      + '<td style="font-size:11px">' + numCell + '</td>'
      + '<td><strong>' + (r.diffuseur||'—') + '</strong></td>'
      + '<td style="font-size:11px">' + (r.spectacle||'—') + '</td>'
      + '<td style="font-size:11px;white-space:nowrap;color:var(--text-sec)">' + periode + '</td>'
      + montantCell
      + '<td>' + recapLink   + '</td>'
      + '<td>' + contratLink + '</td>'
      + '<td>' + statutBadge + '</td>'
      + '<td>' + action + '</td>'
      + '</tr>';
  });

  html += '</tbody></table></div></div>';
  content.innerHTML = html;
  attachContentListeners();
}

function setFactFilter(statut) {
  factState.statut = statut;
  renderFacturation(window._factRows || []);
}

function marquerPayee(id, rowIndex) {
  confirm_action('Marquer la facture comme payée ?', 'Facture ' + id, async () => {
    await apiPost({ action: 'marquerFacturePaye', payload: { tab: 'FACTURATION ' + state.currentYear, rowIndex, year: state.currentYear } });
    toast('Facture payée ✓', 'success');
    loadFacturation();
  });
}

