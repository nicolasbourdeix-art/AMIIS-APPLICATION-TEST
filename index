    + '<button class="btn btn-ghost" data-tab="finance" onclick="showConfigTab(\'finance\',this)">💶 Finances</button>'
    + '<button class="btn btn-ghost" data-tab="codes" onclick="showConfigTab(\'codes\',this)">🔑 Codes d\'accès</button>'
    + '<button class="btn btn-ghost" data-tab="acces-appli" onclick="showConfigTab(\'acces-appli\',this)">👤 Accès appli</button>'
    + '<button class="btn btn-ghost" data-tab="salaries-paie" onclick="showConfigTab(\'salaries-paie\',this)">🧾 Import paie</button>'
    + '</div>'
