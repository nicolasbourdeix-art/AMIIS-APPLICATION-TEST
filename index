async function loadSuivi() {
  const content = document.getElementById('content');
  const tous = !!window._suiviTousExercices;
  const titreAnnee = tous ? 'tous les exercices' : state.currentYear;
  content.innerHTML = '<div class="module-header"><h2>📈 Suivi par projet — ' + state.currentEntity + ' ' + titreAnnee + '</h2></div>'
    + '<div style="padding:40px;text-align:center;color:var(--text-sec)">⏳ Chargement' + (tous ? ' de tous les exercices (peut prendre quelques secondes)' : '') + '…</div>';
  try {
    const data = await apiGet({ action: 'getSuiviProjet', year: tous ? 'tous' : state.currentYear });
    window._suiviExercices = data.exercices || null;
    renderSuivi(data.projets || []);
  } catch(e) {
    content.innerHTML = '<div class="module-header"><h2>📈 Suivi</h2></div>' + renderError('Erreur : ' + e.message);
