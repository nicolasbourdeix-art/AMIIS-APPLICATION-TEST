  let body = '<div class="card"><div class="card-title">Mouvements</div><div class="data-table-wrap"><table class="data-table"><thead><tr><th>Date</th><th>Type</th><th>Libellé</th><th style="text-align:right">Montant</th></tr></thead><tbody>';
  const histo = (data.historique||[]).slice().sort((a,b)=>(b.date||'').localeCompare(a.date||''));
  if (!histo.length) body += '<tr><td colspan="4" style="text-align:center;color:var(--text-sec);padding:20px">Aucun mouvement</td></tr>';
  histo.forEach(h => {
    body += '<tr><td>' + (h.date||'—') + '</td>'
      + '<td>' + (h.montant>=0?'<span class="status-badge status-ok">↑</span>':'<span class="status-badge status-err">↓</span>') + '</td>'
      + '<td>' + (h.libelle||'') + '</td>'
      + '<td style="text-align:right;font-weight:700;color:' + (h.montant>=0?'var(--green)':'var(--red)') + '">' + (h.montant>=0?'+':'') + (h.montant||0).toFixed(2) + ' €</td></tr>';
  });
  body += '</tbody></table></div></div>';
  document.getElementById('pp-body').innerHTML = body;
