  if (compteActuel) {
    if (operationActuelle) {
      labelActuel = compteActuel + ' — ' + operationActuelle;
    } else {
      const candidats = liste.filter(o => o.code === compteActuel);
      labelActuel = candidats.length === 1 ? (compteActuel + ' — ' + candidats[0].label) : (compteActuel + ' — (à préciser)');
    }
  }
  return '<div class="combo-wrap" style="position:relative">'
    + '<input type="text" id="edit-compte-input" class="combo-input" autocomplete="off"'
    + ' style="width:100%;padding:8px;border:1px solid var(--border);border-radius:6px;background:var(--bg);color:var(--text);box-sizing:border-box;font-family:monospace"'
    + ' value="' + (labelActuel ? labelActuel.replace(/"/g,'&quot;') : '') + '"'
