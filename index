}

let _suiviProjetOuvert = null;

// Bascule entre "année sélectionnée" et "tous les exercices" dans le Suivi projets.
function toggleSuiviTousExercices() {
  window._suiviTousExercices = !window._suiviTousExercices;
  _suiviProjetOuvert = null; // referme un éventuel projet déplié
  loadSuivi();
}

function renderSuivi(projets) {
  window._suiviProjets = projets;
  const content = document.getElementById('content');

  // KPIs globaux
  const totalPrev  = projets.reduce((s,p) => s + (p.recettePrevue||0), 0);
  const totalReel  = projets.reduce((s,p) => s + (p.recetteReelle||0), 0);
  const totalCh    = projets.reduce((s,p) => s + (p.totalCharges||0), 0);
  const totalRes   = projets.reduce((s,p) => s + (p.resultat||0), 0);
  const nbPositifs = projets.filter(p => p.resultat > 0).length;
  const nbNegatifs = projets.filter(p => p.resultat < 0 && p.totalCharges > 0).length;

  const tousMode = !!window._suiviTousExercices;
  const titreAnnee = tousMode ? 'tous les exercices' : state.currentYear;
  const exercicesTxt = (tousMode && window._suiviExercices && window._suiviExercices.length)
    ? ' <span style="font-size:11px;color:var(--text-sec);font-weight:400">(' + window._suiviExercices.join(', ') + ')</span>'
    : '';

  let html = '<div class="module-header"><h2>📈 Suivi par projet — ' + state.currentEntity + ' ' + titreAnnee + exercicesTxt + '</h2>'
    + '<div style="display:flex;gap:8px;margin-left:auto">'
    + '<button class="btn ' + (tousMode ? 'btn-orange' : 'btn-ghost') + ' btn-sm" onclick="toggleSuiviTousExercices()" title="Regrouper tous les exercices ou revenir à l\'année sélectionnée">'
    + (tousMode ? '📅 Année ' + state.currentYear : '🌐 Tous les exercices') + '</button>'
    + '<button class="btn btn-ghost btn-sm" onclick="loadSuivi()">🔄 Actualiser</button>'
    + '</div></div>';

  html += '<div class="kpi-grid" style="margin-bottom:20px">'
    + '<div class="kpi-card kpi-blue"><div class="kpi-label">Recettes prévues</div><div class="kpi-value kpi-small">' + totalPrev.toLocaleString('fr-FR') + ' €</div></div>'
    + '<div class="kpi-card kpi-green"><div class="kpi-label">Recettes réelles</div><div class="kpi-value kpi-small">' + totalReel.toLocaleString('fr-FR') + ' €</div></div>'
    + '<div class="kpi-card kpi-orange"><div class="kpi-label">Charges totales</div><div class="kpi-value kpi-small">' + totalCh.toLocaleString('fr-FR') + ' €</div></div>'
    + '<div class="kpi-card ' + (totalRes >= 0 ? 'kpi-green' : 'kpi-red') + '"><div class="kpi-label">Résultat global</div><div class="kpi-value kpi-small">' + (totalRes >= 0 ? '+' : '') + totalRes.toLocaleString('fr-FR') + ' €</div></div>'
    + '<div class="kpi-card kpi-green"><div class="kpi-label">Projets ✓</div><div class="kpi-value">' + nbPositifs + '</div></div>'
    + (nbNegatifs > 0 ? '<div class="kpi-card kpi-red"><div class="kpi-label">Projets déficitaires</div><div class="kpi-value">' + nbNegatifs + '</div></div>' : '')
    + '</div>';

  // Liste des projets
  html += '<div style="display:grid;gap:12px">';

  projets.forEach(function(p, idx) {
    const hasDevis    = p.devis && p.devis.length > 0;
    const hasCharges  = p.totalCharges > 0;
    const isPositif   = p.resultat > 0;
    const isNegatif   = p.resultat < 0 && hasCharges;
    const couverture  = p.tauxCouverture !== null ? p.tauxCouverture : null;

    // Barre de couverture
    const barrePct = couverture !== null ? Math.min(couverture, 150) : 0;
    const barreColor = couverture === null ? 'var(--border)'
      : couverture >= 100 ? 'var(--green)' : couverture >= 70 ? 'var(--orange)' : 'var(--red)';

    // Écart cachets
    const ecartCachBadge = p.cachetPrevi > 0
      ? '<span style="font-size:11px;color:' + (p.ecartCachets === 0 ? 'var(--green)' : p.ecartCachets > 0 ? 'var(--orange)' : 'var(--text-sec)') + '">'
        + (p.ecartCachets > 0 ? '+' : '') + p.ecartCachets + ' cachets vs prévi</span>'
      : '';

    // Header card
    const cardBg = _suiviProjetOuvert === p.nom
      ? 'background:var(--surface);border:2px solid var(--orange)'
      : isPositif ? 'background:var(--surface);border:1px solid var(--green-l,#d4edda)'
      : isNegatif ? 'background:var(--surface);border:1px solid var(--red-l,#f8d7da)'
      : 'background:var(--surface);border:1px solid var(--border)';

    html += '<div class="card" style="' + cardBg + ';cursor:pointer;padding:0" data-action="ouvrir-projet" data-idx="' + idx + '">';

    // Ligne résumé (toujours visible)
    html += '<div style="display:flex;align-items:center;gap:16px;padding:14px 18px">'
      // Indicateur couleur
      + '<div style="width:4px;height:48px;border-radius:2px;background:' + barreColor + ';flex-shrink:0"></div>'
      // Nom + badges
      + '<div style="flex:1;min-width:0">'
      +   '<div style="font-weight:800;font-size:14px">' + p.nom + '</div>'
      +   '<div style="display:flex;gap:6px;margin-top:4px;flex-wrap:wrap">'
      +     (hasDevis ? '<span class="status-badge status-ok" style="font-size:10px">✓ Devis</span>' : '<span class="status-badge status-grey" style="font-size:10px">Pas de devis</span>')
      +     (p.nbDeclarations > 0 ? '<span class="status-badge status-blue" style="font-size:10px">' + p.nbDeclarations + ' DPAE</span>' : '')
      +     (p.ndfCount > 0 ? '<span class="status-badge status-warn" style="font-size:10px">' + p.ndfCount + ' NDF</span>' : '')
      +     ecartCachBadge
      +   '</div>'
      + '</div>'
      // Colonnes chiffres
      + '<div style="text-align:right;min-width:110px">'
      +   '<div style="font-size:10px;color:var(--text-sec)">Résultat</div>'
      +   '<div style="font-weight:800;font-size:15px;color:' + (isPositif ? 'var(--green)' : isNegatif ? 'var(--red)' : 'var(--text-sec)') + '">'
      +     (p.resultat !== 0 ? (p.resultat > 0 ? '+' : '') + p.resultat.toLocaleString('fr-FR') + ' €' : '—')
      +   '</div>'
      +   (couverture !== null ? '<div style="font-size:10px;color:' + barreColor + ';font-weight:600;margin-top:2px">' + couverture + '% couverture</div>' : '')
      + '</div>'
      + '<div style="font-size:18px;color:var(--text-sec)">' + (_suiviProjetOuvert === p.nom ? '▲' : '▼') + '</div>'
      + '</div>';

    // Détail (affiché si ouvert)
    if (_suiviProjetOuvert === p.nom) {
      html += '<div style="border-top:1px solid var(--border);padding:18px">';
      html += renderSuiviDetail(p);
      html += '</div>';
    }

    html += '</div>';
  });

  html += '</div>';
  content.innerHTML = html;
  attachContentListeners();
}

function renderSuiviDetail(p) {
  let html = '<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px">';

  // ── Colonne gauche : Recettes ──
  html += '<div>';
  html += '<h4 style="font-size:13px;font-weight:700;margin-bottom:12px;color:var(--green)">💰 Recettes</h4>';
  html += '<table style="width:100%;font-size:12px;border-collapse:collapse">';
  html += '<tr><td style="padding:4px 0;color:var(--text-sec)">Prévu (devis)</td><td style="text-align:right;font-weight:700">' + (p.recettePrevue||0).toLocaleString('fr-FR') + ' €</td></tr>';

  // Détail devis
  (p.devis || []).forEach(function(d) {
    if (d.montantHT > 0) html += '<tr><td style="padding:2px 0 2px 12px;color:var(--text-sec);font-size:11px">↳ Cession ' + (d.diffuseur||'') + '</td><td style="text-align:right;font-size:11px">' + (d.montantHT||0).toLocaleString('fr-FR') + ' €</td></tr>';
    if (d.montantHeures > 0) html += '<tr><td style="padding:2px 0 2px 12px;color:var(--text-sec);font-size:11px">↳ Médiation ' + (d.nbHeures||0) + 'h</td><td style="text-align:right;font-size:11px">' + (d.montantHeures||0).toLocaleString('fr-FR') + ' €</td></tr>';
  });
  if (p.recetteFraisDevis > 0) html += '<tr><td style="padding:2px 0 2px 12px;color:var(--text-sec);font-size:11px">↳ Frais refacturés (héberg./restau./déplac./matériel)</td><td style="text-align:right;font-size:11px">' + p.recetteFraisDevis.toLocaleString('fr-FR') + ' €</td></tr>';

  html += '<tr style="border-top:1px solid var(--border)"><td style="padding:6px 0;color:var(--text-sec)">Réalisé (facturé)</td><td style="text-align:right;font-weight:700;color:var(--green)">' + (p.recetteReelle||0).toLocaleString('fr-FR') + ' €</td></tr>';
  html += '</table></div>';

  // ── Colonne droite : Charges ──
  html += '<div>';
  html += '<h4 style="font-size:13px;font-weight:700;margin-bottom:12px;color:var(--orange)">💸 Charges</h4>';
  html += '<table style="width:100%;font-size:12px;border-collapse:collapse">';

  // Prévi cachets
  if (p.cachetPrevi > 0 || p.servicePrevi > 0 || p.techPrevi > 0) {
    html += '<tr><td colspan="2" style="padding:4px 0;font-weight:600;color:var(--text-sec)">Prévisionnels</td></tr>';
    if (p.cachetPrevi  > 0) html += '<tr><td style="padding:2px 0 2px 12px;color:var(--text-sec);font-size:11px">Cachets artistes</td><td style="text-align:right;font-size:11px">' + p.cachetPrevi + ' cachets</td></tr>';
    if (p.servicePrevi > 0) html += '<tr><td style="padding:2px 0 2px 12px;color:var(--text-sec);font-size:11px">Services 4h</td><td style="text-align:right;font-size:11px">' + p.servicePrevi + ' services</td></tr>';
    if (p.techPrevi    > 0) html += '<tr><td style="padding:2px 0 2px 12px;color:var(--text-sec);font-size:11px">Journées tech.</td><td style="text-align:right;font-size:11px">' + p.techPrevi + ' j.</td></tr>';
  }

  // Réels DPAE
  if (p.cachetsReels > 0 || p.servicesReels > 0) {
    html += '<tr><td colspan="2" style="padding:6px 0 4px;font-weight:600;color:var(--text-sec)">DPAE réelles</td></tr>';
    if (p.cachetsReels  > 0) {
      const ecart = p.cachetsReels - p.cachetPrevi;
      html += '<tr><td style="padding:2px 0 2px 12px;font-size:11px">Cachets déclarés</td>'
        + '<td style="text-align:right;font-size:11px">' + p.cachetsReels
        + (p.cachetPrevi > 0 ? ' <span style="color:' + (ecart===0?'var(--green)':ecart>0?'var(--orange)':'var(--blue)') + '">' + (ecart>0?'+':'') + ecart + '</span>' : '')
        + '</td></tr>';
    }
    if (p.servicesReels > 0) {
      const ecartSR = p.servicesReels - p.servicePrevi;
      html += '<tr><td style="padding:2px 0 2px 12px;font-size:11px">Services 4h déclarés</td>'
        + '<td style="text-align:right;font-size:11px">' + p.servicesReels
        + (p.servicePrevi > 0 ? ' <span style="color:' + (ecartSR===0?'var(--green)':ecartSR>0?'var(--orange)':'var(--blue)') + '">' + (ecartSR>0?'+':'') + ecartSR + '</span>' : '')
        + '</td></tr>';
    }
  }

  // Charges comptabilité
  html += '<tr><td colspan="2" style="padding:6px 0 4px;font-weight:600;color:var(--text-sec)">Comptabilité validée</td></tr>';
  if (p.chargesSal    > 0) html += '<tr><td style="padding:2px 0 2px 12px;font-size:11px;color:var(--text-sec)">Salaires (641/645)</td><td style="text-align:right;font-weight:700;font-size:11px">' + p.chargesSal.toLocaleString('fr-FR') + ' €</td></tr>';
  if (p.chargesNDF    > 0) html += '<tr><td style="padding:2px 0 2px 12px;font-size:11px;color:var(--text-sec)">Frais (625/606)</td><td style="text-align:right;font-size:11px">' + p.chargesNDF.toLocaleString('fr-FR') + ' €</td></tr>';
  if (p.chargesAutres > 0) html += '<tr><td style="padding:2px 0 2px 12px;font-size:11px;color:var(--text-sec)">Autres charges</td><td style="text-align:right;font-size:11px">' + p.chargesAutres.toLocaleString('fr-FR') + ' €</td></tr>';

  // NDF
  if (p.ndfCount > 0) {
    html += '<tr><td style="padding:2px 0 2px 12px;font-size:11px;color:var(--text-sec)">' + p.ndfCount + ' NDF traitée(s)</td>'
      + '<td style="text-align:right;font-size:11px">' + p.ndfMontant.toLocaleString('fr-FR') + ' €'
      + (p.chargesNDF > 0 ? ' <span style="font-size:10px;color:var(--text-sec)">(incl. compta)</span>' : '') + '</td></tr>';
  }

  // Total charges + résultat
  html += '<tr style="border-top:2px solid var(--border)">'
    + '<td style="padding:8px 0;font-weight:700">Total charges</td>'
    + '<td style="text-align:right;font-weight:800;color:var(--orange)">' + (p.totalCharges||0).toLocaleString('fr-FR') + ' €</td></tr>';

  const isPos = p.resultat > 0;
  const isNeg = p.resultat < 0;
  html += '<tr style="border-top:2px solid var(--border)">'
    + '<td style="padding:8px 0;font-weight:800;font-size:14px">Résultat</td>'
    + '<td style="text-align:right;font-weight:800;font-size:16px;color:' + (isPos?'var(--green)':isNeg?'var(--red)':'var(--text-sec)') + '">'
    + (p.resultat > 0 ? '+' : '') + (p.resultat||0).toLocaleString('fr-FR') + ' €</td></tr>';

  html += '</table></div>';
  html += '</div>'; // grid

  // Liens devis
  if (p.devis && p.devis.length > 0) {
    html += '<div style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap">';
    p.devis.forEach(function(d) {
      if (d.pdfRecap)   html += '<a href="' + d.pdfRecap   + '" target="_blank" class="btn btn-ghost btn-sm">📋 Récap ' + (d.diffuseur||'').substring(0,15) + '</a>';
      if (d.pdfContrat) html += '<a href="' + d.pdfContrat + '" target="_blank" class="btn btn-ghost btn-sm">📄 Contrat ' + (d.diffuseur||'').substring(0,15) + '</a>';
    });
    html += '</div>';
  }

  return html;
}

