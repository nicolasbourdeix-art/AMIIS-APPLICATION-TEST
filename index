async function sauvegarderEditionCompta(rowIndex) {
  const inCompte  = document.getElementById('edit-compte-input');
  const compte    = inCompte?.dataset.code || '';
  const operation = inCompte?.dataset.label || '';
  const date      = document.getElementById('edit-date')?.value;
  const exercice  = document.getElementById('edit-exercice')?.value.trim();
  const libelle   = document.getElementById('edit-libelle')?.value.trim();
  const spectacle = document.getElementById('edit-spectacle')?.value.trim();
  const debit     = document.getElementById('edit-debit')?.value;
  const credit    = document.getElementById('edit-credit')?.value;
  const ventilations = collecterVentilationsEdit(); // null si pas de section (compte non-421)
  const repartitions = collecterRepartitionsEdit(); // 0/1 ligne = pas de répartition
  document.getElementById('compta-edit-modal')?.remove();
  confirm_action('Sauvegarder les modifications ?', 'Ligne ' + rowIndex + ' — écriture directe dans le Sheet COMPTA.', async () => {
    try {
      // Si le champ "Projet / Spectacle" principal est vide mais qu'un seul projet a
      // été saisi dans la section "Répartir sur plusieurs projets" (sans qu'il y ait
      // de vraie répartition à plusieurs lignes, donc jamais envoyé par ailleurs), on
      // s'en sert quand même pour renseigner le Spectacle de la ligne — sinon le nom
      // tapé là est silencieusement perdu (repartitions.length < 2 ne déclenche pas
      // repartirLigneComptaSurProjets).
      const spectacleUnique = (!spectacle && repartitions.length === 1 && repartitions[0].spectacle) ? repartitions[0].spectacle : spectacle;
      const corrections = {
        'Dates': date, 'Numéro comptable': compte,
        'Descriptions/ Libelles': libelle,
        'Spectacle': spectacleUnique,
        'Charges (Sorties)': debit ? parseFloat(debit) : '',
        'Produits (Entrées)': credit ? parseFloat(credit) : '',
        'STATUT_VERIF': compte ? 'VERT' : 'ORANGE',
      };
      // Exercice comptable : n'écrire que si une valeur est sélectionnée.
      // Format identique à celui du Sheet ("EX 25", "EX 26").
      if (exercice) corrections['Année exercice'] = 'EX ' + exercice;
      // N'écrase "Opération compta" que si un libellé précis a été choisi dans
      // la liste — sinon on laisse ce qui était déjà en place (évite d'effacer
      // un libellé existant si l'utilisateur n'a pas touché au compte).
      if (operation) corrections['Opération compta'] = operation;
      await apiPost({ action: 'editerLigneCompta', payload: { rowIndex, corrections } });
      if (ventilations !== null) {
        await apiPost({ action: 'sauvegarderVentilationLigne', payload: { rowIndex, ventilations } });
      }
      // Répartition sur plusieurs projets : scinde la ligne en autant
      // d'écritures que de projets renseignés — exécuté après editerLigneCompta
      // pour que le montant/projet final reflète bien la répartition (et non le
      // champ Débit/Crédit global saisi plus haut dans le formulaire).
      if (repartitions.length >= 2) {
        await apiPost({ action: 'repartirLigneComptaSurProjets', payload: { rowIndex, repartitions } });
      }
      toast('Ligne sauvegardée ✓', 'success');
      loadCompta();
    } catch(e) { toast('Erreur : ' + e.message, 'error'); }
  });
}

function formatDate(d) {
  if (!d || d === '—') return '—';
  if (/^\d{2}\/\d{2}\/\d{4}$/.test(d)) return d;
  try { const dt = new Date(d); if (isNaN(dt.getTime())) return '—'; return dt.toLocaleDateString('fr-FR'); } catch(_) { return d; }
}

function getPlanLabel(code) {
  const found = PLAN_COMPTABLE.find(p => p.code === code);
  return found ? found.label : code;
}

function statutIcon(statut) {
  if (statut === 'VERT') return '✓';
  if (statut === 'ORANGE') return '⚠';
  if (statut === 'ROUGE') return '✗';
  return '≡';
}

