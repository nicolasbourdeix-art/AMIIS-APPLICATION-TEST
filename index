function renderCaisses(data) {
  const content = document.getElementById('content');
  if (!data || data.error) {
    content.innerHTML = '<div class="card"><p style="color:var(--red)">Erreur : ' + (data && data.error || 'inconnue') + '</p></div>';
    return;
  }

  const porteurs   = data.porteurs   || {};
  const balance    = data.balance    || {};
  const personnes  = data.personnes  || Object.keys(porteurs);
  const sorties    = data.sorties    || [];
  const totalSolde = personnes.reduce((s,p) => s + (balance[p] || 0), 0);

  let html = '<div class="module-header"><h2>💼 Caisses perso — ' + state.currentEntity + '</h2>'
    + '<div style="margin-left:auto;display:flex;gap:8px">'
    + '<button class="btn btn-ghost btn-sm" onclick="ouvrirVerificationCaisses()">🔍 Vérifier vs compta</button>'
    + '<button class="btn btn-ghost btn-sm" onclick="ouvrirDeductionManuelle()">← Déduction</button>'
    + '</div></div>';

  // KPI total
  html += '<div class="kpi-grid" style="margin-bottom:20px">'
    + '<div class="kpi-card kpi-green"><div class="kpi-label">Total caisses</div>'
    + '<div class="kpi-value">' + totalSolde.toFixed(2) + ' €</div></div>'
    + '<div class="kpi-card kpi-blue"><div class="kpi-label">Total entrées</div>'
    + '<div class="kpi-value">' + (data.totalEntrees||0).toFixed(2) + ' €</div></div>'
    + '<div class="kpi-card kpi-orange"><div class="kpi-label">Total sorties</div>'
    + '<div class="kpi-value">' + (data.totalSorties||0).toFixed(2) + ' €</div></div>'
    + '</div>';

  // Carte par porteur (cliquable → détail des entrées et sorties)
  html += '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px;margin-bottom:24px">';
  personnes.forEach(function(p) {
    const port   = porteurs[p] || {};
    const solde  = balance[p] || port.solde || 0;
    const color  = solde >= 0 ? 'var(--green)' : 'var(--red)';
    html += '<div class="card" style="padding:16px;cursor:pointer" onclick="ouvrirDetailCaissePorteur(\'' + p.replace(/'/g,"\\'") + '\')" title="Voir le détail des entrées et sorties">'
      + '<div style="font-weight:700;font-size:13px;margin-bottom:8px">👤 ' + p + '</div>'
      + '<div style="font-size:22px;font-weight:800;color:' + color + '">' + solde.toFixed(2) + ' €</div>'
      + '<div style="font-size:11px;color:var(--text-sec);margin-top:6px;display:flex;justify-content:space-between">'
      + '<span>↑ Entrées : ' + (port.entrees||0).toFixed(2) + ' €</span>'
      + '<span>↓ Sorties : ' + (port.sorties||0).toFixed(2) + ' €</span>'
      + '</div>'
      + '<div style="font-size:10px;color:var(--blue);margin-top:6px">Voir le détail →</div>'
      + '</div>';
  });
  html += '</div>';

  // Tableau des sorties
  if (sorties.length > 0) {
    html += '<div class="card"><div class="data-table-wrap"><table class="data-table"><thead><tr>'
      + '<th>Date</th><th>Spectacle</th><th>Intitulé</th><th>Porteur</th>'
      + '<th style="text-align:right">Montant</th>'
      + '</tr></thead><tbody>';
    let dernierMois = null;
    sorties.forEach(function(s) {
      const mois = s.date ? s.date.substring(3) : '';
      if (mois && mois !== dernierMois) {
        dernierMois = mois;
        html += '<tr><td colspan="5" style="background:var(--bg);font-size:11px;font-weight:700;color:var(--text-sec);padding:5px 10px">📅 ' + mois + '</td></tr>';
      }
