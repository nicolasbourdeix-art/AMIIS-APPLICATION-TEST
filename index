async function lierContrat(candidatIndex) {
  const candidat    = window._contratCandidats[candidatIndex];
  const rowIndex    = window._contratRowIndex;
  const sourceSheet = window._contratSourceSheet || 'Contrats';
  if (!candidat) return;
  document.getElementById('contrat-modal')?.remove();

  console.log('[lierContrat] rowIndex=' + rowIndex + ' sourceSheet=' + sourceSheet + ' url=' + candidat.url);

  try {
    const res = await apiPost({
      action:  'lierContratSigne',
      payload: { rowIndex, url: candidat.url, sourceSheet }
    });

    console.log('[lierContrat] réponse :', JSON.stringify(res));

    if (res && res.error) {
      // Colonne non trouvée → essayer avec la colonne alternative
      toast('⚠ ' + res.error + ' (onglet: ' + sourceSheet + ') — essai colonne alternative…', '');
      // Pour DECLA / DPAE_CLR : essayer 'CONTRAT SIGNEE', puis 'Lien PDF'
      const colAlt = (res.col === 'CONTRAT SIGNEE') ? 'Lien PDF' : 'CONTRAT SIGNEE';
      const res2 = await apiPost({
        action:  'lierContratSigne',
        payload: { rowIndex, url: candidat.url, sourceSheet, colNameOverride: colAlt }
      });
      if (res2 && res2.success) {
        toast('✓ Contrat lié (colonne ' + colAlt + ') : ' + candidat.nom, 'success');
        const declRow2 = window._declRows[window._contratDeclIdx];
        if (declRow2) { declRow2.lienContratSigne = candidat.url; declRow2.contratSigne = true; }
        if (window._syncCache[state.currentEntity]) delete window._syncCache[state.currentEntity]['declarations'];
        renderDeclarations(window._declRows);
      } else {
        toast('Erreur liaison : ' + (res2 && res2.error ? res2.error : JSON.stringify(res2)), 'error');
      }
    } else if (res && res.success) {
      toast('✓ Contrat lié : ' + candidat.nom, 'success');
      // Mettre à jour la ligne locale — par index ou par _rowIndex en fallback
      const declIdx = window._contratDeclIdx;
      if (declIdx !== undefined && window._declRows[declIdx]) {
        window._declRows[declIdx].lienContratSigne = candidat.url;
        window._declRows[declIdx].contratSigne = true;
      } else {
        const row = window._declRows.find(r => r._rowIndex === window._contratRowIndex);
        if (row) { row.lienContratSigne = candidat.url; row.contratSigne = true; }
      }
      // Vider le cache pour que la prochaine sync soit fraîche
      if (window._syncCache[state.currentEntity]) delete window._syncCache[state.currentEntity]['declarations'];
      renderDeclarations(window._declRows);
    } else {
      toast('Réponse inattendue : ' + JSON.stringify(res), 'error');
    }
  } catch(e) { toast('Erreur : ' + e.message, 'error'); }
}

