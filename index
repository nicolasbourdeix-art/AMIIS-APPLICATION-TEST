// Même correctif que comptaComboOuvrir : au focus, toujours montrer la liste
// complète plutôt que de filtrer avec le texte déjà affiché ("645 — (à préciser)"
// par ex.), qui ne correspond littéralement à aucune entrée et ferait ressortir
// "Aucun résultat" dès l'ouverture.
function editComboOuvrir(input) {
  input.select();
  _rendreListeEditCombo(input, '');
}

function editComboFiltrer(input) {
  _rendreListeEditCombo(input, input.value.trim().toLowerCase());
}

function _rendreListeEditCombo(input, requete) {
  document.querySelectorAll('.combo-list').forEach(el => { if (el !== input.nextElementSibling) el.style.display = 'none'; });
  const liste = window._comptaPlanListe || [];
  const entries = liste.slice().sort((a, b) => {
    const na = parseFloat(a.code), nb = parseFloat(b.code);
    if (!isNaN(na) && !isNaN(nb) && na !== nb) return na - nb;
    if (a.code !== b.code) return a.code.localeCompare(b.code);
    return a.label.localeCompare(b.label);
  });
  let filtrees = entries;
  if (requete) {
    const parCode  = entries.filter(o => o.code.toLowerCase().startsWith(requete));
    const parLabel = entries.filter(o => !o.code.toLowerCase().startsWith(requete) && o.label.toLowerCase().includes(requete));
    filtrees = parCode.concat(parLabel);
  }
  const listEl = input.nextElementSibling;
  let html = '';
  filtrees.slice(0, 100).forEach(o => {
    html += '<div class="combo-item" style="padding:5px 8px;font-size:12px;cursor:pointer" '
      + 'onmousedown="editComboChoisir(\'' + o.code.replace(/'/g,"\\'") + '\',\'' + o.label.replace(/'/g,"\\'").replace(/"/g,'&quot;') + '\')">'
      + '<span style="font-family:monospace;font-weight:700">' + o.code + '</span> — ' + o.label + '</div>';
  });
  if (filtrees.length === 0) html = '<div style="padding:6px 8px;font-size:12px;color:var(--text-sec)">Aucun résultat pour ce code</div>';
  listEl.innerHTML = html;
  listEl.style.display = 'block';
}

function editComboChoisir(code, label) {
  const input = document.getElementById('edit-compte-input');
  if (!input) return;
  input.value = code + ' — ' + label;
  input.dataset.code = code;
  input.dataset.label = label;
  input.nextElementSibling.style.display = 'none';
}

