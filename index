function mettreAJourControle() {
  const tbody = document.getElementById('vent-body');
  if (!tbody) return;
  const ligne = window._ventLigne;
  const netReleve = Math.abs(ligne ? (ligne.montant || 0) : 0);

  // Sommer les nets versés (champ netVerse extrait par OCR)
  let totalNetFDP = 0;
  let totalCoutEmp = 0;
  Array.from(tbody.children).forEach(tr => {
    const netInput  = tr.querySelector('.vent-net');
    const coutInput = tr.querySelector('.vent-cout');
    if (netInput)  totalNetFDP  += parseFloat(netInput.value)  || 0;
    if (coutInput) totalCoutEmp += parseFloat(coutInput.value) || 0;
  });

  const netFDPEl  = document.getElementById('vent-net-fdp');
  const ecartEl   = document.getElementById('vent-ecart-badge');
  if (!netFDPEl || !ecartEl) return;

  netFDPEl.textContent = totalNetFDP.toLocaleString('fr-FR') + ' €';

  if (totalNetFDP === 0) {
    ecartEl.innerHTML = '<span style="color:var(--text-sec)">Saisir les nets FDP pour contrôler</span>';
    return;
  }

  const ecart = Math.abs(netReleve - totalNetFDP);
  if (ecart < 0.05) {
    ecartEl.innerHTML = '<span style="color:var(--green)">✓ Totaux équilibrés</span>';
    netFDPEl.style.color = 'var(--green)';
  } else {
    ecartEl.innerHTML = '<span style="color:var(--red)">⚠ Écart : ' + (netReleve - totalNetFDP).toLocaleString('fr-FR') + ' €</span>';
    netFDPEl.style.color = 'var(--red)';
  }
}

