function validerPieceReleve(idx, checked) {
  // Si l'utilisateur décoche → effacer la pièce liée
  if (!checked) {
    window._relevePropositions[idx].piece_url = '';
    window._relevePropositions[idx].piece_nom = '';
  }
}

function chercherPieceReleve(idx, btn) {
  const url = prompt('Colle l\'URL Google Drive de la pièce justificative :');
  if (!url || !url.startsWith('http')) return;
  const nom = url.split('/').filter(Boolean).pop() || 'pièce';
  window._relevePropositions[idx].piece_url = url;
  window._relevePropositions[idx].piece_nom = nom;
  // Remplacer le bouton par le lien
  const a = document.createElement('a');
  a.href = url; a.target = '_blank';
  a.style.cssText = 'font-size:10px;color:var(--green);text-decoration:none';
  a.textContent = '📄 ' + nom.substring(0,18);
  btn.replaceWith(a);
}

// Résolution automatique d'un nom de fichier réel connu (issu d'un rapprochement
// par montant contre un devis ou une NDF) en URL Drive cliquable, via la même
// recherche que la colonne Pièce du tableau principal — pas de saisie manuelle
// puisqu'on connaît déjà le nom exact du fichier à chercher.
async function resoudrePieceMontant(idx, btn) {
  const nomFichier = window._relevePropositions[idx].piece_fichier_brut;
  if (!nomFichier) return;
  const btnOrigHtml = btn.outerHTML;
  btn.textContent = '⏳'; btn.disabled = true;
  try {
    const res = await apiGet({ action: 'getPieceComptaUrl', nomFichier });
    if (res && res.url) {
      window._relevePropositions[idx].piece_url = res.url;
      const wrap = document.getElementById('ir-piece-' + idx);
      if (wrap) {
        wrap.innerHTML = '<input type="checkbox" checked title="Valider ce rapprochement" onchange="validerPieceReleve(' + idx + ',this.checked)">'
          + '<a href="' + res.url + '" target="_blank" style="font-size:10px;color:var(--green);text-decoration:none;max-width:110px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:inline-block">📄 ' + (window._relevePropositions[idx].piece_nom||'Voir').substring(0,16) + '</a>';
      }
      window.open(res.url, '_blank');
    } else {
      btn.textContent = '❌';
      btn.title = (res && res.error) || 'Introuvable dans Drive';
      setTimeout(() => { btn.outerHTML = btnOrigHtml; }, 2500);
    }
  } catch(e) {
    btn.textContent = '❌';
