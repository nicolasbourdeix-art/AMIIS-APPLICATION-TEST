function loadModule(id) {
  try {
    const content = document.getElementById('content');
    if (!content) return Promise.resolve();
    // Vide le contenu au lieu d'y mettre le petit spinner inline (renderLoader) :
    // l'overlay plein écran (logo qui tourne) suffit, les deux ensemble faisaient
    // doublon à l'écran.
    content.innerHTML = '';
    afficherChargementModule();
    let p;
    switch(id) {
      case 'dashboard':    p = loadDashboard();    break;
      case 'declarations': p = loadDeclarations(); break;
      case 'suivi':        p = loadSuivi();        break;
      case 'dpae':         p = loadDPAE();         break;
      case 'ndf':          p = loadNDF();          break;
      case 'devis':        p = loadDevis();        break;
      case 'facturation':  p = loadFacturation();  break;
      case 'balance':      p = loadBalance();      break;
      case 'salaries':     p = loadSalaries();     break;
      case 'comptabilite': p = loadCompta();       break;
      case 'caisses':      p = loadCaisses();         break;
      case 'paie':         p = loadPaie();    break;
      case 'prod':           p = loadProd();          break;
      case 'comptes-groupe': p = loadComptesGroupe(); break;
      case 'consolidee':   p = loadConsolidee();   break;
      case 'config':       loadConfig();       break;
      default: renderPlaceholder('🔧', id, 'Module en cours de développement.');
    }
    return (p || Promise.resolve()).finally(masquerChargementModule);
  } catch(err) {
    masquerChargementModule();
    const content = document.getElementById('content');
    if (content) content.innerHTML = '<div style="padding:20px;background:#FDEAEA;border:1px solid #E24B4A;border-radius:8px;color:#E24B4A;font-family:monospace;font-size:13px;margin:20px"><strong>Erreur module ' + id + ' :</strong><br>' + (err.message || err) + '</div>';
