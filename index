      pieceCell = '<span class="status-badge status-blue" style="font-size:10px" title="Rapproché avec un lot de virement groupé — détail dans l\'onglet VIREMENTS NDF">' + nomFichier + '</span>';
    } else if (nomFichier && nomFichier !== 'Fonctionnement' && nomFichier !== 'Spectacle' && nomFichier !== 'Matériel' && nomFichier !== 'Production') {
      // Nom de fichier → bouton qui résout l'URL via Drive
      const nomCourt = nomFichier.length > 22 ? nomFichier.substring(0,20) + '…' : nomFichier;
      const ext = nomFichier.split('.').pop().toLowerCase();
      const icon = ['jpg','jpeg','png','heic'].includes(ext) ? '🖼' : '📄';
      pieceCell = '<button class="status-badge status-grey" style="cursor:pointer;border:none;max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"'
        + ' data-action="ouvrir-piece-compta" data-nom="' + nomFichier.replace(/"/g,'&quot;') + '" data-rowindex="' + r._rowIndex + '"'
        + ' title="' + nomFichier + '">'
        + icon + ' ' + nomCourt + '</button>';
    } else if (nomFichier) {
      // Tag catégorie (Fonctionnement, Spectacle...) + bouton attacher
      pieceCell = '<span style="font-size:10px;color:var(--text-sec);margin-right:3px">' + nomFichier + '</span>'
        + '<button class="btn btn-ghost btn-sm" style="padding:1px 4px;font-size:10px" data-action="attacher-piece" data-rowindex="' + r._rowIndex + '" title="Attacher">📎</button>';
    } else if (r.NUM_FACTURE) {
      pieceCell = '<span class="status-badge status-blue" style="font-size:10px" title="N° facture">' + r.NUM_FACTURE + '</span>'
        + ' <button class="btn btn-ghost btn-sm" style="padding:1px 4px;font-size:10px" data-action="attacher-piece" data-rowindex="' + r._rowIndex + '" title="Attacher">📎</button>';
    } else {
      pieceCell = '<button class="btn btn-ghost btn-sm" style="padding:1px 4px;font-size:10px" data-action="attacher-piece" data-rowindex="' + r._rowIndex + '" title="Attacher une pièce">📎</button>';
    }
    const pieceLink = pieceCell;

    // Salarié / De qui
    const qui = [r.SALARIE, r.DE_QUI].filter(Boolean).join(' / ') || '';

    html += '<tr class="' + classeMois + '" ' + rowBg + '>'
      + '<td style="font-size:10px;color:var(--text-sec)">' + (r.NUM_OP||'') + '</td>'
      + '<td style="white-space:nowrap;font-size:11px">' + (r.DATE||'—') + '</td>'
      + '<td' + orangeTip + '>' + renderComboComptePourLigne(r.COMPTE, r._rowIndex, r.OP_TYPE) + '</td>'
      + '<td style="font-size:12px;max-width:340px;white-space:normal;word-break:break-word" title="' + (r.LIBELLE||'') + '">' + (r.LIBELLE||'—') + '</td>'
      + '<td style="font-size:11px">' + (r.SPECTACLE ? '<span class="status-badge status-grey" style="font-size:10px">' + r.SPECTACLE + '</span>' : '') + '</td>'
      + '<td style="font-size:11px;color:var(--text-sec)">' + qui + '</td>'
      + '<td style="text-align:right;font-weight:700;color:var(--green)">' + ((r.CREDIT||0) > 0 ? (r.CREDIT).toLocaleString('fr-FR') + ' €' : '') + '</td>'
      + '<td style="text-align:right;font-weight:700;color:var(--orange)">'
      + (isVersementNet(r.COMPTE) && filtreSpec !== 'Tous'
          ? '' // masquer le net versé global quand filtre spectacle actif
          : ((r.DEBIT||0) > 0 ? (r.DEBIT).toLocaleString('fr-FR') + ' €' : ''))
      + '</td>'
      + '<td style="white-space:nowrap">' + pieceLink + '</td>'
      + '<td><button class="btn btn-ghost btn-sm" style="padding:2px 6px" data-action="edit-compta" data-rowindex="' + r._rowIndex + '">✏️</button></td>'
      + '</tr>';

    // Afficher les ventilations EMPLOYEUR — filtrer par spectacle si filtre actif
    if (r._ventilations && r._ventilations.length > 0) {
      const ventsAffichees = r._ventilations.filter(v => {
        if ((v.coutEmp||0) === 0) return false;
        if (filtreSpec !== 'Tous' && (v.spectacle||'') !== filtreSpec) return false;
        return true;
      });
      ventsAffichees.forEach(v => {
        // Nettoyer le code salarié : "421GAR" → "GAR", ou garder tel quel si pas de préfixe
        const salCode = (v.salarie||'').replace(/^421/,'').replace(/^421/, '') || v.salarie || '';
        // Lien fiche de paie : URL directe si connue, sinon bouton de résolution
        // par nom de fichier via Drive (même mécanisme que la colonne Pièce des
        // lignes principales).
        let fdpCell = '';
        if (v.fdpUrl && v.fdpUrl.startsWith('http')) {
          fdpCell = '<a href="javascript:void(0)" class="status-badge status-ok" style="text-decoration:none;cursor:pointer" title="Aperçu de la fiche de paie"'
