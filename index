async function loadBalance() {
  try {
    const data = await apiGet({ action: 'getBalance', year: state.currentYear });
    renderBalance(data.rows || [], data.detailCompte || [], data.mouvementsTresorerie || [], data.resteAEncaisser || [], data.resteAEncaisserPasse || 0);
  }
  catch(e) { renderBalance([], [], [], [], 0); }
}

function renderBalance(rows, detailCompte, mouvementsTresorerie, resteAEncaisser, resteAEncaisserPasse) {
  resteAEncaisser = resteAEncaisser || [];
  resteAEncaisserPasse = resteAEncaisserPasse || 0;
  rows.forEach(r => { r.charges = (r.chargesSal||0) + (r.chargesNDF||0) + (r.chargesDivers||0); r.resultat = r.recettes - r.charges; });
  const total = rows.reduce((acc, r) => ({ recettes: acc.recettes + r.recettes, charges: acc.charges + r.charges, resultat: acc.resultat + r.resultat }), { recettes:0, charges:0, resultat:0 });
  const content = document.getElementById('content');
  let html = '<div class="module-header"><h2>⚖️ Balance — ' + state.currentEntity + ' ' + state.currentYear + '</h2></div>';
  html += '<div class="kpi-grid" style="margin-bottom:20px">'
    + '<div class="kpi-card kpi-green"><div class="kpi-label">Recettes HT</div><div class="kpi-value">' + total.recettes.toLocaleString('fr-FR') + ' €</div></div>'
    + '<div class="kpi-card kpi-red"><div class="kpi-label">Charges</div><div class="kpi-value">' + total.charges.toLocaleString('fr-FR') + ' €</div></div>'
    + '<div class="kpi-card ' + (total.resultat>=0?'kpi-green':'kpi-red') + '"><div class="kpi-label">Résultat</div><div class="kpi-value">' + (total.resultat>=0?'+':'') + total.resultat.toLocaleString('fr-FR') + ' €</div></div>'
    + (resteAEncaisserPasse > 0 ? '<div class="kpi-card kpi-orange" title="Total du « Reste à encaisser » (ci-dessous) pour les spectacles dont la dernière date de représentation est déjà passée — argent qui devrait normalement être rentré"><div class="kpi-label">Reste à encaisser (passé)</div><div class="kpi-value">' + resteAEncaisserPasse.toLocaleString('fr-FR') + ' €</div></div>' : '')
    + '</div>';
  if (rows.length === 0 && (!detailCompte || detailCompte.length === 0) && (!mouvementsTresorerie || mouvementsTresorerie.length === 0) && resteAEncaisser.length === 0) { html += '<div class="card" style="text-align:center;color:var(--text-sec);padding:40px">Aucune donnée Balance.</div>'; content.innerHTML = html; return; }

  if (rows.length > 0) {
    html += '<div class="card" style="margin-bottom:20px"><h3 style="font-size:14px;font-weight:700;color:var(--text-sec);margin-bottom:10px;padding:14px 14px 0">Par spectacle</h3><div class="data-table-wrap"><table class="data-table"><thead><tr><th>Spectacle</th><th style="text-align:right">Recettes</th><th style="text-align:right">Charges</th><th style="text-align:right">Résultat</th></tr></thead><tbody>';
    rows.forEach(r => {
      html += '<tr><td><strong>' + r.spectacle + '</strong></td>'
        + '<td style="text-align:right;color:var(--green);font-weight:600">' + (r.recettes||0).toLocaleString('fr-FR') + ' €</td>'
        + '<td style="text-align:right;color:var(--red)">' + (r.charges||0).toLocaleString('fr-FR') + ' €</td>'
        + '<td style="text-align:right;font-weight:800;color:' + (r.resultat>=0?'var(--green)':'var(--red)') + '">' + (r.resultat>=0?'+':'') + (r.resultat||0).toLocaleString('fr-FR') + ' €</td></tr>';
    });
    html += '</tbody></table></div></div>';
  }

  // Reste à encaisser : ce qui est prévu par les devis vs déjà enregistré comme
  // recette en compta, par spectacle. Le rapprochement bancaire relie une
  // recette au spectacle, pas à un devis précis quand plusieurs diffuseurs
  // partagent un même spectacle — l'agrégation se fait donc par spectacle.
  if (resteAEncaisser.length > 0) {
    const totalAttendu  = resteAEncaisser.reduce((s,l) => s + l.attendu, 0);
    const totalEncaisse = resteAEncaisser.reduce((s,l) => s + l.encaisse, 0);
    const totalReste    = resteAEncaisser.reduce((s,l) => s + l.reste, 0);
    html += '<div class="card" style="margin-bottom:20px">'
      + '<h3 style="font-size:14px;font-weight:700;color:var(--text-sec);margin-bottom:2px;padding:14px 14px 0">💰 Reste à encaisser — devis vs compta</h3>'
      + '<div style="font-size:11px;color:var(--text-sec);padding:0 14px 10px">Ce qui est prévu par les devis, comparé à ce qui est déjà enregistré comme recette en comptabilité (par spectacle)</div>'
      + '<div class="data-table-wrap"><table class="data-table"><thead><tr>'
      + '<th>Spectacle</th><th style="text-align:right">Attendu (devis)</th><th style="text-align:right">Encaissé</th><th style="text-align:right">Reste à encaisser</th><th>Statut</th>'
      + '</tr></thead><tbody>'
      + resteAEncaisser.map(l => {
          let statut, couleur;
          if (l.encaisse <= 0)     { statut = 'Rien reçu'; couleur = 'var(--red)'; }
          else if (l.reste <= 0.5) { statut = 'Encaissé';  couleur = 'var(--green)'; }
          else                      { statut = 'Partiel';   couleur = 'var(--orange)'; }
          return '<tr>'
            + '<td><span class="status-badge status-grey">' + l.spectacle + '</span>'
              + (l.estPasse && l.reste > 0 ? ' <span title="Dernière représentation déjà passée — comptée dans la KPI « Reste à encaisser (passé) »" style="font-size:11px">🕐</span>' : '')
            + '</td>'
            + '<td style="text-align:right">' + l.attendu.toLocaleString('fr-FR') + ' €</td>'
            + '<td style="text-align:right;color:var(--green)">' + l.encaisse.toLocaleString('fr-FR') + ' €</td>'
            + '<td style="text-align:right;font-weight:700;color:' + (l.reste>0?'var(--orange)':'var(--text-sec)') + '">' + l.reste.toLocaleString('fr-FR') + ' €</td>'
            + '<td><span class="status-badge" style="background:' + couleur + ';color:#fff">' + statut + '</span></td>'
            + '</tr>';
        }).join('')
      + '<tr style="border-top:2px solid var(--border);font-weight:800">'
        + '<td>TOTAL</td>'
        + '<td style="text-align:right">' + totalAttendu.toLocaleString('fr-FR') + ' €</td>'
        + '<td style="text-align:right;color:var(--green)">' + totalEncaisse.toLocaleString('fr-FR') + ' €</td>'
        + '<td style="text-align:right;color:var(--orange)">' + totalReste.toLocaleString('fr-FR') + ' €</td>'
        + '<td></td></tr>'
      + '</tbody></table></div></div>';
  }

  // Détail par compte comptable — un vrai bilan/grand livre : chaque compte avec
  // son libellé officiel, ses totaux crédit/débit et son solde. Complète la vue
  // par spectacle, qui masque toutes les écritures sans spectacle associé
  // (salaires, cotisations, frais bancaires...) sous un seul "GENERAL".
  if (detailCompte && detailCompte.length > 0) {
    const totalCredit = detailCompte.reduce((s, c) => s + (c.credit||0), 0);
    const totalDebit  = detailCompte.reduce((s, c) => s + (c.debit||0), 0);
    html += '<div class="card"><h3 style="font-size:14px;font-weight:700;color:var(--text-sec);margin-bottom:10px;padding:14px 14px 0">Détail par compte comptable</h3><div class="data-table-wrap"><table class="data-table"><thead><tr><th>Compte</th><th>Libellé</th><th style="text-align:right">Crédit</th><th style="text-align:right">Débit</th><th style="text-align:right">Solde</th></tr></thead><tbody>';
    detailCompte.forEach(c => {
      html += '<tr>'
        + '<td style="font-family:monospace;font-weight:700">' + c.compte + '</td>'
        + '<td style="font-size:12px;color:var(--text-sec)">' + (c.libelle||'—') + '</td>'
        + '<td style="text-align:right;color:var(--green)">' + (c.credit>0 ? c.credit.toLocaleString('fr-FR')+' €' : '—') + '</td>'
        + '<td style="text-align:right;color:var(--red)">' + (c.debit>0 ? c.debit.toLocaleString('fr-FR')+' €' : '—') + '</td>'
        + '<td style="text-align:right;font-weight:700;color:' + (c.solde>=0?'var(--green)':'var(--red)') + '">' + (c.solde>=0?'+':'') + c.solde.toLocaleString('fr-FR') + ' €</td>'
        + '</tr>';
    });
    html += '<tr style="border-top:2px solid var(--border);font-weight:800">'
      + '<td colspan="2">TOTAL</td>'
      + '<td style="text-align:right;color:var(--green)">' + totalCredit.toLocaleString('fr-FR') + ' €</td>'
      + '<td style="text-align:right;color:var(--red)">' + totalDebit.toLocaleString('fr-FR') + ' €</td>'
      + '<td style="text-align:right;color:' + ((totalCredit-totalDebit)>=0?'var(--green)':'var(--red)') + '">' + ((totalCredit-totalDebit)>=0?'+':'') + (totalCredit-totalDebit).toLocaleString('fr-FR') + ' €</td>'
      + '</tr>';
    html += '</tbody></table></div></div>';
  }

  // Mouvements de trésorerie (Banque, Livret A...) — jamais mélangés au compte de
  // résultat ci-dessus : ce sont soit le solde d'ouverture, soit des virements
  // internes entre les propres comptes de l'entité, pas des recettes ni des charges.
  if (mouvementsTresorerie && mouvementsTresorerie.length > 0) {
    html += '<div class="card" style="margin-top:20px;opacity:.85"><h3 style="font-size:14px;font-weight:700;color:var(--text-sec);margin-bottom:4px;padding:14px 14px 0">Mouvements de trésorerie</h3>'
      + '<p style="font-size:11px;color:var(--text-sec);padding:0 14px 10px">Solde d\'ouverture et virements entre comptes de l\'entité (compte courant, Livret A...) — hors compte de résultat, ni recettes ni charges.</p>'
      + '<div class="data-table-wrap"><table class="data-table"><thead><tr><th>Compte</th><th>Libellé</th><th style="text-align:right">Crédit</th><th style="text-align:right">Débit</th><th style="text-align:right">Solde</th></tr></thead><tbody>';
    mouvementsTresorerie.forEach(c => {
      html += '<tr>'
        + '<td style="font-family:monospace;font-weight:700">' + c.compte + '</td>'
        + '<td style="font-size:12px;color:var(--text-sec)">' + (c.libelle||'—') + '</td>'
        + '<td style="text-align:right;color:var(--green)">' + (c.credit>0 ? c.credit.toLocaleString('fr-FR')+' €' : '—') + '</td>'
        + '<td style="text-align:right;color:var(--red)">' + (c.debit>0 ? c.debit.toLocaleString('fr-FR')+' €' : '—') + '</td>'
        + '<td style="text-align:right;font-weight:700">' + (c.solde>=0?'+':'') + c.solde.toLocaleString('fr-FR') + ' €</td>'
        + '</tr>';
    });
    html += '</tbody></table></div></div>';
  }

  content.innerHTML = html;
  window._balanceRows = rows;
  window._balanceDetailCompte = detailCompte;
}

