    + '<button class="btn btn-ghost btn-sm" title="Recalcule Part AMIIS (11% du tarif de vente une fois les frais de déplacement retirés) et Balance (tarif de vente - coût employeur artiste - frais de déplacement - part AMIIS) sur toutes les lignes" onclick="recalculerPartAmiisCompteGroupeUI(\'' + projet.replace(/'/g,"\\'") + '\')">🔄 Recalculer Part AMIIS &amp; Balance</button>'
    + '</div></div>';

  html += '<div class="kpi-grid" style="margin-bottom:16px">'
