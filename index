// compte Google, qui reste géré par Apps Script.
function deconnexionApp() {
  document.getElementById('settings-menu')?.classList.remove('open');
  try {
    localStorage.removeItem('amiis_identite');
    localStorage.removeItem('amiis_identite_entites');
  } catch(e) {}
  // location.reload() ne recharge que le cadre interne du bac à sable Apps
  // Script (page vide) — il faut forcer un rechargement complet de la vraie
  // page via la fenêtre de plus haut niveau. La lecture de window.top.location
  // est bloquée cross-origin, mais l'écriture (navigation) reste autorisée.
  try {
    window.top.location.href = APPS_SCRIPT_URL;
  } catch(e) {
    location.reload();
  }
}

