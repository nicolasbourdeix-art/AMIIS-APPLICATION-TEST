async function loadAllConfig() {
  try {
    const data = await apiGet({ action: 'getAllConfig' });
    _configCache = data;
    const active = document.querySelector('#config-tabs-bar .btn-primary');
    if (active) showConfigTab(active.dataset.tab || 'modules', active);
  } catch(_) {}
}

function showConfigTab(tab, btn) {
  if (btn) {
    document.querySelectorAll('#config-tabs-bar button').forEach(b => { b.className = 'btn btn-ghost'; });
    btn.className = 'btn btn-primary';
    btn.dataset.tab = tab;
  }
  const c = document.getElementById('config-tab-content');
  if (!c) return;
  switch(tab) {
    case 'modules': c.innerHTML = renderConfigModules(); break;
    case 'sheets':
      c.innerHTML = '<div class="loader"><div class="spinner"></div><span>Chargement…</span></div>';
      apiGet({ action: 'getAllConfig' }).then(data => { _configCache = data; c.innerHTML = renderConfigSheets(_configCache); });
      break;
    case 'finance': c.innerHTML = renderConfigFinance(_configCache); break;
