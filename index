/* ============================================================
   API
   ============================================================ */
async function apiGet(params = {}) {
  const url = new URL(APPS_SCRIPT_URL);
  url.searchParams.set('entity', state.currentEntity);
  url.searchParams.set('year',   state.currentYear);
  if (state.user && state.user.email) url.searchParams.set('email', state.user.email);
  Object.entries(params).forEach(([k,v]) => { if (v !== undefined && v !== null) url.searchParams.set(k, v); });
  const resp = await fetch(url.toString());
  if (!resp.ok) throw new Error('HTTP ' + resp.status);
  const data = await _lireReponseJSON(resp);
  if (data && data.error && data.code === 'UNAUTHORIZED') throw new Error('Non autorisé');
  return data;
}
async function apiPost(payload = {}) {
  const body = Object.assign({ entity: state.currentEntity, year: state.currentYear }, payload);
  if (state.user && state.user.email) body.email = state.user.email;
  const resp = await fetch(APPS_SCRIPT_URL, { method: 'POST', headers: { 'Content-Type': 'text/plain' }, body: JSON.stringify(body) });
  if (!resp.ok) throw new Error('HTTP ' + resp.status);
  return _lireReponseJSON(resp);
}

// Le serveur répond parfois avec une page HTML (page d'autorisation Google,
// erreur de déploiement, timeout...) au lieu du JSON attendu — resp.json()
// échoue alors avec un message technique cryptique ("Unexpected token '<'...").
// On détecte ce cas précis pour donner un message compréhensible plutôt que de
// laisser fuiter l'erreur de parsing brute jusqu'à l'utilisateur.
async function _lireReponseJSON(resp) {
  const texte = await resp.text();
  try {
    return JSON.parse(texte);
  } catch(e) {
    if (texte.trim().startsWith('<')) {
      throw new Error('Réponse invalide du serveur (page HTML reçue au lieu de données) — le déploiement Apps Script n\'a peut-être pas totalement pris effet. Réessayez dans un instant ; si ça persiste, vérifiez le déploiement.');
    }
    throw new Error('Réponse du serveur illisible : ' + e.message);
  }
}

