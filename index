}

function calcCompteursPaie(rows, groupeForfaits) {
  groupeForfaits = groupeForfaits || {};
  // Calculs globaux et par gestionnaire
  const stats = { global: { nb:0, total:0, amiis:0, heures:0, heuresPaie:0, heuresProd:0, nbProd:0 } };
  rows.forEach(r => {
    const t = r.tarif || 12;
    const qui = r.qui || 'Non assigné';
    if (!stats[qui]) stats[qui] = { nb:0, total:0, amiis:0, heures:0, heuresPaie:0, heuresProd:0, nbProd:0 };
    stats.global.nb     += 1;
    stats.global.total  += t;
    stats[qui].nb       += 1;
    stats[qui].total    += t;
  });
  // Gestionnaires qui n'ont que des productions (compte groupe), pas de FDP
  Object.keys(groupeForfaits).forEach(g => {
    if (!stats[g]) stats[g] = { nb:0, total:0, amiis:0, heures:0, heuresPaie:0, heuresProd:0, nbProd:0 };
  });
  // Calcul AMIIS (50%) et heures : 5 FDP = 1h (paie) + forfait 3h/production (compte groupe)
  let gHeuresPaie = 0, gHeuresProd = 0, gNbProd = 0;
  Object.keys(stats).forEach(k => {
    if (k === 'global') return;
    stats[k].amiis      = Math.round(stats[k].total * 0.5 * 100) / 100;
    stats[k].heuresPaie = Math.round((stats[k].nb / 5) * 100) / 100;
    const gf = groupeForfaits[k] || { nb:0, heures:0 };
    stats[k].nbProd     = gf.nb || 0;
    stats[k].heuresProd = gf.heures || 0;
    stats[k].heures     = Math.round((stats[k].heuresPaie + stats[k].heuresProd) * 100) / 100;
    stats[k].part        = stats[k].amiis; // part gestionnaire = même que AMIIS
    gHeuresPaie += stats[k].heuresPaie;
    gHeuresProd += stats[k].heuresProd;
    gNbProd     += stats[k].nbProd;
  });
  stats.global.amiis      = Math.round(stats.global.total * 0.5 * 100) / 100;
  stats.global.heuresPaie = Math.round(gHeuresPaie * 100) / 100;
  stats.global.heuresProd = Math.round(gHeuresProd * 100) / 100;
  stats.global.nbProd     = gNbProd;
  stats.global.heures     = Math.round((gHeuresPaie + gHeuresProd) * 100) / 100;
  return stats;
}

