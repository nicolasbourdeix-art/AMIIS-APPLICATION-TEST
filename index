  else           el.classList.toggle('expanded');
}

async function _runSync() {
  const entities = ALL_ENTITIES.filter(e => isEntityVisible(e.code));
  const savedEntity = state.currentEntity;
  const savedYear   = state.currentYear;

  try {
    for (const entity of entities) {
      if (syncState.cancelled) break;

      _expandSyncEntity(entity.code);
      _setEntityStatus(entity.code, 'active', 'En cours…');

      // Vider le cache de cette entité avant de le remplir avec les données fraîches
      window._syncCache[entity.code] = {};

      let entityDone = 0, entityError = 0;
      // NE PAS muter state.currentEntity ici — on passe entity.code directement au fetch

      for (const mod of SYNC_MODULES) {
        if (syncState.cancelled) break;
        _setStepStatus(entity.code, mod.id, 'active', '…');

        try {
          const data = await _fetchSyncWithTimeout(
            { action: mod.action, entity: entity.code, year: savedYear }, 14000
          );
          const rows  = data.rows || data.entries || [];
          window._syncCache[entity.code][mod.id] = {
            rows, fetchedAt: new Date().toISOString(), tab: data.tab || '',
          };
          if (mod.id === 'devis' && data.debugAncien) {
            console.log('[DEVIS ANCIEN — diagnostic]', entity.code, data.debugAncien);
          }
          _setStepStatus(entity.code, mod.id, 'done',
            rows.length > 0 ? rows.length + ' ligne' + (rows.length > 1 ? 's' : '') : 'Vide');
          entityDone++;
        } catch(err) {
          _setStepStatus(entity.code, mod.id, 'error',
            (err.message || 'Erreur').includes('timeout') ? 'Timeout' : 'Erreur');
          entityError++;
          syncState.errors++;
        }

        syncState.done++;
        _setSyncGlobal(
          Math.round(syncState.done / syncState.total * 100),
          entity.code + ' — ' + mod.label
        );
        _setEntityBar(entity.code, Math.round((entityDone + entityError) / SYNC_MODULES.length * 100));
        await new Promise(r => setTimeout(r, 60));
      }

      if (entityError === 0)        _setEntityStatus(entity.code, 'done',  entityDone + ' modules ✓');
      else if (entityDone === 0)    _setEntityStatus(entity.code, 'error', 'Inaccessible');
      else                          _setEntityStatus(entity.code, 'error', entityDone + ' ok · ' + entityError + ' erreur(s)');
    }
  } finally {
    state.currentEntity = savedEntity;
    state.currentYear   = savedYear;
    _finishSync();
  }
}

function _finishSync() {
  syncState.running = false;
  const elapsed = ((Date.now() - syncState.startTime) / 1000).toFixed(1);
  const success  = syncState.done - syncState.errors;

  _setSyncGlobal(100, syncState.errors === 0 ? '✓ Synchronisation terminée' : '⚠ Terminé avec erreurs');
  if (syncState.errors === 0) document.getElementById('sync-global-bar').classList.add('done');

  const closeBtn = document.getElementById('sync-close-btn');
  closeBtn.disabled = false;
  closeBtn.style.opacity = '';

  document.getElementById('sync-header-sub').textContent =
    'Terminé en ' + elapsed + 's — ' + success + '/' + syncState.total + ' modules';

  const entities = ALL_ENTITIES.filter(e => isEntityVisible(e.code));
  const totalRows = entities.reduce((sum, e) => {
    const cache = window._syncCache[e.code] || {};
    return sum + Object.values(cache).reduce((s, m) => s + (m.rows ? m.rows.length : 0), 0);
  }, 0);

  document.getElementById('sync-footer-ts').textContent = new Date().toLocaleTimeString('fr-FR');
  document.getElementById('sync-summary-text').innerHTML =
    '<strong>' + totalRows + '</strong> lignes chargées · '
    + '<strong>' + success + '</strong> requêtes OK'
    + (syncState.errors > 0
      ? ' · <span style="color:var(--red)"><strong>' + syncState.errors + '</strong> erreur(s)</span>'
      : ' · <span style="color:var(--green)">✓ Aucune erreur</span>');
  document.getElementById('sync-footer').style.display = '';

  const btn = document.getElementById('btn-sync-topbar');
  if (btn) {
    btn.classList.remove('syncing');
    btn.title = 'Dernière sync : ' + new Date().toLocaleTimeString('fr-FR') + ' (' + totalRows + ' lignes)';
  }

  toast(
    syncState.errors === 0
      ? '✓ Sync complète — ' + totalRows + ' lignes chargées en ' + elapsed + 's'
      : '⚠ Sync terminée avec ' + syncState.errors + ' erreur(s)',
    syncState.errors === 0 ? 'success' : ''
  );

  // ── Auto-reload du module actif avec les nouvelles données ──
  setTimeout(function() { loadModule(state.currentModule); }, 900);
}

