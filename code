  } catch(e) {
    Logger.log('appendLignesCompta ERREUR: ' + e.message + ' L' + e.lineNumber);
    return { error: true, message: e.message + ' (ligne ' + e.lineNumber + ')' };
  }
  return { success: true, ajoutees: ajoutees };
}


