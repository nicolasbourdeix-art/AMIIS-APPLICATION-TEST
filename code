// Version "tout en un" de updateLigneDevisCLR : écrit TOUS les champs d'une ligne
// en une seule exécution serveur (au lieu d'un aller-retour réseau par champ), pour
// réduire à la fois la latence et le risque d'échec réseau en cours de sauvegarde.
function updateLigneDevisCLRComplete(ss, year, rowIndex, ligne, sourceSheet) {
  var sheet = getDevisClrSheet(ss, year, sourceSheet);
  if (!sheet) return { error: 'Onglet DEVIS introuvable pour CLR ' + year };
  var ri = parseInt(rowIndex, 10);
  if (!ri || ri < 2) return { error: 'rowIndex invalide' };

  try {
    var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    var champsNumeriques = ['montantCession','nbRepresent','fraisHeberg','fraisRest','fraisDeplac','fraisMat','nbHeures','tauxHoraire'];

    function setChamp(nomChamp, valeur) {
      var headerNom = DEVIS_CLR_CHAMP_COLONNE[nomChamp];
      if (!headerNom || valeur === undefined) return;
      var col = findColByHeaderExact(headers, headerNom);
      if (col < 0) return;
      var isNumeric = champsNumeriques.indexOf(nomChamp) >= 0;
      sheet.getRange(ri, col).setValue(isNumeric ? (parseFloat(valeur) || 0) : valeur);
    }

    Object.keys(DEVIS_CLR_CHAMP_COLONNE).forEach(function(champ) {
      if (ligne[champ] !== undefined) setChamp(champ, ligne[champ]);
    });

    return { success: true };
