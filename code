// Mapping prénom → clé colonne CAISSE FILLE
var CAISSE_PRENOM_MAP = {
  'audrey':   'AUDREY',
  'pauline':  'PAULINE',
  'malorie':  'MALORIE',
  'fanny':    'FANNY',
  'thibaud':  'THIBAULT',
  'thibault': 'THIBAULT',
  'nathalie': 'NATHALIE',
  'fred':     null,  // Fred ne figure pas dans CAISSE FILLE
  'cécile':   null,
  'cecile':   null,
  'emmanuelle': null,
  'simon':    null,
};

// Parser "Fanny et Audrey" → ['FANNY', 'AUDREY']
function parserBeneficiairesCaisse(texte) {
  if (!texte) return [];
  var prenoms = texte.toLowerCase()
    .replace(/&/g, ' ')
    .replace(/,/g, ' ')
    .split(/\s+et\s+|\s+,\s+|\s*,\s*/)
    .map(function(s) { return s.trim(); })
    .filter(function(s) { return s.length > 2; });

  var beneficiaires = [];
  prenoms.forEach(function(p) {
    // Garder juste le premier mot (prénom)
    var prenom = p.split(/\s+/)[0].toLowerCase();
    var col = CAISSE_PRENOM_MAP[prenom];
    if (col && beneficiaires.indexOf(col) < 0) {
      beneficiaires.push(col);
    }
  });
  return beneficiaires;
}

// Charger la table CODE COMPTA → map spectacle → bénéficiaires
function getCodeComptaCaisseMap(ss) {
  var sheet = ss.getSheetByName('CODE COMPTA');
  if (!sheet) return {};
  var data  = sheet.getDataRange().getValues();
  var map   = {};
  // Col 0 = spectacle, Col 14 = Nom d'usage, Col 15 = Personnes caisses perso
  for (var i = 1; i < data.length; i++) {
    var row         = data[i];
    var spectacle   = (row[0]  || '').toString().trim();
    var nomUsage    = (row[14] || '').toString().trim();
    var benefTxt    = (row[15] || '').toString().trim();
    var fctAdmin    = parseFloat(row[2]) || 0;  // col C = impots/FCT
    var benefList   = parserBeneficiairesCaisse(benefTxt);
    if (spectacle) {
      map[spectacle.toLowerCase()] = { beneficiaires: benefList, fctAdmin: fctAdmin, nomUsage: nomUsage, texte: benefTxt };
      if (nomUsage) map[nomUsage.toLowerCase()] = { beneficiaires: benefList, fctAdmin: fctAdmin, nomUsage: nomUsage, texte: benefTxt };
    }
  }
  return map;
}

// Coût employeur (comptes 64x + 421) déjà enregistré en compta pour un spectacle
// donné, tous exercices confondus — sert de base de déduction pour la répartition
// automatique des caisses perso au moment où une recette est importée (cf.
// appendLignesCompta), pour ne pas prendre 20% du montant brut de la recette mais
// bien 20% de ce qui reste une fois les cachets/charges sociales déjà connus
// déduits. Reste imparfait si les salaires de ce spectacle n'ont pas encore été
// saisis en compta au moment où la recette arrive (le coût est alors sous-estimé
// pour cette répartition automatique précise) — accepté comme limite connue.
function getCoutEmployeurSpectacle(ss, spectacle) {
  var cle = normaliserNomProjet((spectacle || '').toString().trim(), ss);
  if (!cle) return 0;
  var donnees = calculerRecetteEtCoutParSpectacle(ss); // tous exercices confondus
  return (donnees[cle] || {}).coutEmployeur || 0;
}

// Scanne l'onglet COMPTA une seule fois pour calculer, par spectacle, la recette
// (comptes 7xx) et le coût employeur (comptes 64x/421) déjà enregistrés — SOURCE
// UNIQUE de "combien est réellement rentré pour ce spectacle", réutilisée par
// Balance, Facturation, Suivi projets et Caisses perso (répartition auto +
// vérification) pour qu'elles s'accordent enfin sur la même définition de
// "reçu" et le même regroupement par spectacle (normaliserNomProjet partout,
// au lieu d'une normalisation ad-hoc différente dans chaque module).
// year optionnel : si fourni, ne compte que les lignes de cet exercice (une
// ligne sans "Année exercice" renseignée n'est jamais exclue, comme ailleurs
// dans l'app) ; omis, prend tous les exercices confondus.
function calculerRecetteEtCoutParSpectacle(ss, year) {
  var resultat = {}; // clé normaliserNomProjet -> { label, recette, coutEmployeur }
  var sheet = ss.getSheetByName('COMPTA');
  if (!sheet) return resultat;
  var lastRow = sheet.getLastRow(), lastCol = sheet.getLastColumn();
  if (lastRow < 3 || lastCol < 1) return resultat;

  var headerRow = null, headerRowIdx = 1;
  for (var hi = 1; hi <= Math.min(3, lastRow); hi++) {
    var candidate = sheet.getRange(hi, 1, 1, lastCol).getValues()[0];
    var textCount = candidate.filter(function(v) { return v && typeof v === 'string' && v.trim().length > 2 && v !== '#REF!'; }).length;
    if (textCount >= 3) { headerRow = candidate; headerRowIdx = hi; break; }
  }
  if (!headerRow) return resultat;

  var idx = {};
  headerRow.forEach(function(h, i) { if (h && h !== '#REF!' && h.toString().trim()) idx[h.toString().trim()] = i; });
  function findIdx() {
    for (var a = 0; a < arguments.length; a++) { if (idx[arguments[a]] !== undefined) return idx[arguments[a]]; }
    return undefined;
  }
  var iSpec   = findIdx('Spectacle');
  var iCpt    = findIdx('Numéro comptable');
  var iCredit = findIdx('Produits (Entrées)', 'CREDIT ');
  var iDebit  = findIdx('Charges (Sorties)', 'DEBIT');
  var iAnnee  = findIdx('Année exercice', 'année exercice');
  if (iSpec === undefined || iCpt === undefined) return resultat;

  var yearStr = year ? String(year) : null;
  function anneeCorrespond(val) {
    if (!yearStr) return true; // aucun filtre demandé
    if (val === null || val === '' || val === undefined) return true; // pas de tag -> ne pas exclure
    var v = val.toString().trim().replace(/^EX\s*/i, '');
    return v === yearStr || v === yearStr.slice(2);
  }

  var dataStart = headerRowIdx + 1;
  if (lastRow < dataStart) return resultat;
  var data = sheet.getRange(dataStart, 1, lastRow - headerRowIdx, lastCol).getValues();
  data.forEach(function(row) {
    if (iAnnee !== undefined && !anneeCorrespond(row[iAnnee])) return;
    var specRaw = (row[iSpec] || '').toString().trim();
    var cle = normaliserNomProjet(specRaw, ss);
    if (!cle) return;
    var compte = (row[iCpt] || '').toString().replace(/\./g, '');
    if (!resultat[cle]) resultat[cle] = { label: cle, recette: 0, coutEmployeur: 0 };
    if (compte.startsWith('7') && iCredit !== undefined) resultat[cle].recette += parseFloat(row[iCredit]) || 0;
    if ((compte.startsWith('64') || compte.startsWith('421')) && iDebit !== undefined) resultat[cle].coutEmployeur += parseFloat(row[iDebit]) || 0;
  });
  return resultat;
}

// Rapport de vérification : pour chaque spectacle, compare ce qui DEVRAIT être en
// caisse (recette − FCT/ADMIN/DIFF − coût employeur réel, × pourcentage caisse) à
// ce qui est ACTUELLEMENT écrit dans CAISSE FILLE — pour repérer et corriger les
// montants écrits avec l'ancienne formule (qui ne déduisait jamais le coût
// employeur, cf. repartirCaisse) via le bouton de correction manuelle du front.
function verifierCaissesParSpectacle(ss, entity) {
  var cfg   = getConfigMap(ss);
  var pct   = parseFloat(cfg['PERCENT_CAISSES_PERSO']) || 20;
  var fct   = parseFloat(cfg['FCT_MONTANT'])   || 58;
  var admin = parseFloat(cfg['ADMIN_MONTANT']) || 85;
  var diff  = parseFloat(cfg['DIFF_MONTANT'])  || 85;

  var donneesCompta = calculerRecetteEtCoutParSpectacle(ss);
  var codeMap        = getCodeComptaCaisseMap(ss);

  var PERSONNES        = ['AUDREY','PAULINE','MALORIE','FANNY','THIBAULT','NATHALIE'];
  var iEntreePersonnes = [4,5,6,7,8,9];
  var tabName     = getCaisseTabName(ss);
  var sheetCaisse = ss.getSheetByName(tabName);
  var actuelParSpectacle = {}; // clé -> { label, total, parPersonne: {AUDREY: x, ...} }
  if (sheetCaisse) {
    var allData = sheetCaisse.getDataRange().getValues();
    for (var i = 1; i < allData.length; i++) {
      var spec = (allData[i][0] || '').toString().trim();
      if (!spec || spec.toLowerCase().indexOf('somme') >= 0 || spec === 'BALANCE') continue;
      var cle = normaliserNomProjet(spec, ss);
      if (!cle) continue;
      if (!actuelParSpectacle[cle]) actuelParSpectacle[cle] = { label: cle, total: 0, parPersonne: {} };
      PERSONNES.forEach(function(p, pi) {
        var v = parseFloat(allData[i][iEntreePersonnes[pi]]) || 0;
        if (v) {
          actuelParSpectacle[cle].total += v;
          actuelParSpectacle[cle].parPersonne[p] = (actuelParSpectacle[cle].parPersonne[p] || 0) + v;
        }
      });
    }
  }

  var toutesLesCles = {};
  Object.keys(donneesCompta).forEach(function(c) { toutesLesCles[c] = true; });
  Object.keys(actuelParSpectacle).forEach(function(c) { toutesLesCles[c] = true; });

  var resultats = [];
  Object.keys(toutesLesCles).forEach(function(cle) {
    var compta  = donneesCompta[cle] || { label: '', recette: 0, coutEmployeur: 0 };
    var actuel  = actuelParSpectacle[cle] || { label: '', total: 0, parPersonne: {} };
    var label   = actuel.label || compta.label || cle;
    var apresCharges = compta.recette - compta.coutEmployeur - fct - admin - diff;
    var attendu = apresCharges > 0 ? Math.round(apresCharges * pct / 100 * 100) / 100 : 0;
    var actuelTotal = Math.round(actuel.total * 100) / 100;
    var ecart = Math.round((attendu - actuelTotal) * 100) / 100;
    if (compta.recette === 0 && actuelTotal === 0) return; // rien à comparer
    // getCodeComptaCaisseMap indexe par nom en minuscules brutes (pas
    // normaliserNomProjet) — reconvertir la clé pour cette recherche précise.
    var beneficiaires = (codeMap[cle.toLowerCase()] || {}).beneficiaires || [];
    var attenduParPersonne = beneficiaires.length > 0 ? Math.round(attendu / beneficiaires.length * 100) / 100 : attendu;
    resultats.push({
      spectacle: label,
      recette: Math.round(compta.recette * 100) / 100,
      coutEmployeur: Math.round(compta.coutEmployeur * 100) / 100,
      attendu: attendu,
      actuel: actuelTotal,
      ecart: ecart,
      beneficiaires: beneficiaires,
      attenduParPersonne: attenduParPersonne,
      parPersonneActuel: actuel.parPersonne,
    });
  });
  resultats.sort(function(a, b) { return Math.abs(b.ecart) - Math.abs(a.ecart); });
  return { success: true, resultats: resultats, pct: pct, fct: fct, admin: admin, diff: diff };
}

// Calculer et écrire la répartition caisse pour une facture
function repartirCaisse(ss, entity, spectacle, montantFacture, coutEmployeur, fctAmount, adminAmount, diffAmount, pctCaisse) {
  var cfg       = getConfigMap(ss);
  var pct       = pctCaisse || parseFloat(cfg['PERCENT_CAISSES_PERSO']) || 20;
  var fct       = fctAmount   !== undefined ? fctAmount   : parseFloat(cfg['FCT_MONTANT'])   || 58;
  var admin     = adminAmount !== undefined ? adminAmount : parseFloat(cfg['ADMIN_MONTANT'])  || 85;
  var diff      = diffAmount  !== undefined ? diffAmount  : parseFloat(cfg['DIFF_MONTANT'])   || 85;

  // Calcul
  var apresCharges = montantFacture - (coutEmployeur || 0) - fct - admin - diff;
  if (apresCharges <= 0) {
    Logger.log('repartirCaisse: bénéfice nul après charges (' + apresCharges + ')');
    return { success: true, montantCaisse: 0, repartition: {} };
  }
  var montantCaisse = apresCharges * (pct / 100);

  // Trouver les bénéficiaires
  var codeMap    = getCodeComptaCaisseMap(ss);
  var specKey    = (spectacle || '').toLowerCase();
  var specInfo   = codeMap[specKey] || {};
  var benefList  = specInfo.beneficiaires || [];

  if (benefList.length === 0) {
    Logger.log('repartirCaisse: pas de bénéficiaires pour ' + spectacle);
    return { success: true, montantCaisse: montantCaisse, repartition: {}, warning: 'Pas de bénéficiaires configurés' };
  }

  var partChacun = montantCaisse / benefList.length;
  var repartition = {};
  benefList.forEach(function(p) { repartition[p] = partChacun; });

  // Écrire dans CAISSE FILLE
  var tabName   = getCaisseTabName(ss);
  var sheet     = ss.getSheetByName(tabName);
  if (!sheet) return { error: 'CAISSE FILLE introuvable' };

  var headers   = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  var PERSONNES = ['AUDREY','PAULINE','MALORIE','FANNY','THIBAULT','NATHALIE'];

  // Chercher si une ligne existe déjà pour ce spectacle (col 0)
  var allData   = sheet.getDataRange().getValues();
  var rowIdx    = -1;
  for (var i = 1; i < allData.length; i++) {
    if (allData[i][0] && allData[i][0].toString().toLowerCase() === specKey) {
      rowIdx = i + 1; // 1-indexed
      break;
    }
  }

  // Colonnes ENTREE (4-9 = AUDREY..NATHALIE côté entrée)
  var iEntreePersonnes = [4,5,6,7,8,9];

  if (rowIdx > 0) {
    // Ajouter au solde existant
    var existingRow = allData[rowIdx - 1];
    PERSONNES.forEach(function(p, pi) {
      var col    = iEntreePersonnes[pi];
      var ancien = parseFloat(existingRow[col]) || 0;
      var ajout  = repartition[p] || 0;
      if (ajout > 0) {
        sheet.getRange(rowIdx, col + 1).setValue(ancien + ajout);
      }
    });
    Logger.log('repartirCaisse: mis à jour ligne ' + rowIdx + ' pour ' + spectacle);
  } else {
    // Chercher une ligne vide avant "somme caisse entrée"
    var insertRow = -1;
    for (var j = 1; j < allData.length; j++) {
      if (allData[j][0] && allData[j][0].toString().includes('somme')) {
        insertRow = j + 1; // insérer avant les totaux
        break;
      }
    }
    if (insertRow < 0) insertRow = allData.length + 1;

    // Construire la nouvelle ligne
    var newRow = new Array(headers.length).fill('');
    newRow[0] = spectacle;
    PERSONNES.forEach(function(p, pi) {
      var ajout = repartition[p] || 0;
      if (ajout > 0) newRow[iEntreePersonnes[pi]] = ajout;
    });
    sheet.insertRowBefore(insertRow);
    sheet.getRange(insertRow, 1, 1, newRow.length).setValues([newRow]);
    Logger.log('repartirCaisse: nouvelle ligne insérée pour ' + spectacle);
  }

  return {
    success:       true,
    montantCaisse: montantCaisse,
    apresCharges:  apresCharges,
    partChacun:    partChacun,
    beneficiaires: benefList,
    repartition:   repartition,
  };
}

// Corrige directement le montant "Entrée" d'un porteur pour un spectacle donné
// dans CAISSE FILLE — nécessaire pour rattraper à la main les montants écrits par
// erreur avant le correctif du coût employeur dans la répartition automatique
// (aucune autre façon de les modifier n'existait dans l'interface).
function corrigerEntreeCaisse(ss, spectacle, porteur, montant) {
  var tabName = getCaisseTabName(ss);
  var sheet   = ss.getSheetByName(tabName);
  if (!sheet) return { error: 'Onglet ' + tabName + ' introuvable' };

  var PERSONNES        = ['AUDREY','PAULINE','MALORIE','FANNY','THIBAULT','NATHALIE'];
  var iEntreePersonnes = [4,5,6,7,8,9];
  var colIdx = PERSONNES.indexOf((porteur||'').toString().toUpperCase());
  if (colIdx < 0) return { error: 'Porteur inconnu: ' + porteur };

  var specKey = (spectacle||'').toString().trim().toLowerCase();
  if (!specKey) return { error: 'Spectacle requis' };

  var allData = sheet.getDataRange().getValues();
  var rowIdx = -1;
  for (var i = 1; i < allData.length; i++) {
    if (allData[i][0] && allData[i][0].toString().trim().toLowerCase() === specKey) { rowIdx = i + 1; break; }
  }
  if (rowIdx < 0) return { error: 'Ligne "' + spectacle + '" introuvable dans ' + tabName };

  var nouveauMontant = parseFloat(montant);
  if (isNaN(nouveauMontant) || nouveauMontant < 0) return { error: 'Montant invalide' };

  sheet.getRange(rowIdx, iEntreePersonnes[colIdx] + 1).setValue(nouveauMontant);
  Logger.log('corrigerEntreeCaisse: ' + porteur + ' / ' + spectacle + ' -> ' + nouveauMontant + '€ (ligne ' + rowIdx + ')');
  return { success: true, porteur: porteur, spectacle: spectacle, montant: nouveauMontant };
}

// Déduire un montant d'une caisse perso (NDF ou DPAE)
function deduireCaisse(ss, entity, porteur, montant, spectacle, intitule, date, type) {
  var tabName  = getCaisseTabName(ss);
  var sheet    = ss.getSheetByName(tabName);
  if (!sheet) return { error: 'CAISSE FILLE introuvable' };

  var PERSONNES        = ['AUDREY','PAULINE','MALORIE','FANNY','THIBAULT','NATHALIE'];
  var iSortiePersonnes = [14,15,16,17,18,19];
  var iSortieDate      = 12;
  var iSortieIntitule  = 13;

  var porteurUpper = porteur.toUpperCase();
  var colIdx       = PERSONNES.indexOf(porteurUpper);
  if (colIdx < 0) return { error: 'Porteur inconnu: ' + porteur };

  // Chercher la ligne du spectacle côté SORTIE
  var allData = sheet.getDataRange().getValues();
  var rowIdx  = -1;
  for (var i = 1; i < allData.length; i++) {
    if (allData[i][0] && allData[i][0].toString().toLowerCase() === (spectacle||'').toLowerCase()) {
      // Vérifier si la cellule sortie est vide (date vide)
      if (!allData[i][iSortieDate]) {
        rowIdx = i + 1;
        break;
      }
    }
  }

  if (rowIdx > 0) {
    // Ajouter à la sortie existante
    var existingSortie = parseFloat(allData[rowIdx-1][iSortiePersonnes[colIdx]]) || 0;
    sheet.getRange(rowIdx, iSortieDate + 1).setValue(date);
    sheet.getRange(rowIdx, iSortieIntitule + 1).setValue(intitule + ' (' + type + ')');
    sheet.getRange(rowIdx, iSortiePersonnes[colIdx] + 1).setValue(existingSortie + montant);
  } else {
    // Nouvelle ligne de sortie
    var newRow = new Array(sheet.getLastColumn()).fill('');
    newRow[0]                          = spectacle || 'GENERAL';
    newRow[iSortieDate]                = date;
    newRow[iSortieIntitule]            = intitule + ' (' + type + ')';
    newRow[iSortiePersonnes[colIdx]]   = montant;
    // Insérer avant les totaux
    var insertAt = allData.length;
    for (var j = 1; j < allData.length; j++) {
      if (allData[j][11] && allData[j][11].toString().includes('somme')) {
        insertAt = j + 1; break;
      }
    }
    sheet.insertRowBefore(insertAt);
    sheet.getRange(insertAt, 1, 1, newRow.length).setValues([newRow]);
  }

  Logger.log('deduireCaisse: ' + porteur + ' -' + montant + '€ pour ' + spectacle + ' (' + type + ')');
  return { success: true, porteur: porteur, montant: montant, spectacle: spectacle };
}

