function enrichirAvecFDP(ss, rows) {
  var fdpByRow = {};
  var sheetsToRead = ['Contrats', 'DPAE V2', 'DECLA', 'DAPE', 'DPAE 2025', 'DPAE_CLR', 'Réponses au formulaire 1'];

  for (var s = 0; s < sheetsToRead.length; s++) {
    var sheetName = sheetsToRead[s];
    var sheet     = ss.getSheetByName(sheetName);
    if (!sheet) continue;
    var lastCol = sheet.getLastColumn();
    var headers = sheet.getRange(1, 1, 1, lastCol).getValues()[0];
    var colFDP = -1, colFDPSt = -1, colFDPCand = -1;
    for (var h = 0; h < headers.length; h++) {
      var hh = headers[h].toString().trim();
      if (hh === 'Fiche de paie')  colFDP     = h;
      if (hh === 'FDP_Statut')     colFDPSt   = h;
      if (hh === 'FDP_Candidats')  colFDPCand = h;
    }
    if (colFDP === -1 && colFDPSt === -1) continue;
    var lastRow = sheet.getLastRow();
    if (lastRow < 2) continue;
    var data = sheet.getRange(2, 1, lastRow - 1, lastCol).getValues();
    for (var i = 0; i < data.length; i++) {
      var rowIndex = i + 2;
      var key = sheetName + '_' + rowIndex;
      fdpByRow[key] = {
        fdpUrl:       colFDP     !== -1 ? (data[i][colFDP]     || '').toString().trim() : '',
        fdpStatut:    colFDPSt   !== -1 ? (data[i][colFDPSt]   || '').toString().trim() : '',
        fdpCandidats: colFDPCand !== -1 ? (data[i][colFDPCand] || '').toString().trim() : '',
      };
    }
  }

  var result = [];
  for (var j = 0; j < rows.length; j++) {
    var r = rows[j];
    if (!r || !r._rowIndex) { result.push(r); continue; }
    var sourceSheet = r._sourceSheet || '';
    var fdp = sourceSheet ? (fdpByRow[sourceSheet + '_' + r._rowIndex] || null) : null;
    if (!fdp) {
      fdp = fdpByRow['Contrats_'    + r._rowIndex]
         || fdpByRow['DPAE V2_'     + r._rowIndex]
         || fdpByRow['DECLA_'       + r._rowIndex]
         || fdpByRow['DAPE_'        + r._rowIndex]
         || fdpByRow['DPAE_CLR_'    + r._rowIndex]
         || null;
    }
    if (!fdp) { result.push(r); continue; }
    var enriched = {};
    for (var k in r) { enriched[k] = r[k]; }
    enriched.fdpUrl       = fdp.fdpUrl;
    enriched.fdpStatut    = fdp.fdpStatut;
    enriched.fdpCandidats = fdp.fdpCandidats;
    result.push(enriched);
  }
  return result;
}

