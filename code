// Codes bruts (en minuscule) réellement utilisés comme valeur de la colonne
// "Spectacle" en COMPTA — sert à valider qu'un candidat code-court/nom-complet
// trouvé dans CODE COMPTA est bien une table de PROJETS, et pas une autre table
// qui a la même forme (code court -> texte plus long) mais un tout autre usage,
// comme le mapping salarié (ex: chez DIS, "BAU" -> "BAUDOIN MOSCA Arthur Jeremy").
function getCodesProjetsUtilisesReellement(ss) {
  var codes = {};
  try {
    var sheet = ss.getSheetByName('COMPTA');
    if (!sheet) return codes;
    var lastRow = sheet.getLastRow(), lastCol = sheet.getLastColumn();
    if (lastRow < 3) return codes;
    var headerRow = null, headerRowIdx = 1;
    for (var hi = 1; hi <= Math.min(3, lastRow); hi++) {
      var candidate = sheet.getRange(hi, 1, 1, lastCol).getValues()[0];
      var textCount = candidate.filter(function(v) { return v && typeof v === 'string' && v.trim().length > 2 && v !== '#REF!'; }).length;
      if (textCount >= 3) { headerRow = candidate; headerRowIdx = hi; break; }
    }
    if (!headerRow) return codes;
    var iSpec = headerRow.findIndex(function(h) { return h && h.toString().trim() === 'Spectacle'; });
    if (iSpec < 0) return codes;
    var data = sheet.getRange(headerRowIdx + 1, iSpec + 1, lastRow - headerRowIdx, 1).getValues();
    data.forEach(function(r) {
      var v = (r[0] || '').toString().trim();
      if (v) codes[v.toLowerCase()] = true;
    });
  } catch(e) { Logger.log('getCodesProjetsUtilisesReellement erreur: ' + e.message); }
  return codes;
}

// Cache mémoire (durée d'une seule exécution du script) de la correspondance
// code court -> nom complet des PROJETS déclarée dans CODE COMPTA, par classeur
// — évite de relire les onglets à chaque appel de normaliserNomProjet, alors
// qu'un même traitement (ex: getSuiviProjet) l'appelle des dizaines de fois.
//
// La position de cette table diffère d'une entité à l'autre (colonnes G/H chez
// certaines, D/E chez DIS) et CODE COMPTA n'a pas toujours d'en-têtes pour la
// repérer par leur nom (aucun chez DIS) — impossible donc de se fier à une
// position ou un intitulé fixes. On teste plusieurs positions connues et on ne
// retient un candidat que si son code apparaît réellement comme valeur de la
// colonne "Spectacle" en COMPTA : ça élimine les faux positifs d'une position
// utilisée pour autre chose chez cette entité (ex: G/H = mapping salarié chez
// DIS, dont les codes comme "BAU" n'apparaissent jamais dans une cellule
// Spectacle) sans avoir besoin de connaître la disposition à l'avance.
var _cacheCodeProjetVersNom = {};
function getMapCodeProjetVersNom(ss) {
  if (!ss) return {};
  var id = ss.getId();
  if (_cacheCodeProjetVersNom[id]) return _cacheCodeProjetVersNom[id];
  var map = {};
  try {
    var sheet = ss.getSheetByName('CODE COMPTA');
    if (sheet) {
      var lastCol = Math.max(10, sheet.getLastColumn());
      var lastRow = sheet.getLastRow();
      var data = sheet.getRange(2, 1, Math.max(1, lastRow - 1), lastCol).getValues();
      var usages = getCodesProjetsUtilisesReellement(ss);
      // Positions candidates (index 0-based) : [6,7]=G/H (format historique),
      // [3,4]=D/E (format observé chez DIS).
      [[6, 7], [3, 4]].forEach(function(pair) {
        var ic = pair[0], il = pair[1];
        data.forEach(function(row) {
          var code  = (row[ic] || '').toString().trim();
          var label = (row[il] || '').toString().trim();
          var cle = code.toLowerCase();
          if (code && usages[cle] && !map[cle]) map[cle] = label || code;
        });
      });
    }
  } catch(e) { Logger.log('getMapCodeProjetVersNom erreur: ' + e.message); }
  _cacheCodeProjetVersNom[id] = map;
  return map;
}

// Table CODE COMPTA, colonnes H/I (index 7/8) — mapping salarié distinct de la
// table projets ci-dessus (voir commentaire de getMapCodeProjetVersNom), ex.
// chez DIS : "BAU" -> "BAUDOIN MOSCA Arthur Jeremy", "VIL" -> "VILLANUEVA
// Diane". Sert à résoudre un prénom seul (ex: "Diane") vers le nom complet
// réel : chez DIS, le champ "Pour qui est fait la déclaration ?" des
// déclarations DPAE V2 ne contient QUE le prénom (pas "NOM Prénom"), alors que
// les noms de fichiers de contrats signés dans Drive sont abrégés à partir du
// NOM DE FAMILLE ("VIL", "PEN", "LAG"...) — sans cette résolution, le
// classement automatique des contrats signés (classerContratsSigne) ne peut
// jamais matcher puisqu'il ne compare que les initiales du prénom. Comme pour
// trouverMatricule, on ne résout QUE si le prénom est sans ambiguïté dans la
// table (homonymes, ex: deux "Julie" différentes chez DIS) — sinon on préfère
// ne rien résoudre plutôt que risquer d'attribuer le mauvais nom.
var _cachePrenomVersNomComplet = {};
function getMapPrenomVersNomComplet(ss) {
  if (!ss) return {};
  var id = ss.getId();
  if (_cachePrenomVersNomComplet[id]) return _cachePrenomVersNomComplet[id];
  var parPrenom = {};
  try {
    var sheet = ss.getSheetByName('CODE COMPTA');
    if (sheet) {
      var lastRow = sheet.getLastRow();
      var lastCol = Math.max(10, sheet.getLastColumn());
      if (lastRow >= 2) {
        var data = sheet.getRange(2, 1, lastRow - 1, lastCol).getValues();
        data.forEach(function(row) {
          var code  = (row[7] || '').toString().trim();
          var label = (row[8] || '').toString().trim();
          if (!code || !label) return;
          var np = _separerNomPrenom(label);
          if (!np.prenom) return;
          var clePrenom = _normaliserNomPersonne(np.prenom);
          if (!clePrenom) return;
          if (parPrenom[clePrenom] === undefined) parPrenom[clePrenom] = label;
          else if (parPrenom[clePrenom] !== label) parPrenom[clePrenom] = null; // homonyme -> ambigu, ne rien résoudre
        });
      }
    }
  } catch(e) { Logger.log('getMapPrenomVersNomComplet erreur: ' + e.message); }
  _cachePrenomVersNomComplet[id] = parPrenom;
  return parPrenom;
}

// Résout "salarie" vers son nom complet si c'est un prénom seul (pas de nom de
// famille détecté par _separerNomPrenom), en essayant d'abord la liste des
// Salariés importée (SALARIES_PAIE, export réel sPAIEctacle — la plus
// complète en pratique), puis CODE COMPTA en repli (table tenue à la main,
// souvent partielle). Ne résout que si le prénom est sans ambiguïté dans la
// table utilisée — sinon renvoie salarie tel quel plutôt que de deviner.
function resoudreNomCompletDepuisPrenom(ss, salarie, entity) {
  var brut = (salarie || '').toString().trim();
  if (!brut) return brut;
  if (_separerNomPrenom(brut).prenom) return brut; // déjà "NOM Prénom"
  var cle = _normaliserNomPersonne(brut);
  if (entity) {
    var viaSalariesPaie = getMapPrenomVersNomSalariesPaie(entity)[cle];
    if (viaSalariesPaie) return viaSalariesPaie;
  }
  if (ss) {
    var viaCodeCompta = getMapPrenomVersNomComplet(ss)[cle];
    if (viaCodeCompta) return viaCodeCompta;
  }
  return brut;
}

// ss (optionnel) : quand fourni, résout d'abord les variantes de nommage
// observées en pratique dans les cellules "Spectacle"/"Projet" — un code court
// seul ("Vel", "Aucoeu") ou le format composé "code ( Nom complet )" parfois
// saisi tel quel — vers le nom complet officiel déclaré dans CODE COMPTA (cf.
// getMapCodeProjetVersNom, code court -> nom complet). Sans cette résolution, un même
// projet se dispersait en plusieurs fiches distinctes dans Suivi projets,
// Facturation, Balance et Caisses perso ("Vel", "Vel ( Velue)" et "VELUE"
// formaient 3 lignes séparées au lieu d'une seule).
function normaliserNomProjet(nom, ss) {
  if (!nom) return '';
  var s = nom.toString().trim();

  if (ss) {
    var mapCode = getMapCodeProjetVersNom(ss);
    var mParen = s.match(/^(.+?)\s*\(\s*(.+?)\s*\)\s*$/);
    if (mParen) {
      // Le préfixe avant la parenthèse est presque toujours le code court —
      // c'est la clé la plus fiable du plan ; à défaut, le texte entre
      // parenthèses (généralement déjà le nom complet) sert de repli.
      var codePrefix = mParen[1].trim().toLowerCase();
      s = mapCode[codePrefix] || mParen[2].trim();
    } else if (mapCode[s.toLowerCase()]) {
      s = mapCode[s.toLowerCase()];
    }
  }

  // Normaliser la casse : première lettre de chaque mot en majuscule
  // sauf les articles/prépositions courts
  var STOPS = {'de':1,'du':1,'des':1,'le':1,'la':1,'les':1,'l':1,'au':1,'aux':1,'et':1,'en':1,'un':1,'une':1,'sur':1,'sous':1,'par':1,'pour':1,'avec':1,'dans':1};
  return s.toLowerCase().split(/\s+/).map(function(mot, i) {
    if (i === 0 || !STOPS[mot]) return mot.charAt(0).toUpperCase() + mot.slice(1);
    return mot;
  }).join(' ');
}

function getSuiviProjet(ss, entity, year) {
  var projets = {};
  // Map nom normalisé -> nom canonique (premier vu)
  var nomCanonique = {};

  function getOrCreate(nom) {
    var key = normaliserNomProjet((nom || '').toString().trim(), ss);
    if (!key) return null;
    // Mémoriser le premier nom vu comme nom canonique
    if (!nomCanonique[key]) nomCanonique[key] = (nom || '').toString().trim();
    if (!projets[key]) {
      projets[key] = {
        nom: key,
        // Devis
        devis: [],
        recettePrevue:   0, // cession + médiation prévisionnelle
        recetteReelle:   0, // factures encaissées
        cachetPrevi:     0,
        servicePrevi:    0,
        techPrevi:       0,
        recetteFraisDevis: 0, // frais renseignés dans les devis (héberg./restau./déplac./matériel), refacturés au client
        // DPAE réelles
        cachetsReels:    0,
        servicesReels:   0,
        nbDeclarations:  0,
        // Comptabilité
        chargesSal:      0, // 641/645/421
        chargesNDF:      0, // 625/606
        chargesAutres:   0,
        // NDF
        ndfMontant:      0,
        ndfCount:        0,
        // Calculé
        totalCharges:    0,
        resultat:        0,
      };
    }
    return projets[key];
  }

  // ── 1. DEVIS ─────────────────────────────────────────────────────────
  var devisTab = resolveTabName('DEVIS V', year, entity);
  if (devisTab) {
    var devisRaw = getTab(ss, devisTab);
    if (!devisRaw.error) {
      // Extraire hyperliens
      var hlDevis = {};
      try {
        var sheet   = ss.getSheetByName(devisTab);
        var headers = sheet.getRange(1,1,1,sheet.getLastColumn()).getValues()[0];
        var lastRow = sheet.getLastRow();
        if (lastRow >= 2) {
          [{ nom:'lien ', cle:'urlRecap' },{ nom:'contrat ', cle:'urlContrat' },{ nom:'contrat', cle:'urlContrat' }]
            .forEach(function(col) {
              var colIdx = headers.findIndex(function(h) { return h.toString().trim() === col.nom.trim(); });
              if (colIdx === -1) return;
              var rich = sheet.getRange(2, colIdx+1, lastRow-1, 1).getRichTextValues();
              rich.forEach(function(cellArr, i) {
                var cell = cellArr[0]; if (!cell) return;
                var runs = cell.getRuns();
                for (var r=0; r<runs.length; r++) {
                  var link = runs[r].getLinkUrl();
                  if (link) { var ri=i+2; if(!hlDevis[ri]) hlDevis[ri]={}; if(!hlDevis[ri][col.cle]) hlDevis[ri][col.cle]=link; break; }
                }
              });
            });
        }
      } catch(e) { Logger.log('getSuiviProjet hyperliens: '+e.message); }

      devisRaw.rows.forEach(function(r) {
        var d = normalizeRow(r, 'DEVIS', entity);
        if (!d || !d.spectacle) return;
        // Filtrer par année (comme les sections DPAE/Comptabilité) : si une date de
        // début est renseignée et qu'elle ne correspond pas à l'année sélectionnée,
        // on ignore ce devis — sinon un devis d'une autre année (ex: 2024) polluait
        // systématiquement la vue, quelle que soit l'année choisie dans le filtre.
        if (year && d.dateDebut) {
          var dDate = parserDateFR(d.dateDebut);
          if (dDate && dDate.getFullYear() !== parseInt(year, 10)) return;
        }
        var p = getOrCreate(d.spectacle);
        if (!p) return;
        var hl = hlDevis[r._rowIndex] || {};
        d.pdfRecap   = hl['urlRecap']   || '';
        d.pdfContrat = hl['urlContrat'] || '';
        p.devis.push(d);
        // Frais du devis (hébergement/restauration/déplacement/matériel) refacturés au
        // client : c'est du chiffre d'affaires, pas une charge — on les ajoute à la
        // recette prévue, même si le devis ne génère pas de cession/médiation par ailleurs.
        var fraisDevis = (d.fraisHeberg || 0) + (d.fraisRest || 0) + (d.fraisDeplac || 0) + (d.fraisMat || 0);
        p.recettePrevue += (d.montantPrincipal || d.montantHT || 0) + fraisDevis;
        p.recetteFraisDevis = (p.recetteFraisDevis || 0) + fraisDevis;
        p.cachetPrevi   += d.cachetPrevi  || 0;
        p.servicePrevi  += d.servicePrevi || 0;
        p.techPrevi     += d.techPrevi    || 0;
      });
    }
  }

  // ── 2. COMPTA (recettes réelles = crédits 7xx rapprochés en banque) ──
  // Remplace l'ancienne source (statut "Payée" saisi à la main dans l'onglet
  // Facturation, qui pouvait rester non coché indéfiniment même après paiement
  // effectif — cf. le bug "reste à facturer" corrigé plus tôt) par la même
  // fonction et la même clé de regroupement (normaliserNomProjet) que Balance,
  // Facturation et Caisses perso, pour que ces vues s'accordent enfin entre
  // elles sur ce qui compte comme "reçu".
  try {
    var recettesComptaProjet = calculerRecetteEtCoutParSpectacle(ss, year);
    Object.keys(recettesComptaProjet).forEach(function(cle) {
      if (cle === 'General') return; // lignes compta sans spectacle réel affecté
      var p = getOrCreate(cle); // cle est déjà au format normaliserNomProjet
      if (!p) return;
      p.recetteReelle += recettesComptaProjet[cle].recette || 0;
    });
  } catch(eRecComp) { Logger.log('getSuiviProjet recettesComptaProjet erreur: ' + eRecComp.message); }

  // ── 3. DPAE / DÉCLARATIONS (cachets réels) ───────────────────────────
  var declaTab = resolveTabName('DECLA', year, entity);
  var ongletsDPAE = [declaTab];
  if (entity === 'CLR') ongletsDPAE.push('DPAE_CLR');

  ongletsDPAE.forEach(function(tabName) {
    if (!tabName) return;
    var raw = getTab(ss, tabName);
    if (raw.error) return;
    raw.rows.forEach(function(r) {
      var d = normalizeRow(r, 'DECLA', entity);
      if (!d || !d.projet) return;
      // Filtre année
      if (d.debut) {
        var parts = d.debut.split('/');
        if (parts.length === 3 && parseInt(parts[2]) !== year) return;
      }
      // Pour CLR/DPAE_CLR : seulement les validées
      if (tabName === 'DPAE_CLR') {
        if (r['DPAE_OK'] !== true && r['DPAE_OK'] !== 'TRUE' && r['DPAE_OK'] !== 'OUI') return;
      }
      var p = getOrCreate(d.projet);
      if (!p) return;
      p.cachetsReels  += parseInt(d.cachets   || 0) || 0;
      p.servicesReels += parseInt(d.services4h || 0) || 0;
      p.nbDeclarations++;
    });
  });

  // ── 4. COMPTABILITÉ (charges réelles validées) ───────────────────────
  var compta = getComptaRows(ss, entity, year, null);
  if (!compta.error) {
    compta.rows.forEach(function(r) {
      var compte = (r.COMPTE || '').toString();
      var debit  = parseFloat(r.DEBIT)  || 0;

      // ── Ligne principale avec spectacle renseigné ──
      var spectacle = (r.SPECTACLE || '').trim();
      if (spectacle && spectacle !== 'GENERAL') {
        var p = getOrCreate(spectacle);
        if (p) {
          if (compte.startsWith('64') || compte.startsWith('421')) p.chargesSal   += debit;
          else if (compte.startsWith('625') || compte.startsWith('606')) p.chargesNDF += debit;
          else if (debit > 0 && compte.startsWith('6')) p.chargesAutres += debit;
        }
      }

      // ── Ventilations EMPLOYEUR par spectacle (lignes 421 ventilées) ──
      // Ces ventilations contiennent le coût employeur réel ventilé par spectacle
      if (r._ventilations && r._ventilations.length > 0) {
        r._ventilations.forEach(function(v) {
          var vSpec = (v.spectacle || '').trim();
          var vCout = parseFloat(v.coutEmp) || 0;
          if (!vSpec || vSpec === 'GENERAL' || vCout === 0) return;
          var pv = getOrCreate(vSpec);
          if (!pv) return;
          pv.chargesSal += vCout; // coût employeur ventilé par projet
        });
      }
    });
  }

  // ── 5. NOTES DE FRAIS par projet ─────────────────────────────────────
  var ndfTab = resolveTabName('NOTE DE FRAIS V', year, entity);
  if (ndfTab) {
    var ndfRaw = getTab(ss, ndfTab);
    if (!ndfRaw.error) {
      ndfRaw.rows.forEach(function(r) {
        var n = normalizeRow(r, 'NDF', entity);
        if (!n || !n.spectacle || n.statut !== 'Traitee') return;
        var p = getOrCreate(n.spectacle);
        if (!p) return;
        p.ndfMontant += n.montant || 0;
        p.ndfCount++;
      });
    }
  }

  // ── 6. Calcul résultat ───────────────────────────────────────────────
  var result = Object.values(projets).map(function(p) {
    p.chargesSal    = Math.round(p.chargesSal    * 100) / 100;
    p.chargesNDF    = Math.round(p.chargesNDF    * 100) / 100;
    p.chargesAutres = Math.round(p.chargesAutres * 100) / 100;
    p.ndfMontant    = Math.round(p.ndfMontant    * 100) / 100;
    p.recetteFraisDevis = Math.round((p.recetteFraisDevis || 0) * 100) / 100;
    p.recettePrevue = Math.round(p.recettePrevue * 100) / 100;
    p.recetteReelle = Math.round(p.recetteReelle * 100) / 100;
    // Total charges = compta validée (inclut NDF via 625) ou NDF si compta vide
    p.totalCharges  = Math.round((p.chargesSal + p.chargesNDF + p.chargesAutres || p.ndfMontant) * 100) / 100;
    p.resultat      = Math.round((p.recetteReelle - p.totalCharges) * 100) / 100;
    p.tauxCouverture = p.totalCharges > 0 ? Math.round(p.recetteReelle / p.totalCharges * 100) : null;
    // Écarts prévi/réel
    p.ecartCachets  = p.cachetsReels  - p.cachetPrevi;
    p.ecartServices = p.servicesReels - p.servicePrevi;
    return p;
  });

  // Utiliser le nom canonique dans chaque projet
  Object.keys(projets).forEach(function(key) {
    if (nomCanonique[key]) projets[key].nom = nomCanonique[key];
  });

  // Trier : projets actifs en premier (avec devis), puis par recette prévue
  result.sort(function(a, b) {
    var aActif = a.devis.length > 0 ? 1 : 0;
    var bActif = b.devis.length > 0 ? 1 : 0;
    if (aActif !== bActif) return bActif - aActif;
    return b.recettePrevue - a.recettePrevue;
  });

  return { success: true, year, entity, projets: result };
}

// Suivi projets agrégé sur TOUS les exercices : appelle getSuiviProjet pour chaque
// année disponible (détectée via les onglets datés du Sheet) et fusionne les projets
// par nom normalisé — additionne recettes, charges, cachets, résultats, etc. Réutilise
// entièrement la logique par année (aucun recalcul réécrit), on ne fait qu'agréger.
function getSuiviProjetTousExercices(ss, entity) {
  // Années à balayer : celles détectées dans les onglets + une petite plage de
  // sécurité autour de l'année courante (certaines entités n'ont pas d'onglet
  // "…AAAA" mais un onglet fixe type "Contrats" partagé, où les lignes portent
  // leur propre année de date — getSuiviProjet(year) les filtre alors par date).
  var anneesSet = {};
  try {
    (getAvailableYears(ss).years || []).forEach(function(y) { anneesSet[y] = true; });
  } catch(_) {}
  var courante = new Date().getFullYear();
  for (var y = courante - 5; y <= courante + 1; y++) anneesSet[y] = true;
  var annees = Object.keys(anneesSet).map(function(a) { return parseInt(a, 10); })
    .filter(function(a) { return a >= 2000 && a <= 2100; })
    .sort();

  // Même normalisation de nom que getSuiviProjet, pour fusionner un projet présent
  // sur plusieurs exercices sous une seule ligne.
  function cleNom(nom) { return normaliserNomProjet((nom || '').toString().trim(), ss); }

  var fusion = {};        // clé normalisée -> projet agrégé
  var nomCanonique = {};  // clé -> premier nom lisible rencontré
  var anneesTraitees = [];

  annees.forEach(function(an) {
    var res;
    try { res = getSuiviProjet(ss, entity, an); }
    catch(e) { Logger.log('getSuiviProjetTousExercices ' + an + ': ' + e.message); return; }
    if (!res || !res.success || !res.projets) return;
    anneesTraitees.push(an);

    res.projets.forEach(function(p) {
      var key = cleNom(p.nom);
      if (!key) return;
      if (!nomCanonique[key]) nomCanonique[key] = p.nom;
      if (!fusion[key]) {
        fusion[key] = {
          nom: nomCanonique[key],
          devis: [],
          recettePrevue: 0, recetteReelle: 0, recetteFraisDevis: 0,
          cachetPrevi: 0, servicePrevi: 0, techPrevi: 0,
          cachetsReels: 0, servicesReels: 0, nbDeclarations: 0,
          chargesSal: 0, chargesNDF: 0, chargesAutres: 0,
          ndfMontant: 0, ndfCount: 0,
          totalCharges: 0, resultat: 0,
          _exercices: [],
        };
      }
      var f = fusion[key];
      // Additionner les montants et compteurs.
      f.recettePrevue     += p.recettePrevue     || 0;
      f.recetteReelle     += p.recetteReelle     || 0;
      f.recetteFraisDevis += p.recetteFraisDevis || 0;
      f.cachetPrevi       += p.cachetPrevi       || 0;
      f.servicePrevi      += p.servicePrevi      || 0;
      f.techPrevi         += p.techPrevi         || 0;
      f.cachetsReels      += p.cachetsReels      || 0;
      f.servicesReels     += p.servicesReels     || 0;
      f.nbDeclarations    += p.nbDeclarations    || 0;
      f.chargesSal        += p.chargesSal        || 0;
      f.chargesNDF        += p.chargesNDF        || 0;
      f.chargesAutres     += p.chargesAutres     || 0;
      f.ndfMontant        += p.ndfMontant        || 0;
      f.ndfCount          += p.ndfCount          || 0;
      // Concaténer les devis (chaque devis garde son année via ses dates).
      if (p.devis && p.devis.length) f.devis = f.devis.concat(p.devis);
      if (f._exercices.indexOf(an) < 0) f._exercices.push(an);
    });
  });

  // Recalculer les totaux dérivés sur les montants cumulés.
  var result = Object.keys(fusion).map(function(key) {
    var p = fusion[key];
    p.chargesSal        = Math.round(p.chargesSal        * 100) / 100;
    p.chargesNDF        = Math.round(p.chargesNDF        * 100) / 100;
    p.chargesAutres     = Math.round(p.chargesAutres     * 100) / 100;
    p.ndfMontant        = Math.round(p.ndfMontant        * 100) / 100;
    p.recetteFraisDevis = Math.round(p.recetteFraisDevis * 100) / 100;
    p.recettePrevue     = Math.round(p.recettePrevue     * 100) / 100;
    p.recetteReelle     = Math.round(p.recetteReelle     * 100) / 100;
    p.totalCharges  = Math.round((p.chargesSal + p.chargesNDF + p.chargesAutres || p.ndfMontant) * 100) / 100;
    p.resultat      = Math.round((p.recetteReelle - p.totalCharges) * 100) / 100;
    p.tauxCouverture = p.totalCharges > 0 ? Math.round(p.recetteReelle / p.totalCharges * 100) : null;
    p.ecartCachets  = p.cachetsReels  - p.cachetPrevi;
    p.ecartServices = p.servicesReels - p.servicePrevi;
    return p;
  });

  result.sort(function(a, b) {
    var aActif = a.devis.length > 0 ? 1 : 0;
    var bActif = b.devis.length > 0 ? 1 : 0;
    if (aActif !== bActif) return bActif - aActif;
    return b.recettePrevue - a.recettePrevue;
  });

  return { success: true, year: 'tous', entity: entity, projets: result, exercices: anneesTraitees };
}

