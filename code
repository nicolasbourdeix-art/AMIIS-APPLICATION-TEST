const CODES_HEADERS = ['CODE','NOM','ROLE','COMPAGNIES','DATE_CREATION','ACTIF'];

function ensureCodesTab(ss) {
  let sheet = ss.getSheetByName('CODES_ACCES');
  if (sheet) return sheet;
  sheet = ss.insertSheet('CODES_ACCES');
  sheet.getRange(1, 1, 1, CODES_HEADERS.length).setValues([CODES_HEADERS]).setFontWeight('bold').setBackground('#555555').setFontColor('#ffffff');
  sheet.setFrozenRows(1);
  return sheet;
}

function findCode(ss, code) {
  const sheet = ss.getSheetByName('CODES_ACCES');
  if (!sheet) return null;
  const data    = sheet.getDataRange().getValues();
  const headers = data[0];
  for (let i = 1; i < data.length; i++) {
    const row = {};
    headers.forEach((h, j) => { row[h] = data[i][j]; });
    if (row['CODE'] === code && row['ACTIF'] !== false && row['ACTIF'] !== 'NON') {
      return { code: row['CODE'], nom: row['NOM'], role: (row['ROLE']||'').toLowerCase(), compagnies: row['COMPAGNIES']||'', dateCreation: row['DATE_CREATION'] };
    }
  }
  return null;
}

function getCodes(ss) { ensureCodesTab(ss); return getTab(ss, 'CODES_ACCES'); }

function genererCodeAcces(ss, nom, role, compagnies) {
  if (!nom || !role) return { error: 'Nom et role requis' };
  if (!['porteur','diffuseur'].includes(role.toLowerCase())) return { error: 'Role invalide' };
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
  let code = '';
  for (let i = 0; i < 8; i++) code += chars[Math.floor(Math.random() * chars.length)];
  ensureCodesTab(ss);
  const sheet = ss.getSheetByName('CODES_ACCES');
  sheet.appendRow(CODES_HEADERS.map(h => {
    switch(h) {
      case 'CODE':          return code;
      case 'NOM':           return nom;
      case 'ROLE':          return role.toLowerCase();
      case 'COMPAGNIES':    return (compagnies||[]).join(',');
      case 'DATE_CREATION': return new Date().toISOString().split('T')[0];
      case 'ACTIF':         return 'OUI';
      default:              return '';
    }
  }));
  return { success: true, code, nom, role, compagnies };
}

function revoquerCodeAcces(ss, code) {
  if (!code) return { error: 'Code requis' };
  const sheet = ss.getSheetByName('CODES_ACCES');
  if (!sheet) return { error: 'Onglet CODES_ACCES introuvable' };
  const data     = sheet.getDataRange().getValues();
  const headers  = data[0];
  const codeCol  = headers.indexOf('CODE');
  const actifCol = headers.indexOf('ACTIF');
  for (let i = 1; i < data.length; i++) {
    if (data[i][codeCol] === code) { sheet.getRange(i + 1, actifCol + 1).setValue('NON'); return { success: true, code }; }
  }
  return { error: 'Code non trouve : ' + code };
}

