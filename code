// Vérifie, pour un salarié + projet donné, si le formulaire DAPE correspondant a
// bien la case "Caisse perso" = "Oui", et retourne alors le nom indiqué dans
// "Caisse (nom)" (la personne à débiter — peut différer du salarié lui-même).
// Retourne null si aucune ligne DAPE ne correspond, ou si "Caisse perso" n'est
// pas "Oui" : dans ce cas, AUCUNE déduction ne doit être faite.
function chercherAutorisationCaisseDAPE(ss, entity, year, prenomSalarie, spectacle) {
  try {
    var tabName = resolveTabName('DECLA', year, entity);
    if (!tabName) return null;
    var raw = getTab(ss, tabName);
    if (raw.error) return null;

    var prenomCle = (prenomSalarie || '').toString().trim().toUpperCase();
    var specCle   = (spectacle || '').toString().trim().toLowerCase();

    var matches = raw.rows.filter(function(r) {
      var sal = (r['Salarié'] || '').toString().trim().toUpperCase();
      var proj = (r['Projet'] || '').toString().trim().toLowerCase();
      return sal === prenomCle && (specCle === '' || proj === specCle || proj.indexOf(specCle) >= 0 || specCle.indexOf(proj) >= 0);
    });

    for (var i = 0; i < matches.length; i++) {
      var caissePerso = (matches[i]['Caisse perso'] || '').toString().trim().toLowerCase();
      if (caissePerso === 'oui') {
        var nomCaisse = (matches[i]['Caisse (nom)'] || '').toString().trim();
        return nomCaisse || prenomSalarie; // par défaut, la personne elle-même si le nom n'est pas précisé
      }
    }
    return null;
  } catch(e) {
    Logger.log('chercherAutorisationCaisseDAPE erreur: ' + e.message);
    return null;
  }
}

