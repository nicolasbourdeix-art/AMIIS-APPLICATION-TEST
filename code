function updateRowField(ss, tabName, rowIndex, colName, value) {
  const sheet = ss.getSheetByName(tabName);
  if (!sheet) return { error: 'TAB_NOT_FOUND', tab: tabName };
  const headers  = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  const colIndex = headers.indexOf(colName);
  if (colIndex === -1) return { error: 'COL_NOT_FOUND', col: colName };
  sheet.getRange(rowIndex, colIndex + 1).setValue(value);
  return { success: true, tab: tabName, rowIndex, colName, value };
}

function updateConfig(ss, key, value) {
  ensureConfigTab(ss);
  const sheet = ss.getSheetByName('CONFIG');
  const data  = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (data[i][0] === key) { sheet.getRange(i + 1, 2).setValue(value); return { success: true, key, value }; }
  }
  sheet.appendRow([key, value, '']);
  return { success: true, key, value, created: true };
}

function validerDSN(ss, year, mois, dateEnvoi) {
  return updateConfig(ss, 'DSN_' + year + '_' + String(mois).padStart(2, '0'), dateEnvoi || new Date().toISOString().split('T')[0]);
}

function validerDPAE(ss, tabName, rowIndex, dateEnvoi) {
  const date = dateEnvoi || new Date().toISOString().split('T')[0];
  updateRowField(ss, tabName, rowIndex, 'DPAE_ENVOYEE', 'OUI');
  updateRowField(ss, tabName, rowIndex, 'DPAE_DATE', date);
  return { success: true, dpaeDate: date };
}

function marquerFacturePaye(ss, entity, tabName, rowIndex, year) {
  const r = updateRowField(ss, tabName, rowIndex, 'STATUT', 'Payée');
  if (!r.success) return r;
  const sheet   = ss.getSheetByName(tabName);
  const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  const rowData = sheet.getRange(rowIndex, 1, 1, headers.length).getValues()[0];
  const ligne   = {};
  headers.forEach((h, i) => { ligne[h] = rowData[i]; });
  const caisse = calculerCaisse(ss, ligne);
  return { success: true, rowIndex, caisse };
}

function calculerCaisse(ss, factLigne) {
  const cfg      = getConfigMap(ss);
  const prixHT   = parseFloat(factLigne['MONTANT_HT']) || 0;
  const benefice = prixHT - (parseFloat(cfg['CHARGES_FIXES_COMPAGNIE']) || 58)
                           - (parseFloat(cfg['CHARGES_FIXES_ADMIN'])      || 85)
                           - (parseFloat(cfg['CHARGES_FIXES_DIFFUSION'])  || 85)
                           - (parseFloat(factLigne['COUT_EMPLOYEUR_REEL']) || 0)
                           - (parseFloat(factLigne['FRAIS_DEPLACEMENT'])   || 0);
  const pct = parseFloat(cfg['PERCENT_CAISSES_PERSO']) || 20;
  return { prixHT, benefice, pct, montantCaisses: benefice * (pct / 100) };
}

function genererVirementGroupe(ss, entity, year, mois, email) {
  const tabName = resolveTabName('NOTE DE FRAIS V', year, entity);
  if (!tabName) return { success: false, msg: 'Pas de NDF pour ' + entity };
  const data = getTab(ss, tabName);
  if (data.error) return data;
  const m = String(mois).padStart(2, '0');
  const lignes = [];
  data.rows.forEach(row => {
    if (row['STATUT'] !== 'Traitée' || !row['DATE']) return;
    const d = new Date(row['DATE']);
    if (String(d.getFullYear()) !== String(year) || String(d.getMonth()+1).padStart(2,'0') !== m) return;
    lignes.push({ salarie: row['SALARIE'] || '', iban: row['IBAN'] || '', montant: parseFloat(row['MONTANT']) || 0, objet: row['OBJET'] || '' });
  });
  if (lignes.length === 0) return { success: false, msg: 'Aucune NDF traitee pour cette periode' };
  const csv = [['Salarie','IBAN','Montant','Objet'].join(';'), ...lignes.map(l => [l.salarie, l.iban, l.montant.toFixed(2), l.objet].join(';'))].join('\n');
  return { success: true, nbLignes: lignes.length, csv };
}

// Colonnes de l'onglet VIREMENTS NDF (créé au besoin) — un lot = un virement
// groupé qui va rembourser plusieurs NDF d'un coup ; le total et la liste des
// NDF concernées sont enregistrés pour permettre le rapprochement automatique
// une fois que le débit correspondant apparaît dans le relevé bancaire importé
// (cf. rapprochementLotsVirementNDF, appelé depuis appendLignesCompta).
var COLONNES_VIREMENTS_NDF = ['LOT_ID', 'DATE_CREATION', 'MONTANT_TOTAL', 'NB_NDF', 'DETAIL_JSON', 'STATUT', 'DATE_RAPPROCHEMENT'];

function ensureVirementsNdfTab(ss) {
  var sheet = ss.getSheetByName('VIREMENTS NDF');
  if (!sheet) {
    sheet = ss.insertSheet('VIREMENTS NDF');
    sheet.getRange(1, 1, 1, COLONNES_VIREMENTS_NDF.length).setValues([COLONNES_VIREMENTS_NDF]);
  }
  return sheet;
}

// Crée un lot "en attente de rapprochement" au moment où un virement groupé de
// remboursement de NDF est généré (bouton "💸 Virement groupé", NDF à
// rembourser hors carte entreprise). Le débit correspondant, quand il arrivera
// dans un futur import de relevé, sera rapproché automatiquement par montant
// total + date (cf. rapprochementLotsVirementNDF).
function creerLotVirementNDF(ss, entity, payload) {
  var ndfIds = payload.ndfIds || [];
  if (ndfIds.length === 0) return { error: 'Aucune NDF à lier au lot' };
  var montantTotal = Math.round((parseFloat(payload.montantTotal) || 0) * 100) / 100;
  if (montantTotal <= 0) return { error: 'Montant total invalide' };
  var sheet = ensureVirementsNdfTab(ss);
  var now = new Date();
  var lotId = 'VIR-NDF-' + Utilities.formatDate(now, 'Europe/Paris', 'yyyyMMddHHmmss');
  var detailJson = JSON.stringify({ entity: entity, ndfIds: ndfIds });
  sheet.appendRow([lotId, now, montantTotal, ndfIds.length, detailJson, 'En attente rapprochement', '']);
  Logger.log('creerLotVirementNDF: ' + lotId + ' — ' + ndfIds.length + ' NDF — ' + montantTotal + '€');
  return { success: true, lotId: lotId };
}

// Charge les lots "en attente" pour une entité donnée (STATUT non "Rapproché").
function chargerLotsVirementNDFEnAttente(ss, entity) {
  var sheet = ss.getSheetByName('VIREMENTS NDF');
  if (!sheet) return [];
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return [];
  var data = sheet.getRange(2, 1, lastRow - 1, COLONNES_VIREMENTS_NDF.length).getValues();
  var lots = [];
  data.forEach(function(row, i) {
    var statut = (row[5] || '').toString().trim();
    if (statut === 'Rapproché') return;
    var detail = {};
    try { detail = JSON.parse(row[4] || '{}'); } catch(e) { return; }
    if ((detail.entity || '') !== entity) return;
    lots.push({
      _rowIndex: i + 2,
      lotId: row[0],
      dateCreation: row[1] instanceof Date ? row[1] : null,
      montantTotal: parseFloat(row[2]) || 0,
      nbNdf: parseInt(row[3]) || 0,
      ndfIds: detail.ndfIds || [],
    });
  });
  return lots;
}

// Marque un lot comme rapproché (appelé au moment où le débit correspondant
// est effectivement importé/validé dans la compta, pas juste prévisualisé).
function marquerLotVirementNDFRapproche(ss, lotRowIndex, dateRapprochement) {
  var sheet = ss.getSheetByName('VIREMENTS NDF');
  if (!sheet) return;
  sheet.getRange(lotRowIndex, 6).setValue('Rapproché'); // STATUT
  sheet.getRange(lotRowIndex, 7).setValue(dateRapprochement || new Date()); // DATE_RAPPROCHEMENT
}

