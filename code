      'CAISSE':          'CAISSE FILLE',
      'DPAE':            'DPAE_CLR',
      'DECLA':           'DECLA',
      'NOTE DE FRAIS V': 'NOTE DE FRAIS V2',
      'DEVIS V':         'DEVIS V' + y,
      'FACTURATION':     'FACTURATION',
      'BALANCE':         'BALANCE',
    },
    'PALM': {
      'DPAE':            'Contrats',      // nouvelles DPAE → Contrats
      'DPAE_LEGACY':     'DECLA',         // anciennes déclarations
      'DECLA':           'DECLA',
      'CONTRATS':        'Contrats',
      'NOTE DE FRAIS V': 'NOTE DE FRAIS V2',
      'DEVIS V':         '',
      'FACTURATION':     'FACTURATION',
      'BALANCE':         'BALANCE',
    },
    'MAN': {
      'DPAE':            'Contrats',      // nouvelles DPAE → Contrats
      'DPAE_LEGACY':     'DAPE',          // anciennes déclarations
      'DECLA':           'DAPE',
      'CONTRATS':        'Contrats',
      'NOTE DE FRAIS V': '',
      'DEVIS V':         'Contrats',
      'FACTURATION':     'BA',
      'BALANCE':         'BALANCE',
    },
    'OM': {
      'DPAE':            'DPAE 2025',     // OM garde son onglet actuel
      'DPAE_LEGACY':     '',
      'DECLA':           'DPAE 2025',
      'NOTE DE FRAIS V': '',
      'DEVIS V':         'CONTRAT 2',
      'FACTURATION':     'BA',
      'BALANCE':         'BALANCE',
    },
    'DIS': {
      'DPAE':            'Contrats',      // nouvelles DPAE → Contrats
      'DPAE_LEGACY':     'DPAE V2',       // anciennes déclarations
      'DECLA':           'DPAE V2',
      'CONTRATS':        'Contrats',
      'NOTE DE FRAIS V': 'NOTE DE FRAIS V2',
      'DEVIS V':         'Contrats',
      'FACTURATION':     'BA',
      'BALANCE':         'BALANCE',
    },
    'AMIIS': {
      'DPAE':            'Réponses au formulaire 1',
      'DECLA':           'Réponses au formulaire 1',
      'NOTE DE FRAIS V': '',
      'DEVIS V':         'Contrats',
      'FACTURATION':     'BA',
      'BALANCE':         'BALANCE',
    },
  };

  const entityMap = TAB_MAP[entity] || TAB_MAP['CLR'];
  const resolved  = entityMap[base];
  if (resolved !== undefined) return resolved;
  if (base === 'DEVIS V') return base + y;
  if (base === 'NOTE DE FRAIS V') return base + y;
  return base;
}

// =============================================================================
// NORMALIZE ROW
// =============================================================================

function extraireJours(val) {
  if (!val) return '';
  const s = val.toString().trim();
  if (!s) return '';
  if (/^[\d,\s]+$/.test(s)) return s.replace(/\s*,\s*/g, ', ').trim();
  if (s.includes('T') && s.includes('-')) {
    try { const d = new Date(s); if (!isNaN(d.getTime())) return String(d.getDate()); } catch(_) {}
  }
  if (/^\d{2}\/\d{2}\/\d{4}$/.test(s)) return s.split('/')[0].replace(/^0/, '');
  if (s.includes(',')) {
    const jours = s.split(',').map(part => {
      const p = part.trim();
      if (/^\d+$/.test(p)) return p;
      try { const d = new Date(p); if (!isNaN(d.getTime())) return String(d.getDate()); } catch(_) {}
      return p;
    }).filter(Boolean);
    return jours.join(', ');
  }
  return s;
}

function parseFR(val) {
  if (val === null || val === undefined || val === '') return 0;
  return parseFloat(String(val).replace(/[€\s\u00a0]/g, '').replace(',', '.')) || 0;
}

function fmtDate(val) {
  if (!val) return '';
  try {
    if (val instanceof Date) {
      if (isNaN(val.getTime())) return '';
      return String(val.getDate()).padStart(2,'0') + '/' + String(val.getMonth()+1).padStart(2,'0') + '/' + val.getFullYear();
    }
    const d = new Date(val);
    if (isNaN(d.getTime())) return String(val);
    return d.toLocaleDateString('fr-FR');
  } catch(_) { return String(val); }
}

// Extrait les URL de lien réelles (HYPERLINK() ou puce/smart chip fichier Drive)
// d'une colonne — getValues() ne renvoie jamais que le texte affiché (ex: le nom
// du fichier), jamais l'URL sous-jacente ; il faut passer par getRichTextValues()
// pour la récupérer. Retourne { rowIndex(1-based, incl. en-tête) : url }.
function extraireLiensColonne(sheet, headers, nomColonne, startRow) {
  var liens = {};
  if (!sheet || !headers) return liens;
  var colIdx = headers.findIndex(function(h) { return (h || '').toString().trim() === nomColonne; });
  if (colIdx === -1) return liens;
  startRow = startRow || 2;
  var lastRow = sheet.getLastRow();
  if (lastRow < startRow) return liens;
  try {
    var richValues = sheet.getRange(startRow, colIdx + 1, lastRow - startRow + 1, 1).getRichTextValues();
    richValues.forEach(function(cellArr, i) {
      var cell = cellArr[0];
      if (!cell) return;
      var runs = cell.getRuns();
      for (var r = 0; r < runs.length; r++) {
        var link = runs[r].getLinkUrl();
        if (link) { liens[i + startRow] = link; break; }
      }
    });
  } catch(e) { Logger.log('extraireLiensColonne erreur (' + nomColonne + '): ' + e.message); }
  return liens;
}

// Parse les colonnes texte "Detail montants" / "Services" du format Contrats
// (ex: "Cachet : 160€ × 3", "T1 : 160€ × 1 | T2 : 130€ × 2", "60€ × 4
// service(s) 4h") en valeurs numériques exploitables. Factorisé pour être
// réutilisé par normalizeRow (déclarations) et getPaieProduction (Paie AMIIS).
function _parserMontantsContrat(detailMontants, servicesStr) {
  detailMontants = (detailMontants || '').toString();
  servicesStr    = (servicesStr    || '').toString();

  var cachets = 0, montantCachet = 0;
  var cachetDetails = []; // [{montant, qte, label}]
  if (detailMontants) {
    var segments = detailMontants.split('|');
    segments.forEach(function(seg) {
      seg = seg.trim();
      // Format "Label : 160€ × 3"
      var m1 = seg.match(/([\d]+)\s*€\s*×\s*([\d]+)/);
      if (m1) {
        var mt = parseInt(m1[1]), qt = parseInt(m1[2]);
        cachets += qt;
        if (!montantCachet) montantCachet = mt;
        cachetDetails.push({ montant: mt, qte: qt, label: seg.split(':')[0].trim() });
        return;
      }
      // Format "Identique : 130€ — journée" → 1 unité, pas de cachet incrémenté
      var m2 = seg.match(/([\d]+)\s*€/);
      if (m2 && !seg.includes('×')) {
        var mt2 = parseInt(m2[1]);
        if (!montantCachet) montantCachet = mt2;
        cachetDetails.push({ montant: mt2, qte: 1, label: seg.split(':')[0].trim() });
      }
    });
  }

  // Parser services 4h : "60€ × 4 service(s) 4h" → services4h=4, montantService=60
  var services4h = 0, montantService = 0;
  var mSrv = servicesStr.match(/([\d]+)\s*€?\s*×\s*(\d+)/) ||
             servicesStr.match(/(\d+)\s*service/i);
  if (mSrv) {
    if (mSrv[2]) { montantService = parseInt(mSrv[1]); services4h = parseInt(mSrv[2]); }
    else          { services4h = parseInt(mSrv[1]); }
  }
  // Fallback : si pas de ×, essayer parseInt direct (ancien format)
  if (services4h === 0 && !servicesStr.includes('€')) {
    services4h = parseInt(servicesStr) || 0;
  }

  return { cachets: cachets, montantCachet: montantCachet, cachetDetails: cachetDetails, services4h: services4h, montantService: montantService };
}

function normalizeRow(row, tabBase, entity, lienDirect) {
  entity = (entity || '').toUpperCase();

  if (tabBase === 'DECLA' || tabBase === 'DPAE') {
    const col0 = Object.values(row).filter(v => v !== row._rowIndex)[0];
    if (col0 && typeof col0 === 'string' && /^[a-z]{3,4}-\d{2}$/i.test(col0.trim())) return null;

    if (row['Référence'] !== undefined) {
      const debut = fmtDate(row['Date début']);
      if (!debut) return null;
      return {
        _rowIndex: row._rowIndex, id: row['Référence'] || row._rowIndex,
        salarie: (row['Salarié'] || '').toString().trim(),
        nomComplet: (row['Salarié'] || '').toString().trim(),
        fonction: (row['Fonction'] || '').toString().trim(),
        projet: (row['Projet'] || '').toString().trim(),
        debut, fin: fmtDate(row['Date fin']),
        cachets: parseInt(row['Nb cachets'] || 0) || 0,
        services4h: parseInt(row['Nb services 4h'] || 0) || 0,
        joursTravailles: extraireJours(row['Jours travaillés'] || ''),
        commentaire: (row['Commentaire'] || '').toString().trim(),
        paieOK: false, contratSigne: false, dpaeEnvoyee: true, envoyee: true,
      };
    }

    const isPalmDis = row['Pour qui est fait la déclaration ? '] !== undefined
                   || row['Pour qui est fait la déclaration ?']  !== undefined;
    if (isPalmDis) {
      const salarie = (row['Pour qui est fait la déclaration ? '] || row['Pour qui est fait la déclaration ?'] || '').toString().trim();
      if (!salarie) return null;
      const debut = fmtDate(row['Date début du contrat '] || row['Date début du contrat'] || '');
      if (!debut) return null;
      let cachets = 0, services4h = 0, joursTravailles = '';
      const isPALM = entity === 'PALM' || (row['CACHET'] !== undefined && row['Volume horaire jour ? '] === undefined);
      if (isPALM) {
        for (let i = 1; i <= 5; i++) { if (row[i + '-Montant du cachet '] && parseFloat(row[i + '-Montant du cachet ']) > 0) cachets++; }
        Object.keys(row).forEach(h => { if (h.trim() === 'Montant du service ' && row[h] && parseFloat(row[h]) > 0) services4h++; });
        const joursArr = [];
        for (let i = 1; i <= 5; i++) {
          const d = row[i + '-Date du cachet '];
          if (d) { try { const dt = new Date(d); if (!isNaN(dt.getTime())) joursArr.push(dt.getDate()); } catch(_) {} }
        }
        joursTravailles = joursArr.filter(Boolean).join(', ');
      } else {
        const nbJours   = parseInt(row['Nombre de jours '] || 0) || 0;
        const nbCachets = parseInt(row['Nombre de cachet '] || 0) || 0;
        const nbSR      = parseInt(row['Nombre de service '] || 0) || parseInt(row['Nombre de service __2'] || 0) || 0;
        const montantSR = parseFloat(row['Montant Service 4h '] || 0) || parseFloat(row['Montant Service 4h __2'] || 0) || 0;
        if (nbJours > 0) { cachets = nbJours; services4h = 0; }
        else if (nbCachets > 0 || nbSR > 0 || montantSR > 0) { cachets = nbCachets; services4h = nbSR || (montantSR > 0 ? 1 : 0); }
        else {
          const joursServices = [];
          for (let i = 1; i <= 15; i++) {
            const val = row[i + '-Montant du service '];
            if (val && parseFloat(val) > 0) {
              services4h++;
              const d = row[i + '-date du service ? '];
              if (d) { try { const dt = new Date(d); if (!isNaN(dt.getTime())) joursServices.push(dt.getDate()); } catch(_) {} }
            }
          }
          if (joursServices.length > 0) joursTravailles = joursServices.join(', ');
        }
        if (!joursTravailles) joursTravailles = extraireJours(row['Jours déclaré. '] || row['Date des jours travaillés '] || '');
      }
      return {
        _rowIndex: row._rowIndex, id: row._rowIndex, salarie,
        nomComplet: (row['Nom complet'] || row['Nom et Prénom'] || row['NOM PRENOM'] || salarie).toString().trim(),
        fonction: (row['Fonction a déclarer '] || row['Fonction a déclarer'] || '').toString().trim(),
        projet: (row['Projet '] || row['Projet'] || '').toString().trim(),
        debut, fin: fmtDate(row['Date de Fin '] || row['Date de Fin'] || ''),
        cachets, services4h, joursTravailles,
        // Formulaire "Avez vous des défraiements non soumis a déclarer ?" /
        // "Montant" / "Nombres de defraiements" (DIS legacy "DPAE V2") — absent
        // chez PALM, row['Montant'] est alors simplement vide.
        defraiement: parseFR(row['Montant'] || 0),
        nbDefraiements: parseInt(row['Nombres de defraiements'] || 0) || 0,
        commentaire: (row['commentaires / remarques '] || row['Commentaire '] || '').toString().trim(),
        paieOK: row['PAIES'] === true, contratSigne: !!(row['CONTRAT SIGNEE']),
        dpaeEnvoyee: row['DPAE'] === true, envoyee: row['DPAE'] === true,
      };
    }

    const salarie = (row['pour qui faite vous la déclaration ? '] || '').toString().trim();
    if (!salarie) return null;
    if (/^[a-z]{3,4}-\d{2}$/i.test(salarie)) return null;
    const debut = fmtDate(row['date de début '] || '');
    if (!debut) return null;
    const fin        = fmtDate(row['date de fin '] || '');
    const cachets    = parseInt(row['Nombre de cachets '] || 0) || 0;
    const services4h = parseInt(row['Nombre de service de 4H'] || 0) || 0;
    const joursCoches = [];
    Object.keys(row).forEach(h => {
      if (/^\s*\[\d+\]\s*$/.test(h) && row[h] && row[h].toString().trim()) joursCoches.push(h.replace(/[\[\]\s]/g, ''));
    });
    const joursTravailles = joursCoches.length > 0 ? joursCoches.join(', ') : extraireJours(row['Date des jours travaillés '] || '');
    return {
      _rowIndex: row._rowIndex, id: row._rowIndex, salarie,
      fonction: (row['Fonction a déclarer'] || row['Fonction a déclarer '] || '').toString().trim(),
      projet: (row['Quel projet ? '] || '').toString().trim(),
      debut, fin, cachets, services4h, joursTravailles,
      // Même formulaire "Montant"/"Nombres de defraiements" que le legacy DIS
      // (MAN "DAPE" a les mêmes colonnes) — vide ailleurs.
      defraiement: parseFR(row['Montant'] || 0),
      nbDefraiements: parseInt(row['Nombres de defraiements'] || 0) || 0,
      commentaire: (row['Commentaire '] || row['commentaires / remarques '] || '').toString().trim(),
      paieOK: row['PAIES'] === true || row['PAIES'] === 'OUI',
      contratSigne: !!(row['CONTRAT SIGNEE'] && row['CONTRAT SIGNEE'].toString().trim()),
      lienContratSigne: (row['CONTRAT SIGNEE'] && row['CONTRAT SIGNEE'].toString().trim().startsWith('http')) ? row['CONTRAT SIGNEE'].toString().trim() : '',
      dpaeEnvoyee: row['DPAE'] === true || row['DPAE'] === 'OUI',
      envoyee: row['DPAE'] === true || row['DPAE'] === 'OUI',
      facture: row['FACTURE'] === true || row['FACTURE'] === 'TRUE' || row['FACTURE'] === 'OUI',
      tarifFacture: 12,
    };
  }

  if (tabBase === 'CONTRATS') {
    const salarie = (row['Salarie'] || row['Salarié'] || '').toString().trim();
    if (!salarie) return null;
    const debut = fmtDate(row['Date debut'] || row['Date début'] || '');
    if (!debut) return null;
    const joursTravailles = extraireJours((row['Jours travailles'] || row['Jours travaillés'] || '').toString());
    const detailMontants  = (row['Detail montants'] || '').toString();
    const servicesStr     = (row['Services'] || '').toString();
    var montants = _parserMontantsContrat(detailMontants, servicesStr);
    var cachets = montants.cachets, montantCachet = montants.montantCachet, cachetDetails = montants.cachetDetails;
    var services4h = montants.services4h, montantService = montants.montantService;
    return {
      _rowIndex: row._rowIndex, id: row['Reference'] || row._rowIndex,
      salarie, nomComplet: salarie, // Contrats = nom complet déjà
      fonction: (row['Fonction'] || '').toString().trim(),
      projet: (row['Projet'] || '').toString().trim(),
      debut, fin: fmtDate(row['Date fin'] || ''),
      cachets, montantCachet, cachetDetails, services4h, montantService, joursTravailles,
      defraiement: parseFR(row['Defraiement'] || 0),
      commentaire: (row['Commentaire'] || '').toString().trim(),
      detailMontants: detailMontants, servicesStr: servicesStr,
      pdfUrl: getLienPdfRecap(row['Lien PDF']),
      lienContratSigne: getLienContrat(row['Lien PDF']),
      paieOK: false, contratSigne: false,
      // DPAE_OK = TRUE → validée → Déclarations / FALSE ou vide → DPAE
      dpaeEnvoyee: row['DPAE_OK'] === true || row['DPAE_OK'] === 'TRUE' || row['DPAE_OK'] === 'OUI',
      envoyee:     row['DPAE_OK'] === true || row['DPAE_OK'] === 'TRUE' || row['DPAE_OK'] === 'OUI',
      fdpStatut:    (row['FDP_Statut']    || '').toString().trim(),
      fdpUrl:       (row['Fiche de paie'] || '').toString().trim(),
      fdpCandidats: (row['FDP_Candidats'] || '').toString().trim(),
      // Facturation à la fiche de paie (MAN, PALM) — statut par ligne, colonne FACTURE
      facture: row['FACTURE'] === true || row['FACTURE'] === 'TRUE' || row['FACTURE'] === 'OUI',
      tarifFacture: (row['ACCOMPAGNEMENT'] === true || row['ACCOMPAGNEMENT'] === 'TRUE') ? 13 : 12,
    };
  }

  if (tabBase === 'NDF') {
    // ── Détection robuste par nom de colonne (les sheets ont des structures différentes)
    // CLR : Reference, Date soumission, Salarie, Periode, Projet, Moyen paiement,
    //       IBAN, Caisse deduction, Total TTC (EUR), Statut, Traité, Lien PDF
    // PALM: Reference, Date, Salarie, Objet, Total TTC, Statut, Lien PDF
    // DIS : colonnes décalées — détection par contenu nécessaire

    // Chercher les valeurs par noms de colonnes alternatifs
    function col() {
      var keys = Array.from(arguments);
      for (var k = 0; k < keys.length; k++) {
        var v = row[keys[k]];
        if (v !== undefined && v !== null && v !== '') return v;
      }
      return '';
    }

    // Référence
    var id  = col('Reference', 'Référence', 'REF') || row._rowIndex;

    // Salarié — nettoyer les tabs éventuels (PALM a "NOM	Prenom")
    var salarie = col('Salarie', 'Salarié', 'SALARIE', 'Nom').toString().replace(/	/g, ' ').trim();

    // Date — préférer Date soumission, sinon Date
    var date = fmtDate(col('Date soumission', 'Date', 'DATE'));

    // Période
    var periode = col('Periode', 'Période', 'PERIODE').toString().trim();

    // Projet / Spectacle
    // DIS : les colonnes sont décalées, "Objet" contient la période, "Total TTC" contient le projet
    // On détecte : si "Objet" ressemble à une date on l'ignore pour le spectacle
    var projetRaw  = col('Projet', 'Project').toString().trim();
    var objetRaw   = col('Objet').toString().trim();
    var totalRaw   = col('Total TTC (EUR)', 'Total TTC', 'TOTAL', 'Montant').toString().trim();

    // Détection du décalage DIS : si totalRaw ne contient pas de chiffres c'est le projet
    var spectacle = projetRaw;
    var objet     = objetRaw;
    var montantStr = totalRaw;

    if (!spectacle && !montantStr.match(/[\d]/)) {
      // Colonnes décalées (DIS) : Total TTC contient le projet, Objet contient la période,
      // et le vrai montant se retrouve dans la colonne suivante (généralement sans en-tête
      // exploitable — un simple décalage d'une colonne sur toute la ligne). On la retrouve
      // par POSITION plutôt que par nom : Object.keys(row) conserve l'ordre des colonnes
      // tel que lu par getTab, donc la clé juste après celle de "Total TTC" pointe vers
      // cette colonne, quel que soit son intitulé (ou son absence).
      spectacle  = montantStr;
      if (!periode && objetRaw.match(/\d{4}/)) periode = objetRaw;
      montantStr = '';
      var clesRow = Object.keys(row);
      var idxTotalCol = clesRow.findIndex(function(k) { return k.toLowerCase().indexOf('total') >= 0; });
      if (idxTotalCol >= 0 && clesRow[idxTotalCol + 1] !== undefined) {
        montantStr = (row[clesRow[idxTotalCol + 1]] || '').toString().trim();
      }
    }
    if (!spectacle) spectacle = objetRaw;

    // Montant
    var montant = parseFloat((montantStr || '0').toString()
      .replace(/[^\d,\.]/g, '').replace(',', '.')) || 0;

    // Moyen de paiement / IBAN
    var categorie = col('Moyen paiement', 'Moyen de paiement', 'MOYEN').toString().trim();
    var iban      = col('IBAN').toString().trim();

    // Caisse déduction
    var caisseDeduction = col('Caisse deduction', 'Caisse déduction').toString().trim();
    var nomCaisse       = col('Nom caisse').toString().trim();

    // Nb justificatifs
    var nbJustifs = parseInt(col('Nb justificatifs', 'Justificatifs') || 0) || 0;

    // Date signature
    var dateSignature = fmtDate(col('Date signature', 'Date de signature'));

    // Statut — détecter "Traité" (booléen CLR) ou "✅ Signé" (PALM/DIS) ou texte
    var statutRaw = col('Traité', 'Statut', 'STATUT');
    var statut = 'Non traitee';
    var statutStr = statutRaw.toString();
    if (statutRaw === true || statutStr.toUpperCase() === 'OUI'
        || statutStr.includes('Signe') || statutStr.includes('Signé')
        || statutStr.includes('✅') || statutStr.includes('OK')) {
      statut = 'Traitee';
    }

    // PDF — préférer le lien Drive réel (extrait via getRichTextValues, cf.
    // extraireLiensColonne) au simple texte affiché dans la cellule (nom de
    // fichier), qui nécessiterait sinon une recherche Drive à chaque ouverture
    var pdfUrl = lienDirect || col('Lien PDF', 'PDF', 'Lien').toString().trim();

    // Commentaires
    var commentaires = col('Commentaires', 'Commentaire').toString().trim();

    return {
      _rowIndex:      row._rowIndex,
      id:             id,
      salarie:        salarie,
      date:           date,
      periode:        periode,
      spectacle:      spectacle,
      objet:          objet,
      categorie:      categorie,
      montant:        montant,
      iban:           iban,
      caisseDeduction: caisseDeduction,
      nomCaisse:      nomCaisse,
      nbJustifs:      nbJustifs,
      dateSignature:  dateSignature,
      statut:         statut,
      pdfUrl:         pdfUrl,
      commentaires:   commentaires,
    };
  }

  if (tabBase === 'DEVIS') {

    // ── Format CLR : devis diffuseur (cession de spectacle) ──────────
    // Colonnes : ref, Raison sociale, Prix de Cession, Quel projet ?,
    //            Date de début/fin du contrat, contrat (statut), Frais divers
    if (row['Raison sociale'] !== undefined || row['Prix de Cession '] !== undefined || row['Prix de Cession'] !== undefined) {
      // Ignorer les lignes de totaux/prévi (pas de ref, pas de raison sociale)
      const diffuseur = (row['Raison sociale'] || '').toString().trim();
      const ref       = (row['ref'] || '').toString().trim();
      if (!diffuseur && !ref) return null;

      const statutRaw = (row['contrat '] || row['contrat'] || '').toString().trim();
      let statutContrat = 'En attente';
      if (statutRaw.startsWith('📄') || statutRaw.toUpperCase().includes('CONTRAT')) statutContrat = 'Signé';
      else if (statutRaw.toUpperCase() === 'OUI' || statutRaw.toUpperCase().includes('SIGN')) statutContrat = 'Signé';
      else if (statutRaw === 'Envoyé') statutContrat = 'Envoyé';

      const montantCession  = parseFR(row['Prix de Cession '] || row['Prix de Cession'] || 0);
      const fraisHeberg     = parseFR(row["Frais d'hébergement "] || 0);
      const fraisRest       = parseFR(row["Frais de réstauration "] || 0);
      const fraisDeplac     = parseFR(row["Frais de déplacement "] || 0);
      const fraisMat        = parseFR(row["Frais petit materiel médiation"] || 0);
      // Médiation / facturation horaire
      const nbHeures        = parseFR(row["Nombres d'heures facturés "] || row["Nombres d'heures facturés"] || 0);
      const tauxHoraire     = parseFR(row["Montant de l'heure facturés"] || row["Montant de l'heure facturés "] || 0);
      const montantHeures   = nbHeures > 0 && tauxHoraire > 0 ? Math.round(nbHeures * tauxHoraire * 100) / 100 : 0;
      const represLiee      = (row["Une représentation est t'elle lié a cette médiation ? "] || '').toString().trim();
      // Montant principal = cession OU heures (selon type de devis)
      // Type de facturation selon les montants présents
      const hasCession      = montantCession > 0;
      const hasMediation    = nbHeures > 0 && tauxHoraire > 0;
      const typeFacturation = hasCession && hasMediation ? 'Mixte'
        : hasCession   ? 'Cession'
        : hasMediation ? 'Médiation'
        : 'Non défini';
      const montantPrincipal = montantCession + montantHeures; // cumul si les deux
      const montantTotal     = montantPrincipal + fraisHeberg + fraisRest + fraisDeplac + fraisMat;


      // PDF : "Dépos au format pdf du devis validé" contient un lien ou emoji
      const pdfRaw = (row['Dépos au format pdf du devis validé'] || '').toString().trim();
      const pdfUrl = pdfRaw.startsWith('http') ? pdfRaw : '';

      return {
        _rowIndex:     row._rowIndex,
        id:            ref || row._rowIndex,
        type:          'DIFFUSEUR',
        diffuseur,
        email:         (row['Adresse e-mail'] || '').toString().trim(),
        signataire:    (row['Nom et Prénom du signataire (Représentant légal)'] || '').toString().trim(),
        qualite:       (row['Qualité du signataire (Ex: Présidente)'] || '').toString().trim(),
        ville:         (row['Ville'] || '').toString().trim(),
        codePostal:    (row['Code Postal'] || '').toString().trim(),
        siret:         (row['Siret (14 chiffres)'] || '').toString().trim(),
        spectacle:     (row['Quel projet ? '] || row['Quel projet ?'] || '').toString().trim(),
        typeDevis:     (row['type de devis'] || '').toString().trim(),
        dateDebut:     fmtDate(row['Date de début du contrat '] || row['Date de début du contrat']),
        dateFin:       fmtDate(row['Date de fin de contrat ']   || row['Date de fin de contrat']),
        nbRepresent:   parseInt(row['Nombres de Représentation'] || 0) || 0,
        montantHT:       montantCession,
        nbHeures,
        tauxHoraire,
        montantHeures,
        montantPrincipal,
        hasCession,
        hasMediation,
        typeFacturation,
        fraisHeberg,
        fraisRest,
        fraisDeplac,
        fraisMat,
        montantTotal,
        represLiee,
        cachetPrevi:   parseInt(row['Cachet Artiste previ '] || row['Cachet Artiste previ'] || 0) || 0,
        servicePrevi:  parseInt(row['Service Prévi ']         || row['Service Prévi']        || 0) || 0,
        techPrevi:     parseInt(row['Journée Technicien previ'] || 0) || 0,
        chorus:        (row['Facturation Chorus ? '] || '').toString().trim(),
        rediger:       (row["Rédige t'on le contrat de cession ? "] || '').toString().trim(),
        statutContrat,
        pdfUrl,
        pdfRaw,
        rowIndex:      row._rowIndex,
        source:        (row['SOURCE'] || '').toString().trim(), // 'MANUEL' si ajoutée depuis l'interface
      };
    }

    // ── Format ancien CLR : export brut Google Forms (avant "DEVIS V<année>") ──
    // Colonnes très différentes des deux formats ci-dessus (typos d'origine
    // conservées telles quelles : "Exerçice", "MOTANT FRAIS DEPLA"...). Détection
    // via "Exerçice" + "TOTAL", peu susceptibles d'exister dans un autre format.
    if (row['Exerçice'] !== undefined && row['TOTAL'] !== undefined) {
      const diffuseurBrut = (row['identifier le client par une dénomination commencent par "CL" (faire dénomination la plus courte possible ) '] || '').toString().trim();
      const projet         = (row['spectacle '] || row['PROJET'] || '').toString().trim();
      if (!diffuseurBrut && !projet) return null;

      const dateRepres = fmtDate(row['DATE DE LA REPRESENTATION'] || '');

      // Année d'exercice : "EX 24 " -> 2024, "EX 2024" -> 2024. Repli sur l'année
      // de la date de représentation si la colonne est absente/illisible, pour
      // que la ligne reste filtrable par le sélecteur d'année même dans ce cas.
      const exerciceRaw = (row['Exerçice'] || '').toString().trim();
      const exerciceMatch = exerciceRaw.match(/(\d{2,4})/);
      let anneeExercice = 0;
      if (exerciceMatch) {
        const n = parseInt(exerciceMatch[1], 10);
        anneeExercice = n < 100 ? 2000 + n : n;
      } else if (dateRepres) {
        const partsDate = dateRepres.split('/');
        if (partsDate.length === 3) anneeExercice = parseInt(partsDate[2], 10) || 0;
      }

      const montantCession = parseFR(row['TARIF DE VENTE ( sans frais de deplacement)'] || 0);
      const fraisDeplac    = parseFR(row['MOTANT FRAIS DEPLA'] || 0);
      const nbHeures       = parseFR(row['nombres heures facturée au client '] || 0);
      const tauxHoraire    = parseFR(row['facturation de la médiation '] || 0);
      const montantHeures  = nbHeures > 0 && tauxHoraire > 0 ? Math.round(nbHeures * tauxHoraire * 100) / 100 : 0;
      const medRaw          = (row["Y a t'il une mediation liée a la représentation "] || '').toString().trim().toLowerCase();
      const hasCession      = montantCession > 0;
      const hasMediation    = medRaw === 'oui' || nbHeures > 0;
      const typeFacturation = hasCession && hasMediation ? 'Mixte'
        : hasCession   ? 'Cession'
        : hasMediation ? 'Médiation'
        : 'Non défini';
      const montantPrincipal = montantCession + montantHeures;
      // "TOTAL" est déjà calculé dans la feuille d'origine — on le préfère au
      // recalcul local (peut inclure des ajustements manuels historiques).
      const montantTotalBrut = parseFR(row['TOTAL'] || 0);
      const montantTotal     = montantTotalBrut > 0 ? montantTotalBrut : (montantPrincipal + fraisDeplac);

      const contratCessionRaw = row['CONTRAT DE CESSION'];
      const statutContrat = (contratCessionRaw === true || contratCessionRaw === 'true' || contratCessionRaw === 'TRUE' || contratCessionRaw === 'Oui' || contratCessionRaw === 'oui')
        ? 'Signé' : 'En attente';

      // Le fichier joint du formulaire n'est en général qu'un nom de fichier texte
      // (pas une URL Drive exploitable directement) — on ne l'utilise donc que
      // comme information, jamais comme lien cliquable, sauf s'il s'agit bien
      // exceptionnellement déjà d'une URL.
      const fichierJoint = (row['Merci de me transmettre le devis validé via la plateforme ci-jointe.'] || '').toString().trim();
      const pdfUrlAncien = fichierJoint.startsWith('http') ? fichierJoint : '';

      return {
        _rowIndex:     row._rowIndex,
        id:            'CL-ANCIEN-' + row._rowIndex,
        type:          'DIFFUSEUR',
        annee:         anneeExercice,
        diffuseur:     diffuseurBrut || projet,
        email:         (row['Adresse e-mail'] || '').toString().trim(),
        signataire:    '',
        qualite:       '',
        ville:         '',
        codePostal:    '',
        siret:         '',
        spectacle:     projet,
        typeDevis:     '',
        dateDebut:     dateRepres,
        dateFin:       dateRepres,
        nbRepresent:   parseInt(row['Combien de représentation liée au devis vont etre déclarer en Cachet Artiste ?  '] || 0) || 1,
        montantHT:     montantCession,
        nbHeures,
        tauxHoraire,
        montantHeures,
        montantPrincipal,
        hasCession,
        hasMediation,
        typeFacturation,
        fraisHeberg:   0,
        fraisRest:     0,
        fraisDeplac,
        fraisMat:      0,
        montantTotal,
        represLiee:    '',
        cachetPrevi:   parseInt(row['Cachets totaux '] || row['Interprete '] || 0) || 0,
        servicePrevi:  parseInt(row['Nombres de SR4 ? '] || 0) || 0,
        techPrevi:     parseInt(row['technicien'] || 0) || 0,
        chorus:        (row['Facturation Chorus ? '] || '').toString().trim(),
        rediger:       '',
        statutContrat,
        pdfUrl:        pdfUrlAncien,
        pdfRaw:        fichierJoint,
        rowIndex:      row._rowIndex,
        source:        '',
      };
    }

    // ── Format MAN/DIS : contrats salariés ───────────────────────────
    // Colonnes : Reference, Salarie, Projet, Date debut/fin, Fonction,
    //            Detail montants, Lien PDF
    if (row['Reference'] !== undefined || row['Salarie'] !== undefined) {
      const salarie = (row['Salarie'] || '').toString().replace(/	/g, ' ').trim();
      const ref     = (row['Reference'] || '').toString().trim();
      if (!salarie && !ref) return null;

      const lienPdf = (row['Lien PDF'] || '').toString().trim();
      let statutContrat = 'En attente';
      if (lienPdf.startsWith('http')) statutContrat = 'Signé';
      else if (lienPdf.startsWith('DPAE_ENVOYEE')) statutContrat = 'DPAE envoyée';

      return {
        _rowIndex:    row._rowIndex,
        id:           ref || row._rowIndex,
        type:         'SALARIE',
        salarie,
        diffuseur:    (row['Structure'] || '').toString().trim(),
        email:        (row['Email'] || '').toString().trim(),
        spectacle:    (row['Projet'] || '').toString().trim(),
        fonction:     (row['Fonction'] || '').toString().trim(),
        artTech:      (row['Art/Tech'] || '').toString().trim(),
        dateDebut:    fmtDate(row['Date debut'] || row['Date début'] || ''),
        dateFin:      fmtDate(row['Date fin']   || row['Date fin']   || ''),
        detail:       (row['Detail montants'] || '').toString().trim(),
        defraiement:  parseFR(row['Defraiement'] || 0),
        commentaire:  (row['Commentaire'] || '').toString().trim(),
        montantHT:    0, // calculé depuis Detail montants si besoin
        pdfUrl:       lienPdf.startsWith('http') ? lienPdf : '',
        fdpUrl:       (row['Fiche de paie'] || '').toString().trim(),
        fdpStatut:    (row['FDP_Statut'] || '').toString().trim(),
        statutContrat,
        rowIndex:     row._rowIndex,
      };
    }

    // Fallback
    return null;
  }

  if (tabBase === 'FACTURATION') {
    // Filtrer les lignes vides ou invalides
    const num       = (row['N°facture '] || row['N°facture'] || '').toString().trim();
    const diffuseur = (row['FACTURE 2024'] || row['Diffuseur'] || '').toString().trim();
    const montant   = parseFR((row['TOTAL'] || row['MONTANT'] || '0').toString().replace(/[€]/g, ''));
    // Ignorer les lignes sans contenu utile
    if (!num && !diffuseur && montant === 0) return null;
    if (diffuseur === false || diffuseur === 'false') return null;

    // Statut : PAYEE peut être "VRAI", "OUI", true, "✓"
    const payeeRaw = (row['PAYEE'] || '').toString().toUpperCase();
    const payee    = payeeRaw === 'VRAI' || payeeRaw === 'OUI' || payeeRaw === 'TRUE' || row['PAYEE'] === true;

    // Date
    const dateVal  = row['DATE '] || row['DATE'] || row['Date'] || '';
    const dateEmise = fmtDate(dateVal);

    // Lien Drive — peut être un nom de fichier ou une URL
    const lienRaw   = (row['LIEN DRIVE'] || '').toString().trim();
    const lienDrive = lienRaw.startsWith('http') ? lienRaw : '';

    // Retard (si pas payée et date > 30j)
    let joursRetard = 0;
    if (!payee && dateVal) {
      try {
        const d = dateVal instanceof Date ? dateVal : new Date(dateVal);
        if (!isNaN(d)) joursRetard = Math.max(0, Math.floor((new Date() - d) / 86400000) - 30);
      } catch(_) {}
    }

    return {
      _rowIndex:  row._rowIndex,
      id:         num || row._rowIndex,
      num,
      refDevis:   '',
      diffuseur,
      spectacle:  (row['SPECTACLE'] || '').toString().trim(),
      montantHT:  montant,
      montantCession: montant,
      montantHeures:  0,
      fraisTotal: 0,
      emise:      dateEmise,
      echeance:   dateEmise,
      dateDebut:  '',
      dateFin:    '',
      statut:     payee ? 'Payée' : 'Impayée',
      joursRetard,
      lienDrive,
      pdfRecap:   '',
      pdfContrat: lienDrive,
      rowIndex:   row._rowIndex,
      chorus:     (row['CHORUS ?'] || row['BL CHORUS'] || '').toString().trim(),
      caissePerso: parseFR((row['CAISSE PERSO'] || '0').toString()),
    };
  }

  return row;
}

