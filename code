function _initStat(nom) {
  return { nom, fonction: '', cachets: 0, nbDpae: 0, ndfTotal: 0, ndfCount: 0, salaires: 0 };
}

function getSalariesData(ss, entity, year) {
  const stats = {};
  const declaRaw = getTab(ss, resolveTabName('DECLA', year, entity));
  if (!declaRaw.error) {
    declaRaw.rows.map(r => normalizeRow(r, 'DECLA', entity)).filter(r => r && r.debut).forEach(r => {
      const parts = r.debut.split('/');
      if (parts.length !== 3 || parseInt(parts[2]) !== year) return;
      const nom = r.salarie; if (!nom) return;
      if (!stats[nom]) stats[nom] = _initStat(nom);
      stats[nom].cachets += parseInt(r.cachets) || 0;
      stats[nom].fonction = stats[nom].fonction || r.fonction;
    });
  }
  // CLR : inclure aussi DPAE_CLR validées
  if (entity === 'CLR') {
    const dpaeClrSheet = ss.getSheetByName('DPAE_CLR');
    if (dpaeClrSheet) {
      ensureDpaeOkColumn(dpaeClrSheet);
      const rawClr = getTab(ss, 'DPAE_CLR');
      if (!rawClr.error) {
        rawClr.rows
          .filter(r => { const ok = r['DPAE_OK']; return ok === true || ok === 'TRUE' || ok === 'OUI'; })
          .map(r => normalizeRow(r, 'DECLA', entity))
          .filter(r => r && r.debut)
          .forEach(r => {
            const parts = r.debut.split('/');
            if (parts.length !== 3 || parseInt(parts[2]) !== year) return;
            const nom = r.salarie; if (!nom) return;
            if (!stats[nom]) stats[nom] = _initStat(nom);
            stats[nom].cachets += parseInt(r.cachets) || 0;
            stats[nom].fonction = stats[nom].fonction || r.fonction;
          });
      }
    }
  }
  const ndfTabName = resolveTabName('NOTE DE FRAIS V', year, entity);
  if (ndfTabName) {
    const ndfRaw = getTab(ss, ndfTabName);
    if (!ndfRaw.error) {
      ndfRaw.rows.map(r => normalizeRow(r, 'NDF', entity)).filter(r => r && r.date).forEach(r => {
        const parts = r.date.split('/');
        if (parts.length !== 3 || parseInt(parts[2]) !== year) return;
        const nom = r.salarie; if (!nom) return;
        if (!stats[nom]) stats[nom] = _initStat(nom);
        stats[nom].ndfTotal += parseFloat(r.montant) || 0;
        stats[nom].ndfCount++;
      });
    }
  }
  const comptaData = getComptaRows(ss, entity, year, null);
  if (!comptaData.error) {
    comptaData.rows.forEach(r => {
      if (!r.COMPTE || (!r.COMPTE.startsWith('64') && !r.COMPTE.startsWith('421'))) return;
      const nom = r.SALARIE; if (!nom) return;
      if (!stats[nom]) stats[nom] = _initStat(nom);
      stats[nom].salaires += parseFloat(r.DEBIT) || 0;
    });
  }
  const rows = Object.values(stats)
    .map(s => ({ id: s.nom, nom: s.nom, fonction: s.fonction, cachets: s.cachets, nbDpae: s.nbDpae,
                 ndf_total: Math.round(s.ndfTotal*100)/100, ndf_count: s.ndfCount,
                 depla_total: 0, salaires: Math.round(s.salaires*100)/100 }))
    .filter(s => s.cachets > 0 || s.nbDpae > 0 || s.ndf_total > 0 || s.salaires > 0)
    .sort((a, b) => a.nom.localeCompare(b.nom));
  return { tab: 'SALARIES', rows };
}

function getStatsSalaries(ss, entity, year) { return getSalariesData(ss, entity, year); }

