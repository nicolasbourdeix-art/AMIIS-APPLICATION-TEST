function getPaieProduction(ss, entity, year) {
  // Uniquement pour AMIIS
  if (entity !== 'AMIIS') return { error: 'Module réservé à AMIIS' };

  function parseRows(sheet, type) {
    if (!sheet) return [];
    var data = sheet.getDataRange().getValues();
    if (data.length < 2) return [];
    var h = data[0].map(function(x) { return (x||'').toString().trim(); });

    function col(row, names) {
      for (var i = 0; i < names.length; i++) {
        var idx = h.indexOf(names[i]);
        if (idx >= 0 && row[idx] !== null && row[idx] !== undefined && row[idx] !== '') return row[idx];
      }
      return '';
    }

    var rows = [];
    for (var i = 1; i < data.length; i++) {
      var row = data[i];
      var salarie = col(row, ['Salarié','Salarie','NOM']);
      if (!salarie) continue;

      var dateDebut = col(row, ['Date début','Date debut','Date début du contrat ']);
      var dateFin   = col(row, ['Date fin','Date de fin du contrat ']);
      var dateStr   = '';
      if (dateDebut instanceof Date) {
        dateStr = Utilities.formatDate(dateDebut, 'Europe/Paris', 'dd/MM/yyyy');
      } else if (dateDebut) {
        dateStr = dateDebut.toString().substring(0,10);
      }
      var dateFinStr = '';
      if (dateFin instanceof Date) {
        dateFinStr = Utilities.formatDate(dateFin, 'Europe/Paris', 'dd/MM/yyyy');
      } else if (dateFin) {
        dateFinStr = dateFin.toString().substring(0,10);
      }

      // Filtrer par année
      var yearRow = dateDebut instanceof Date ? dateDebut.getFullYear() : (dateStr ? parseInt(dateStr.split('/')[2]) : 0);
      if (year && yearRow && yearRow !== parseInt(year)) continue;

      var iDPAE    = h.indexOf('DPAE');
      var iFDP     = h.indexOf('FDP');
      var iAEM     = h.indexOf('AEM-DSN');
      var iFACT    = h.indexOf('FACTURE');
      var iQUI     = h.indexOf('QUI ? ');
      if (iQUI < 0) iQUI = h.indexOf('QUI ?');
      var iDPAEOK  = h.indexOf('DPAE_OK');
      var iRef     = h.indexOf('Reference'); if (iRef < 0) iRef = h.indexOf('Référence');
      var iLienPDF = h.lastIndexOf('PDF'); // dernière occurrence

      var detailMontants = col(row, ['Détail montants','Detail montants','Montant brut 1']);
      var servicesStr    = col(row, ['Services']);
      var montants = _parserMontantsContrat(detailMontants, servicesStr);

      rows.push({
        _rowIndex:  i + 1,
        _type:      type,
        ref:        col(row, ['Reference','Référence']) || '',
        structure:  col(row, ['Structure']) || 'AMIIS',
        salarie:    salarie.toString().replace(/	/g,' ').trim(),
        projet:     col(row, ['Projet']) || '',
        debut:      dateStr,
        fin:        dateFinStr,
        fonction:   col(row, ['Fonction','Fonction du salarié ']) || '',
        artTech:    col(row, ['Art/Tech','Art-Tech','Artistique ou Technique']) || '',
        remuneration: col(row, ['Détail montants','Remuneration','Detail montants','Montant brut 1']) || '',
        cachets:        montants.cachets,
        montantCachet:  montants.montantCachet,
        cachetDetails:  montants.cachetDetails,
        services4h:     montants.services4h,
        montantService: montants.montantService,
        jours:      col(row, ['Jours travaillés','Jours travailles']) || '',
        qui:        iQUI >= 0 ? (row[iQUI] || '').toString().trim() : '',
        dpae:       iDPAE  >= 0 ? !!row[iDPAE]  : false,
        fdp:        iFDP   >= 0 ? !!row[iFDP]   : false,
        aemDsn:     iAEM   >= 0 ? !!row[iAEM]   : false,
        facture:    iFACT  >= 0 ? !!row[iFACT]  : false,
        dpaeOk:       iDPAEOK>= 0 ? !!row[iDPAEOK]: false,
        lienPDF:      iLienPDF >= 0 ? (row[iLienPDF] || '').toString().trim() : '',
        accompagnement: (function() {
          var iAcc = h.indexOf('ACCOMPAGNEMENT');
          return iAcc >= 0 ? !!row[iAcc] : false;
        })(),
        tarif:        (function() {
          var iAcc = h.indexOf('ACCOMPAGNEMENT');
          var acc  = iAcc >= 0 ? !!row[iAcc] : false;
          return acc ? 13 : 12;
        })(),
      });
    }
    return rows;
  }

  // Créer la colonne ACCOMPAGNEMENT si absente
  ensureAccompagnementCol(ss, 'presta');
  ensureAccompagnementCol(ss, 'prod');

  var sheetPresta = ss.getSheetByName('Contrats');
  var sheetProd   = ss.getSheetByName('contrat salarié prod AMIIS');

  var prestaRows = parseRows(sheetPresta, 'presta').filter(function(r) {
    // Exclure les lignes où AMIIS gère sa propre production (structure AMIIS)
    return (r.structure || '').toUpperCase() !== 'AMIIS';
  });
  var prodRows   = parseRows(sheetProd, 'prod');

  // Forfait heures "Comptes groupe" (ex : productions KELTAS) — même compteur gestionnaire
  // que la paie (5 FDP = 1h), mais ici c'est un forfait de FORFAIT_HEURES_PROD par production attribuée.
  // On réutilise lireCompteGroupe (lecture par nom de colonne) pour rester cohérent avec l'écran Comptes groupe,
  // et on récupère au passage le détail par production (pour affichage détaillé du compteur).
  var groupeForfaits = {};
  var groupeDetailParGestionnaire = {};
  Object.keys(getTousComptesGroupe()).forEach(function(key) {
    try {
      var cg = lireCompteGroupe(key);
      if (!cg || !cg.success) return;
      (cg.rows || []).forEach(function(r) {
        if (!r.gestionnaire) return;
        var gyear = 0;
        if (r.date) {
          var parts = r.date.split('/');
          if (parts.length === 3) gyear = parseInt(parts[2], 10);
        }
        if (year && gyear && gyear !== parseInt(year)) return;

        var gest = r.gestionnaire;
        if (!groupeForfaits[gest]) groupeForfaits[gest] = { nb: 0, heures: 0, coutEmployeur: 0 };
        groupeForfaits[gest].nb           += 1;
        groupeForfaits[gest].heures        = Math.round((groupeForfaits[gest].heures + FORFAIT_HEURES_PROD) * 100) / 100;
        groupeForfaits[gest].coutEmployeur = Math.round((groupeForfaits[gest].coutEmployeur + FORFAIT_HEURES_PROD * TAUX_HORAIRE_GESTIONNAIRE) * 100) / 100;

        if (!groupeDetailParGestionnaire[gest]) groupeDetailParGestionnaire[gest] = [];
        groupeDetailParGestionnaire[gest].push({ projet: cg.projet, lieu: r.lieu, date: r.date, heures: FORFAIT_HEURES_PROD });
      });
    } catch(e) {
      Logger.log('groupeForfaits: lecture impossible pour ' + key + ' — ' + e.message);
    }
  });

  return {
    success: true,
    presta:  prestaRows,
    prod:    prodRows,
    groupeForfaits: groupeForfaits,
    groupeDetailParGestionnaire: groupeDetailParGestionnaire,
  };
}

