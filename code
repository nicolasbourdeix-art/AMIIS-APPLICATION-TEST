    Logger.log('Lignes reconnues par normalizeRow (format devis) : ' + reconnues + ' / ' + detecte.rows.length);
    if (detecte.rows.length > 0) {
      Logger.log('--- Contenu de la 1ère ligne de données (clés reconnues par le code) ---');
      Logger.log(JSON.stringify(detecte.rows[0]));
    }
  }
