function extraireTextePDFAdobe(fileId) {
  var props   = PropertiesService.getScriptProperties();
  var clientId     = props.getProperty('ADOBE_CLIENT_ID');
  var clientSecret = props.getProperty('ADOBE_CLIENT_SECRET');

  if (!clientId || !clientSecret) {
    return { error: 'ADOBE_CLIENT_ID / ADOBE_CLIENT_SECRET non configurés dans ScriptProperties' };
  }

  try {
    // 1. Obtenir un token Adobe IMS
    var tokenResp = UrlFetchApp.fetch('https://ims-na1.adobelogin.com/ims/token/v3', {
      method: 'post',
      payload: {
        grant_type:    'client_credentials',
        client_id:     clientId,
        client_secret: clientSecret,
        scope:         'openid,AdobeID,DCAPI',
      },
      muteHttpExceptions: true,
    });
    var tokenData = JSON.parse(tokenResp.getContentText());
    if (!tokenData.access_token) {
      return { error: 'Adobe auth: ' + JSON.stringify(tokenData) };
    }
    var adobeToken = tokenData.access_token;

    // 2. Obtenir une URL d'upload présignée
    var uploadResp = UrlFetchApp.fetch(
      'https://pdf-services-ue1.adobe.io/assets',
      {
        method: 'post',
        headers: {
          'Authorization':  'Bearer ' + adobeToken,
          'x-api-key':      clientId,
          'Content-Type':   'application/json',
        },
        payload: JSON.stringify({ mediaType: 'application/pdf' }),
        muteHttpExceptions: true,
      }
    );
    var uploadData = JSON.parse(uploadResp.getContentText());
    if (!uploadData.uploadUri || !uploadData.assetID) {
      return { error: 'Adobe upload URI: ' + JSON.stringify(uploadData) };
    }

    // 3. Uploader le PDF vers Adobe
    var file = DriveApp.getFileById(fileId);
    var blob = file.getBlob().setContentType('application/pdf');

    var putResp = UrlFetchApp.fetch(uploadData.uploadUri, {
      method:  'put',
      headers: { 'Content-Type': 'application/pdf' },
      payload: blob.getBytes(),
      muteHttpExceptions: true,
    });
    if (putResp.getResponseCode() !== 200) {
      return { error: 'Adobe PUT: ' + putResp.getResponseCode() };
    }

    // 4. Lancer l'extraction texte
    var extractResp = UrlFetchApp.fetch(
      'https://pdf-services-ue1.adobe.io/operation/extractpdf',
      {
        method: 'post',
        headers: {
          'Authorization':  'Bearer ' + adobeToken,
          'x-api-key':      clientId,
          'Content-Type':   'application/json',
        },
        payload: JSON.stringify({
          assetID:            uploadData.assetID,
          elementsToExtract:  ['text'],
        }),
        muteHttpExceptions: true,
      }
    );

    if (extractResp.getResponseCode() !== 201) {
      return { error: 'Adobe extract: ' + extractResp.getContentText() };
    }

    var jobLocation = extractResp.getHeaders()['location'] || extractResp.getHeaders()['Location'];
    if (!jobLocation) return { error: 'Adobe: pas de location header' };

    // 5. Polling jusqu'à fin du job (max 30s)
    var jobData = null;
    for (var i = 0; i < 10; i++) {
      Utilities.sleep(3000);
      var pollResp = UrlFetchApp.fetch(jobLocation, {
        headers: {
          'Authorization': 'Bearer ' + adobeToken,
          'x-api-key':     clientId,
        },
        muteHttpExceptions: true,
      });
      jobData = JSON.parse(pollResp.getContentText());
      Logger.log('Adobe job status: ' + jobData.status);
      if (jobData.status === 'done') break;
      if (jobData.status === 'failed') return { error: 'Adobe job failed: ' + JSON.stringify(jobData) };
    }

    if (!jobData || jobData.status !== 'done') {
      return { error: 'Adobe timeout' };
    }

    // 6. Télécharger le JSON résultat
    var resultUrl = jobData.content && jobData.content.downloadUri;
    if (!resultUrl) return { error: 'Adobe: pas de downloadUri' };

    var resultResp = UrlFetchApp.fetch(resultUrl, { muteHttpExceptions: true });
    var resultData = JSON.parse(resultResp.getContentText());

    // 7. Extraire le texte depuis la structure JSON Adobe
    var texte = '';
    (resultData.elements || []).forEach(function(el) {
      if (el.Text) texte += el.Text + '\n';
    });

    Logger.log('Adobe extraction: ' + texte.length + ' chars extraits de ' + file.getName());
    return { success: true, text: texte, method: 'adobe' };

  } catch(e) {
    return { error: 'Adobe exception: ' + e.message };
  }
}

