  Logger.log('Nombre de lignes de données lues : ' + (detecte.rows ? detecte.rows.length : 0));

  // Combien de lignes seraient reconnues par normalizeRow (format devis CLR)
  if (detecte.rows && detecte.rows.length > 0) {
    var reconnues = 0;
    detecte.rows.forEach(function(r) {
      if (normalizeRow(r, 'DEVIS', 'CLR')) reconnues++;
