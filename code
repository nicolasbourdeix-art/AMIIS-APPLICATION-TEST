// Pour les codes ABSENTS de CODE COMPTA (donc pas curatés manuellement) : un
// seul libellé "de secours" par code, choisi comme le plus fréquemment utilisé
// dans l'historique réel de la feuille COMPTA (reflète ce que l'utilisateur
// saisit vraiment) — jamais plusieurs variantes textuelles du même code, pour
// ne pas encombrer le menu déroulant de quasi-doublons.
function meilleurLabelHistoriqueParCode(ss, codesAIgnorer) {
  var frequenceParCode = {};
  var comptaSheet = ss.getSheetByName('COMPTA');
  if (comptaSheet) {
    var cHeaders = comptaSheet.getRange(2, 1, 1, comptaSheet.getLastColumn()).getValues()[0];
    var iCpt = cHeaders.findIndex(function(h) { return h && h.toString().trim() === 'Numéro comptable'; });
    var iOp  = cHeaders.findIndex(function(h) { return h && h.toString().trim() === 'Opération compta'; });
    if (iCpt >= 0 && iOp >= 0) {
      var lastRowCompta = comptaSheet.getLastRow();
      var cRng = lastRowCompta >= 3 ? comptaSheet.getRange(3, 1, lastRowCompta-2, Math.max(iCpt, iOp)+1).getValues() : [];
      cRng.forEach(function(row) {
        var code = (row[iCpt] || '').toString().trim();
        var op   = (row[iOp]  || '').toString().trim();
        if (!code || !op || (codesAIgnorer && codesAIgnorer[code])) return;
        if (!frequenceParCode[code]) frequenceParCode[code] = {};
        frequenceParCode[code][op] = (frequenceParCode[code][op] || 0) + 1;
      });
    }
  }
  var meilleurParCode = {};
  Object.keys(frequenceParCode).forEach(function(code) {
    var labels = frequenceParCode[code];
    meilleurParCode[code] = Object.keys(labels).sort(function(a, b) { return labels[b] - labels[a]; })[0];
  });
  return meilleurParCode;
}

function getCodeComptaMap(ss) {
  var plan = {};
  var codesVus = {};

  // 1. Onglet CODE COMPTA — curaté manuellement, la plus fiable.
  var sheet = ss.getSheetByName('CODE COMPTA');
  if (sheet) {
    var data = sheet.getRange(2, 1, Math.max(1, sheet.getLastRow()-1), 4).getValues();
    data.forEach(function(row) {
      var code = (row[1]||'').toString().trim();
      var lib  = (row[2]||'').toString().trim();
      if (code && lib) { plan[code] = lib; codesVus[code] = true; }
    });
  }

  // 2. Pour les codes restants : le libellé le plus utilisé dans l'historique COMPTA.
  var meilleurHistorique = meilleurLabelHistoriqueParCode(ss, codesVus);
  Object.keys(meilleurHistorique).forEach(function(code) {
    plan[code] = meilleurHistorique[code];
    codesVus[code] = true;
  });

  // 3. Plan comptable standard générique — dernier recours pour les codes
  //    encore jamais rencontrés nulle part.
  Object.keys(PLAN_COMPTABLE_STANDARD).forEach(function(code) {
    if (!codesVus[code]) plan[code] = PLAN_COMPTABLE_STANDARD[code];
  });

  return plan;
}

// Comme getCodeComptaMap, mais retourne la liste des combinaisons {code, label}
// en gardant PLUSIEURS libellés pour un même code quand l'onglet CODE COMPTA le
// prévoit explicitement — nécessaire car un même code peut avoir plusieurs
// usages distincts valides (ex: chez CLR, le code 625.6 sert à la fois pour
// "Frais de dépla", "Frais de repas" et "Hébergement" ; seul le texte de
// l'opération distingue les trois, pas le numéro de compte). Un simple
// dictionnaire code->libellé perdrait deux des trois lignes par écrasement.
// Utilisée partout où cette distinction doit être préservée : le menu déroulant
// de compte (recherche par libellé) et le rapprochement automatique à l'import
// (deviner "Frais de repas" pour "restaurant" vs "Frais de dépla" pour "essence").
// Pour les codes ABSENTS de CODE COMPTA : un seul libellé de secours par code
// (le plus utilisé dans l'historique COMPTA, sinon le plan comptable standard),
// jamais plusieurs variantes textuelles — c'est cette accumulation de variantes
// qui encombrait le menu de quasi-doublons.
function getListeCodeCompta(ss) {
  var liste = [];
  // Déduplique les variantes qui ne diffèrent que par la casse ou les espaces
  // (ex: "Service bancaire" / "Service Bancaire" / "Service  bancaire") — la
  // première rencontrée l'emporte et garde son écriture d'origine à l'affichage.
  var vusNormalise = {};
  function cleNormalisee(code, label) {
    return code + '|' + label.toLowerCase().trim().replace(/\s+/g, ' ');
  }
  function ajouter(code, label) {
    var cle = cleNormalisee(code, label);
    if (vusNormalise[cle]) return;
    vusNormalise[cle] = true;
    liste.push({ code: code, label: label });
  }

  var codesVus = {};
  var sheet = ss.getSheetByName('CODE COMPTA');
  if (sheet) {
    var data = sheet.getRange(2, 1, Math.max(1, sheet.getLastRow()-1), 4).getValues();
    data.forEach(function(row) {
      var code = (row[1]||'').toString().trim();
      var lib  = (row[2]||'').toString().trim();
      if (code && lib) { ajouter(code, lib); codesVus[code] = true; }
    });
  }

  var meilleurHistorique = meilleurLabelHistoriqueParCode(ss, codesVus);
  Object.keys(meilleurHistorique).forEach(function(code) {
    ajouter(code, meilleurHistorique[code]);
    codesVus[code] = true;
  });

  Object.keys(PLAN_COMPTABLE_STANDARD).forEach(function(code) {
    if (!codesVus[code]) ajouter(code, PLAN_COMPTABLE_STANDARD[code]);
  });

  return liste;
}

// Lit la liste RÉELLE des valeurs autorisées par la validation de données de la
// colonne "Opération compta" de l'onglet COMPTA (liste déroulante en mode rejet).
// Sert de garde-fou : écrire une valeur absente de cette liste fait échouer
// tout Range.setValues() avec "ne respectent pas les règles de validation" et
// annule l'import de la ligne entière. Retourne null si aucune règle n'a pu être
// détectée (pas de restriction connue → aucune vérification à faire), ou
// { set: {...} (recherche exacte insensible casse/espaces), list: [...] (valeurs
// d'origine, pour le rapprochement approximatif) } sinon.
function getListeValidationOperationCompta(ss) {
  try {
    var sheet = ss.getSheetByName('COMPTA');
    if (!sheet) return null;
    var headers = sheet.getRange(2, 1, 1, sheet.getLastColumn()).getValues()[0];
    var iOp = headers.findIndex(function(h) { return h && h.toString().trim() === 'Opération compta'; });
    if (iOp < 0) return null;

    function buildResult(valeursBrutes) {
      var set = {};
      var list = [];
      valeursBrutes.forEach(function(v) {
        var s = (v||'').toString().trim();
        if (!s) return;
        set[s.toLowerCase()] = true;
        list.push(s);
      });
      return { set: set, list: list };
    }

    var lastRow = sheet.getLastRow();
    if (lastRow < 3) return null;
    // Lit la validation de TOUTE la plage en un seul appel (getDataValidations,
    // pluriel) au lieu d'un scan cellule par cellule — l'ancienne version
    // appelait getRange(r, iOp+1).getDataValidation() jusqu'à ~700 fois de
    // suite (400 dernières lignes + 300 premières), ce qui prenait 20-35s et
    // finissait parfois par dépasser un quota Google, faisant échouer TOUTE
    // la sauvegarde de la ligne compta (page d'erreur au lieu du JSON attendu).
    // On repart de la fin (les blocs récents ont toujours une règle ; les
    // blocs anciens peuvent en être dépourvus) jusqu'au début si besoin.
    var rules = sheet.getRange(3, iOp + 1, lastRow - 2, 1).getDataValidations();
    for (var i = rules.length - 1; i >= 0; i--) {
      var rule = rules[i][0];
      if (!rule) continue;
      var type = rule.getCriteriaType();
      var values = rule.getCriteriaValues();
      if (type === SpreadsheetApp.DataValidationCriteria.VALUE_IN_LIST) {
        return buildResult(values[0] || []);
      }
      if (type === SpreadsheetApp.DataValidationCriteria.VALUE_IN_RANGE) {
        try {
          var rangeVals = values[0].getValues();
          var flat = [];
          rangeVals.forEach(function(rowV) { rowV.forEach(function(v) { flat.push(v); }); });
          return buildResult(flat);
        } catch(eRange) { return null; }
      }
    }
    return null; // aucune règle trouvée
  } catch(e) {
    Logger.log('getListeValidationOperationCompta erreur: ' + e.message);
    return null;
  }
}


// Listes pour les menus déroulants de la modale d'import relevé : comptes (label →
// code numérique) et projets (code court → nom complet), lus depuis l'onglet
// CODE COMPTA de l'entité (colonnes B/C pour les comptes, G/H pour les projets).
function getListesImportCompta(ss) {
  var comptes = [];
  var projets = [];
  var sheet = ss.getSheetByName('CODE COMPTA');
  if (!sheet) return { comptes: comptes, projets: projets };

  var lastCol = Math.max(10, sheet.getLastColumn());
  var headers = sheet.getRange(1, 1, 1, lastCol).getValues()[0];
  var data = sheet.getRange(2, 1, Math.max(1, sheet.getLastRow() - 1), lastCol).getValues();
  var vusComptes = {};
  var vusProjets = {};

  // Format 1 (ex: MAN) : colonnes G/H = code court + nom complet du projet
  data.forEach(function(row) {
    var labelCompte = (row[1] || '').toString().trim();
    var codeCompte  = (row[2] || '').toString().trim();
    if (labelCompte && codeCompte && !vusComptes[codeCompte]) {
      vusComptes[codeCompte] = true;
      comptes.push({ code: codeCompte, label: labelCompte });
    }
    var codeProjet = (row[6] || '').toString().trim();
    var nomProjet  = (row[7] || '').toString().trim();
    if (codeProjet && !vusProjets[codeProjet]) {
      vusProjets[codeProjet] = true;
      projets.push({ code: codeProjet, label: nomProjet || codeProjet });
    }
  });

  // Format 2 (ex: CLR) : une colonne unique listant les projets. La colonne "Vrai nom"
  // fait foi (colonne A "spectacle"/"spectalce" existe aussi mais n'est pas la bonne
  // source selon Nicolas — on ne l'utilise qu'en dernier recours si "Vrai nom" est absente).
  var colVraiNom = headers.findIndex(function(h) {
    return (h || '').toString().trim().toLowerCase() === 'vrai nom';
  });
  var colSpectacle = colVraiNom >= 0 ? -1 : headers.findIndex(function(h) {
    var norm = (h || '').toString().trim().toLowerCase();
    return norm.indexOf('spect') === 0 && norm.length <= 12;
  });
  var colNoms = colVraiNom >= 0 ? colVraiNom : colSpectacle;
  if (colNoms >= 0) {
    data.forEach(function(row) {
      var nom = (row[colNoms] || '').toString().trim();
      if (nom && !vusProjets[nom]) {
        vusProjets[nom] = true;
        projets.push({ code: nom, label: nom });
      }
    });
  }

  return { comptes: comptes, projets: projets };
}

function analyserReleveAvecClaude(entity, lignesReleve, contextCompta, piecesDrive) {
  // Toujours faire le rapprochement local d'abord (sans API)
  var propositionsLocales = fallbackImputationLocale(lignesReleve, piecesDrive);

  // Tenter Claude API pour enrichir si disponible
  var apiKey = PropertiesService.getScriptProperties().getProperty('ANTHROPIC_API_KEY');
  if (!apiKey) {
    return { success: true, propositions: propositionsLocales, source: 'local' };
  }

  var exemples = contextCompta.slice(0, 30).map(function(r) {
    return (r.LIBELLE||'') + ' -> ' + (r.COMPTE||'') + ' (' + (r.DEBIT>0 ? '-'+r.DEBIT : '+'+r.CREDIT) + 'EUR)' + (r.SPECTACLE ? ' ['+r.SPECTACLE+']' : '');
  }).join('\n');

  var lignesStr = lignesReleve.map(function(l, i) {
    return '[' + i + '] ' + (l.date||'') + ' | ' + (l.libelle||'') + ' | ' + (l.montant > 0 ? '+'+l.montant : l.montant) + ' EUR';
  }).join('\n');

  var planStr = Object.keys(contextCompta.plan || {}).slice(0, 40).map(function(k) {
    return k + ':' + contextCompta.plan[k];
  }).join(', ');

  // Construire la liste des pièces Drive disponibles pour le rapprochement
  var piecesStr = '';
  if (piecesDrive && piecesDrive.length > 0) {
    piecesStr = '\n\nPIECES COMPTABLES DISPONIBLES DANS DRIVE (nom;montant;url) :\n'
      + piecesDrive.slice(0, 80).map(function(p) {
          return p.nom + ';' + (p.montant ? p.montant + 'EUR' : '?') + ';' + p.url;
        }).join('\n');
  }

  var prompt = 'Tu es un comptable expert en associations culturelles francaises.\n\n'
    + 'Ecritures COMPTA recentes pour ' + entity + ' (apprends les patterns) :\n'
    + exemples + '\n\n'
    + 'Plan comptable : ' + planStr
    + piecesStr + '\n\n'
    + 'Lignes du releve bancaire a imputer :\n' + lignesStr + '\n\n'
    + 'Pour chaque ligne [i], propose :\n'
    + '- compte : code comptable\n'
    + '- libelle : libelle court propre\n'
    + '- spectacle : nom du projet si identifiable\n'
    + '- operation : categorie\n'
    + '- confiance : haute/moyenne/basse\n'
    + '- piece_url : URL Drive de la piece justificative correspondante si tu trouves une correspondance (meme montant, meme periode, meme nature), sinon ""\n'
    + '- piece_nom : nom du fichier piece correspondant, sinon ""\n'
    + 'Reponds UNIQUEMENT en JSON : {"propositions":[{"index":0,"compte":"627","libelle":"Frais bancaires","spectacle":"","operation":"Services bancaires","confiance":"haute","piece_url":"","piece_nom":""}]}';

  try {
    var raw = UrlFetchApp.fetch('https://api.anthropic.com/v1/messages', {
      method: 'post', muteHttpExceptions: true,
      headers: { 'Content-Type': 'application/json', 'x-api-key': apiKey, 'anthropic-version': '2023-06-01' },
      payload: JSON.stringify({
        model: 'claude-sonnet-4-6', max_tokens: 4096,
        system: 'Tu es un expert-comptable. Reponds UNIQUEMENT en JSON valide, sans markdown.',
        messages: [{ role: 'user', content: prompt }]
      })
    });
    var resp = JSON.parse(raw.getContentText());
    if (resp.error) {
      // Fallback local si crédits insuffisants
      Logger.log('Claude API error: ' + JSON.stringify(resp.error));
      return { success: true, propositions: fallbackImputationLocale(lignesReleve, piecesDrive), fallback: true };
    }
    var text = resp.content[0].text.trim().replace(/^```json/,'').replace(/^```/,'').replace(/```$/,'').trim();
    var result = JSON.parse(text);
    return { success: true, propositions: result.propositions || [] };
  } catch(e) {
    return { success: true, propositions: fallbackImputationLocale(lignesReleve, piecesDrive), fallback: true };
  }
}

// =============================================================================
// RAPPROCHEMENT PIECE COMPTA — matching direct date+montant (toutes entités sauf CLR)
// =============================================================================

function resolvePieceComptaSheet(ss) {
  var sheets = ss.getSheets();
  for (var i = 0; i < sheets.length; i++) {
    var nom = sheets[i].getName().trim().toUpperCase();
    if (nom === 'PIECE COMPTA' || nom === 'PIECES COMPTA') return sheets[i];
  }
  return null;
}

// Résout le nom réel d'une colonne PIECE COMPTA à partir d'une liste de
// libellés candidats, en comparant sans tenir compte de la casse, des
// accents ni des espaces superflus — le nom exact des en-têtes varie selon
// les classeurs de compagnie (ex: "Date" vs "date"), et une correspondance
// figée fait échouer silencieusement tout le rapprochement pour l'entité
// concernée (cf. DIS). Retourne le nom d'en-tête exact tel qu'il apparaît
// dans le Sheet, ou null si aucun des candidats n'est trouvé.
function resolverColonnePieceCompta(headers, candidats) {
  var normalises = (headers || []).map(function(h) { return normaliserTexteCompta(h); });
  for (var i = 0; i < candidats.length; i++) {
    var idx = normalises.indexOf(normaliserTexteCompta(candidats[i]));
    if (idx >= 0) return headers[idx];
  }
  return null;
}

function chargerPiecesComptaSheet(ss) {
  var sheet = resolvePieceComptaSheet(ss);
  if (!sheet) return [];
  // Détection dynamique de la ligne d'en-têtes plutôt que getTab (ligne 1
  // figée) : certains classeurs (ex: DIS) ont une ligne 1 vide/décorative et
  // les vrais intitulés de colonnes en ligne 2, ce qui fait échouer
  // silencieusement toute résolution basée sur la ligne 1.
  var raw = getTabEnTetesDynamiques(ss, sheet.getName());
  if (raw.error) return [];

  var colDate    = resolverColonnePieceCompta(raw.headers, ['date']);
  var colMontant = resolverColonnePieceCompta(raw.headers, ['montant']);
  var colCateg   = resolverColonnePieceCompta(raw.headers, ['categorisation']);
  var colProjet  = resolverColonnePieceCompta(raw.headers, ['projet', 'spectacle']);
  var colComment = resolverColonnePieceCompta(raw.headers, ['infos / commantaire', 'infos / commentaire', 'commentaire']);
  var colLien    = resolverColonnePieceCompta(raw.headers, ['photos piece comptable']);

  if (!colDate || !colMontant) {
    Logger.log('PIECE COMPTA: colonne date ou montant introuvable (en-tetes: ' + (raw.headers || []).join(' | ') + ')');
  }

  return raw.rows.map(function(r) {
    var dateVal = colDate ? r[colDate] : undefined;
    var date = dateVal instanceof Date ? dateVal : parserDateFR(dateVal);
    var montantRaw = ((colMontant && r[colMontant]) || '').toString().replace('€', '').replace(/\s/g, '').replace(',', '.').trim();
    var montant = parseFloat(montantRaw) || 0;
    var lienVal = ((colLien && r[colLien]) || '').toString().trim();
    var lien = lienVal.startsWith('http') ? lienVal : '';
    var nom  = !lien && lienVal ? lienVal : '';

    return {
      _rowIndex:      r._rowIndex,
      date:           date,
      montant:        Math.round(montant * 100) / 100,
      categorisation: ((colCateg && r[colCateg]) || '').toString().trim(),
      projet:         ((colProjet && r[colProjet]) || '').toString().trim(),
      commentaire:    ((colComment && r[colComment]) || '').toString().trim(),
      lien: lien, nom: nom,
    };
  }).filter(function(p) { return p.date && p.montant > 0; });
}

// Pour chaque ligne du relevé, cherche une pièce PIECE COMPTA au montant exact (au
// centime près) et à la date à ±7 jours. En cas de plusieurs candidats, on garde le
// plus proche en date. Retourne les lignes matchées (avec la pièce liée) et les index
// des lignes non matchées, à passer en secours au rapprochement IA/Drive existant.
// Normalise un texte libre pour comparaison (sans accents/casse/ponctuation)
function normaliserTexteCompta(s) {
  return (s || '').toString().trim().toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '') // retire les accents
    .replace(/\([^)]*\)/g, '') // retire le contenu entre parenthèses
    .replace(/[^a-z0-9\s]/g, ' ') // ponctuation -> espace
    .replace(/\s+/g, ' ').trim();
}

// Rapproche un texte libre (ex: le libellé générique déduit d'un compte, ou la
// description de la ligne bancaire) de la valeur la plus proche dans une liste de
// chaînes autorisées (ex: la liste réelle de validation de "Opération compta").
// Même stratégie de matching que trouverCompteEtLabelOfficiel (exact > préfixe >
// mots communs), mais générique sur un simple tableau de valeurs plutôt que sur
// une map code->libellé — utilisé pour caler un libellé généré automatiquement
// sur une valeur strictement valide, plutôt que de le laisser vide.
function trouverMeilleureCorrespondance(texteLibre, listeAutorisee) {
  var cle = normaliserTexteCompta(texteLibre);
  if (!cle || !listeAutorisee || listeAutorisee.length === 0) return '';

  var normalises = listeAutorisee
    .map(function(v) { return { orig: v, norm: normaliserTexteCompta(v) }; })
    .filter(function(o) { return o.norm; });

  var exact = normalises.find(function(o) { return o.norm === cle; });
  if (exact) return exact.orig;

  var parPrefixeLongueur = normalises.slice().sort(function(a, b) { return b.norm.length - a.norm.length; });
  var prefixe = parPrefixeLongueur.find(function(o) { return o.norm.indexOf(cle) === 0 || cle.indexOf(o.norm) === 0; });
  if (prefixe) return prefixe.orig;

  var motsCle = cle.split(' ').filter(function(m) { return m.length >= 3; });
  if (motsCle.length === 0) return '';
  var meilleurScore = 0, meilleur = '', meilleurNbMotsLabel = 0;
  normalises.forEach(function(o) {
    var motsLabel = o.norm.split(' ').filter(function(m) { return m.length >= 3; });
    var communs = motsLabel.filter(function(m) { return motsCle.indexOf(m) >= 0; }).length;
    if (communs > meilleurScore) { meilleurScore = communs; meilleur = o.orig; meilleurNbMotsLabel = motsLabel.length; }
  });
  // Un seul mot commun ne suffit à confirmer une correspondance que si le
  // libellé candidat n'a lui-même qu'un seul mot distinctif (ex: "Urssaf") —
  // sinon un mot trop générique partagé avec un libellé plus long (ex:
  // "service" entre "Divers Service extérieur" et "Service bancaire")
  // ferait deviner une correspondance au hasard.
  if (meilleurScore === 0 || (meilleurScore < 2 && meilleurNbMotsLabel > 1)) return '';
  return meilleur;
}

// Rapproche un texte libre (catégorisation PIECE COMPTA, ou proposition IA) du
// libellé OFFICIEL le plus proche dans CODE COMPTA, et retourne {code, label}.
// Le "label" retourné est TOUJOURS l'un des libellés officiels (jamais du texte
// libre), car la colonne "Opération compta" du Sheet a une liste déroulante figée
// sur ces valeurs exactes — y écrire autre chose casse la validation de données.
// Rapproche un texte libre (catégorisation PIECE COMPTA, ou proposition IA) du
// libellé OFFICIEL le plus proche parmi une LISTE de paires {code, label} (voir
// getListeCodeCompta — un même code peut apparaître plusieurs fois avec des
// libellés différents, ex: 625.6 pour "Frais de dépla"/"Frais de repas"/
// "Hébergement" chez CLR ; c'est le texte qui doit trancher, pas le code seul).
// Le "label" retourné est TOUJOURS l'un des libellés officiels (jamais du texte
// libre), car la colonne "Opération compta" du Sheet a une liste déroulante figée
// sur ces valeurs exactes — y écrire autre chose casse la validation de données.
function trouverCompteEtLabelOfficiel(listeCodeCompta, texteLibre) {
  var entrees = (listeCodeCompta || [])
    .map(function(o) { return { code: o.code, label: o.label, norm: normaliserTexteCompta(o.label) }; })
    .filter(function(o) { return o.norm; });

  var cle = normaliserTexteCompta(texteLibre);
  if (!cle) return { code: '', label: '' };

  var exact = entrees.find(function(o) { return o.norm === cle; });
  if (exact) return { code: exact.code, label: exact.label };

  var parLongueur = entrees.slice().sort(function(a, b) { return b.norm.length - a.norm.length; });
  var prefixe = parLongueur.find(function(o) { return o.norm.indexOf(cle) === 0 || cle.indexOf(o.norm) === 0; });
  if (prefixe) return { code: prefixe.code, label: prefixe.label };

  var motsCle = cle.split(' ').filter(function(m) { return m.length >= 3; });
  if (motsCle.length === 0) return { code: '', label: '' };
  var meilleurScore = 0, meilleur = null, meilleurNbMotsLabel = 0;
  entrees.forEach(function(o) {
    var motsLabel = o.norm.split(' ').filter(function(m) { return m.length >= 3; });
    var communs = motsLabel.filter(function(m) { return motsCle.indexOf(m) >= 0; }).length;
    if (communs > meilleurScore) { meilleurScore = communs; meilleur = o; meilleurNbMotsLabel = motsLabel.length; }
  });
  // Même garde-fou que trouverMeilleureCorrespondance : un seul mot commun ne
  // suffit pas si le libellé officiel a plusieurs mots (ex: "Divers Service
  // extérieur" ne doit jamais se retrouver imputé en "Service bancaire" juste
  // parce qu'ils partagent le mot générique "service").
  if (!meilleur || (meilleurScore < 2 && meilleurNbMotsLabel > 1)) return { code: '', label: '' };
  return { code: meilleur.code, label: meilleur.label };
}

// Parse une date JJ/MM/AAAA, JJ.MM.AAAA ou JJ-MM-AAAA (formats bancaires courants,
// certaines banques comme la Société Générale utilisent des points ou des tirets au
// lieu de slashs). Retourne un objet Date ou null si le format n'est pas reconnu.
function parserDateFR(dateStr) {
  if (!dateStr) return null;
  var parts = dateStr.toString().trim().split(/[\/.\-]/);
  if (parts.length !== 3) return null;
  var jour = parseInt(parts[0], 10), mois = parseInt(parts[1], 10), annee = parseInt(parts[2], 10);
  if (isNaN(jour) || isNaN(mois) || isNaN(annee)) return null;
  if (annee < 100) annee += 2000; // au cas où l'année serait sur 2 chiffres
  var d = new Date(annee, mois - 1, jour);
  return isNaN(d.getTime()) ? null : d;
}

// Fenêtre de tolérance date pour le rapprochement PIECE COMPTA. Le montant est
// déjà comparé à l'exact centime près (voir plus bas), donc élargir cette
// fenêtre n'augmente pas vraiment le risque de faux positif — le vrai facteur
// limitant reste le montant. Des virements institutionnels (théâtre,
// subventions, cessions) peuvent être payés 8-10 jours après la date de la
// pièce, largement au-delà de l'ancienne fenêtre de 7 jours (cas constaté sur
// DIS : pièces à 2400€/2280€ datées du 02/06, virements bancaires reçus les
// 10-11/06 — 8-9 jours d'écart, hors fenêtre alors que le montant matche).
var FENETRE_PIECE_COMPTA_J = 20;

function matcherAvecPieceComptaSheet(lignesReleve, pieces, listeCodeCompta) {
  var propositionsMatchees = [];
  var indexNonMatches = [];

  lignesReleve.forEach(function(ligne, idx) {
    var montantAbs = Math.round(Math.abs(parseFloat(ligne.montant) || 0) * 100) / 100;
    var dateLigne = parserDateFR(ligne.date);

    if (!montantAbs || !dateLigne) { indexNonMatches.push(idx); return; }

    var candidats = pieces.filter(function(p) {
      if (p.montant !== montantAbs) return false;
      var diffJours = Math.abs((p.date - dateLigne) / 86400000);
      return diffJours <= FENETRE_PIECE_COMPTA_J;
    });

    if (candidats.length === 0) { indexNonMatches.push(idx); return; }

    candidats.sort(function(a, b) {
      return Math.abs(a.date - dateLigne) - Math.abs(b.date - dateLigne);
    });
    var meilleur = candidats[0];
    var match = trouverCompteEtLabelOfficiel(listeCodeCompta, meilleur.categorisation);

    propositionsMatchees.push({
      index: idx,
      compte: match.code,
      libelle: meilleur.categorisation || '', // texte libre OK : colonne "Descriptions/Libelles", pas de liste déroulante
      spectacle: meilleur.projet || '',
      operation: match.label || '', // toujours un libellé officiel (ou vide), jamais du texte libre
      confiance: 'haute',
      piece_url: meilleur.lien || '',
      piece_nom: meilleur.nom || '',
      source: 'PIECE_COMPTA_SHEET',
    });
  });

  return { propositionsMatchees: propositionsMatchees, indexNonMatches: indexNonMatches };
}

// Rapprochement par MONTANT + DATE contre les Devis (pour retrouver le
// spectacle/projet réglé) et, à défaut, contre les Notes de frais (remboursement
// d'une NDF précise) — appliqué en complément du rapprochement par mots-clés/IA,
// uniquement sur les lignes dont le projet n'a pas déjà été déterminé. Ne modifie
// jamais une proposition qui a déjà un spectacle rempli par une autre source.
//
// Garde-fous contre les faux positifs (un petit montant rond — 2€, 8€, 28€ — a de
// fortes chances de coïncider par hasard avec une NDF ou un devis sans rapport) :
// - MONTANT_MIN : en dessous de ce seuil, le montant seul n'est pas jugé assez
//   distinctif pour servir d'identifiant fiable — on n'essaie même pas.
// - La date de la ligne bancaire est comparée à la date du devis/de la NDF ; les
//   candidats hors fenêtre sont écartés en priorité (un paiement de cession peut
//   arriver bien après la représentation, d'où une fenêtre large côté devis).
// - En cas d'AMBIGUÏTÉ (plusieurs candidats restants après filtrage par date) :
//   on propose quand même le plus proche en date, mais en confiance "basse" et
//   avec le lien de la pièce (récap/contrat/NDF) pour vérification manuelle —
//   plutôt que de deviner silencieusement ou de ne rien proposer du tout.
function enrichirSpectacleParMontant(ss, entity, year, propositions, lignesReleve) {
  if (!propositions || propositions.length === 0) return;
  Logger.log('enrichirSpectacleParMontant (v2 date+seuil) — ' + propositions.length + ' proposition(s) à examiner');

  var devisTous = [];
  try {
    devisTous = (chargerTousLesDevisEntite(ss, entity, year).rows) || [];
  } catch(e) { Logger.log('enrichirSpectacleParMontant devis erreur: ' + e.message); }

  var ndfTous = [];
  try {
    var tabNdf = resolveTabName('NOTE DE FRAIS V', year, entity);
    if (tabNdf) {
      var rawNdf = getTab(ss, tabNdf);
      if (!rawNdf.error) {
        var liensPdfNdf2 = extraireLiensColonne(ss.getSheetByName(tabNdf), rawNdf.headers, 'Lien PDF');
        ndfTous = rawNdf.rows
          .map(function(r) { return normalizeRow(r, 'NDF', entity, liensPdfNdf2[r._rowIndex]); })
          .filter(function(r) { return r !== null; });
      }
    }
  } catch(e) { Logger.log('enrichirSpectacleParMontant ndf erreur: ' + e.message); }
  Logger.log('enrichirSpectacleParMontant — ' + devisTous.length + ' devis chargés, ' + ndfTous.length + ' NDF chargées');

  var TOLERANCE       = 0.02; // arrondis centimes
  var MONTANT_MIN      = 20;  // en-deçà, un montant seul n'identifie rien de fiable
  var FENETRE_DEVIS_J  = 180; // un paiement de cession peut arriver longtemps après l'événement
  var FENETRE_NDF_J    = 60;  // un remboursement de NDF suit en général de plus près

  // Garde-fou spécifique aux NDF : un virement de remboursement mentionne quasi
  // toujours le bénéficiaire dans son libellé ("Virement émis VIR INST vers Audrey
  // ..."). Si ce nom est identifiable ET ne correspond pas au salarié de la NDF
  // trouvée par montant/date, la coïncidence est fortuite — on rejette plutôt que
  // de proposer un remboursement à la mauvaise personne. Si le libellé ne permet
  // pas d'identifier de bénéficiaire, on ne bloque pas (pas de preuve contraire).
  function libelleCoherentAvecSalarie(libelle, nomSalarie) {
    if (!nomSalarie) return true;
    var libNorm = normaliserTexteCompta(libelle);
    var mots = normaliserTexteCompta(nomSalarie).split(' ').filter(function(m) { return m.length >= 3; });
    if (mots.length === 0 || !libNorm) return true;
    return mots.some(function(m) { return libNorm.indexOf(m) >= 0; });
  }

  // Cherche tous les candidats au bon montant, les classe par proximité de date
  // avec la ligne bancaire (les candidats dans la fenêtre passent avant les
  // autres), et retourne le meilleur + s'il reste ambigu (plusieurs candidats
  // dans la fenêtre de date, ou aucune date exploitable pour trancher).
  function evaluerCandidats(liste, montantAbs, dateLigne, getMontant, getDateStr, fenetreJours) {
    var parMontant = liste.filter(function(x) {
      var m = getMontant(x);
      return m > 0 && Math.abs(m - montantAbs) < TOLERANCE;
    });
    if (parMontant.length === 0) return null;

    var avecDiff = parMontant.map(function(x) {
      var dStr = getDateStr(x);
      var d = dStr ? parserDateFR(dStr) : null;
      var diffJours = (d && dateLigne) ? Math.abs((d - dateLigne) / 86400000) : null;
      return { item: x, diffJours: diffJours };
    });

    var dansFenetre = avecDiff.filter(function(o) { return o.diffJours !== null && o.diffJours <= fenetreJours; });
    var pool = dansFenetre.length > 0 ? dansFenetre : avecDiff; // repli : pas de date exploitable → tout le pool

    pool.sort(function(a, b) {
      if (a.diffJours === null && b.diffJours === null) return 0;
      if (a.diffJours === null) return 1;
      if (b.diffJours === null) return -1;
      return a.diffJours - b.diffJours;
    });

    return { item: pool[0].item, ambigu: pool.length > 1, nbCandidatsMontant: parMontant.length };
  }

  propositions.forEach(function(p) {
    // Une proposition déjà résolue par PIECE COMPTA arrive ici avec un
    // spectacle/projet connu mais parfois sans pièce exploitable (nom de
    // fichier sans URL valide). On ne raisonne alors qu'en piece_url pour
    // décider s'il reste quelque chose à compléter, afin de ne pas se
    // priver du vrai lien NDF/devis simplement parce que le projet est déjà
    // déterminé — mais sans jamais écraser ce projet déjà connu.
    var spectacleDejaConnu = !!p.spectacle;
    if (spectacleDejaConnu && p.piece_url) return; // entièrement résolu
    var ligne = lignesReleve[p.index];
    if (!ligne) return;
    var montantAbs = Math.abs(parseFloat(ligne.montant) || 0);
    if (!montantAbs) return;
    // Sous MONTANT_MIN, le montant seul n'identifie rien de fiable — mais un
    // remboursement de NDF reste vérifiable via le nom du salarié dans le
    // libellé bancaire (ex: "VIR FRAIS TRANSPORT LEBIJOUTIER" pour une NDF de
    // 5,60€ signée par Lebijoutier) : on n'écarte donc ici que le devis (pas
    // de garde-fou nominatif équivalent côté devis), la NDF restant tentée
    // plus bas avec une exigence de nom renforcée.
    var montantFaible = montantAbs < MONTANT_MIN;
    if (montantFaible) {
      Logger.log('  ligne ' + p.index + ' (' + montantAbs + '€) : sous le seuil de ' + MONTANT_MIN + '€ — devis ignoré, NDF tentée si le libellé nomme le salarié');
    }
    var dateLigne = ligne.date ? parserDateFR(ligne.date) : null;

    var resDevis = montantFaible ? null : evaluerCandidats(devisTous, montantAbs, dateLigne,
      function(d) { return d.montantTotal || d.montantHT || d.montantPrincipal || 0; },
      function(d) { return d.dateDebut || d.dateFin || ''; },
      FENETRE_DEVIS_J);
    if (resDevis) {
      var devisTrouve = resDevis.item;
      if (!spectacleDejaConnu) {
        p.spectacle = devisTrouve.spectacle || '';
        p.matchMontant = { type: 'devis', diffuseur: devisTrouve.diffuseur || '', ref: devisTrouve.id || '', ambigu: resDevis.ambigu };
        p.confiance = resDevis.ambigu ? 'basse' : (p.confiance === 'basse' ? 'moyenne' : p.confiance);
      }
      // Fournir le lien de la pièce pour vérification, sans écraser un lien déjà trouvé
      if (!p.piece_url) {
        p.piece_url = devisTrouve.pdfContrat || devisTrouve.pdfRecap || devisTrouve.pdfUrl || '';
        p.piece_nom = 'Devis' + (devisTrouve.diffuseur ? ' — ' + devisTrouve.diffuseur : (devisTrouve.id ? ' ' + devisTrouve.id : ''));
        if (!p.piece_url && devisTrouve.pdfRaw) p.piece_fichier_brut = devisTrouve.pdfRaw;
      }
      Logger.log('  ligne ' + p.index + ' (' + montantAbs + '€) : matché devis "' + p.spectacle + '" (ambigu=' + resDevis.ambigu + ', ' + resDevis.nbCandidatsMontant + ' candidat(s) au même montant)');
      return;
    }

    var resNdf = evaluerCandidats(ndfTous, montantAbs, dateLigne,
      function(n) { return n.montant || 0; },
      function(n) { return n.date || ''; },
      FENETRE_NDF_J);
    if (resNdf) {
      var ndfTrouve = resNdf.item;
      // Le garde-fou "nom du salarié dans le libellé" ne vaut que pour un virement
      // de remboursement (le libellé nomme le bénéficiaire). Pour un paiement par
      // carte, le libellé nomme le COMMERÇANT, jamais le salarié — appliquer le
      // garde-fou rejetterait alors systématiquement des matchs pourtant valides
      // (montant + date corrects). On s'appuie dans ce cas uniquement sur
      // montant/date, avec le même mécanisme d'ambiguïté que d'habitude.
      var estPaiementCarte = /paiement\s*(par\s*)?carte/i.test(ligne.libelle || '');
      // Sous MONTANT_MIN, le montant seul ne suffit jamais à identifier une
      // NDF de façon fiable (trop de petits montants ronds coïncident par
      // hasard) : le nom du salarié doit obligatoirement apparaître dans le
      // libellé, y compris pour un paiement carte (qui nomme normalement le
      // commerçant, pas le salarié — s'il nomme quand même le salarié ici,
      // tant mieux, sinon ce n'est pas assez fiable pour ce montant).
      var nomConfirme = libelleCoherentAvecSalarie(ligne.libelle, ndfTrouve.salarie);
      if (montantFaible ? !nomConfirme : (!estPaiementCarte && !nomConfirme)) {
        Logger.log('  ligne ' + p.index + ' (' + montantAbs + '€) : NDF "' + ndfTrouve.salarie + '" incohérente avec le libellé "' + (ligne.libelle||'') + '" — rejetée malgré montant/date');
        return;
      }
      if (!spectacleDejaConnu) {
        p.spectacle = ndfTrouve.spectacle || '';
        p.matchMontant = { type: 'ndf', salarie: ndfTrouve.salarie || '', id: ndfTrouve.id || '', ambigu: resNdf.ambigu };
        p.confiance = resNdf.ambigu ? 'basse' : (p.confiance === 'basse' ? 'moyenne' : p.confiance);
      }
      if (!p.piece_url) {
        p.piece_nom = 'NDF' + (ndfTrouve.salarie ? ' — ' + ndfTrouve.salarie : '');
        if (ndfTrouve.pdfUrl && ndfTrouve.pdfUrl.startsWith('http')) {
          p.piece_url = ndfTrouve.pdfUrl;
        } else if (ndfTrouve.pdfUrl) {
          // Nom de fichier connu mais pas d'URL directe : laisser le front résoudre
          // automatiquement via la recherche Drive (même mécanisme que la colonne
          // Pièce du tableau principal), plutôt qu'une saisie manuelle à l'aveugle.
          p.piece_fichier_brut = ndfTrouve.pdfUrl;
        }
      }
      Logger.log('  ligne ' + p.index + ' (' + montantAbs + '€) : matché NDF "' + p.spectacle + '" — ' + (ndfTrouve.salarie||'') + ' (ambigu=' + resNdf.ambigu + ')');
    } else {
      // Rien trouvé ni côté devis ni côté NDF pour ce montant : le plus souvent
      // parce qu'aucun devis/NDF n'a exactement ce total à ± quelques centimes
      // (les frais/la TVA peuvent faire dévier le total attendu), ou que le seul
      // candidat trouvé est hors de la fenêtre de date. Log dédié pour vérifier
      // rapidement lequel des deux cas s'applique, plutôt que de deviner.
      var plusProcheDevis = devisTous
        .map(function(d) { return { m: d.montantTotal || d.montantHT || d.montantPrincipal || 0, spectacle: d.spectacle }; })
        .filter(function(x) { return x.m > 0; })
        .sort(function(a, b) { return Math.abs(a.m - montantAbs) - Math.abs(b.m - montantAbs); })[0];
      Logger.log('  ligne ' + p.index + ' (' + montantAbs + '€) : aucun devis/NDF ne correspond exactement à ce montant.'
        + (plusProcheDevis ? ' Devis le plus proche par montant : ' + plusProcheDevis.m + '€ (' + (plusProcheDevis.spectacle||'') + '), écart de ' + Math.round(Math.abs(plusProcheDevis.m - montantAbs) * 100) / 100 + '€.' : ' Aucun devis chargé.'));
    }
  });

  // ── Étape 2 : NDF "Carte entreprise" à plusieurs tickets ──────────────────
  // Une NDF payée par carte entreprise peut regrouper plusieurs achats (un par
  // ticket joint) : chaque achat est réglé comme un paiement carte DISTINCT en
  // banque, donc aucune ligne bancaire individuelle n'égale le total de la NDF
  // (seule la somme de plusieurs lignes y correspond) — l'étape 1 ci-dessus ne
  // peut pas les matcher. On cherche donc, pour chaque NDF "Carte entreprise"
  // pas déjà matchée, une combinaison de paiements carte non matchés (dates
  // proches) dont la somme égale le total NDF, et on les lie tous ensemble.
  var idsNdfDejaMatches = {};
  propositions.forEach(function(p) {
    if (p.matchMontant && p.matchMontant.type === 'ndf' && p.matchMontant.id) idsNdfDejaMatches[p.matchMontant.id] = true;
  });

  var candidatsCarte = propositions
    .map(function(p, i) { return { p: p, i: i }; })
    .filter(function(o) {
      if (o.p.spectacle) return false; // déjà matchée (étape 1)
      var ligne = lignesReleve[o.p.index];
      if (!ligne) return false;
      return /paiement\s*(par\s*)?carte/i.test(ligne.libelle || '');
    })
    .map(function(o) {
      var ligne = lignesReleve[o.p.index];
      return { p: o.p, montant: Math.abs(parseFloat(ligne.montant) || 0), date: ligne.date ? parserDateFR(ligne.date) : null };
    })
    .filter(function(c) { return c.montant > 0; });

  var FENETRE_MULTI_J = 5;  // les tickets d'une même NDF sont réglés à des dates très proches
  var MAX_TICKETS      = 4; // borne la recherche combinatoire (reste petite : pool déjà filtré par date)

  // Cherche tous les sous-ensembles de `pool` (2 à MAX_TICKETS éléments) dont
  // la somme des montants égale `cible` (± tolérance). Permet de détecter
  // l'ambiguïté (plusieurs combinaisons possibles) plutôt que de deviner.
  function trouverCombinaisonsSomme(pool, cible) {
    var resultats = [];
    function explorer(depart, courant, sommeCourante) {
      if (courant.length >= 2 && Math.abs(sommeCourante - cible) < TOLERANCE) resultats.push(courant.slice());
      if (courant.length >= MAX_TICKETS || sommeCourante >= cible + TOLERANCE) return;
      for (var i = depart; i < pool.length; i++) {
        courant.push(pool[i]);
        explorer(i + 1, courant, sommeCourante + pool[i].montant);
        courant.pop();
      }
    }
    explorer(0, [], 0);
    return resultats;
  }

  ndfTous
    .filter(function(n) { return (n.categorie || '').toLowerCase().indexOf('carte entreprise') >= 0; })
    .filter(function(n) { return n.montant >= MONTANT_MIN && !idsNdfDejaMatches[n.id]; })
    .forEach(function(n) {
      var dateNdf = n.date ? parserDateFR(n.date) : null;
      var pool = candidatsCarte.filter(function(c) {
        return !c.date || !dateNdf || Math.abs((c.date - dateNdf) / 86400000) <= FENETRE_MULTI_J;
      });
      var combos = trouverCombinaisonsSomme(pool, n.montant);
      if (combos.length === 0) return;

      // Combinaison retenue : celle dont la date moyenne est la plus proche du NDF
      combos.sort(function(a, b) {
        function diffMoy(c) {
          if (!dateNdf) return 0;
          var diffs = c.map(function(x) { return x.date ? Math.abs((x.date - dateNdf) / 86400000) : 999; });
          return diffs.reduce(function(s, d) { return s + d; }, 0) / diffs.length;
        }
        return diffMoy(a) - diffMoy(b);
      });
      var meilleure = combos[0];
      var ambigu = combos.length > 1;

      meilleure.forEach(function(c) {
        c.p.spectacle = n.spectacle || '';
        c.p.matchMontant = { type: 'ndf-multi', salarie: n.salarie || '', id: n.id || '', ambigu: ambigu, nbTickets: meilleure.length };
        c.p.confiance = ambigu ? 'basse' : (c.p.confiance === 'basse' ? 'moyenne' : c.p.confiance);
        if (!c.p.piece_url) {
          c.p.piece_nom = 'NDF' + (n.salarie ? ' — ' + n.salarie : '') + ' (' + meilleure.length + ' tickets)';
          if (n.pdfUrl && n.pdfUrl.startsWith('http')) c.p.piece_url = n.pdfUrl;
          else if (n.pdfUrl) c.p.piece_fichier_brut = n.pdfUrl;
        }
        // Retirer du pool pour ne pas réutiliser ce paiement carte pour une autre NDF
        candidatsCarte.splice(candidatsCarte.indexOf(c), 1);
      });
      Logger.log('  NDF multi-tickets "' + n.spectacle + '" — ' + (n.salarie||'') + ' (' + n.montant + '€) : ' + meilleure.length + ' ligne(s) carte liée(s) (ambigu=' + ambigu + ')');
    });

  // ── Étape 3 : lots de virement groupé NDF (onglet VIREMENTS NDF) ──────────
  // Quand plusieurs NDF sont remboursées en un seul virement (bouton "💸
  // Virement groupé"), un lot "en attente de rapprochement" est créé avec le
  // montant total et la liste des NDF concernées (creerLotVirementNDF). On
  // cherche ici, parmi les lignes bancaires pas encore matchées, celle dont le
  // montant correspond exactement au total d'un lot en attente, dans une
  // fenêtre de dates raisonnable après sa création (le virement met un peu de
  // temps à apparaître en banque). Le rapprochement définitif du lot (STATUT +
  // DATE_RAPPROCHEMENT) n'est écrit qu'à la validation de l'import, pas ici
  // (cf. appendLignesCompta) — cette étape ne fait que proposer le match.
  var lotsNdfEnAttente = [];
  try { lotsNdfEnAttente = chargerLotsVirementNDFEnAttente(ss, entity); } catch(e) { Logger.log('enrichirSpectacleParMontant lots NDF erreur: ' + e.message); }

  if (lotsNdfEnAttente.length > 0) {
    var FENETRE_LOT_APRES_J = 45;
    propositions.forEach(function(p) {
      if (p.spectacle) return; // déjà matchée aux étapes précédentes
      var ligne = lignesReleve[p.index];
      if (!ligne) return;
      var montantAbs = Math.abs(parseFloat(ligne.montant) || 0);
      if (!montantAbs) return;
      var dateLigne = ligne.date ? parserDateFR(ligne.date) : null;

      var candidats = lotsNdfEnAttente.filter(function(lot) {
        if (Math.abs(lot.montantTotal - montantAbs) >= TOLERANCE) return false;
        if (dateLigne && lot.dateCreation) {
          var diffJ = (dateLigne - lot.dateCreation) / 86400000;
          if (diffJ < -1 || diffJ > FENETRE_LOT_APRES_J) return false; // un virement n'apparaît pas AVANT d'avoir été généré
        }
        return true;
      });
      if (candidats.length === 0) return;
      var lot = candidats[0];
      var ambigu = candidats.length > 1;

      p.spectacle = 'GENERAL'; // le lot couvre potentiellement plusieurs projets
      p.matchMontant = { type: 'lot-ndf', lotId: lot.lotId, lotRowIndex: lot._rowIndex, nbNdf: lot.nbNdf, ambigu: ambigu };
      p.confiance = ambigu ? 'basse' : (p.confiance === 'basse' ? 'moyenne' : p.confiance);
      if (!p.piece_nom) p.piece_nom = 'Virement groupé NDF (' + lot.nbNdf + ' NDF)';
      Logger.log('  ligne ' + p.index + ' (' + montantAbs + '€) : matchée au lot virement NDF ' + lot.lotId + ' (' + lot.nbNdf + ' NDF, ambigu=' + ambigu + ')');
    });
  }
}

// Fallback local : imputation par mots-clés si Claude API indisponible
function fallbackImputationLocale(lignes, piecesDrive) {

  // ── Rapprochement Drive par montant ───────────────────────────────────────
  // Extraire tous les montants présents dans les noms de fichiers Drive
  var piecesMontants = []; // [{montant, nom, url}]
  if (piecesDrive && piecesDrive.length > 0) {
    piecesDrive.forEach(function(p) {
      // Chercher montants dans le nom : 598,61 ou 598.61 ou 1 367,20
      var nom = p.nom || '';
      // Plusieurs patterns : "598,61" "1367,20" "1 367.20" "2518.53"
      var matches = nom.match(/(\d[\d\s]*[,.]\d{2})/g) || [];
      matches.forEach(function(m) {
        var n = parseFloat(m.replace(/\s/g,'').replace(',','.'));
        if (!isNaN(n) && n > 0) {
          piecesMontants.push({ montant: n, nom: nom, url: p.url || '', id: p.id || '' });
        }
      });
    });
  }

  function chercherPiece(montantReleve, libReleve) {
    if (!montantReleve || piecesMontants.length === 0) return null;
    var abs = Math.abs(montantReleve);
    var libUpper = (libReleve || '').toUpperCase();

    // 1. Match montant exact (tolérance 0.05€)
    var candidates = piecesMontants.filter(function(p) {
      return Math.abs(p.montant - abs) < 0.05;
    });
    if (candidates.length === 0) return null;
    if (candidates.length === 1) return candidates[0];

    // 2. Plusieurs montants identiques → affiner par libellé
    // Chercher des mots communs entre le libellé du relevé et le nom de la pièce
    var mots = libUpper.split(/\s+/).filter(function(m) { return m.length > 3; });
    var best = candidates.find(function(c) {
      var nomUp = (c.nom || '').toUpperCase();
      return mots.some(function(m) { return nomUp.indexOf(m) >= 0; });
    });
    return best || candidates[0];
  }

  var REGLES = [
    // Charges sociales
    { mots: ['audiens','auden'], compte: '645', op: 'Charges sociales AUDIENS' },
    { mots: ['urssaf','d2p'], compte: '442', op: 'Charges sociales URSSAF' },
