// Chercher les FDP du mois correspondant à une date de virement
// Préfixe ajouté par decoupage_pdf_fiches_paie.gs (OK_PREFIX là-bas) aux pages
// individuelles correctement découpées — doit rester identique entre les deux scripts.
var OK_PREFIX_DASHBOARD = 'OK ';

// Dossier Drive perso (Nico) contenant un raccourci par structure vers son
// dossier Fiches de paie ("FDP DIS", "FDP PALM", "FDP OM", "FDP MAN", et "FDP"
// tout court pour AMIIS — CLR n'y est pas, son DRIVE_FICHES_PAIE est déjà
// configuré directement). Utilisé en source prioritaire par chercherFDPDuMois
// car plus fiable/à jour que le champ CONFIG par structure.
var DOSSIER_RACCOURCIS_FDP = '1mzrez_1kmixg1xoBWEs_LobndvfE6QUD';

function resoudreDossierFDPViaRaccourcis(entity) {
  var nomAttendu = (entity === 'AMIIS' ? 'FDP' : 'FDP ' + entity).toUpperCase();
  try {
    var dossier = DriveApp.getFolderById(DOSSIER_RACCOURCIS_FDP);
    var fichiers = dossier.getFiles();
    while (fichiers.hasNext()) {
      var f = fichiers.next();
      if (f.getName().trim().toUpperCase() !== nomAttendu) continue;
      if (!f.isShortcut()) return null;
      var targetId = f.getTargetId();
      return DriveApp.getFolderById(targetId);
    }
  } catch(e) {
    Logger.log('resoudreDossierFDPViaRaccourcis erreur: ' + e.message);
  }
  return null;
}

function chercherFDPDuMois(ss, entity, dateVirement) {
  var cfg = getConfigMap(ss);
  var fid = cfg['DRIVE_FICHES_PAIE'];
  var root = null;
  var sourceDossier = '';
  try {
    root = resoudreDossierFDPViaRaccourcis(entity);
    if (root) sourceDossier = 'raccourci ' + (entity === 'AMIIS' ? 'FDP' : 'FDP ' + entity);
  } catch(e) {
    Logger.log('chercherFDPDuMois: échec résolution via raccourcis: ' + e.message);
  }
  if (!root) {
    if (!fid) return { error: 'DRIVE_FICHES_PAIE non configuré et aucun raccourci FDP trouvé pour ' + entity };
    try {
      root = DriveApp.getFolderById(fid);
    } catch(e) {
      return { error: 'DRIVE_FICHES_PAIE invalide (' + fid + '): ' + e.message };
    }
    sourceDossier = 'CONFIG DRIVE_FICHES_PAIE';
  }
  Logger.log('chercherFDPDuMois: source=' + sourceDossier + ' date=' + dateVirement + ' entity=' + entity);

  // Parser la date : "29/05/2026" → mois=5, annee=2026
  var parts = dateVirement ? dateVirement.split('/') : [];
  var mois  = parts.length >= 2 ? parseInt(parts[1]) : new Date().getMonth() + 1;
  var annee = parts.length >= 3 ? parseInt(parts[2]) : new Date().getFullYear();
  var aa    = String(annee).slice(2); // "26"
  var mm    = String(mois).padStart(2, '0'); // "05"

  // Mois précédent (les FDP sont souvent payées le mois suivant)
  var moisPaie  = mois;
  var anneePaie = annee;
  // Si virement en début de mois → FDP du mois précédent
  var jour = parts.length >= 1 ? parseInt(parts[0]) : 15;
  if (jour <= 10) {
    moisPaie--;
    if (moisPaie === 0) { moisPaie = 12; anneePaie--; }
  }
  var mmPaie = String(moisPaie).padStart(2,'0');
  var aaPaie = String(anneePaie).slice(2);

  try {
    var fdps = [];
    var trace = []; // trace lisible côté frontend (les Logger.log ne sont pas accessibles depuis le webapp)
    function log(msg) { Logger.log(msg); trace.push(msg); }
    log('Source dossier FDP : ' + sourceDossier);
    log('Recherche mmPaie=' + mmPaie + ' anneePaie=' + anneePaie + ' (annee virement=' + annee + ', mois virement=' + mm + ')');

    // Chercher le sous-dossier de l'année
    var yearFolders = root.getFolders();
    while (yearFolders.hasNext()) {
      var yf = yearFolders.next();
      var yfName = yf.getName().toUpperCase();
      log('Dossier année trouvé : "' + yf.getName() + '"');
      // "2026 CLR" ou "2025 CLR"
      if (!yfName.includes(String(annee)) && !yfName.includes(String(anneePaie))) {
        log('  → ignoré (ne contient ni ' + annee + ' ni ' + anneePaie + ')');
        continue;
      }

      // Chercher le sous-dossier du mois
      var monthFolders = yf.getFolders();
      while (monthFolders.hasNext()) {
        var mf = monthFolders.next();
        var mfName = mf.getName(); // "05-MAI-26 CLR"
        log('  Dossier mois trouvé : "' + mfName + '" — cherché : "' + mmPaie + '-"');
        // Ne matcher QUE le mois de paie calculé (mmPaie). L'ancien fallback qui
        // acceptait aussi le mois du virement (mm) sans condition faisait fusionner
        // les FDP de deux mois différents (ex: virement du 01/07 pour la paie de
        // juin — mmPaie=06 correctement calculé, mais le dossier 07-JUIL était
        // aussi accepté en même temps, mélangeant les deux mois).
        var isMatch = mfName.startsWith(mmPaie + '-');
        if (!isMatch) { log('    → ignoré (ne commence pas par "' + mmPaie + '-")'); continue; }
        log('    → MATCH');

        // Lister les FDP du dossier, dédupliquer sal+proj. Deux passes : d'abord les
        // fichiers "OK ..." (déjà découpés proprement), puis en secours les fichiers
        // "[DÉCOUPÉ] ..." (l'original renommé après traitement) SEULEMENT s'il n'existe
        // pas déjà une version "OK" pour ce même salarié+projet — utile quand la page
        // individuelle n'a jamais été régénérée alors que l'original est déjà marqué
        // comme traité.
        var files = mf.getFiles();
        var tousLesFichiers = [];
        var nbFichiers = 0;
        while (files.hasNext()) {
          var f = files.next();
          tousLesFichiers.push(f);
          nbFichiers++;
          log('      Fichier vu (brut) : "' + f.getName() + '"');
        }

        var vusSalProj = {}; // pour dédupliquer, rempli en 2 passes (OK d'abord, [DÉCOUPÉ] en secours)

        function traiterFichier(f, estFallback) {
          var nom = f.getName();
          log('      Fichier : "' + nom + '"' + (estFallback ? ' (secours [DÉCOUPÉ])' : ''));
          // "BP " (Bulletin de Paie) est le préfixe utilisé par certaines compagnies
          // (ex: DIS) au lieu de "FDP"/"fiche" — reconnu ici comme une FDP valide.
          var estBulletinPaie = /^bp\s/i.test(nom.trim());
          if (!nom.toLowerCase().includes('fdp') && !nom.toLowerCase().includes('fiche') && !estBulletinPaie) {
            log('        → ignoré (ne contient ni "fdp", "fiche" ni "bp" dans le nom)');
            return;
          }
          if (nom.toLowerCase().includes('inconnu')) {
            log('        → ignoré (page non identifiée "INCONNU")');
            return;
          }

          var parsed = parserNomFDP(nom);
          log('        → parsé : salarie="' + parsed.salarie + '" projet="' + parsed.projet + '"');
          if (!parsed.salarie || parsed.salarie === 'INCONNU') { log('        → ignoré (code salarié vide ou "INCONNU")'); return; }

          var key = (parsed.salarie + '|' + parsed.projet).toUpperCase();
          if (vusSalProj[key]) {
            log('        → doublon (déjà une version OK pour ce salarié+projet), ignoré');
            return;
          }
          log('        → RETENU' + (estFallback ? ' (via original [DÉCOUPÉ], à vérifier)' : ''));
          vusSalProj[key] = {
            nom:        nom,
            id:         f.getId(),
            url:        f.getUrl(),
            dossier:    mfName,
            salarie:    '421' + parsed.salarie,   // code complet ex: 421LUX
            salarieNom: parsed.salarieNom,          // Fanny LUXE
            projet:     parsed.codeProj || parsed.projet,
            projetNom:  parsed.projetNom,           // Miroir
            isDecoupe:  !!estFallback,
          };
        }

        // On ne traite QUE les fichiers "propres" — "OK ..." ou directement "FDP "/
        // "BP " sans aucun préfixe. Les fichiers "[DÉCOUPÉ] ..." sont l'ORIGINAL
        // multi-salariés avant découpage (ex: "[DÉCOUPÉ] FDP JUIN DIS.pdf") : leur
        // nom ne contient pas un code salarié individuel mais un mois/une entité,
        // que le parseur prenait à tort pour un salarié — on ne les traite donc
        // jamais, même en secours.
        tousLesFichiers.forEach(function(f) {
          if (f.getName().indexOf('[') < 0) traiterFichier(f, false);
        });

        log('    Total fichiers dans ce dossier : ' + nbFichiers);
        Object.values(vusSalProj).forEach(function(fdp) {
          fdps.push(fdp);
        });
      }
    }

    return { success: true, fdps: fdps, moisRecherche: mmPaie + '/' + anneePaie, trace: trace, source: sourceDossier };
  } catch(e) {
    Logger.log('chercherFDPDuMois erreur: ' + e.message);
    return { error: e.message };
  }
}

// Parser le nom d'une FDP : "FDP LUX LC.pdf" → {salarie:"LUX", projet:"LC"}
// "[DÉCOUPÉ] FDP AVR 26 CLR.pdf" → multi-salariés, pas de code direct
// Table codes projets CLR (depuis CODE COMPTA)
var CODE_PROJETS = {
  'CN':'Contes de noël','CM':'Contes en musique','EN':'Energie','HF':'Histoires de fil',
  'HQ':'HQPDA','CO':'Le Coquelicot','LR':'Le Rouge Gorge','MM':'Marcelle',
  'SU':'SPI','DM':'Dans ma valise','TR':'Le Triselectops','SI':'Silhouettes',
  'MI':'Miroir','ENS':'Ensembles','JE':'Le jardin extraordinaire','LT':'Vendanges',
  'EV':'Evoluteam','LPH':'Les petites histoires de l\'hiver','JVP':'Je vous parle d\'un temps',
  'DECA':'Décalés','LMI':'Les mitaines','LA':'Les autres','LE':'Légèreté',
  'BAL':'banane à lunettes','LC':'le clucs','FCT':'FCT','LPAH':'Les petites aventures de l\'hiver',
  'IEUF':'Il était une fois','SZ':'Super Zero','SO':'Souvenir','ME':'Mes émotions',
  'IEUL':'Il était un livre','CIEL':'Ciel',
};

// Table codes salariés CLR
var CODE_SALARIES = {
  'BAZ':'Malorie BAZIN','LUX':'Fanny LUXE','GAR':'Audrey GARESTE',
  'KAUF':'Pauline KAUFLING','BOUR':'Nicolas BOURDEIX','TIS':'Nathalie M\'RICA',
  'WAR':'Fred WARMULLA','RAM':'Emmanuelle RAMON','GHI':'Thibaud GHIDONE',
  'MAR':'Svetlana MARTINOVIC','MID':'Marine MIDY','BER':'','BOU':'',
  'CIN':'','DEL':'Simon DELGRANGE','HEQ':'','KAU':'','LAC':'',
};

function parserNomFDP(nom) {
  var base = nom.replace(/\.pdf$/i,'').replace(/\[.*?\]/g,'').trim();
  // Retire le préfixe "OK " ajouté par le script de découpage (decoupage_pdf_fiches_paie.gs,
  // OK_PREFIX) avant de parser — sinon "OK FDP MAR LR" se décale et "OK"/"FDP" sont pris
  // à tort pour le code salarié / le code projet.
  base = base.replace(/^OK\s+/i, '').trim();
  var parts = base.split(/\s+/).filter(function(p) { return p.length > 0; });

  // Format "BP [PROJET] [SALARIE].pdf" (Bulletin de Paie, ex: DIS) : préfixe et
  // ORDRE des codes inversés par rapport au format historique "FDP [SALARIE] [PROJET].pdf".
  var estFormatBP = parts[0] && parts[0].toUpperCase() === 'BP';
  if (estFormatBP) parts.shift();
  else if (parts[0] && parts[0].toUpperCase() === 'FDP') parts.shift();

  // Les 2 premiers tokens restants sont TOUJOURS salarié+projet (dans un ordre qui
  // dépend du format) — on ne les filtre jamais, même s'ils ressemblent à un mois ou
  // une entité (ex: le code salarié "MAR" = Martinovic/Marchal, pas Mars). Le filtre
  // mois/entité/année ne s'applique qu'aux tokens EN TROP au-delà de ces 2.
  var codeSal, codeProj;
  if (estFormatBP) {
    codeProj = parts[0] || '';
    codeSal  = parts[1] || '';
  } else {
    codeSal  = parts[0] || '';
    codeProj = parts[1] || '';
  }

  return {
    salarie:     codeSal,
    salarieNom:  CODE_SALARIES[codeSal.toUpperCase()] || '',
    projet:      codeProj,
    projetNom:   CODE_PROJETS[codeProj.toUpperCase()] || codeProj,
  };
}

// Extraire le texte d'un PDF
// Priorité : Adobe PDF Services (précis) → fallback Drive API v2 (OCR)
function extraireTextePDF(fileId) {
  // Adobe en priorité si configuré
  var props    = PropertiesService.getScriptProperties();
  var adobeKey = props.getProperty('ADOBE_CLIENT_ID');
  if (adobeKey) {
    var adobeResult = extraireTextePDFAdobe(fileId);
    if (adobeResult.success) return adobeResult;
    Logger.log('Adobe failed, fallback: ' + adobeResult.error);
  }
  // Fallback Drive API v2
  return extraireTextePDFv2(fileId);
}

// Extraction PDF via Drive API v2 + export REST (sans DocumentApp)
function extraireTextePDFv2(fileId) {
  var token = ScriptApp.getOAuthToken();
  var tmpId = null;

  try {
    // Télécharger le contenu binaire du PDF via l'API Drive
    var resp = UrlFetchApp.fetch(
      'https://www.googleapis.com/drive/v3/files/' + fileId + '?alt=media',
      { headers: { Authorization: 'Bearer ' + token }, muteHttpExceptions: true }
    );
    if (resp.getResponseCode() !== 200) {
      return { error: 'Download PDF: ' + resp.getResponseCode() };
    }
    var pdfBytes = resp.getContent(); // bytes bruts du PDF

    // Uploader en convertissant en Google Doc (sans passer par getBlob)
    var boundary = 'fdp_ocr_' + Date.now();
    var metaJson = JSON.stringify({
      name:     'tmp_ocr_' + fileId,
      mimeType: 'application/vnd.google-apps.document',
    });

    var header = '--' + boundary + '\r\n'
               + 'Content-Type: application/json; charset=UTF-8\r\n\r\n'
               + metaJson + '\r\n'
               + '--' + boundary + '\r\n'
               + 'Content-Type: application/pdf\r\n\r\n';
    var footer = '\r\n--' + boundary + '--';

    var bodyBytes = Utilities.newBlob(header).getBytes()
      .concat(Array.from ? Array.from(pdfBytes) : pdfBytes)
      .concat(Utilities.newBlob(footer).getBytes());

    var insertResp = UrlFetchApp.fetch(
      'https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart',
      {
        method: 'post',
        headers: {
          'Authorization': 'Bearer ' + token,
          'Content-Type':  'multipart/related; boundary="' + boundary + '"',
        },
        payload: bodyBytes,
        muteHttpExceptions: true,
      }
    );

    var insertData = JSON.parse(insertResp.getContentText());
    if (!insertData.id) {
      return { error: 'Insert v3: ' + insertResp.getContentText().substring(0, 200) };
    }
    tmpId = insertData.id;

    // Attendre la conversion
    Utilities.sleep(5000);

    // Exporter en texte plain
    var exportResp = UrlFetchApp.fetch(
      'https://www.googleapis.com/drive/v3/files/' + tmpId + '/export?mimeType=text/plain',
      { headers: { Authorization: 'Bearer ' + token }, muteHttpExceptions: true }
    );

    if (exportResp.getResponseCode() !== 200) {
      return { error: 'Export: ' + exportResp.getResponseCode() };
    }

    return { success: true, text: exportResp.getContentText('UTF-8'), method: 'drive_v3' };

  } catch(e) {
    return { error: 'extraireTextePDFv2: ' + e.message };
  } finally {
    if (tmpId) {
      try {
        UrlFetchApp.fetch(
          'https://www.googleapis.com/drive/v3/files/' + tmpId,
          { method: 'delete', headers: { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() }, muteHttpExceptions: true }
        );
      } catch(e) {}
    }
  }
}


// Convertit un montant textuel potentiellement à séparateur de milliers
// ("1 234,56", "1.234,56", "1234,56") en nombre. parseFloat seul tronque tout
// avant le séparateur de milliers (ex: "1 234,56" → 234.56), ce qui faussait
// silencieusement tout montant ≥ 1000€ extrait par OCR (brut, coût employeur,
// net versé).
function parserMontantFrancais(str) {
  if (!str) return 0;
  var s = str.toString().trim().replace(/\s/g, '');
  if (s.indexOf(',') >= 0) {
    // Virgule présente : c'est le séparateur décimal (format FR) — tout point
    // restant est alors un séparateur de milliers, à retirer.
    s = s.replace(/\./g, '').replace(',', '.');
  } else {
    // Pas de virgule : plusieurs points = milliers + décimale finale (le
    // dernier point sépare les décimales, les précédents sont des milliers).
    var parts = s.split('.');
    if (parts.length > 2) {
      var decimales = parts.pop();
      s = parts.join('') + '.' + decimales;
    }
  }
  return parseFloat(s) || 0;
}

// Capture un montant avec séparateur de milliers optionnel (espace ou point)
// suivi de exactement 2 décimales — ex: "1 234,56", "1.234,56", "79,43".
var RE_MONTANT = '(\\d{1,3}(?:[\\s.]\\d{3})*[,.]\\d{2})';

// Parser le texte d'une FDP pour extraire brut, coût employeur, salarié, projets
function parserTexteFDP(text) {
  var result = { salarie: '', brut: 0, coutEmp: 0, netVerse: 0, projets: [] };
  if (!text) return result;

  var clean = text.replace(/\r/g, '').replace(/[ \t]+/g, ' ');

  // ── MONTANT BRUT ── "MONTANT BRUT 50,00" ou "Salaire brut 50,00"
  var mBrut = clean.match(new RegExp('MONTANT\\s+BRUT\\s+' + RE_MONTANT, 'i'))
           || clean.match(new RegExp('Salaire\\s+brut\\s+' + RE_MONTANT, 'i'));
  if (mBrut) result.brut = parserMontantFrancais(mBrut[1]);

  // ── COÛT EMPLOYEUR ── "Total versé par l'employeur 79,43 €" (format Spaiectacle).
  // Sur certaines fiches, la mise en page en colonnes fait que l'OCR restitue les
  // mots dans un ordre différent — "l'employeur" peut apparaître AVANT "Total versé
  // par" au lieu de juste après (ex: "...l'employeur / Net payé / 77,86 € / Total
  // versé par / 158,24 €"). Le "l'employeur" est donc rendu optionnel juste après
  // "par" : on se base sur "Total versé par [montant]" qui, lui, reste toujours
  // adjacent au bon chiffre quel que soit l'ordre de lecture du reste de la page.
  var mEmp = clean.match(new RegExp('[Tt]otal\\s+vers[ée]\\s+par\\s+(?:l.employeur\\s+)?' + RE_MONTANT, 'i'))
          || clean.match(new RegExp('[Tt]otal\\s+employeur\\s*[:\\s]?\\s*' + RE_MONTANT, 'i'))
          || clean.match(new RegExp('[Cc]o[uû]t\\s+(?:total\\s+)?employeur\\s*[:\\s]?\\s*' + RE_MONTANT, 'i'));
  if (mEmp) result.coutEmp = parserMontantFrancais(mEmp[1]);

  // ── NET VERSÉ ── "38,92 €  Total versé" → prendre le montant juste avant
  var mNet = clean.match(new RegExp(RE_MONTANT + '\\s*€\\s*Total\\s+vers', 'i'))
          || clean.match(new RegExp('NET\\s+A\\s+PAYER[^\\d]*' + RE_MONTANT, 'i'));
  if (mNet) result.netVerse = parserMontantFrancais(mNet[1]);

  // ── SALARIÉ ── "Metteur en scène Fanny LUXE Artiste" → chercher après l'emploi
  // Pattern : mot(s) d'emploi puis Prénom NOM-majuscules
  // Format Spaiectacle : "[Fonction variable] Fanny LUXE Artiste Cadre"
  // Le salarié est TOUJOURS juste avant "Artiste" ou "Cadre" ou "Non-cadre"
  // Pattern : Prénom (1 maj + minuscules) NOM (tout majuscules) suivi du statut
  var mSal = clean.match(/([A-ZÀÂÉÈÊËÎÏÔÙÛÜ][a-zàâéèêëîïôùûü]+-?[a-zàâéèêëîïôùûü]*)\s+([A-ZÀÂÉÈÊËÎÏÔÙÛÜ]{2,15})\s+(?:Artiste|Cadre|Non.cadre|Intermittent)/i);
  if (mSal) {
    result.salarie = mSal[1] + ' ' + mSal[2];
  } else {
    // Fallback : chercher "Prénom NOM" en évitant les faux positifs connus
    var EXCLUSIONS = ['Code APE', 'COLLECTIF LES', 'Convention Collective', 'Congés Sp', 'Numéro objet'];
    var mSal2 = clean.match(/\b([A-ZÀÂÉÈÊËÎÏÔÙÛÜ][a-zàâéèêëîïôùûü]{1,15})\s+([A-ZÀÂÉÈÊËÎÏÔÙÛÜ]{2,15})\b/g) || [];
    for (var si = 0; si < mSal2.length; si++) {
      var candidate = mSal2[si];
      var excluded = EXCLUSIONS.some(function(e) { return clean.indexOf(candidate) === clean.indexOf(e.split(' ')[0]); });
      if (!excluded && candidate.split(' ').length === 2) {
        result.salarie = candidate;
        break;
      }
    }
  }

  // ── PROJET ── "Analytique Mes émotions" (Spaiectacle)
  var mProj = clean.match(/Analytique\s+([A-ZÀÂÉÈÊËa-zàâéèêëîïôùûü][^\n\r\d]{2,35}?)(?=\s{2,}|\s*[A-Z]{3,}|$)/m);
  if (!mProj) mProj = clean.match(/Analytique\s+(.{3,35}?)(?:\s{2}|\n)/);
  if (mProj) {
    var proj = mProj[1].trim();
    if (proj.length > 2) result.projets.push(proj);
  }

  Logger.log('Parser FDP: brut=' + result.brut + ' coutEmp=' + result.coutEmp
    + ' net=' + result.netVerse + ' salarie=' + result.salarie
    + ' projets=' + JSON.stringify(result.projets));

  return result;
}

// Action GAS : chercher + extraire les FDP d'un mois
function getFDPDuMois(ss, entity, dateVirement, extraireTexte) {
  var recherche;
  try {
    recherche = chercherFDPDuMois(ss, entity, dateVirement);
  } catch(e) {
    Logger.log('chercherFDPDuMois erreur: ' + e.message + ' ligne: ' + e.lineNumber);
    return { error: 'chercherFDPDuMois: ' + e.message };
  }
  if (!recherche) return { error: 'chercherFDPDuMois retourne undefined' };
  if (recherche.error) return recherche;

  var fdps = recherche.fdps || [];

  // Extraction texte OCR — automatique sur les FDP individuelles (pas les découpées)
  var fdpsAExtraire = fdps; // tous sont déjà individuels (découpés exclus à la source)
  var texteOCRParFichier = {}; // nom de fichier -> texte brut extrait, pour debug côté dashboard
  Logger.log('getFDPDuMois: ' + fdps.length + ' FDP trouvées, extraireTexte=' + extraireTexte);
  if (fdpsAExtraire.length > 0 && extraireTexte && fdpsAExtraire.length <= 20) {
    fdpsAExtraire.forEach(function(fdp) {
      try {
        var extraction = extraireTextePDF(fdp.id);
        if (extraction.success) {
          texteOCRParFichier[fdp.nom] = extraction.text;
          var parsed = parserTexteFDP(extraction.text);
          if (parsed.brut     > 0) fdp.brut     = parsed.brut;
          if (parsed.coutEmp  > 0) fdp.coutEmp  = parsed.coutEmp;
          if (parsed.netVerse > 0) fdp.netVerse  = parsed.netVerse;
          if (parsed.salarie && !fdp.salarie) fdp.salarie = parsed.salarie;
          if (parsed.projets && parsed.projets.length > 0) fdp.projetsExtraits = parsed.projets;
          Logger.log('FDP ' + fdp.nom + ' → brut=' + fdp.brut + ' coutEmp=' + fdp.coutEmp);
        } else {
          texteOCRParFichier[fdp.nom] = '(échec extraction : ' + (extraction.error || 'inconnu') + ')';
        }
      } catch(e) {
        texteOCRParFichier[fdp.nom] = '(erreur : ' + e.message + ')';
        Logger.log('OCR erreur sur ' + fdp.nom + ': ' + e.message);
      }
    });
  } else if (fdpsAExtraire.length > 15) {
    Logger.log('Trop de FDP (' + fdpsAExtraire.length + ') pour OCR auto — extraction manuelle');
  }

  // Calculer le total net versé des FDP extraites
  var totalNetFDP   = 0;
  var totalCoutEmp  = 0;
  fdps.forEach(function(f) {
    if (f.netVerse) totalNetFDP  += f.netVerse;
    if (f.coutEmp)  totalCoutEmp += f.coutEmp;
  });

  return {
    success:       true,
    fdps:          fdps,
    moisRecherche: recherche.moisRecherche,
    totalNetFDP:   Math.round(totalNetFDP  * 100) / 100,
    totalCoutEmp:  Math.round(totalCoutEmp * 100) / 100,
    trace:         recherche.trace || [],
    texteOCR:      texteOCRParFichier,
  };
}


