function getTousComptesGroupe() {
  var tous = {};
  Object.keys(COMPTES_GROUPE).forEach(function(k) { tous[k] = COMPTES_GROUPE[k]; });
  var dyn = getComptesGroupeDynamiques();
  Object.keys(dyn).forEach(function(k) { if (!tous[k]) tous[k] = dyn[k]; });
  return tous;
}

