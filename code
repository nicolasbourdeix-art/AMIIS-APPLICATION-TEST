// =============================================================================

// Retire les lignes venant d'un onglet historique (DAPE, DPAE V2, DECLA…) quand la
// MÊME déclaration existe déjà dans l'onglet Contrats (qui fait foi : DPAE_OK, FACTURE
// à jour). Clé de rapprochement : salarié + date de début + projet, normalisés.
function dedupliquerParContrats(rows) {
  // La clé de rapprochement ne peut pas comparer les noms tels quels : l'onglet
  // historique (DAPE, DPAE V2…) stocke le salarié en code abrégé ("MID"), alors que
  // Contrats utilise le nom complet ("MIDY Marine"). On compare donc sur les 3
  // premières lettres du nom (majuscules, sans accents) + la date de début — le
  // projet est exclu de la clé car lui aussi peut être codé différemment (ex: "MES"
  // vs "Marionnettes en scène").
  function normaliserNom(s) {
    return (s || '').toString().trim().toUpperCase()
      .normalize('NFD').replace(/[\u0300-\u036f]/g, '') // retire les accents
      .substring(0, 3);
  }
  function cle(r) {
    return normaliserNom(r.salarie) + '|' + (r.debut || '').toString().trim();
  }
  var clesContrats = {};
  rows.forEach(function(r) {
    if (r._sourceSheet === 'Contrats') clesContrats[cle(r)] = true;
  });
  return rows.filter(function(r) {
    if (r._sourceSheet === 'Contrats') return true;
    return !clesContrats[cle(r)];
  });
}

function ensureDpaeOkColumn(sheet) {
  if (!sheet) return;
  const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  const exists  = headers.some(h => h.toString().trim() === 'DPAE_OK');
  if (exists) return;
  const newCol      = sheet.getLastColumn() + 1;
  const headerCell  = sheet.getRange(1, newCol);
  headerCell.setValue('DPAE_OK');
  headerCell.setFontWeight('bold');
  headerCell.setBackground('#27AE60');
  headerCell.setFontColor('#ffffff');
  Logger.log('Colonne DPAE_OK créée dans ' + sheet.getName() + ' — colonne ' + newCol);
}

function ensureFactureCol(sheet) {
  if (!sheet) return -1;
  const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  var idx = -1;
  headers.forEach(function(h, i) { if ((h || '').toString().trim() === 'FACTURE') idx = i; });
  if (idx >= 0) return idx + 1; // 1-indexé

  const newCol      = sheet.getLastColumn() + 1;
  const headerCell  = sheet.getRange(1, newCol);
  headerCell.setValue('FACTURE');
  headerCell.setFontWeight('bold');
  headerCell.setBackground('#F5A623');
  headerCell.setFontColor('#ffffff');
  Logger.log('Colonne FACTURE créée dans ' + sheet.getName() + ' — colonne ' + newCol);
  return newCol;
}

// Entités facturées "à la fiche de paie" (comme Paie AMIIS), dont les FDP vivent dans leur propre Sheet
var ENTITES_FACTURATION_FDP = ['MAN', 'PALM'];

function getFacturationEntite(ss, entity, year) {
  if (ENTITES_FACTURATION_FDP.indexOf(entity) < 0) return { error: 'Module non disponible pour ' + entity };

  var sheet = ss.getSheetByName('Contrats');
  if (!sheet) return { error: 'Onglet Contrats introuvable pour ' + entity };

  ensureDpaeOkColumn(sheet);
  var colFacture = ensureFactureCol(sheet);

  var raw = getTab(ss, 'Contrats');
  if (raw.error) return { error: raw.error };

  var rows = raw.rows
    .filter(function(r) {
      var ok = r['DPAE_OK'];
      return ok === true || ok === 'TRUE' || ok === 'OUI';
    })
    .map(function(r) {
      var n = normalizeRow(r, 'CONTRATS', entity);
      if (!n) return null;
      var acc = r['ACCOMPAGNEMENT'];
      n.tarif   = (acc === true || acc === 'TRUE') ? 13 : 12;
      n.facture = r['FACTURE'] === true || r['FACTURE'] === 'TRUE' || r['FACTURE'] === 'OUI';
      return n;
    })
    .filter(function(r) { return r !== null; })
    .filter(function(r) {
      if (!r.debut) return false;
      var parts = r.debut.split('/');
      return parts.length === 3 && parseInt(parts[2]) === (parseInt(year) || new Date().getFullYear());
    });

  var nbAFacturer  = rows.filter(function(r) { return !r.facture; }).length;
  var montantDu    = rows.filter(function(r) { return !r.facture; }).reduce(function(s, r) { return s + r.tarif; }, 0);

  return { success: true, rows: rows, totaux: { nb: rows.length, nbAFacturer: nbAFacturer, montantDu: Math.round(montantDu * 100) / 100 } };
}

function toggleFactureEntite(ss, sourceSheet, rowIndex, valeur) {
  var ri = parseInt(rowIndex, 10);
  if (!ri || ri < 2) return { error: 'rowIndex invalide' };
  if (!sourceSheet) return { error: 'Onglet source manquant' };
  var sheet = ss.getSheetByName(sourceSheet);
  if (!sheet) return { error: 'Onglet ' + sourceSheet + ' introuvable' };
  var col = ensureFactureCol(sheet);
  try {
    sheet.getRange(ri, col).setValue(!!valeur);
    return { success: true };
  } catch(e) {
    return { error: 'Ecriture facture: ' + e.message };
  }
}

