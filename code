// RECHERCHE PDF NOTE DE FRAIS PAR NOM DE FICHIER
// =============================================================================

function getNDFPdfUrl(entity, nomFichier) {
  if (!nomFichier) return { error: 'Nom de fichier requis' };
  // Si c'est déjà une URL -> retourner directement
  if (nomFichier.startsWith('http')) return { success: true, url: nomFichier };

  const ss  = getSheetById(entity);
  if (!ss) return { error: 'Entity introuvable' };
  const cfg = getConfigMap(ss);

  // Chercher dans DRIVE_NDF d'abord, puis DRIVE_FICHES_PAIE en fallback
  const folderIds = [cfg['DRIVE_NDF'], cfg['DRIVE_FICHES_PAIE']].filter(Boolean);
  if (folderIds.length === 0) return { error: 'DRIVE_NDF non configuré pour ' + entity };

  const nomCherche = nomFichier.toLowerCase().replace(/\.pdf$/i, '');
  const dateDebutNdf = new Date().getTime();
  const DELAI_MAX_NDF_MS = 20000; // au-delà, on arrête pour ne pas bloquer l'utilisateur indéfiniment

  for (var f = 0; f < folderIds.length; f++) {
    if (new Date().getTime() - dateDebutNdf > DELAI_MAX_NDF_MS) break;
    try {
      const folder = DriveApp.getFolderById(folderIds[f]);
      // Recherche scopée au dossier (rapide) plutôt que sur tout le Drive
      const query = 'name contains "' + nomCherche.replace(/"/g, '') + '" and mimeType = "application/pdf" and trashed = false';
      const files = folder.searchFiles(query);
      while (files.hasNext()) {
        const file = files.next();
        const fileName = file.getName().toLowerCase().replace(/\.pdf$/i, '');
        if (fileName === nomCherche || file.getName() === nomFichier) {
          return { success: true, url: file.getUrl(), fileId: file.getId() };
        }
      }
      // Fallback : scanner le dossier (sous-dossiers), borné dans le temps
      const found = scanForFile(folder, nomFichier, dateDebutNdf, DELAI_MAX_NDF_MS);
      if (found) return { success: true, url: found.getUrl(), fileId: found.getId() };
    } catch(e) {
      Logger.log('getNDFPdfUrl erreur dossier ' + folderIds[f] + ' : ' + e.message);
    }
  }
  return { error: 'Fichier introuvable (ou recherche interrompue après 20s) : ' + nomFichier };
}

function scanForFile(folder, nomFichier, dateDebut, delaiMaxMs) {
  if (dateDebut && delaiMaxMs && (new Date().getTime() - dateDebut > delaiMaxMs)) return null;
  var files = folder.getFiles();
  while (files.hasNext()) {
    var f = files.next();
    if (f.getName() === nomFichier) return f;
    if (dateDebut && delaiMaxMs && (new Date().getTime() - dateDebut > delaiMaxMs)) return null;
  }
  var subs = folder.getFolders();
  while (subs.hasNext()) {
    var found = scanForFile(subs.next(), nomFichier, dateDebut, delaiMaxMs);
    if (found) return found;
    if (dateDebut && delaiMaxMs && (new Date().getTime() - dateDebut > delaiMaxMs)) return null;
  }
  return null;
}

// =============================================================================
// RECHERCHE CONTRATS SIGNÉS
// =============================================================================

function chercherContratsSigne(entity, salarie, projet, mois, annee) {
  const ss = getSheetById(entity);
  if (!ss) return { error: 'Entity introuvable: ' + entity };
  const cfg      = getConfigMap(ss);
  const folderId = cfg['DRIVE_CONTRATS'];
  if (!folderId) return { error: 'DRIVE_CONTRATS non configure pour ' + entity };
  try {
    const MOIS_FR  = ['JAN','FEV','MAR','AVR','MAI','JUIN','JUIL','AOUT','SEP','OCT','NOV','DEC'];
    const moisStr  = MOIS_FR[parseInt(mois) - 1] || '';
    const anneeStr = String(annee).slice(2);

    // Un même salarié a souvent plusieurs contrats le même mois (un par
    // projet, ex: "CONTRAT OM SEPT 26 BAB CIN" vs "...BRASS CIN") — un match
    // en sous-chaîne partout dans le nom ne suffit pas à les départager.
    // On exige donc un token EXACT (isolé entre espaces/tirets/underscores)
    // pour le score fort, avec un repli faible en sous-chaîne.
    function initiales(champ) {
      var inits = [];
      (champ || '').toUpperCase().replace(/[^A-Z\s]/g, '').trim().split(/\s+/).forEach(function(m) {
        if (m.length >= 3) inits.push(m.substring(0, 3));
        if (m.length >= 4) inits.push(m.substring(0, 4));
      });
      return inits;
    }
    var initSal  = initiales(salarie);
    var initProj = initiales(projet);

    const candidats = [];
    function scanFolder(folder) {
      const files = folder.getFiles();
      while (files.hasNext()) {
        var file = files.next();
        var nom  = file.getName().toUpperCase();
        // La plateforme de signature électronique nomme parfois le fichier
        // signé avec l'email du signataire ("-E.LIOTARDKH_GMAIL.COM.pdf", "@"
        // remplacé par "_") — /-[A-Z0-9]+_/ cassait dès que la partie locale
        // de l'email contenait un point (ex: "e.liotardkh"), le "." coupant
        // la suite de caractères juste après le tiret avant d'atteindre le
        // "_" : confirmé en comparant avec de vrais fichiers Drive signés
        // (DIS) où cette personne précise ne se liait jamais alors que
        // d'autres, à email sans point, fonctionnaient. Le point est
        // désormais accepté dans la suite de caractères.
        var estSigne = nom.indexOf('_SIGNE') !== -1 ||
                       (nom.indexOf('-') !== -1 && (nom.indexOf('@') !== -1 || nom.match(/-[A-Z0-9.]+_/)));
        if (!estSigne) continue;

        var tokens = nom.replace(/\.PDF$/, '').split(/[\s_\-]+/).filter(Boolean);
        function scorerChamp(inits, label) {
          var best = 0, raison = '';
          tokens.forEach(function(tok) {
            inits.forEach(function(init) {
              var pts = tok === init ? (init.length >= 4 ? 8 : 6) : (tok.indexOf(init) !== -1 ? 2 : 0);
              if (pts > best) { best = pts; raison = label + '(' + init + (tok === init ? ' exact' : '') + ')'; }
            });
          });
          return { pts: best, raison: raison };
        }

        var scoreSal  = scorerChamp(initSal,  'sal');
        var scoreProj = scorerChamp(initProj, 'proj');
        var score = scoreSal.pts + scoreProj.pts;
        var raisons = [];
        if (nom.indexOf(entity.toUpperCase()) !== -1) { score += 3; raisons.push('compagnie'); }
        if (moisStr  && nom.indexOf(moisStr)  !== -1) { score += 3; raisons.push('mois'); }
        if (anneeStr && nom.indexOf(anneeStr) !== -1) { score += 1; raisons.push('annee'); }
        if (scoreSal.raison)  raisons.push(scoreSal.raison);
        if (scoreProj.raison) raisons.push(scoreProj.raison);
        if (score > 0) candidats.push({ nom: file.getName(), url: file.getUrl(), score, raisons: raisons.join(', ') });
      }
      const subFolders = folder.getFolders();
      while (subFolders.hasNext()) scanFolder(subFolders.next());
    }
    const rootFolder = DriveApp.getFolderById(folderId);
    scanFolder(rootFolder);
    candidats.sort(function(a, b) { return b.score - a.score; });
    return { success: true, candidats: candidats.slice(0, 5), nbTotal: candidats.length };
  } catch(err) { return { error: err.message }; }
}

// Classement en masse des contrats signés — même principe que classerFichesPaie :
// scanne une seule fois tout le dossier DRIVE_CONTRATS, puis pour chaque ligne de
// déclaration sans contrat déjà lié, score les fichiers (même heuristique que
// chercherContratsSigne : compagnie/mois/année/initiales salarié+projet) et lie
// automatiquement quand un candidat domine nettement, sinon laisse la ligne pour
// une recherche manuelle via le bouton "🔍 Chercher" existant.
function classerContratsSigne(entity, annee) {
  const ss = getSheetById(entity);
  if (!ss) return { error: 'Entity introuvable: ' + entity };
  const cfg      = getConfigMap(ss);
  const folderId = cfg['DRIVE_CONTRATS'];
  if (!folderId) return { error: 'DRIVE_CONTRATS non configure pour ' + entity };
  const anneeInt = parseInt(annee) || new Date().getFullYear();

  var trace = [];
  function tlog(msg) { Logger.log(msg); trace.push(msg); }

  var rootFolder;
  try { rootFolder = DriveApp.getFolderById(folderId); }
  catch(e) { return { error: 'DRIVE_CONTRATS invalide (' + folderId + '): ' + e.message }; }
  tlog('Dossier racine : "' + rootFolder.getName() + '"');

  var fichiers = [];
  function scanFolder(folder) {
    var files = folder.getFiles();
    while (files.hasNext()) {
      var f   = files.next();
      var nom = f.getName().toUpperCase();
      // Voir le commentaire équivalent dans chercherContratsSigne : le point
      // dans la partie locale d'un email ("e.liotardkh") cassait la regex.
      var estSigne = nom.indexOf('_SIGNE') !== -1 ||
                     (nom.indexOf('-') !== -1 && (nom.indexOf('@') !== -1 || nom.match(/-[A-Z0-9.]+_/)));
      if (estSigne) fichiers.push({ nom: nom, nomOriginal: f.getName(), url: f.getUrl() });
    }
    var subs = folder.getFolders();
    while (subs.hasNext()) scanFolder(subs.next());
  }
  scanFolder(rootFolder);
  tlog(fichiers.length + ' fichier(s) "contrat signé" trouvé(s) au total dans le Drive');
  if (fichiers.length === 0) return { success: true, lies: 0, dejaSignes: 0, nonTrouves: 0, trace: trace };

  // Format réel observé chez OM : "CONTRAT OM SEPT 26 <PROJET> <SALARIE>[_SIGNE].pdf"
  // — même salarié présent dans plusieurs fichiers du même mois (un par projet),
  // donc un simple "le code apparaît quelque part" (ancien +2/+1 fixes) ne
  // suffit pas à départager BAB/CIN de BRASS/CIN : on exige un token EXACT
  // (le code isolé entre espaces/tirets/underscores, pas une sous-chaîne
  // noyée dans un mot plus long) pour le score fort, avec un repli faible en
  // sous-chaîne pour ne pas perdre les cas où le découpage en tokens échoue.
  var MOIS_FR = ['JAN','FEV','MAR','AVR','MAI','JUIN','JUIL','AOUT','SEP','OCT','NOV','DEC'];
  function scorer(f, salarie, projet, moisLigne, anneeLigne) {
    var moisStr  = MOIS_FR[moisLigne - 1] || '';
    var anneeStr = String(anneeLigne).slice(2);
    var tokens = f.nom.replace(/\.PDF$/, '').split(/[\s_\-]+/).filter(Boolean);

    function initiales(champ) {
      var inits = [];
      (champ || '').toUpperCase().replace(/[^A-Z\s]/g, '').trim().split(/\s+/).forEach(function(m) {
        if (m.length >= 3) inits.push(m.substring(0, 3));
        if (m.length >= 4) inits.push(m.substring(0, 4));
      });
      return inits;
    }
    function scorerChamp(inits) {
      var best = 0;
      tokens.forEach(function(tok) {
        inits.forEach(function(init) {
          if (tok === init) best = Math.max(best, init.length >= 4 ? 8 : 6);
          else if (tok.indexOf(init) !== -1) best = Math.max(best, 2);
        });
      });
      return best;
    }

    var scoreSal  = scorerChamp(initiales(salarie));
    var scoreProj = scorerChamp(initiales(projet));
    var moisMatch = !!(moisStr && f.nom.indexOf(moisStr) !== -1);
    var score = scoreSal + scoreProj;
    if (f.nom.indexOf(entity.toUpperCase()) !== -1) score += 3;
    if (moisMatch) score += 3;
    if (anneeStr && f.nom.indexOf(anneeStr) !== -1) score += 1;
    return { score: score, scoreSal: scoreSal, moisMatch: moisMatch };
  }

  // Mêmes onglets/colonnes que classerFichesPaie — les déclarations de chaque
  // structure vivent dans les mêmes feuilles pour la paie et les contrats.
  var ONGLETS_PAR_ENTITE = {
    'CLR':  [ { nom: 'DECLA',    colSal: -1, colProj: -1, colDate: -1 },
              { nom: 'DPAE_CLR', colSal: -1, colProj: -1, colDate: -1 } ],
    'PALM': [ { nom: 'DECLA',    colSal: -1, colProj: -1, colDate: -1 },
              { nom: 'Contrats', colSal: -1, colProj: -1, colDate: -1 } ],
    'MAN':  [ { nom: 'DAPE',     colSal: 3,  colProj: 4,  colDate: 6 },
              { nom: 'Contrats', colSal: -1, colProj: -1, colDate: -1 } ],
    'OM':   [ { nom: 'DPAE 2025', colSal: -1, colProj: -1, colDate: -1 } ],
    'DIS':  [ { nom: 'DPAE V2',  colSal: 3,  colProj: 7,  colDate: 4 },
              { nom: 'Contrats', colSal: -1, colProj: -1, colDate: -1 } ],
    'AMIIS':[ { nom: 'Réponses au formulaire 1', colSal: -1, colProj: -1, colDate: -1 } ],
  };
  var COL_SAL_NAMES  = ['Pour qui est fait la déclaration ? ', 'Salarié', 'Salarie', 'pour qui faite vous la déclaration ? ', 'SALARIE'];
  var COL_PROJ_NAMES = ['Projet ', 'Projet', 'Quel projet ? ', 'SPECTACLE'];
  var COL_DATE_NAMES = ['Date début du contrat ', 'Date début', 'Date debut', 'date de début ', 'Date début du contrat'];
  function findCol(headers, names) {
    for (var n = 0; n < names.length; n++) {
      for (var h = 0; h < headers.length; h++) {
        if (headers[h].toString().trim() === names[n].trim()) return h;
      }
    }
    return -1;
  }

  var SEUIL_MIN = 4, SEUIL_DOMINANT = 2;
  var nbLies = 0, nbNonTrouves = 0, nbDejaSignes = 0;
  // Diagnostic affiché dans le popup (pas besoin d'aller chercher dans les
  // exécutions Apps Script) : combien de lignes avaient un prénom seul, et
  // combien ont pu être résolues en nom complet via SALARIES_PAIE/CODE COMPTA.
  var nbPrenomSeul = 0, nbResolus = 0;
  var exemplesResolus = [], exemplesNonResolus = [];
  var onglets = ONGLETS_PAR_ENTITE[entity] || [];
  if (onglets.length === 0) tlog('Aucun onglet de déclaration configuré pour ' + entity);

  onglets.forEach(function(cfgOnglet) {
    var sheet = ss.getSheetByName(cfgOnglet.nom);
    if (!sheet) { tlog('Onglet introuvable : "' + cfgOnglet.nom + '"'); return; }
    var lastRow = sheet.getLastRow();
    if (lastRow < 2) return;
    var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    var colSal  = cfgOnglet.colSal  !== -1 ? cfgOnglet.colSal  : findCol(headers, COL_SAL_NAMES);
    var colProj = cfgOnglet.colProj !== -1 ? cfgOnglet.colProj : findCol(headers, COL_PROJ_NAMES);
    var colDate = cfgOnglet.colDate !== -1 ? cfgOnglet.colDate : findCol(headers, COL_DATE_NAMES);
    tlog('Onglet "' + cfgOnglet.nom + '" : colSal=' + colSal + ' colProj=' + colProj + ' colDate=' + colDate);
    if (colSal === -1) { tlog('  → colonne salarié introuvable, onglet ignoré'); return; }

    // Même colonne cible que lierContratSigne (POST) : "Lien PDF" pour l'onglet
    // Contrats, "CONTRAT SIGNEE" partout ailleurs.
    var colNameSigne = cfgOnglet.nom === 'Contrats' ? 'Lien PDF' : 'CONTRAT SIGNEE';
    var colSigne = headers.findIndex(function(h) { return h.toString().trim() === colNameSigne; });
    if (colSigne === -1) {
      var newCol = sheet.getLastColumn() + 1;
      sheet.getRange(1, newCol).setValue(colNameSigne);
      colSigne = newCol - 1;
    }

    var data = sheet.getRange(2, 1, lastRow - 1, sheet.getLastColumn()).getValues();
    var avant = { lies: nbLies, nonTrouves: nbNonTrouves, dejaSignes: nbDejaSignes };
    data.forEach(function(row, i) {
      var rowIndex   = i + 2;
      var dejaSigne  = colSigne < row.length ? (row[colSigne] || '').toString().trim() : '';
      if (dejaSigne) { nbDejaSignes++; return; }
      var salarie = (row[colSal] || '').toString().trim();
      if (!salarie) return;
      // Chez DIS, "Pour qui est fait la déclaration ?" ne contient que le
      // prénom ("Diane") alors que les fichiers de contrats signés dans Drive
      // sont abrégés à partir du NOM DE FAMILLE ("VIL") — sans cette
      // résolution, aucune de ces lignes ne peut jamais matcher (testé en
      // conditions réelles : 0 lié sur 38 lignes). Voir
      // resoudreNomCompletDepuisPrenom / getMapPrenomVersNomComplet.
      var salarieResolu = resoudreNomCompletDepuisPrenom(ss, salarie, entity);
      if (!_separerNomPrenom(salarie).prenom) {
        nbPrenomSeul++;
        if (salarieResolu !== salarie) {
          nbResolus++;
          if (exemplesResolus.length < 5) exemplesResolus.push(salarie + ' → ' + salarieResolu);
        } else if (exemplesNonResolus.length < 5 && exemplesNonResolus.indexOf(salarie) === -1) {
          exemplesNonResolus.push(salarie);
        }
      }
      var projet  = colProj !== -1 ? (row[colProj] || '').toString().trim() : '';
      var moisLigne = null, anneeLigne = anneeInt;
      if (colDate !== -1 && row[colDate]) {
        try { var d = new Date(row[colDate]); if (!isNaN(d)) { moisLigne = d.getMonth() + 1; anneeLigne = d.getFullYear(); } } catch(_) {}
      }
      var scores = fichiers.map(function(f) {
        var r = scorer(f, salarieResolu, projet, moisLigne, anneeLigne);
        return { nomOriginal: f.nomOriginal, url: f.url, score: r.score, scoreSal: r.scoreSal, moisMatch: r.moisMatch };
      // scoreSal > 0 exigé : un match uniquement sur compagnie/mois/année (sans
      // aucune trace du salarié dans le nom) n'est jamais une preuve suffisante.
      }).filter(function(f) { return f.score >= SEUIL_MIN && f.scoreSal > 0; }).sort(function(a, b) { return b.score - a.score; });
      if (scores.length === 0) { nbNonTrouves++; return; }
      // "Seul candidat" ne suffit pas à lui seul : sans confirmation de mois
      // (le dossier Drive n'est pas trié par mois pour les contrats, contrairement
      // aux FDP — tout le dossier est scanné d'un coup), un contrat d'un tout
      // autre mois pour le même salarié peut être le seul résultat et serait
      // alors lié à tort (ex: contrat de mai lié à une déclaration d'octobre).
      // On exige donc le mois de la ligne si on le connaît ; à défaut, on exige
      // un vrai double match salarié+projet pour compenser l'absence de repère
      // temporel.
      var exigenceTemporelle = moisLigne ? scores[0].moisMatch : (scores[0].scoreSal > 0 && scores[0].score >= SEUIL_MIN + 4);
      var confiant = exigenceTemporelle && (scores.length === 1 || (scores[0].score - scores[1].score) >= SEUIL_DOMINANT);
      if (confiant) {
        sheet.getRange(rowIndex, colSigne + 1).setValue(scores[0].url);
        nbLies++;
      } else {
        nbNonTrouves++; // ambigu — laissé pour la recherche manuelle par ligne
      }
    });
    tlog('  → ' + (nbLies - avant.lies) + ' lié(s) auto, ' + (nbNonTrouves - avant.nonTrouves) + ' non trouvé(s)/ambigu(s), ' + (nbDejaSignes - avant.dejaSignes) + ' déjà signé(s)');
  });
  tlog(nbPrenomSeul + ' ligne(s) avec prénom seul (sans nom de famille), dont ' + nbResolus + ' résolue(s) en nom complet');
  if (exemplesResolus.length)    tlog('  Résolus : ' + exemplesResolus.join(' | '));
  if (exemplesNonResolus.length) tlog('  Non résolus (absents de SALARIES_PAIE et CODE COMPTA, ou homonymes) : ' + exemplesNonResolus.join(', '));

  tlog('TOTAL : ' + nbLies + ' lié(s) auto, ' + nbDejaSignes + ' déjà signé(s), ' + nbNonTrouves + ' non trouvé(s)/ambigu(s)');
  return { success: true, entity: entity, annee: anneeInt, lies: nbLies, dejaSignes: nbDejaSignes, nonTrouves: nbNonTrouves, trace: trace };
}

