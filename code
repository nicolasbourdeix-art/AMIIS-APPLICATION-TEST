const CAISSE_HEADERS = ['ID_OP','DATE','TYPE','PORTEUR','SPECTACLE','LIBELLE','MONTANT','FACTURE_REF','BENEFICE_NET','ANNEE'];

function ensureCaisseTab(ss) {
  // Chercher le bon onglet caisse selon l'entité
  var tabName = getCaisseTabName(ss);
  let sheet = ss.getSheetByName(tabName);
  if (sheet) return sheet;
  // Créer si inexistant
  sheet = ss.insertSheet(tabName);
  sheet.getRange(1, 1, 1, CAISSE_HEADERS.length).setValues([CAISSE_HEADERS]).setFontWeight('bold').setBackground('#F5A623').setFontColor('#ffffff');
  sheet.setFrozenRows(1);
  return sheet;
}

function getCaisseTabName(ss) {
  // Essayer dans l'ordre : CAISSE FILLE, CAISSE, CAISSE PERSO
  var candidates = ['CAISSE FILLE', 'CAISSE PERSO', 'CAISSE', 'Caisse'];
  for (var i = 0; i < candidates.length; i++) {
    if (ss.getSheetByName(candidates[i])) return candidates[i];
  }
  return 'CAISSE'; // fallback
}

function getCaissesDetail(ss, entity) {
  var tabName = getCaisseTabName(ss);
  var sheet   = ss.getSheetByName(tabName);
  if (!sheet) return { error: 'Onglet ' + tabName + ' introuvable' };

  var allData = sheet.getDataRange().getValues();
  if (allData.length < 2) return { porteurs: {}, total: 0, balance: {}, sorties: [] };

  // Headers ligne 1
  var headers = allData[0];
  // Personnes côté ENTREE (col 4 à 9) et SORTIE (col 14 à 19)
  var PERSONNES = ['AUDREY','PAULINE','MALORIE','FANNY','THIBAULT','NATHALIE'];
  var iEntreeTotal = 1; // col B = total entrée
  var iEntreePersonnes = [4,5,6,7,8,9]; // AUDREY..NATHALIE côté entrée
  var iSortieDate      = 12;
  var iSortieIntitule  = 13;
  var iSortiePersonnes = [14,15,16,17,18,19]; // AUDREY..NATHALIE côté sortie

  var porteurs = {};
  PERSONNES.forEach(function(p) {
    porteurs[p] = { nom: p, entrees: 0, sorties: 0, solde: 0, lignes: [] };
  });

  var totalEntrees = 0, totalSorties = 0;
  var sorties = [];

  allData.forEach(function(row, i) {
    if (i === 0) return; // header
    var spectacle = (row[0] || '').toString().trim();
    if (!spectacle || spectacle === 'somme caisse entrée' || spectacle === 'BALANCE ') return;

    // Entrées par personne
    iEntreePersonnes.forEach(function(col, pi) {
      var montant = parseFloat(row[col]) || 0;
      if (montant !== 0) {
        porteurs[PERSONNES[pi]].entrees += montant;
        totalEntrees += montant;
        // Conserver le détail de chaque entrée (pour l'affichage au clic sur le
        // prénom). L'entrée n'a pas de date/intitulé propre côté ENTREE dans le
        // Sheet : on rattache le spectacle de la ligne, et l'intitulé "Entrée".
        porteurs[PERSONNES[pi]].entreesDetail = porteurs[PERSONNES[pi]].entreesDetail || [];
        porteurs[PERSONNES[pi]].entreesDetail.push({
          spectacle: spectacle,
          montant: montant,
        });
        porteurs[PERSONNES[pi]].lignes.push({
          date: '', spectacle: spectacle, intitule: 'Entrée', montant: montant,
        });
      }
    });

    // Sortie (une par ligne)
    var dateVal = row[iSortieDate];
    var intitule = (row[iSortieIntitule] || '').toString().trim();
    if (dateVal || intitule) {
      var dateStr = '';
      if (dateVal instanceof Date) {
        dateStr = Utilities.formatDate(dateVal, 'Europe/Paris', 'dd/MM/yyyy');
      } else if (dateVal) {
        dateStr = dateVal.toString().substring(0,10);
      }
      iSortiePersonnes.forEach(function(col, pi) {
        var montant = parseFloat(row[col]) || 0;
        if (montant !== 0) {
          porteurs[PERSONNES[pi]].sorties += montant;
          totalSorties += montant;
          sorties.push({
            date: dateStr,
            spectacle: spectacle,
            intitule: intitule,
            porteur: PERSONNES[pi],
            montant: montant,
          });
          porteurs[PERSONNES[pi]].lignes.push({
            date: dateStr, spectacle: spectacle, intitule: intitule, montant: -montant
          });
        }
      });
    }
  });

  // Calculer soldes
  PERSONNES.forEach(function(p) {
    porteurs[p].solde = porteurs[p].entrees - porteurs[p].sorties;
  });

  // Lire la ligne BALANCE si présente (L31)
  var balance = {};
  var balanceLigne = allData.find(function(r) { return r[0] && r[0].toString().trim() === 'BALANCE '; });
  if (balanceLigne) {
    var balanceVals = allData[allData.indexOf(balanceLigne) + 1] || [];
    PERSONNES.forEach(function(p, pi) {
      balance[p] = parseFloat(balanceVals[pi + 1]) || porteurs[p].solde;
    });
  } else {
    PERSONNES.forEach(function(p) { balance[p] = porteurs[p].solde; });
  }

  return {
    porteurs:     porteurs,
    total:        totalEntrees - totalSorties,
    totalEntrees: totalEntrees,
    totalSorties: totalSorties,
    balance:      balance,
    sorties:      sorties,
    personnes:    PERSONNES,
  };
}

// Détail DATÉ des entrées d'un porteur, reconstruit depuis les écritures 706/74
// (recettes) de l'onglet COMPTA — car CAISSE FILLE ne stocke que des montants
// agrégés par spectacle, sans date. Pour chaque recette d'un spectacle dont le
// porteur est bénéficiaire, on renvoie la date, le libellé, le montant BRUT de la
// recette, et la PART ESTIMÉE du porteur (recalculée avec la même formule que
// repartirCaisse : bénéfice après charges fixes × pct, divisé entre bénéficiaires).
// NB : c'est une estimation — les paramètres (charges/pct/bénéficiaires) peuvent
// avoir changé depuis l'import, donc la somme des parts estimées n'égale pas
// forcément au centime le total réel de CAISSE FILLE. Le total réel reste la
// référence (affiché à part côté interface).
function getDetailEntreesCaisse(ss, entity, prenom) {
  prenom = (prenom || '').toString().trim().toUpperCase();
  if (!prenom) return { error: 'Porteur requis' };

  var cfg   = getConfigMap(ss);
  var pct   = parseFloat(cfg['PERCENT_CAISSES_PERSO']) || 20;
  var fct   = parseFloat(cfg['FCT_MONTANT'])   || 58;
  var admin = parseFloat(cfg['ADMIN_MONTANT']) || 85;
  var diff  = parseFloat(cfg['DIFF_MONTANT'])  || 85;
  var chargesFixes = fct + admin + diff;

  var codeMap = getCodeComptaCaisseMap(ss);

  // Écritures comptables (toutes années confondues) — on garde les 706/74 crédit.
  var compta = getComptaRows(ss, entity, 0, null);
  if (compta.error) return { error: compta.error };

  var entrees = [];
  (compta.rows || []).forEach(function(r) {
    var compte = (r.COMPTE || '').toString();
    if (!(compte.indexOf('706') === 0 || compte.indexOf('74') === 0)) return;
    var credit = parseFloat(r.CREDIT) || 0;
    if (credit <= 0) return;
    var spectacle = (r.SPECTACLE || '').toString().trim();
    if (!spectacle) return;

    var specInfo = codeMap[spectacle.toLowerCase()] || {};
    var benefList = specInfo.beneficiaires || [];
    if (benefList.length === 0) return;                 // spectacle sans bénéficiaires
    if (benefList.indexOf(prenom) < 0) return;          // ce porteur n'est pas bénéficiaire

    // Recalcul de la part (coût employeur non déduit à l'import → 0 ici aussi).
    var apresCharges = credit - chargesFixes;
    var montantCaisse = apresCharges > 0 ? apresCharges * (pct / 100) : 0;
    var partEstimee = montantCaisse > 0 ? (montantCaisse / benefList.length) : 0;

    entrees.push({
      date:        r.DATE || '',
      libelle:     r.LIBELLE || '',
      spectacle:   spectacle,
      montantBrut: Math.round(credit * 100) / 100,
      partEstimee: Math.round(partEstimee * 100) / 100,
      beneficiaires: benefList.join(', '),
    });
  });

  // Tri par date décroissante (dd/mm/yyyy).
  entrees.sort(function(a, b) {
    function key(d) { var p = (d || '').split('/'); return p.length === 3 ? p[2] + p[1] + p[0] : ''; }
    return key(b.date).localeCompare(key(a.date));
  });

  var totalPartEstimee = Math.round(entrees.reduce(function(s, e) { return s + e.partEstimee; }, 0) * 100) / 100;
  return { success: true, prenom: prenom, entrees: entrees, totalPartEstimee: totalPartEstimee };
}



