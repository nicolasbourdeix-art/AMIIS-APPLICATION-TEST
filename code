// Colonne ENTITES vide = accès à toutes les entités. Sinon liste de codes
// séparés par des virgules (ex: "CLR,DIS,AMIIS").
function _parseEntitesUtilisateurApp(valeur) {
  return (valeur || '').toString().split(',').map(s => s.trim()).filter(Boolean);
}

function verifierIdentiteApp(nom, motDePasse) {
  if (!nom || !motDePasse) return { success: false, error: 'Nom et mot de passe requis' };
  const sheet = ensureUtilisateursAppTab();
  const data  = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if ((data[i][0]||'').toString().trim().toLowerCase() === nom.trim().toLowerCase()
        && (data[i][1]||'').toString() === motDePasse) {
      return { success: true, nom: data[i][0], entites: _parseEntitesUtilisateurApp(data[i][2]) };
    }
  }
  return { success: false, error: 'Identifiants incorrects' };
}

// Ne renvoie jamais les mots de passe — juste les noms et entités
// autorisées, pour l'affichage dans Configuration > Accès appli.
function getUtilisateursApp() {
  const sheet = ensureUtilisateursAppTab();
  const data  = sheet.getDataRange().getValues();
  const utilisateurs = [];
  for (let i = 1; i < data.length; i++) {
    if (data[i][0]) utilisateurs.push({ nom: data[i][0], entites: _parseEntitesUtilisateurApp(data[i][2]) });
  }
  return { success: true, utilisateurs };
}

function ajouterUtilisateurApp(nom, motDePasse, entites) {
  if (!nom || !motDePasse) return { error: 'Nom et mot de passe requis' };
  const sheet = ensureUtilisateursAppTab();
  const data  = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if ((data[i][0]||'').toString().trim().toLowerCase() === nom.trim().toLowerCase()) {
      return { error: 'Un utilisateur avec ce nom existe déjà' };
    }
  }
  sheet.appendRow([nom, motDePasse, (entites||[]).join(',')]);
  return { success: true, nom };
}

function modifierMotDePasseUtilisateurApp(nom, motDePasse) {
  if (!nom || !motDePasse) return { error: 'Nom et mot de passe requis' };
  const sheet = ensureUtilisateursAppTab();
  const data  = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if ((data[i][0]||'').toString().trim().toLowerCase() === nom.trim().toLowerCase()) {
      sheet.getRange(i + 1, 2).setValue(motDePasse);
      return { success: true, nom };
    }
  }
  return { error: 'Utilisateur non trouvé : ' + nom };
}

function modifierEntitesUtilisateurApp(nom, entites) {
  if (!nom) return { error: 'Nom requis' };
  const sheet = ensureUtilisateursAppTab();
  const data  = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if ((data[i][0]||'').toString().trim().toLowerCase() === nom.trim().toLowerCase()) {
      sheet.getRange(i + 1, 3).setValue((entites||[]).join(','));
      return { success: true, nom, entites: entites||[] };
    }
  }
  return { error: 'Utilisateur non trouvé : ' + nom };
}

function supprimerUtilisateurApp(nom) {
  if (!nom) return { error: 'Nom requis' };
  const sheet = ensureUtilisateursAppTab();
  const data  = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if ((data[i][0]||'').toString().trim().toLowerCase() === nom.trim().toLowerCase()) {
      sheet.deleteRow(i + 1);
      return { success: true, nom };
    }
  }
  return { error: 'Utilisateur non trouvé : ' + nom };
}

