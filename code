  if (COMPTES_GROUPE[key]) return COMPTES_GROUPE[key];
  var dyn = getComptesGroupeDynamiques();
  return dyn[key] || null;
}

// Trouve l'index (0-based) de la première colonne dont l'en-tête contient l'un des motifs donnés
function findColCompteGroupe(headers, patterns) {
  for (var i = 0; i < headers.length; i++) {
    var h = (headers[i] || '').toString().trim().toLowerCase();
    if (!h) continue;
    for (var p = 0; p < patterns.length; p++) {
      if (h.indexOf(patterns[p]) >= 0) return i;
    }
  }
  return -1;
}

function resolveColsCompteGroupe(headers) {
  return {
    date:           findColCompteGroupe(headers, ['date']),
    lieu:           findColCompteGroupe(headers, ['lieu']),
    tariVente:      findColCompteGroupe(headers, ['tarif de vente', 'tarif vente']),
    partAmiis:      findColCompteGroupe(headers, ['pro / amiis', 'pro/amiis', 'amiis']),
    balance:        findColCompteGroupe(headers, ['balance']),
    facture:        findColCompteGroupe(headers, ['facture']),
    contratCession: findColCompteGroupe(headers, ['contrat de cession', 'contrat cession']),
    contratArtiste: findColCompteGroupe(headers, ['contrat artiste', 'artiste']),
    gestionnaire:   findColCompteGroupe(headers, ['gestionnaire']),
    // Numéros de référence (texte libre, distincts des colonnes de pièces jointes
    // ci-dessus) — motifs volontairement plus précis ("n°"/"numero"/"référence")
    // pour ne jamais matcher "FACTURE"/"CONTRAT CESSION" par erreur.
    refContrat:     findColCompteGroupe(headers, ['n° contrat', 'numero contrat', 'num contrat', 'référence contrat', 'reference contrat']),
    refDevis:       findColCompteGroupe(headers, ['n° devis', 'numero devis', 'num devis', 'référence devis', 'reference devis']),
    refFacture:     findColCompteGroupe(headers, ['n° facture', 'numero facture', 'num facture', 'référence facture', 'reference facture']),
    deplacements:         findColCompteGroupe(headers, ['deplacement', 'déplacement', "frais d'approche", 'approche']),
    coutEmployeurArtiste: findColCompteGroupe(headers, ['cout employeur', 'coût employeur']),
  };
}

// Convertit un index de colonne 0-based en lettre(s) de colonne Sheets (0->A,
// 25->Z, 26->AA...) — nécessaire pour construire des formules référençant la
// colonne "Coût employeur artiste", dont la position n'est pas fixe (créée à
// la volée par ensureColonneCompteGroupe, donc jamais à la même lettre d'un
// projet à l'autre selon ce qui existait déjà dans son Sheet).
function lettreColonne(index0) {
  var lettre = '';
  var n = index0 + 1;
  while (n > 0) {
    var reste = (n - 1) % 26;
    lettre = String.fromCharCode(65 + reste) + lettre;
    n = Math.floor((n - 1) / 26);
  }
  return lettre;
}

// Repli positionnel pour "deplacements" : cette colonne existe toujours dans le
// modèle de compte groupe (7ᵉ colonne / G, écrite par ajouterLigneCompteGroupe)
// mais son intitulé exact varie parfois d'un projet à l'autre — si la recherche
// par en-tête échoue, on se fie à cette position garantie plutôt que de la
// traiter comme absente (ce qui créerait une colonne en double à côté).
function resoudreColDeplacements(cols, headers) {
  if (cols.deplacements < 0 && headers.length > 6) cols.deplacements = 6;
  return cols;
}

// Garantit l'existence d'une colonne de l'onglet Compte groupe, en la créant à
// la suite de la dernière colonne utilisée si absente (même principe que
// setGestionnaireCompteGroupe, généralisé). Retourne son index 0-based et met
// à jour l'objet `cols` en place pour les appels suivants dans la même requête.
function ensureColonneCompteGroupe(sheet, cols, champ, nomColonne) {
  if (cols[champ] >= 0) return cols[champ];
  var col = sheet.getLastColumn(); // = index 0-based de la nouvelle colonne
  sheet.getRange(3, col + 1).setValue(nomColonne);
  cols[champ] = col;
  return col;
}

// Dossier Drive dédié à un compte groupe (un sous-dossier par projet à l'intérieur
// du dossier parent commun COMPTE_GROUPE_DOSSIER_PARENT) — créé au premier import
// de fichier si besoin, puis réutilisé (recherché par nom à chaque appel : pas de
// nouvel identifiant à stocker, donc rien à casser sur les projets déjà créés).
function getOuCreerDossierCompteGroupe(cfg) {
  var parent = DriveApp.getFolderById(COMPTE_GROUPE_DOSSIER_PARENT);
  var nomDossier = cfg.nom;
  var existants = parent.getFoldersByName(nomDossier);
  if (existants.hasNext()) return existants.next();
  return parent.createFolder(nomDossier);
}

function lireCompteGroupe(projet) {
  var cfg = getCompteGroupe(projet);
  if (!cfg) return { error: 'Projet inconnu: ' + projet };

  try {
    var ss    = SpreadsheetApp.openById(cfg.id);
    var sheet = ss.getSheetByName(cfg.onglet);
    if (!sheet) return { error: 'Onglet ' + cfg.onglet + ' introuvable' };

    var data    = sheet.getDataRange().getValues();
    var headers = data[2]; // ligne 3 = headers
    var cols    = resoudreColDeplacements(resolveColsCompteGroupe(headers), headers);
    var rows    = [];

    // Liens Drive des pièces jointes (Facture / Contrat de cession / Contrat
    // artiste) : quand la cellule porte un lien cliquable (HYPERLINK écrit par
    // uploaderFichierCompteGroupe, ou posé à la main), getValues() ne renvoie que
    // le texte affiché — il faut lire le rich text pour récupérer l'URL réelle.
    // Même technique que l'extraction des hyperliens DEVIS dans getSuiviProjet.
    function extraireLiens(colIdx) {
      var liens = {};
      if (colIdx < 0 || data.length <= 3) return liens;
      var rich = sheet.getRange(4, colIdx + 1, data.length - 3, 1).getRichTextValues();
      rich.forEach(function(cellArr, idx) {
        var cell = cellArr[0]; if (!cell) return;
        var runs = cell.getRuns();
        for (var r = 0; r < runs.length; r++) {
          var link = runs[r].getLinkUrl();
          if (link) { liens[idx + 4] = link; break; }
        }
      });
      return liens;
    }
    var liensFacture        = extraireLiens(cols.facture);
    var liensContratCession = extraireLiens(cols.contratCession);
    var liensContratArtiste = extraireLiens(cols.contratArtiste);
    // Une cellule qui contient directement une URL en texte brut (saisie à la
    // main, sans formule HYPERLINK) est aussi un lien valide.
    function resoudreUrl(texteBrut, liensParLigne, rowIdx1) {
      var t = (texteBrut || '').toString().trim();
      if (t.toLowerCase().startsWith('http')) return t;
      return liensParLigne[rowIdx1] || '';
    }

    for (var i = 3; i < data.length; i++) {
      var row = data[i];
      if (!row[0] && !row[1] && !row[2]) continue; // ligne vide
      // Ligne "Totaux" : on l'ignore (elle sera recalculée en sommant les lignes)
      var col0 = (row[0] || '').toString().trim().toLowerCase();
      if (col0 === 'totaux' || col0 === 'total') continue;

      var dateVal = cols.date >= 0 ? row[cols.date] : '';
      var dateStr = '';
      if (dateVal instanceof Date) {
        dateStr = Utilities.formatDate(dateVal, 'Europe/Paris', 'dd/MM/yyyy');
      } else if (dateVal) {
        dateStr = dateVal.toString().substring(0, 10);
      }

      var gestionnaire = cols.gestionnaire >= 0 ? (row[cols.gestionnaire] || '').toString().trim() : '';
      var rowIdx1 = i + 1;
      var factureTexte        = cols.facture        >= 0 ? (row[cols.facture]        || '').toString().trim() : '';
      var contratCessionTexte = cols.contratCession >= 0 ? (row[cols.contratCession] || '').toString().trim() : '';
      var contratArtisteTexte = cols.contratArtiste >= 0 ? (row[cols.contratArtiste] || '').toString().trim() : '';

      rows.push({
        _rowIndex:      rowIdx1,
        date:           dateStr,
        lieu:           cols.lieu >= 0 ? (row[cols.lieu] || '').toString().trim() : '',
        tariVente:      cols.tariVente >= 0 ? (parseFloat(row[cols.tariVente]) || 0) : 0,
        partAmiis:      cols.partAmiis >= 0 ? (parseFloat(row[cols.partAmiis]) || 0) : 0,
        balance:        cols.balance >= 0 ? (parseFloat(row[cols.balance]) || 0) : 0,
        facture:            factureTexte,
        factureUrl:         resoudreUrl(factureTexte, liensFacture, rowIdx1),
        contratCession:     contratCessionTexte,
        contratCessionUrl:  resoudreUrl(contratCessionTexte, liensContratCession, rowIdx1),
        contratArtiste:     contratArtisteTexte,
        contratArtisteUrl:  resoudreUrl(contratArtisteTexte, liensContratArtiste, rowIdx1),
        refContrat:     cols.refContrat >= 0 ? (row[cols.refContrat] || '').toString().trim() : '',
        refDevis:       cols.refDevis   >= 0 ? (row[cols.refDevis]   || '').toString().trim() : '',
        refFacture:     cols.refFacture >= 0 ? (row[cols.refFacture] || '').toString().trim() : '',
        deplacements:         cols.deplacements         >= 0 ? (parseFloat(row[cols.deplacements])         || 0) : 0,
        coutEmployeurArtiste: cols.coutEmployeurArtiste  >= 0 ? (parseFloat(row[cols.coutEmployeurArtiste]) || 0) : 0,
        gestionnaire:   gestionnaire,
      });
    }

    // Totaux calculés en sommant les lignes (robuste, indépendant du layout de chaque sheet)
    var total = {
      partAmiis: Math.round(rows.reduce(function(s, r) { return s + r.partAmiis; }, 0) * 100) / 100,
      balance:   Math.round(rows.reduce(function(s, r) { return s + r.balance;   }, 0) * 100) / 100,
    };

    // Compteur d'heures gestionnaire : forfait FORFAIT_HEURES_PROD par production attribuée
    var compteurGestionnaires = {};
    rows.forEach(function(r) {
      if (!r.gestionnaire) return;
      if (!compteurGestionnaires[r.gestionnaire]) {
        compteurGestionnaires[r.gestionnaire] = { nb: 0, heures: 0, coutEmployeur: 0 };
      }
      compteurGestionnaires[r.gestionnaire].nb            += 1;
      compteurGestionnaires[r.gestionnaire].heures         = Math.round((compteurGestionnaires[r.gestionnaire].heures + FORFAIT_HEURES_PROD) * 100) / 100;
      compteurGestionnaires[r.gestionnaire].coutEmployeur  = Math.round((compteurGestionnaires[r.gestionnaire].coutEmployeur + FORFAIT_HEURES_PROD * TAUX_HORAIRE_GESTIONNAIRE) * 100) / 100;
    });
    var coutTotalCompteur = 0;
    Object.keys(compteurGestionnaires).forEach(function(k) { coutTotalCompteur += compteurGestionnaires[k].coutEmployeur; });
    total.coutCompteur     = Math.round(coutTotalCompteur * 100) / 100;
    total.margeAmiisNette  = Math.round((total.partAmiis - coutTotalCompteur) * 100) / 100;

    return {
      success: true, projet: cfg.nom, rows: rows, totaux: total, contact: cfg.contact,
      gestionnairesDisponibles: GESTIONNAIRES_COMPTE_GROUPE,
      compteurGestionnaires: compteurGestionnaires,
    };
  } catch(e) {
    return { error: 'Lecture compte groupe: ' + e.message };
  }
}

// Synthèse consolidée de tous les Comptes groupe : combien AMIIS détient actuellement
// pour le compte du groupe (Balance cumulée), la part AMIIS (marge propre) par structure,
// et le total consolidé. Utilise exclusivement les données déjà lues par lireCompteGroupe
// (aucune nouvelle donnée créée, aucun doublon).
function getSyntheseGlobaleComptesGroupe() {
  var projets = [];
  var totaux = {
    nbProjets: 0, nbProductions: 0,
    totalVente: 0, totalPartAmiis: 0, totalBalance: 0,
    totalCoutCompteur: 0, totalMargeNette: 0,
    totalBalancePositive: 0, totalBalanceNegative: 0,
  };

  Object.keys(getTousComptesGroupe()).forEach(function(key) {
    var cg = lireCompteGroupe(key);
    if (!cg || !cg.success) {
      projets.push({ key: key, nom: (getCompteGroupe(key) || {}).nom || key, error: (cg && cg.error) || 'Lecture impossible' });
      return;
    }
    var totalVente = (cg.rows || []).reduce(function(s, r) { return s + (r.tariVente || 0); }, 0);
    var bal = cg.totaux.balance || 0;

    projets.push({
      key: key, nom: cg.projet,
      nbProductions: (cg.rows || []).length,
      totalVente: Math.round(totalVente * 100) / 100,
      partAmiis: cg.totaux.partAmiis || 0,
      balance: bal,
      coutCompteur: cg.totaux.coutCompteur || 0,
      margeNette: cg.totaux.margeAmiisNette || 0,
    });

    totaux.nbProjets        += 1;
    totaux.nbProductions    += (cg.rows || []).length;
    totaux.totalVente        = Math.round((totaux.totalVente + totalVente) * 100) / 100;
    totaux.totalPartAmiis    = Math.round((totaux.totalPartAmiis + (cg.totaux.partAmiis || 0)) * 100) / 100;
    totaux.totalBalance      = Math.round((totaux.totalBalance + bal) * 100) / 100;
    totaux.totalCoutCompteur = Math.round((totaux.totalCoutCompteur + (cg.totaux.coutCompteur || 0)) * 100) / 100;
    totaux.totalMargeNette   = Math.round((totaux.totalMargeNette + (cg.totaux.margeAmiisNette || 0)) * 100) / 100;
    if (bal >= 0) totaux.totalBalancePositive = Math.round((totaux.totalBalancePositive + bal) * 100) / 100;
    else          totaux.totalBalanceNegative = Math.round((totaux.totalBalanceNegative + Math.abs(bal)) * 100) / 100;
  });

  return { success: true, projets: projets, totaux: totaux };
}

function setGestionnaireCompteGroupe(projet, rowIndex, gestionnaire) {
  var cfg = getCompteGroupe(projet);
  if (!cfg) return { error: 'Projet inconnu: ' + projet };
  var ri = parseInt(rowIndex, 10);
  if (!ri || ri < 4) return { error: 'rowIndex invalide' };

  try {
    var ss    = SpreadsheetApp.openById(cfg.id);
    var sheet = ss.getSheetByName(cfg.onglet);
    if (!sheet) return { error: 'Onglet ' + cfg.onglet + ' introuvable' };

    var headers = sheet.getRange(3, 1, 1, sheet.getLastColumn()).getValues()[0];
    var cols    = resolveColsCompteGroupe(headers);
    var col     = cols.gestionnaire;

    if (col < 0) {
      // Colonne "Gestionnaire" absente : on la crée à la suite de la dernière colonne utilisée
      col = sheet.getLastColumn();
      sheet.getRange(3, col + 1).setValue('Gestionnaire');
      col = col; // index 0-based de la nouvelle colonne = ancien getLastColumn()
    }

    sheet.getRange(ri, col + 1).setValue(gestionnaire || '');
    return { success: true };
  } catch(e) {
    return { error: 'Ecriture gestionnaire: ' + e.message };
  }
}

// Champs éditables d'une ligne de compte groupe (numéros de référence en texte
// libre + déplacements/coût employeur artiste en numérique) — crée la colonne
// à la volée si elle n'existe pas encore sur ce projet (même principe que
// setGestionnaireCompteGroupe, généralisé via ensureColonneCompteGroupe).
var CHAMPS_TEXTE_COMPTE_GROUPE = {
  refContrat: 'N° Contrat', refDevis: 'N° Devis', refFacture: 'N° Facture',
  deplacements: 'Déplacements', coutEmployeurArtiste: 'Coût employeur artiste',
};
var CHAMPS_NUMERIQUES_COMPTE_GROUPE = { deplacements: true, coutEmployeurArtiste: true };
function setChampTexteCompteGroupe(projet, rowIndex, champ, valeur) {
  var cfg = getCompteGroupe(projet);
  if (!cfg) return { error: 'Projet inconnu: ' + projet };
  var ri = parseInt(rowIndex, 10);
  if (!ri || ri < 4) return { error: 'rowIndex invalide' };
  var nomColonne = CHAMPS_TEXTE_COMPTE_GROUPE[champ];
  if (!nomColonne) return { error: 'Champ inconnu: ' + champ };

  try {
    var ss    = SpreadsheetApp.openById(cfg.id);
    var sheet = ss.getSheetByName(cfg.onglet);
    if (!sheet) return { error: 'Onglet ' + cfg.onglet + ' introuvable' };

    var headers = sheet.getRange(3, 1, 1, sheet.getLastColumn()).getValues()[0];
    var cols    = resoudreColDeplacements(resolveColsCompteGroupe(headers), headers);
    var col     = ensureColonneCompteGroupe(sheet, cols, champ, nomColonne);

    var valeurFinale = CHAMPS_NUMERIQUES_COMPTE_GROUPE[champ] ? (parseFloat(valeur) || 0) : (valeur || '');
    sheet.getRange(ri, col + 1).setValue(valeurFinale);
    return { success: true };
  } catch(e) {
    return { error: 'Ecriture ' + champ + ': ' + e.message };
  }
}

// Dépose un fichier (contrat signé, facture, contrat artiste...) dans le dossier
// Drive dédié au projet produit, et pose un lien cliquable dans la cellule
// correspondante de la ligne — crée la colonne si elle n'existe pas déjà.
var CHAMPS_FICHIER_COMPTE_GROUPE = { facture: 'Facture', contratCession: 'Contrat de cession', contratArtiste: 'Contrat artiste' };
function uploaderFichierCompteGroupe(projet, rowIndex, champ, nomFichier, mimeType, base64Data) {
  var cfg = getCompteGroupe(projet);
  if (!cfg) return { error: 'Projet inconnu: ' + projet };
  var ri = parseInt(rowIndex, 10);
  if (!ri || ri < 4) return { error: 'rowIndex invalide' };
  var nomColonne = CHAMPS_FICHIER_COMPTE_GROUPE[champ];
  if (!nomColonne) return { error: 'Champ inconnu: ' + champ };
  if (!base64Data) return { error: 'Fichier vide' };

  try {
    var ss    = SpreadsheetApp.openById(cfg.id);
    var sheet = ss.getSheetByName(cfg.onglet);
    if (!sheet) return { error: 'Onglet ' + cfg.onglet + ' introuvable' };

    var headers = sheet.getRange(3, 1, 1, sheet.getLastColumn()).getValues()[0];
    var cols    = resolveColsCompteGroupe(headers);
    var col     = ensureColonneCompteGroupe(sheet, cols, champ, nomColonne);

    var dossier = getOuCreerDossierCompteGroupe(cfg);
    var blob = Utilities.newBlob(Utilities.base64Decode(base64Data), mimeType || 'application/octet-stream', nomFichier || 'Document');
    var fichier = dossier.createFile(blob);
    var url = fichier.getUrl();

    var libelle = (nomFichier || 'Document').toString().replace(/"/g, "'");
    if (libelle.length > 40) libelle = libelle.substring(0, 40) + '…';
    try {
      sheet.getRange(ri, col + 1).setFormula('=HYPERLINK("' + url + '";"' + libelle + '")');
    } catch(eFormula) {
      sheet.getRange(ri, col + 1).setValue(url);
    }

    Logger.log('uploaderFichierCompteGroupe: ' + projet + ' L' + ri + ' ' + champ + ' -> ' + url);
    return { success: true, url: url, nom: nomFichier || 'Document' };
  } catch(e) {
    return { error: 'Import fichier: ' + e.message };
  }
}

function supprimerLigneCompteGroupe(projet, rowIndex) {
  var cfg = getCompteGroupe(projet);
  if (!cfg) return { error: 'Projet inconnu: ' + projet };
  var ri = parseInt(rowIndex, 10);
  if (!ri || ri < 4) return { error: 'rowIndex invalide' };

  try {
    var ss    = SpreadsheetApp.openById(cfg.id);
    var sheet = ss.getSheetByName(cfg.onglet);
    if (!sheet) return { error: 'Onglet ' + cfg.onglet + ' introuvable' };
    sheet.deleteRow(ri);
    return { success: true };
  } catch(e) {
    return { error: 'Suppression ligne: ' + e.message };
  }
}

function ajouterLigneCompteGroupe(projet, ligne) {
  var cfg = getCompteGroupe(projet);
  if (!cfg) return { error: 'Projet inconnu: ' + projet };

  try {
    var ss    = SpreadsheetApp.openById(cfg.id);
    var sheet = ss.getSheetByName(cfg.onglet);
    if (!sheet) return { error: 'Onglet introuvable' };

    // Trouver la première ligne vide (avant la ligne Totaux)
    var lastRow = sheet.getLastRow();
    var data    = sheet.getRange(4, 1, lastRow - 3, 1).getValues();
    var insertRow = lastRow; // avant totaux
    for (var i = 0; i < data.length; i++) {
      if (!data[i][0]) { insertRow = i + 4; break; }
    }

    var newRow = [
      ligne.date      ? new Date(ligne.date.split('/').reverse().join('-')) : '',
      ligne.lieu      || '',
      parseFloat(ligne.tariVente)    || 0,
      parseFloat(ligne.salaireEmp)   || 0,
      parseFloat(ligne.partJohann)   || 0,
      '', // formule AMIIS posée explicitement juste après (voir plus bas)
      parseFloat(ligne.deplacements) || 0,
      parseFloat(ligne.autres)       || 0,
      '', // balance = formule
      ligne.facture         || '',
      ligne.contratCession  || '',
      ligne.contratArtiste  || '',
    ];

    sheet.getRange(insertRow, 1, 1, newRow.length).setValues([newRow]);

    // Colonne "Coût employeur artiste" : garantie présente avant de construire
    // la formule Balance qui la référence (position variable, créée à la volée).
    var headersLigne = sheet.getRange(3, 1, 1, sheet.getLastColumn()).getValues()[0];
    var colsLigne    = resoudreColDeplacements(resolveColsCompteGroupe(headersLigne), headersLigne);
    var colCoutEmp   = ensureColonneCompteGroupe(sheet, colsLigne, 'coutEmployeurArtiste', 'Coût employeur artiste');
    var letCoutEmp   = lettreColonne(colCoutEmp);

    // Part AMIIS = 11% du tarif de vente (colonne C) UNE FOIS les frais de
    // déplacement (colonne G) retirés.
    sheet.getRange(insertRow, 6).setFormula('=(C' + insertRow + '-G' + insertRow + ')*11%');
    // Balance = tarif de vente - coût employeur artiste - frais de déplacement -
    // part AMIIS : doit rester >= 0 (sinon la cession coûte plus qu'elle ne
    // rapporte une fois toutes les charges déduites — la cellule s'affiche alors
    // en rouge côté interface).
    sheet.getRange(insertRow, 9).setFormula('=C' + insertRow + '-' + letCoutEmp + insertRow + '-G' + insertRow + '-F' + insertRow);

    Logger.log('ajouterLigneCompteGroupe: ' + projet + ' L' + insertRow + ' ' + ligne.lieu);
    return { success: true, rowIndex: insertRow };
  } catch(e) {
    return { error: 'Écriture compte groupe: ' + e.message };
  }
}

// Réécrit les formules Part AMIIS (colonne F = 11% de [Tarif de vente − Frais
// de déplacement]) et Balance (colonne I = Tarif de vente − Coût employeur
// artiste − Frais de déplacement − Part AMIIS) sur TOUTES les lignes déjà
// existantes d'un compte groupe — pour corriger les lignes créées avant
// l'introduction de ces formules. Sans effet sur les autres colonnes.
function recalculerPartAmiisCompteGroupe(projet) {
  var cfg = getCompteGroupe(projet);
  if (!cfg) return { error: 'Projet inconnu: ' + projet };

  try {
    var ss    = SpreadsheetApp.openById(cfg.id);
    var sheet = ss.getSheetByName(cfg.onglet);
    if (!sheet) return { error: 'Onglet ' + cfg.onglet + ' introuvable' };

    var lastRow = sheet.getLastRow();
    if (lastRow < 4) return { success: true, nbLignes: 0 };

    var headers    = sheet.getRange(3, 1, 1, sheet.getLastColumn()).getValues()[0];
    var cols       = resoudreColDeplacements(resolveColsCompteGroupe(headers), headers);
    var colCoutEmp = ensureColonneCompteGroupe(sheet, cols, 'coutEmployeurArtiste', 'Coût employeur artiste');
    var letCoutEmp = lettreColonne(colCoutEmp);

    var colA = sheet.getRange(4, 1, lastRow - 3, 1).getValues();
    var nb = 0;
    for (var i = 0; i < colA.length; i++) {
      var ri = i + 4;
      var v = (colA[i][0] || '').toString().trim().toLowerCase();
      if (!colA[i][0] || v === 'totaux' || v === 'total') continue;
      sheet.getRange(ri, 6).setFormula('=(C' + ri + '-G' + ri + ')*11%');
      sheet.getRange(ri, 9).setFormula('=C' + ri + '-' + letCoutEmp + ri + '-G' + ri + '-F' + ri);
      nb++;
    }
    return { success: true, nbLignes: nb };
  } catch(e) {
    return { error: 'Recalcul Part AMIIS: ' + e.message };
  }
}

// Crée un nouveau compte groupe depuis l'interface :
//  1. copie le Sheet MODÈLE (KELTAS, formules + structure garanties identiques)
//     dans le dossier Drive parent commun aux comptes groupe ;
//  2. renomme l'onglet copié au nom du projet, et vide ses lignes de données
//     (de la ligne 4 jusqu'à la ligne "Totaux" exclue) ;
//  3. enregistre la config (clé, nom, id, onglet, contact) dans l'onglet AMIIS,
//     pour que le projet soit reconnu sans jamais toucher au code.
function creerCompteGroupe(nom, contact) {
  nom = (nom || '').toString().trim();
  if (!nom) return { error: 'Nom du projet requis' };
  contact = (contact || '').toString().trim();

  // Clé normalisée (sans accents, sans espaces, minuscules) — sert d'identifiant.
  var cle = nom.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]/g, '');
  if (!cle) return { error: 'Nom invalide (aucun caractère exploitable pour la clé)' };

  // Refuser un doublon (codé en dur OU déjà créé).
  if (getCompteGroupe(cle)) return { error: 'Un compte groupe existe déjà pour "' + nom + '" (clé ' + cle + ')' };

  // Nom de l'onglet = nom du projet en MAJUSCULES (choix retenu).
  var nomOnglet = nom.toUpperCase();

  try {
    // 1. Copier le fichier modèle dans le dossier parent.
    var modele = DriveApp.getFileById(COMPTE_GROUPE_MODELE_SHEET_ID);
    var dossier = DriveApp.getFolderById(COMPTE_GROUPE_DOSSIER_PARENT);
    var copie = modele.makeCopy('Compte groupe — ' + nom, dossier);
    var nouvelId = copie.getId();

    // 2. Ouvrir la copie, renommer l'onglet, vider les données.
    var ss = SpreadsheetApp.openById(nouvelId);
    var sheet = ss.getSheetByName(COMPTE_GROUPE_MODELE_ONGLET);
    if (!sheet) {
      // L'onglet modèle est introuvable dans la copie : on annule proprement.
      try { DriveApp.getFileById(nouvelId).setTrashed(true); } catch(_) {}
      return { error: 'Onglet modèle "' + COMPTE_GROUPE_MODELE_ONGLET.trim() + '" introuvable dans la copie' };
    }
    try { sheet.setName(nomOnglet); } catch(eRename) {
      // Si le renommage échoue (nom déjà pris, caractères…), on garde le nom modèle.
      nomOnglet = COMPTE_GROUPE_MODELE_ONGLET;
    }

    // Vider les lignes de données : de la ligne 4 jusqu'à la ligne "Totaux" exclue.
    // Les en-têtes (ligne 3), les formules de la ligne Totaux et sa mise en forme
    // restent intactes puisqu'on ne touche qu'aux lignes de productions.
    var lastRow = sheet.getLastRow();
    if (lastRow >= 4) {
      var colA = sheet.getRange(4, 1, lastRow - 3, 1).getValues();
      var ligneTotaux = -1; // 1-indexée
      for (var i = 0; i < colA.length; i++) {
        var v = (colA[i][0] || '').toString().trim().toLowerCase();
        if (v === 'totaux' || v === 'total') { ligneTotaux = i + 4; break; }
      }
      var finVidage = (ligneTotaux > 0) ? ligneTotaux - 1 : lastRow;
      if (finVidage >= 4) {
        // clearContent efface les valeurs mais garde formules de colonnes calculées ?
        // Non : on veut retirer les productions du modèle, y compris leurs formules de
        // ligne. On efface donc tout le contenu de ces lignes. La formule Part AMIIS
        // est reposée explicitement par ajouterLigneCompteGroupe à chaque nouvelle
        // production (11% du tarif de vente une fois les frais de déplacement
        // retirés) ; celle de Balance continue d'être recopiée depuis la ligne
        // précédente.
        sheet.getRange(4, 1, finVidage - 4 + 1, sheet.getLastColumn()).clearContent();
      }
    }

    // 3. Enregistrer la config.
    var cfgSheet = ensureComptesGroupeConfigTab();
    cfgSheet.appendRow([cle, nom, nouvelId, nomOnglet, contact]);

    Logger.log('creerCompteGroupe: "' + nom + '" (clé ' + cle + ') → ' + nouvelId + ' onglet ' + nomOnglet);
    return {
      success: true,
      cle: cle, nom: nom, id: nouvelId, onglet: nomOnglet,
      url: 'https://docs.google.com/spreadsheets/d/' + nouvelId + '/edit',
    };
  } catch(e) {
    return { error: 'Création compte groupe : ' + e.message };
  }
}

// Liste tous les comptes groupe (codés en dur + dynamiques) pour le front, sous
// forme d'un tableau [{ key, nom }] — remplace la liste jusque-là codée en dur
// côté interface, pour que les nouveaux projets apparaissent automatiquement.
function listerComptesGroupe() {
  var tous = getTousComptesGroupe();
  var liste = Object.keys(tous).map(function(k) {
    return { key: k, nom: tous[k].nom || k };
  });
  return { success: true, projets: liste };
}

function debugCaisseFille() {
  var ss = getSheetById('CLR');
  var tabName = getCaisseTabName(ss);
  Logger.log('Onglet caisse: ' + tabName);
  var sheet = ss.getSheetByName(tabName);
  if (!sheet) { Logger.log('Sheet introuvable'); return; }

  // Afficher les 2 premières lignes brutes (header + ligne 2)
  var lastCol = sheet.getLastColumn();
  var row1 = sheet.getRange(1, 1, 1, lastCol).getValues()[0];
  var row2 = sheet.getRange(2, 1, 1, lastCol).getValues()[0];
  Logger.log('Row1 (header): ' + JSON.stringify(row1));
  Logger.log('Row2 (data): ' + JSON.stringify(row2));

  // Toutes les lignes
  var allData = sheet.getRange(1, 1, sheet.getLastRow(), lastCol).getValues();
  Logger.log('Total: ' + allData.length + ' lignes x ' + lastCol + ' colonnes');
  for (var i = 1; i < allData.length; i++) {
    Logger.log('L' + (i+1) + ': ' + JSON.stringify(allData[i]));
  }
}

