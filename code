function getLienContrat(val) {
  if (!val) return '';
  var v = val.toString().trim();
  if (!v.startsWith('http')) return '';
  try {
    var fileId = v.match(/\/d\/([a-zA-Z0-9_-]+)/);
    if (fileId) {
      var nom = DriveApp.getFileById(fileId[1]).getName().toUpperCase();
      return nom.indexOf('_SIGNE') !== -1 ? v : '';
    }
  } catch(e) {}
  return '';
}

function getLienPdfRecap(val) {
  if (!val) return '';
  var v = val.toString().trim();
  if (v.startsWith('DPAE_ENVOYEE_')) return '';
  if (!v.startsWith('http')) return '';
  try {
    var fileId = v.match(/\/d\/([a-zA-Z0-9_-]+)/);
    if (fileId) {
      var nom = DriveApp.getFileById(fileId[1]).getName().toUpperCase();
      return nom.indexOf('_SIGNE') === -1 ? v : '';
    }
  } catch(e) {}
  return '';
}

