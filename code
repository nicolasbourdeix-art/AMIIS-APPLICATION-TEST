// Extraction des hyperliens (colonnes 'contrat'/'lien ') sur un onglet devis au
// format CLR, actuel ou ancien. headerRowIdx permet de gérer les onglets
// historiques dont les en-têtes ne sont pas en ligne 1 (les données utiles
// démarrent alors juste après cette ligne).
function extraireHyperliensDevis(entity, sheet, headerRowIdx) {
  var hyperliens = {};
  if (entity !== 'CLR' || !sheet) return hyperliens;
  headerRowIdx = headerRowIdx || 1;
  try {
    const headers  = sheet.getRange(headerRowIdx, 1, 1, sheet.getLastColumn()).getValues()[0];
    const lastRow  = sheet.getLastRow();
    const dataStart = headerRowIdx + 1;
    if (lastRow >= dataStart) {
      [
        { nom: 'lien ',    cle: 'urlRecap'   },
        { nom: 'lien',     cle: 'urlRecap'   },
        { nom: 'contrat ', cle: 'urlContrat' },
        { nom: 'contrat',  cle: 'urlContrat' },
        { nom: 'Dépos au format pdf du devis validé', cle: 'urlRecap' },
      ].forEach(function(col) {
        const colIdx = headers.findIndex(function(h) { return h.toString().trim() === col.nom.trim(); });
        if (colIdx === -1) return;
        const richValues = sheet.getRange(dataStart, colIdx + 1, lastRow - dataStart + 1, 1).getRichTextValues();
        richValues.forEach(function(cellArr, i) {
          const cell = cellArr[0];
          if (!cell) return;
          const runs = cell.getRuns();
          for (var r = 0; r < runs.length; r++) {
            const link = runs[r].getLinkUrl();
            if (link) {
              const rowIdx = dataStart + i;
              if (!hyperliens[rowIdx]) hyperliens[rowIdx] = {};
              if (!hyperliens[rowIdx][col.cle]) hyperliens[rowIdx][col.cle] = link;
              break;
            }
          }
        });
      });
    }
  } catch(e) {
    Logger.log('Hyperliens devis erreur (' + sheet.getName() + '): ' + e.message);
  }
  return hyperliens;
}

// Charge et normalise un onglet devis donné ; marque chaque ligne avec son
// onglet d'origine (_sourceSheet) pour que les actions d'édition/suppression
// ciblent la bonne feuille par la suite. Les onglets historiques (estAncien)
// utilisent la détection dynamique de la ligne d'en-têtes, car leur ligne 1
// est parfois vide ou inutilisée (vraies colonnes en ligne 2 ou 3).
function chargerDevisOnglet(ss, entity, nomOnglet, estAncien) {
  if (!nomOnglet) return [];
  const raw = estAncien ? getTabEnTetesDynamiques(ss, nomOnglet) : getTab(ss, nomOnglet);
  if (raw.error || !raw.rows || raw.rows.length === 0) return [];
  const sheet = ss.getSheetByName(nomOnglet);
  const hyperliens = extraireHyperliensDevis(entity, sheet, raw.headerRowIdx || 1);
  return raw.rows.map(function(r) {
    var normalized = normalizeRow(r, 'DEVIS', entity);
    if (!normalized) return null;
    var hl = hyperliens[r._rowIndex] || {};
    if (hl['urlRecap']   ) normalized.pdfRecap   = hl['urlRecap'];
    if (hl['urlContrat'] ) normalized.pdfContrat = hl['urlContrat'];
    normalized.pdfUrl = hl['urlContrat'] || hl['urlRecap'] || normalized.pdfUrl || '';
    normalized._sourceSheet = nomOnglet;
    normalized._ancien = !!estAncien;
    return normalized;
  }).filter(function(r) { return r !== null; });
}

// Charge tous les devis d'une entité pour une année donnée : la feuille actuelle
// ("DEVIS V<année>") + l'ancienne feuille "DEVIS" (filtrée sur l'année). Retourne
// { tabName, rows, debugAncien }.
function chargerTousLesDevisEntite(ss, entity, year) {
  const tabName   = resolveTabName('DEVIS V', year, entity);
  const tabAncien = 'DEVIS'; // ancienne feuille, avant l'introduction de "DEVIS V<année>"

  var rows = chargerDevisOnglet(ss, entity, tabName, false);

  var debugAncien = null;
  if (tabAncien !== tabName) {
    var rawAncien   = getTabEnTetesDynamiques(ss, tabAncien);
    var sheetAncien = ss.getSheetByName(tabAncien);
    var apercuBrut = [];
    if (sheetAncien) {
      var nCols = Math.min(sheetAncien.getLastColumn(), 15);
      var nRows = Math.min(sheetAncien.getLastRow(), 8);
      if (nRows > 0 && nCols > 0) apercuBrut = sheetAncien.getRange(1, 1, nRows, nCols).getValues();
    }
    debugAncien = {
      ongletExiste:         !!sheetAncien,
      erreurLecture:        rawAncien.error || null,
      nbColonnesTotal:      sheetAncien ? sheetAncien.getLastColumn() : 0,
      nbLignesTotal:        sheetAncien ? sheetAncien.getLastRow() : 0,
      ligneEnTetesDetectee: rawAncien.headerRowIdx || 0,
      enTetesDetectees:     rawAncien.headers || [],
      nbLignesBrutes:       rawAncien.rows ? rawAncien.rows.length : 0,
      apercuBrut8x15:       apercuBrut,
    };
    var rowsAnciensTous = chargerDevisOnglet(ss, entity, tabAncien, true);
    debugAncien.nbLignesNormalisees = rowsAnciensTous.length;
    var rowsAnciens = rowsAnciensTous.filter(function(r) { return !r.annee || r.annee === year; });
    debugAncien.nbLignesAnneeSelectionnee = rowsAnciens.length;
    rows = rows.concat(rowsAnciens);
  }

  return { tabName: tabName, rows: rows, debugAncien: debugAncien };
}

function getTab(ss, tabName) {
  if (!tabName) return { error: 'TAB_NAME_EMPTY', tab: tabName };
  const sheet = ss.getSheetByName(tabName);
  if (!sheet) return { error: 'TAB_NOT_FOUND', tab: tabName };
  const data = sheet.getDataRange().getValues();
  if (data.length === 0) return { tab: tabName, headers: [], rows: [] };
  const headers = data[0];
  const headerCount = {};
  const headerKeys  = headers.map(h => {
    const key = (h || '').toString();
    if (!key) return '_empty_' + Math.random();
    headerCount[key] = (headerCount[key] || 0) + 1;
    return headerCount[key] === 1 ? key : key + '__' + headerCount[key];
  });
  const rows = data.slice(1).map((row, i) => {
    const obj = { _rowIndex: i + 2 };
    headerKeys.forEach((k, j) => { obj[k] = row[j]; });
    return obj;
  });
  return { tab: tabName, headers, rows };
}

// Comme getTab, mais détecte automatiquement la ligne d'en-têtes au lieu de
// supposer que c'est toujours la ligne 1 — nécessaire pour les onglets
// historiques (ex: ancienne feuille "DEVIS") où la ligne 1 est vide/inutilisée
// et les vraies colonnes ne démarrent qu'en ligne 2 ou 3. Scanne les 5
// premières lignes et retient la première avec au moins 3 cellules texte non
// vides comme ligne d'en-têtes ; si aucune n'est trouvée, retombe sur un
// résultat vide (pas d'erreur) plutôt que de mal interpréter les données.
function getTabEnTetesDynamiques(ss, tabName) {
  if (!tabName) return { error: 'TAB_NAME_EMPTY', tab: tabName };
  const sheet = ss.getSheetByName(tabName);
  if (!sheet) return { error: 'TAB_NOT_FOUND', tab: tabName };
  const lastRow = sheet.getLastRow();
  const lastCol = sheet.getLastColumn();
  if (lastRow === 0 || lastCol === 0) return { tab: tabName, headers: [], rows: [], headerRowIdx: 0 };

  var headerRowIdx = 0;
  var headers = null;
  var maxScan = Math.min(lastRow, 5);
  for (var r = 1; r <= maxScan; r++) {
    var candidate = sheet.getRange(r, 1, 1, lastCol).getValues()[0];
    var textCount = candidate.filter(function(v) {
      return v && typeof v === 'string' && v.trim().length > 1 && v !== '#REF!';
    }).length;
    if (textCount >= 3) { headers = candidate; headerRowIdx = r; break; }
  }
  if (!headers) return { tab: tabName, headers: [], rows: [], headerRowIdx: 0 };

  const headerCount = {};
  const headerKeys  = headers.map(function(h) {
    const key = (h || '').toString();
    if (!key) return '_empty_' + Math.random();
    headerCount[key] = (headerCount[key] || 0) + 1;
    return headerCount[key] === 1 ? key : key + '__' + headerCount[key];
  });

  if (lastRow <= headerRowIdx) return { tab: tabName, headers: headers, rows: [], headerRowIdx: headerRowIdx };
  const data = sheet.getRange(headerRowIdx + 1, 1, lastRow - headerRowIdx, lastCol).getValues();
  const rows = data.map(function(row, i) {
    const obj = { _rowIndex: headerRowIdx + 1 + i };
    headerKeys.forEach(function(k, j) { obj[k] = row[j]; });
    return obj;
  });
  return { tab: tabName, headers: headers, rows: rows, headerRowIdx: headerRowIdx };
}

function getConfig(ss) { ensureConfigTab(ss); return getConfigMap(ss); }

function getConfigMap(ss) {
  const sheet = ss.getSheetByName('CONFIG');
  if (!sheet) return {};
  const data = sheet.getDataRange().getValues();
  const map  = {};
  data.slice(1).forEach(row => { if (row[0]) map[row[0]] = row[1]; });
  return map;
}

function getAvailableYears(ss) {
  const sheets = ss.getSheets().map(s => s.getName());
  const years  = new Set();
  sheets.forEach(name => { const m = name.match(/(\d{4})$/); if (m) years.add(parseInt(m[1])); });
  return { years: Array.from(years).sort() };
}

function getLicences(ss) {
  const cfg   = getConfigMap(ss);
  const today = new Date();
  const exp   = cfg['LICENCE_EXPIRATION'] ? new Date(cfg['LICENCE_EXPIRATION']) : null;
  const joursRestants = exp ? Math.round((exp - today) / 86400000) : null;
  return { numero: cfg['LICENCE_NUMERO'] || '', expiration: cfg['LICENCE_EXPIRATION'] || '',
           joursRestants, alerte: joursRestants !== null && joursRestants < 60,
           danger: joursRestants !== null && joursRestants < 30 };
}

function getAllConfig(ss, entity, email) {
  const cfg      = getConfigMap(ss);
  const licences = getLicences(ss);
  const sheetIds = {};
  Object.entries(ENTITY_SHEET_IDS).forEach(([code, id]) => {
    const savedId = cfg['SHEET_ID_' + code] || '';
    const finalId = (!id || id.startsWith('TODO_')) ? savedId : id;
    sheetIds[code] = { id: finalId, configured: !!(finalId && !finalId.startsWith('TODO_')) };
  });
  const porteursBruts = {};
  Object.entries(cfg).forEach(([k, v]) => { if (k.startsWith('PORTEURS')) porteursBruts[k] = v; });
  return {
    isAdmin: getRoleForEmail(email) === 'ADMIN', entity, cfg, sheetIds, licences, porteursBruts,
    driveIds: {
      fiches:       cfg['DRIVE_FICHES_PAIE']       || '',
      contrats:     cfg['DRIVE_CONTRATS']           || '',
      virements:    cfg['DRIVE_VIREMENTS']          || '',
      ndf:          cfg['DRIVE_NDF']                || '',
      piecesCompta: cfg['DRIVE_PIECES_COMPTA']      || '',
    },
  };
}

function testSheetConnection(entityCode) {
  if (!entityCode) return { success: false, error: 'Entity requis' };
  const ss = getSheetById(entityCode.toUpperCase());
  if (!ss) return { success: false, error: 'Sheet ID non configure pour ' + entityCode };
  try { return { success: true, entityCode, name: ss.getName() }; }
  catch(err) { return { success: false, error: err.message, entityCode }; }
}

function getDSNStatus(ss, year, mois) {
  const cfg    = getConfigMap(ss);
  const key    = 'DSN_' + year + '_' + String(mois).padStart(2, '0');
  const val    = cfg[key] || '';
  const alerte = !val && new Date() > new Date(year, parseInt(mois), 5);
  return { key, value: val, valide: !!val, alerte };
}

function getDevisSpectacles(ss, year, entity) {
  const tabName = resolveTabName('DEVIS V', year, entity);
  if (!tabName) return { spectacles: [] };
  const data = getTab(ss, tabName);
  if (data.error) return { spectacles: [] };
  const set = new Set();
  data.rows.forEach(r => {
    const s = r['SPECTACLE'] || r['Quel projet ? '] || r['Quel projet ?'] || '';
    if (s) set.add(s.toString().trim());
  });
  return { spectacles: Array.from(set).sort() };
}

