// Génère un matricule au format réellement utilisé dans sPAIEctacle (vu dans
// la liste des salariés) : 2 lettres du nom + 1 lettre du prénom, en
// minuscules (ex: BOURDEIX Nicolas → "bon", BAZIN Malorie → "bam"). Un
// chiffre est ajouté par le logiciel en cas de collision (ex: "bon2", "bon3"
// pour la même personne sur plusieurs structures) — on ne peut pas le
// prédire sans accès à sa base, donc pas de suffixe généré ici ; si le code
// de base est déjà pris, le logiciel le signalera et il faudra ajuster à la
// main. Le premier essai (10 caractères avec tirets) avait été rejeté
// "non reconnu ou non valide" — probablement à cause de ce format trop long.
// Testé ensuite avec un vrai import groupé : quand le prénom n'a pas pu être
// séparé du nom, le code tombait à 2 lettres ("fa", "au"...) et était rejeté
// avec le même message — tous les matricules réels observés (liste des
// salariés + contrats existants) font au moins 3 caractères. On complète
// donc avec une 3e lettre du nom quand le prénom est vide plutôt que de
// renvoyer un code trop court.
function _genererMatricule(nom, prenom) {
  var n = (nom    || '').toUpperCase().replace(/[^A-Z]/g, '');
  var p = (prenom || '').toUpperCase().replace(/[^A-Z]/g, '');
  var base = p ? (n.substring(0, 2) + p.substring(0, 1)) : n.substring(0, 3);
  return (base || 'xxx').toLowerCase();
}

// Construit les lignes TSV (sans en-tête) et les avertissements pour UNE
// Hash court et déterministe (base36, ~6-7 caractères) — utilisé pour générer
// un "Code contrat" compact qui reste unique par déclaration sans dépasser la
// limite de 20 caractères imposée par sPAIEctacle.
function _hashCourt(s) {
  var h = 0;
  s = s.toString();
  for (var i = 0; i < s.length; i++) { h = ((h << 5) - h + s.charCodeAt(i)) | 0; }
  return Math.abs(h).toString(36);
}

// ligne de contrat — factorisé pour être réutilisé aussi bien par l'export
// d'un seul contrat que par l'export groupé de plusieurs contrats dans un
// même fichier (bouton "Exporter tous les contrats").
function _construireLignesContratPaie(entity, salarie, fonction, projet, debut, fin, cachets, montantCachet, services4h, montantService, codeSociete, cachetDetails) {
  var avertissements = [];

  // codeSociete distingue le "Code société" réel à écrire dans le contrat
  // (ex: une structure cliente gérée par Paie AMIIS, "LES PAILLETTES") de
  // `entity`, qui reste le contexte de session utilisé pour l'autorisation —
  // les deux sont souvent identiques (DPAE d'une structure AMIIS classique :
  // OM, DIS, CLR...) mais pas pour Paie AMIIS, où entity vaut toujours
  // 'AMIIS' alors que le Code société est celui du client. Quand codeSociete
  // est fourni, c'est le nom de structure affiché (pas forcément le vrai
  // code sPAIEctacle) — on le résout via la table des sociétés importée.
  var cs = codeSociete || entity;
  if (codeSociete) {
    var codeResolu = trouverCodeSociete(codeSociete);
    if (codeResolu) {
      cs = codeResolu;
      avertissements.push('Code société résolu pour "' + codeSociete + '" → "' + cs + '".');
    } else {
      avertissements.push('Code société introuvable pour "' + codeSociete + '" dans la table des sociétés importée — utilisé tel quel ("' + cs + '"), à vérifier avant import.');
    }
  }

  // Si "salarie" n'est qu'un prénom (ex: déclarations DIS : "Pour qui est fait
  // la déclaration ?" ne contient que "Diane", pas "VILLANUEVA Diane"), le
  // résoudre en nom complet AVANT de séparer nom/prénom — sinon
  // _separerNomPrenom traite tout le prénom comme un "nom" de famille (nom="
  // Diane", prénom="") et le matricule généré/recherché est faux. Utilise `cs`
  // (le vrai code société, pas `entity` qui vaut toujours 'AMIIS' pour Paie
  // AMIIS) pour cibler la bonne table des salariés importée.
  var salarieResolu = resoudreNomCompletDepuisPrenom(getSheetById(cs), salarie, cs);
  if (salarieResolu !== salarie) avertissements.push('Prénom "' + salarie + '" résolu en nom complet "' + salarieResolu + '".');
  var nomProf = _separerNomPrenom(salarieResolu);

  var profession = trouverCodeProfession(fonction);
  if (!profession) avertissements.push('Profession "' + fonction + '" non reconnue ou ambiguë — code et libellé profession laissés vides.');

  var tarifsDefaut = _tarifsPaieEntity(cs, getSheetById(cs) || SpreadsheetApp.getActiveSpreadsheet());
  var tarifCachet  = montantCachet  > 0 ? montantCachet  : tarifsDefaut.cachet;
  var tarifService = montantService > 0 ? montantService : tarifsDefaut.service;
  var aDesCachetsDetailles = cachetDetails && cachetDetails.length > 0;
  if ((!aDesCachetsDetailles && cachets > 0 && !tarifCachet) || (services4h > 0 && !tarifService)) {
    avertissements.push('Tarif cachet/service inconnu pour ' + cs + ' — base rubrique laissée à 0, à corriger avant import.');
  }

  // D'après la doc officielle sPAIEctacle : seuls Code société, Matricule et
  // Début de contrat sont réellement obligatoires. Code contrat, Catégorie
  // salariale, Type de contrat, Heure d'embauche, Convention collective,
  // Numéro d'objet, Calcul du plafond et A.T. applicable sont tous générés
  // PAR DÉFAUT depuis la fiche Société si laissés vides — donc on ne les
  // devine plus nous-mêmes (plus fiable que nos suppositions, et ça marche
  // pour toutes les structures sans avoir à confirmer leurs réglages un par
  // un). "Code société" accepte directement le code d'entité (OM, DIS...),
  // pas besoin de raison sociale. Matricule + Début de contrat sont aussi les
  // champs qui relient les lignes multivaluées (rubriques) entre elles.
  var matricule = trouverMatricule(cs, nomProf.nom, nomProf.prenom);
  if (matricule) {
    avertissements.push('Matricule réel trouvé dans la table des salariés importée ("' + matricule + '").');
  } else {
    matricule = _genererMatricule(nomProf.nom, nomProf.prenom);
    avertissements.push('Salarié non trouvé dans la table des salariés importée — matricule généré provisoirement ("' + matricule + '"), à vérifier avant import (créera une nouvelle fiche salarié si ce matricule n\'existe pas déjà).');
  }

  // "Compte analytique" doit correspondre à un code déjà existant dans
  // sPAIEctacle (leur propre plan analytique) — testé avec un vrai import :
  // notre nom de projet interne ("MIC") y a été rejeté "non reconnu ou non
  // valide", et comme cette ligne porte l'identification du contrat, l'échec
  // invalidait aussi la ligne de rubrique suivante (Matricule "non reconnu"
  // en cascade, alors que le matricule lui-même était bon). On cherche donc
  // le vrai code dans la table des comptes analytiques importée (voir
  // trouverCompteAnalytique) avant de laisser vide.
  var compteAnalytique = trouverCompteAnalytique(cs, projet);
  if (compteAnalytique) {
    avertissements.push('Compte analytique trouvé pour le projet "' + projet + '" ("' + compteAnalytique.compte + '").');
  } else if (projet) {
    avertissements.push('Compte analytique introuvable pour le projet "' + projet + '" — laissé vide, à associer manuellement (vérifier/compléter la table des comptes analytiques importée).');
  }

  // "Code contrat" (répété à l'identique sur les lignes de rubrique d'un même
  // contrat, voir plus bas) — confirmé en comparant avec un vrai export d'un
  // contrat existant à 2 rubriques : c'est la vraie clé qui relie les lignes
  // entre elles, pas Matricule + Début comme le suggérait la doc officielle
  // (probablement valable seulement pour mettre à jour un contrat déjà
  // saisi, pas pour en créer un tout neuf à plusieurs rubriques).
  // Doit distinguer deux DPAE différentes du même salarié démarrant le même
  // jour (ex: deux projets différents) — testé avec un vrai export groupé,
  // sinon elles reçoivent le même code et se retrouvent fusionnées à tort
  // (rubrique dupliquée). Mais limité à 20 caractères par sPAIEctacle, donc
  // pas la place d'inclure tous les champs identifiants en clair : on
  // termine par un hash court de (début+fin+projet) plutôt que du texte
  // tronqué, qui avait justement coupé la partie qui distinguait les DPAE.
  var codeContrat = (matricule.substring(0, 8) + '_' + _hashCourt(debut + '|' + fin + '|' + projet)).substring(0, 20);

  var valeursBase = {
    'Code société': cs,
    'Code contrat': codeContrat,
    'Matricule': matricule,
    '(nom salarié)': nomProf.nom,
    '(prénom salarié)': nomProf.prenom,
    'Code profession': profession ? profession.code : '',
    '(libellé profession)': profession ? profession.libelle : '',
    'Début de contrat': debut || '',
    'Fin de contrat': fin || '',
    'Compte analytique': compteAnalytique ? compteAnalytique.compte : '',
    '(libellé analytique)': compteAnalytique ? compteAnalytique.libelle : '',
    '(motif CDD)': "CDD d'usage",
  };
  if (!nomProf.prenom) avertissements.push('Prénom du salarié non séparé du nom — "' + salarie + '" mis tel quel dans (nom salarié).');

  // Une ligne de rubrique par type de paiement présent sur la DPAE (cachet
  // et/ou service). On avait d'abord fait porter Fin/Fonction/Projet etc.
  // uniquement par la 1ère ligne, en pensant que répéter Matricule + Début
  // de contrat suffirait à relier les lignes suivantes au même contrat
  // (comme décrit dans la doc officielle pour les champs multivalués). Testé
  // avec un vrai import groupé, et un 2e essai en répétant aussi "Code
  // contrat" sur toutes les lignes n'a pas marché non plus (chaque ligne
  // reste un contrat séparé). La vraie clé a été trouvée en comparant avec
  // un EXPORT réel d'un contrat existant à 2 rubriques (cachet + service) :
  // sur la ligne de continuation, TOUT est vide sauf "Code contrat" (répété
  // à l'identique) et les champs de rubrique — Code société, Matricule, nom,
  // dates, profession... ne doivent PAS être répétés. En les remplissant
  // (comme on le faisait), le logiciel comprend que chaque ligne déclare son
  // propre contrat complet, d'où les contrats séparés observés.
  // Certains contrats ont plusieurs cachets à des tarifs différents sur la
  // même DPAE (ex: "T1 : 200€ × 4 | T2 : 500€ × 4" — deux tarifs, pas cachet
  // + service) — cachetDetails porte alors chaque tarif séparément. Les
  // fusionner en une seule ligne avec seulement le tarif du premier groupe
  // aurait fait perdre le second montant, donc une ligne de rubrique par
  // tarif quand cachetDetails est fourni, au lieu d'une seule ligne globale.
  var rubriques = [];
  if (aDesCachetsDetailles) {
    cachetDetails.forEach(function(d) {
      if (d.qte > 0) rubriques.push({ code: RUBRIQUE_CACHET.code, libelle: RUBRIQUE_CACHET.libelle, quantite: d.qte, base: d.montant });
    });
  } else if (cachets > 0) {
    rubriques.push({ code: RUBRIQUE_CACHET.code, libelle: RUBRIQUE_CACHET.libelle, quantite: cachets, base: tarifCachet });
  }
  if (services4h > 0) rubriques.push({ code: RUBRIQUE_SERVICE.code, libelle: RUBRIQUE_SERVICE.libelle, quantite: services4h, base: tarifService });
  if (rubriques.length === 0) avertissements.push('Aucun cachet ni service sur cette ligne — pas de rubrique de paie générée.');

  var lignes = [];
  rubriques.forEach(function(r, i) {
    // 1ère ligne : toutes les infos du contrat. Lignes suivantes : QUE le
    // Code contrat (pour les rattacher) + la rubrique — rien d'autre, comme
    // observé dans le vrai export.
    var valeurs = i === 0 ? Object.assign({}, valeursBase) : { 'Code contrat': codeContrat };
    valeurs['Code rubrique']      = r.code;
    valeurs['Libellé rubrique']   = r.libelle;
    valeurs['Quantité rubrique']  = r.quantite;
    valeurs['Base rubrique']      = r.base;
    lignes.push(COLONNES_EXPORT_PAIE.map(function(col) { return valeurs[col] !== undefined ? valeurs[col] : ''; }).join('\t'));
  });
  if (lignes.length === 0) lignes.push(COLONNES_EXPORT_PAIE.map(function(col) { return valeursBase[col] !== undefined ? valeursBase[col] : ''; }).join('\t'));

  return { lignes: lignes, avertissements: avertissements, nomProf: nomProf };
}

function genererFichierContratPaie(entity, salarie, fonction, projet, debut, fin, cachets, montantCachet, services4h, montantService, codeSociete, cachetDetails) {
  var r = _construireLignesContratPaie(entity, salarie, fonction, projet, debut, fin, cachets, montantCachet, services4h, montantService, codeSociete, cachetDetails);

  // sPAIEctacle refuse les titres de colonnes accentués s'ils ne sont pas en
  // Windows-1252 (ANSI) — testé avec un vrai import : toutes les colonnes
  // accentuées étaient rejetées ("Titre ... non reconnu") en UTF-8. Le fichier
  // est donc encodé en Windows-1252 et renvoyé en base64 (GAS n'a pas de
  // conversion de charset intégrée pour du texte arbitraire).
  var contenu = COLONNES_EXPORT_PAIE.join('\t') + '\r\n' + r.lignes.join('\r\n') + '\r\n';
  var contenuBase64 = Utilities.base64Encode(_texteVersOctetsWin1252(contenu));
  var nomProf = r.nomProf;
  var avertissements = r.avertissements;

  var nomFichier = 'Contrat_' + (codeSociete || entity) + '_' + (nomProf.nom || 'salarie').replace(/[^A-Za-z0-9]/g, '') + '_' + (debut || '').replace(/\//g, '-') + '.txt';
  return { success: true, contenuBase64: contenuBase64, nomFichier: nomFichier, avertissements: avertissements };
}

// Regroupe l'export de plusieurs lignes DPAE (bouton "Exporter tous les
// contrats", à côté de "Valider toutes") dans UN SEUL fichier .txt — un seul
// en-tête, toutes les lignes de contrat à la suite. Les avertissements de
// chaque ligne sont conservés et préfixés par le salarié concerné pour
// rester exploitables malgré le regroupement.
function genererFichiersContratsPaie(entity, lignes) {
  if (!lignes || !lignes.length) return { error: 'Aucune ligne à exporter' };
  var toutesLesLignes = [];
  var avertissements = [];
  lignes.forEach(function(l) {
    var r = _construireLignesContratPaie(entity, l.salarie, l.fonction, l.projet, l.debut, l.fin,
      l.cachets, l.montantCachet, l.services4h, l.montantService, l.codeSociete, l.cachetDetails);
    toutesLesLignes = toutesLesLignes.concat(r.lignes);
    var label = (l.salarie || '?') + (l.debut ? ' (' + l.debut + ')' : '');
    r.avertissements.forEach(function(a) { avertissements.push(label + ' — ' + a); });
  });

  var contenu = COLONNES_EXPORT_PAIE.join('\t') + '\r\n' + toutesLesLignes.join('\r\n') + '\r\n';
  var contenuBase64 = Utilities.base64Encode(_texteVersOctetsWin1252(contenu));
  var nomFichier = 'Contrats_' + entity + '_' + Utilities.formatDate(new Date(), 'Europe/Paris', 'yyyyMMdd') + '.txt';
  return { success: true, contenuBase64: contenuBase64, nomFichier: nomFichier, avertissements: avertissements, count: lignes.length };
}

// =============================================================================
// SALARIÉS PAIE — table des vrais matricules sPAIEctacle, importée depuis
// l'export "Salariés de l'année" du logiciel (colonnes : Code société /
// Matricule / Nom / Prénom). Remplace la génération à l'aveugle d'un
// matricule dès qu'un salarié y est trouvé : c'est la seule source fiable,
// le format réel n'étant pas prévisible à 100% (suffixes numériques ajoutés
// par le logiciel en cas de collision, quelques codes qui ne suivent même
// pas le schéma "2 lettres nom + 1 lettre prénom" observé). Table stockée
// dans un onglet dédié du classeur AMIIS, indépendant de l'entité —comme
// UTILISATEURS_APP— et entièrement remplacée à chaque import mensuel (le
// fichier exporté est une photo complète, pas un delta).
// =============================================================================

var SALARIES_PAIE_HEADERS = ['ENTITE', 'MATRICULE', 'NOM', 'PRENOM'];

function ensureSalariesPaieTab() {
  var ss = SpreadsheetApp.openById(ENTITY_SHEET_IDS.AMIIS);
  var sheet = ss.getSheetByName('SALARIES_PAIE');
  if (!sheet) {
    sheet = ss.insertSheet('SALARIES_PAIE');
    sheet.getRange(1, 1, 1, SALARIES_PAIE_HEADERS.length).setValues([SALARIES_PAIE_HEADERS]).setFontWeight('bold').setBackground('#555555').setFontColor('#ffffff');
    sheet.setFrozenRows(1);
  }
  return sheet;
}

// Ignore accents, casse et séparateurs (espaces, tirets, apostrophes) pour
// comparer des noms saisis différemment selon la source ("LE BARS CAILLET"
// vs le "LEBARSCAILLET" utilisé dans _genererMatricule, "Paul-Henri" vs
// "Paul Henri").
function _normaliserNomPersonne(s) {
  return (s || '').toString().toUpperCase()
    .normalize('NFD').replace(/[̀-ͯ]/g, '')
    .replace(/[^A-Z]/g, '');
}

// Remplace entièrement le contenu de l'onglet à chaque import — le fichier
// "Salariés de l'année" exporté du logiciel est une photo complète.
function importerSalariesPaie(texte) {
  if (!texte) return { error: 'Fichier vide' };
  var lignes = texte.split(/\r\n|\r|\n/)
    .map(function(l) { return l.split('\t'); })
    .filter(function(cols) { return cols.length >= 4 && (cols[0] || '').trim(); });
  var rows = lignes
    .filter(function(cols) { return _normaliserNomPersonne(cols[0]) !== 'CODESOCIETE'; }) // ignore l'en-tête
    .map(function(cols) { return [cols[0].trim().toUpperCase(), (cols[1]||'').trim(), (cols[2]||'').trim(), (cols[3]||'').trim()]; })
    .filter(function(row) { return row[0] && row[1]; });
  if (rows.length === 0) return { error: 'Aucune ligne salarié reconnue dans le fichier' };

  var sheet = ensureSalariesPaieTab();
  var lastRow = sheet.getLastRow();
  if (lastRow > 1) sheet.getRange(2, 1, lastRow - 1, SALARIES_PAIE_HEADERS.length).clearContent();
  sheet.getRange(2, 1, rows.length, SALARIES_PAIE_HEADERS.length).setValues(rows);
  updateConfig(SpreadsheetApp.openById(ENTITY_SHEET_IDS.AMIIS), 'SALARIES_PAIE_DERNIER_IMPORT', new Date().toISOString());
  return { success: true, count: rows.length };
}

function getInfoSalariesPaie() {
  var sheet = ensureSalariesPaieTab();
  var count = Math.max(sheet.getLastRow() - 1, 0);
  var dernierImport = '';
  try { dernierImport = getConfigMap(SpreadsheetApp.openById(ENTITY_SHEET_IDS.AMIIS))['SALARIES_PAIE_DERNIER_IMPORT'] || ''; } catch(_) {}
  return { success: true, count: count, dernierImport: dernierImport };
}

// Cherche le matricule réel importé pour ce salarié dans cette entité. Ne
// renvoie un résultat QUE si la correspondance nom+prénom est unique pour
// cette entité — en cas d'ambiguïté (homonymes non départagés) on préfère
// ne rien renvoyer plutôt que de risquer d'assigner le mauvais matricule.
function trouverMatricule(entity, nom, prenom) {
  var sheet = ensureSalariesPaieTab();
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return null;
  var data = sheet.getRange(2, 1, lastRow - 1, SALARIES_PAIE_HEADERS.length).getValues();
  var cibleEntity = (entity || '').toUpperCase();
  var cibleNom = _normaliserNomPersonne(nom);
  var ciblePrenom = _normaliserNomPersonne(prenom);
  var correspondances = data.filter(function(row) {
    return (row[0] || '').toString().trim().toUpperCase() === cibleEntity
      && _normaliserNomPersonne(row[2]) === cibleNom
      && (!ciblePrenom || _normaliserNomPersonne(row[3]) === ciblePrenom);
  });
  if (correspondances.length === 1) return correspondances[0][1];
  return null;
}

// Même table SALARIES_PAIE que trouverMatricule, mais indexée en sens inverse
// (prénom -> nom complet) pour résoudre un champ "salarié" qui ne contient
// que le prénom (ex: déclarations DPAE V2 chez DIS : "Pour qui est fait la
// déclaration ?" ne contient que "Diane", jamais "VILLANUEVA Diane") — table
// plus complète en pratique que CODE COMPTA (tenue à la main, souvent
// partielle). Même garde anti-ambiguïté : un prénom partagé par plusieurs
// salariés de la même entité (homonymes) n'est jamais résolu.
var _cachePrenomVersNomSalariesPaie = {};
function getMapPrenomVersNomSalariesPaie(entity) {
  var cle = (entity || '').toUpperCase();
  if (!cle) return {};
  if (_cachePrenomVersNomSalariesPaie[cle]) return _cachePrenomVersNomSalariesPaie[cle];
  var parPrenom = {};
  try {
    var sheet = ensureSalariesPaieTab();
    var lastRow = sheet.getLastRow();
    if (lastRow >= 2) {
      var data = sheet.getRange(2, 1, lastRow - 1, SALARIES_PAIE_HEADERS.length).getValues();
      data.forEach(function(row) {
        if ((row[0] || '').toString().trim().toUpperCase() !== cle) return;
        var nom = (row[2] || '').toString().trim();
        var prenom = (row[3] || '').toString().trim();
        if (!nom || !prenom) return;
        var clePrenom = _normaliserNomPersonne(prenom);
        if (!clePrenom) return;
        var complet = nom + ' ' + prenom;
        if (parPrenom[clePrenom] === undefined) parPrenom[clePrenom] = complet;
        else if (parPrenom[clePrenom] !== complet) parPrenom[clePrenom] = null; // homonyme -> ambigu
      });
    }
  } catch(e) { Logger.log('getMapPrenomVersNomSalariesPaie erreur: ' + e.message); }
  _cachePrenomVersNomSalariesPaie[cle] = parPrenom;
  return parPrenom;
}

