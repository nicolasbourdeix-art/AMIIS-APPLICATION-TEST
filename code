// EXACTEMENT à une ou plusieurs entrées de la table, ET que l'ambiguïté
// éventuelle a été explicitement résolue (voir PROFESSION_PREFEREE_SI_AMBIGU)
// — jamais de correspondance approximative ou de choix arbitraire entre
// plusieurs candidats non confirmés.
function trouverCodeProfession(fonction) {
  var cible = _normaliserLibelleProfession(fonction);
  if (!cible) return null;
  var correspondances = PROFESSIONS_PAIE.filter(function(p) {
    return _normaliserLibelleProfession(p.libelle) === cible;
  });
  if (correspondances.length === 1) return correspondances[0];
  if (correspondances.length > 1 && PROFESSION_PREFEREE_SI_AMBIGU[cible]) {
    var code = PROFESSION_PREFEREE_SI_AMBIGU[cible];
    var choisie = correspondances.find(function(p) { return p.code === code; });
    if (choisie) return choisie;
  }
  return null; // 0, ou plusieurs sans préférence confirmée → on ne devine pas
}

// Table des caractères "spéciaux" Windows-1252 (plage 0x80-0x9F) qui ne
// correspondent pas directement à leur point de code Unicode, contrairement
// aux caractères accentués français usuels (é, è, ç... sont identiques en
// Unicode et en Windows-1252 sur la plage 0xA0-0xFF).
var WIN1252_SPECIAUX = {
  0x20AC: 0x80, 0x201A: 0x82, 0x0192: 0x83, 0x201E: 0x84, 0x2026: 0x85,
  0x2020: 0x86, 0x2021: 0x87, 0x02C6: 0x88, 0x2030: 0x89, 0x0160: 0x8A,
  0x2039: 0x8B, 0x0152: 0x8C, 0x017D: 0x8E, 0x2018: 0x91, 0x2019: 0x92,
  0x201C: 0x93, 0x201D: 0x94, 0x2022: 0x95, 0x2013: 0x96, 0x2014: 0x97,
  0x02DC: 0x98, 0x2122: 0x99, 0x0161: 0x9A, 0x203A: 0x9B, 0x0153: 0x9C,
  0x017E: 0x9E, 0x0178: 0x9F,
};

// Convertit une chaîne JS (UTF-16 interne) en tableau d'octets Windows-1252 —
// GAS n'a pas de conversion de charset native pour du texte arbitraire, donc
// on mappe caractère par caractère. Les octets Apps Script sont signés
// (-128..127), d'où le décalage pour les valeurs > 127.
function _texteVersOctetsWin1252(texte) {
  var octets = [];
  for (var i = 0; i < texte.length; i++) {
    var code = texte.charCodeAt(i);
    var octet = code <= 0xFF ? code : (WIN1252_SPECIAUX[code] !== undefined ? WIN1252_SPECIAUX[code] : 0x3F);
    octets.push(octet > 127 ? octet - 256 : octet);
  }
  return octets;
}

// Sépare un champ salarié en nom/prénom du mieux possible. Nos données ne
// suivent pas une convention unique selon la structure (parfois "NOM Prénom",
// parfois juste "NOM", parfois "Prénom NOM") : on suppose que le premier mot
// tout en majuscules est le nom de famille (convention la plus fréquente
// observée, ex: "BOURDEIX Nicolas", "CAILLET Evelyne") — à défaut, tout va
// dans "nom" et "prénom" reste vide plutôt que de deviner un mauvais ordre.
// Un nom de famille composé de PLUSIEURS mots tout en majuscules ("LE LAGADEC
// Julie", "LIOTARD KHOURI-HADDAD Edouard") n'était pas géré : seul le tout
// premier mot majuscule était pris comme nom ("LE", "LIOTARD"), le reste
// (contenant le vrai reste du nom de famille) atterrissait à tort dans le
// prénom — testé avec un vrai import : sPAIEctacle a rejeté les matricules
// générés ("lel", "lik") comme "non reconnu ou non valide" car ils ne
// correspondaient à aucune vraie fiche salarié. On consomme donc maintenant
// TOUS les mots en tête qui sont en majuscules (en gardant toujours au moins
// un mot pour le prénom) plutôt qu'un seul.
// Particules de nom françaises usuelles — un nom à particule ("De Baecque",
// "Le Gall") ne suit ni la convention "NOM Prénom" ni "Prénom NOM" tout en
// majuscules (aucun des deux ne matche), et retombait donc entièrement dans
// "nom" avec un prénom vide — testé avec un vrai import : ça produit un
// matricule généré invalide (3 lettres du "nom" complet mêlant nom+prénom)
// ET un prénom manquant, tous deux rejetés à la création d'une fiche
// salarié.
var PARTICULES_NOM = ['de','du','des','le','la','les','von','van','der','den','di','da','dos','das'];

function _estMotMajuscule(mot) {
  return mot === mot.toUpperCase() && /[A-ZÀ-Ü]/.test(mot);
}

function _separerNomPrenom(salarie) {
  var mots = (salarie || '').toString().trim().split(/\s+/).filter(Boolean);
  if (mots.length === 0) return { nom: '', prenom: '' };
  if (mots.length === 1) return { nom: mots[0], prenom: '' };
  if (_estMotMajuscule(mots[0])) {
    var i = 0;
    while (i < mots.length - 1 && _estMotMajuscule(mots[i])) i++;
    if (i === 0) i = 1;
    return { nom: mots.slice(0, i).join(' '), prenom: mots.slice(i).join(' ') };
  }
  // Dernier mot en majuscules → probablement "Prénom NOM"
  var dernier = mots[mots.length - 1];
  if (_estMotMajuscule(dernier)) {
    return { nom: dernier, prenom: mots.slice(0, -1).join(' ') };
  }
  if (mots.length >= 3 && PARTICULES_NOM.indexOf(mots[0].toLowerCase()) !== -1) {
    return { nom: mots[0] + ' ' + mots[1], prenom: mots.slice(2).join(' ') };
  }
  return { nom: salarie, prenom: '' };
}

