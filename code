function _normaliserLibelleProfession(s) {
  return (s || '').toString()
    .replace(/\([^)]*\)/g, '') // retire "( MAR )", "(ADMP)", etc. — nos propres codes internes
    .toUpperCase()
    .normalize('NFD').replace(/[̀-ͯ]/g, '')
    .replace(/[^A-Z ]/g, ' ')
