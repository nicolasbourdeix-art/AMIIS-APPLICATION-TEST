function confirmerFichePaie(entity, rowIndex, url, sourceSheetName) {
  const ss = getSheetById(entity);
  if (!ss) return { error: 'Entity introuvable: ' + entity };

  // Chercher la feuille dans l'ordre de priorité : sourceSheet -> Contrats -> onglet DECLA
  const sheetsToTry = [];
  if (sourceSheetName) sheetsToTry.push(sourceSheetName);
  sheetsToTry.push('Contrats');
  // Ajouter l'onglet DECLA/DPAE de l'entité
  const tabDecla = resolveTabName('DECLA', new Date().getFullYear(), entity);
  if (tabDecla && !sheetsToTry.includes(tabDecla)) sheetsToTry.push(tabDecla);

  for (var s = 0; s < sheetsToTry.length; s++) {
    var targetSheet = ss.getSheetByName(sheetsToTry[s]);
    if (!targetSheet) continue;
    var headers = targetSheet.getRange(1, 1, 1, targetSheet.getLastColumn()).getValues()[0];
    var colFDP      = -1, colFDPSt = -1, colFDPCand = -1;
    headers.forEach(function(h, i) {
      var hh = h.toString().trim();
      if (hh === 'Fiche de paie')  colFDP    = i;
      if (hh === 'FDP_Statut')     colFDPSt  = i;
      if (hh === 'FDP_Candidats')  colFDPCand = i;
    });
    if (colFDP === -1) {
      // Créer la colonne Fiche de paie dans cet onglet
      var newCol = targetSheet.getLastColumn() + 1;
      targetSheet.getRange(1, newCol).setValue('Fiche de paie').setFontWeight('bold').setBackground('#27AE60').setFontColor('#fff');
      colFDP = newCol - 1;
      Logger.log('Colonne Fiche de paie créée dans ' + sheetsToTry[s]);
    }
    targetSheet.getRange(rowIndex, colFDP + 1).setValue(url);
    if (colFDPSt   !== -1) targetSheet.getRange(rowIndex, colFDPSt   + 1).setValue('CONFIRME');
    if (colFDPCand !== -1) targetSheet.getRange(rowIndex, colFDPCand + 1).setValue('');
    Logger.log('FDP confirmée — onglet: ' + sheetsToTry[s] + ' row: ' + rowIndex);
    return { success: true, rowIndex, url, sheet: sheetsToTry[s] };
  }

  return { error: 'Aucun onglet valide trouvé parmi : ' + sheetsToTry.join(', ') };
}

