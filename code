    { mots: ['msa','cpam','securite sociale'], compte: '442', op: 'Cotisations sociales' },
    { mots: ['dgfip','b2b direction generale','impot'], compte: '447', op: 'Impôts et taxes' },
    // Salaires
    { mots: ['vir paye','virement emis web paie','web paie','web sdb salaire'], compte: '421', op: 'Salaires net versés' },
    { mots: ['virement emis web','remb frais','remb ndf','remboursement frais'], compte: '625', op: 'Remboursement NDF' },
    // Trésorerie
    { mots: ['retour provision livret','retour provision assoc','retour assoc'], compte: '512', op: 'Retour provision Livret A' },
    { mots: ['provision livret','livret a','epargne'], compte: '5121', op: 'Virement Livret A' },
    // Recettes
    { mots: ['virement en votre faveur','remise de cheque','remise cheque','virement recu'], compte: '706', op: 'Prestation de service' },
    { mots: ['subvention','drac','region ','departement','commune','mairie','agglomeration','fdva','sgc ','ligue enseignement'], compte: '74', op: 'Subvention' },
    { mots: ['don exceptionnel','don asso','don association'], compte: '771', op: 'Don exceptionnel' },
    // Frais
    { mots: ['airbnb','hotel','logement','hebergement'], compte: '625.6', op: 'Hébergement' },
    { mots: ['sncf','tgv','ter','train','billet train','ratp'], compte: '625', op: 'Transport' },
    { mots: ['autoroute','peage','essence','carburant','total ','bp ','shell'], compte: '625', op: 'Déplacements' },
    { mots: ['restaurant','pizza','courses supermarche','leclerc','carrefour','lidl','monoprix','super u'], compte: '625.6', op: 'Repas / restauration' },
    { mots: ['paiement carte x4044','paiement par carte'], compte: '625', op: 'Frais CB (à préciser)' },
    // Services bancaires
    { mots: ['frais tenue','tenue de compte','cotisation bancaire','interets crediteurs','frais bancaires'], compte: '627', op: 'Service bancaire' },
    { mots: ['interets debiteurs','agios'], compte: '661', op: 'Intérêts débiteurs' },
    // Fournitures
    { mots: ['amazon','fnac','cultura','materiel','fourniture','imprimante','cartouche'], compte: '606', op: 'Fournitures' },
    { mots: ['logiciel','spaiectacle','abonnement'], compte: '205', op: 'Logiciels' },
    { mots: ['assurance','maif','smacl','axa','allianz','macif'], compte: '616', op: 'Assurances' },
    { mots: ['communication','publicite','flyer','graphiste'], compte: '623', op: 'Communication' },
    { mots: ['cotisation','adhesion','fonds national'], compte: '6281', op: 'Cotisations' },
  ];

  return lignes.map(function(l, i) {
    var lib = (l.libelle || '').toLowerCase();
    var compte = '', op = '', confiance = 'basse';

    // Chercher d'abord dans les règles
    for (var r = 0; r < REGLES.length; r++) {
      var regle = REGLES[r];
      for (var m = 0; m < regle.mots.length; m++) {
        if (lib.indexOf(regle.mots[m]) !== -1) {
          compte = regle.compte;
          op = regle.op;
          confiance = 'moyenne';
          break;
        }
      }
      if (compte) break;
    }

    // Aucune règle ne matche : on laisse le compte VIDE plutôt que de deviner un
    // 512 par défaut qui masque le fait que la ligne n'a pas pu être identifiée —
    // l'utilisateur choisit lui-même le compte dans l'interface. Le libellé garde
    // une indication du sens du mouvement pour aider à trancher.
    if (!compte && l.montant > 0) { op = 'A identifier - recette'; }
    if (!compte && l.montant < 0) { op = 'A identifier - charge'; }

    // Chercher une pièce correspondante par montant dans les noms de fichiers
    var piece_url = '', piece_nom = '';
    var pieceMatch = chercherPiece(l.montant, l.libelle);
    if (pieceMatch) {
      piece_url = pieceMatch.url;
      piece_nom = pieceMatch.nom;
      if (confiance === 'basse') confiance = 'moyenne';
    }

    return { index: i, compte: compte, libelle: l.libelle, spectacle: '', operation: op, confiance: confiance, piece_url: piece_url, piece_nom: piece_nom };
  });
}


