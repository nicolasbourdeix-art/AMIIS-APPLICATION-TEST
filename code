// Résout un nom de structure (tel qu'affiché sur Paie AMIIS, ex: "LES
// PAILLETTES", "CEKO") vers le vrai Code société sPAIEctacle (ex: "PAI",
// "CC"). Le nom affiché n'est pas toujours identique à la Raison sociale/au
// Nom abrégé au caractère près ("CEKO" vs "Compagnie Ceko"), donc on accepte
// une égalité exacte OU une inclusion dans un sens ou l'autre — mais on
// n'agit que si ça désigne une seule société sans ambiguïté.
function trouverCodeSociete(nomStructure) {
  if (!nomStructure) return null;
  var sheet = ensureSocietesPaieTab();
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return null;
  var data = sheet.getRange(2, 1, lastRow - 1, SOCIETES_PAIE_HEADERS.length).getValues();
  var cible = _normaliserNomPersonne(nomStructure);
  if (!cible) return null;
  var correspondances = data.filter(function(row) {
    var raison = _normaliserNomPersonne(row[1]);
    var abrege = _normaliserNomPersonne(row[2]);
    return (raison && (cible === raison || cible.indexOf(raison) !== -1 || raison.indexOf(cible) !== -1))
        || (abrege && (cible === abrege || cible.indexOf(abrege) !== -1 || abrege.indexOf(cible) !== -1));
  });
  if (correspondances.length !== 1) return null;
  return (correspondances[0][0] || '').toString().trim().toUpperCase();
}

// =============================================================================
// RECHERCHE FICHES DE PAIE
// =============================================================================

function chercherFichesPaie(entity, salarie, projet, mois, annee, nomComplet) {
  const ss = getSheetById(entity);
  if (!ss) return { error: 'Entity introuvable: ' + entity };
  const cfg = getConfigMap(ss);

  // Même priorité que chercherFDPDuMois : dossier de raccourcis Drive perso
  // (plus fiable/à jour) avant le champ CONFIG par structure.
  var rootFolder = null;
  try { rootFolder = resoudreDossierFDPViaRaccourcis(entity); } catch(e) {}
  var rootFolderId = cfg['DRIVE_FICHES_PAIE'];
  if (!rootFolder && !rootFolderId) return { error: 'DRIVE_FICHES_PAIE non configure et aucun raccourci FDP trouvé pour ' + entity };

  var trace = [];
  function tlog(msg) { Logger.log(msg); trace.push(msg); }
  tlog('Source dossier : ' + (rootFolder ? 'raccourci ' + (entity === 'AMIIS' ? 'FDP' : 'FDP ' + entity) : 'CONFIG DRIVE_FICHES_PAIE (' + rootFolderId + ')'));

  try {
    const anneeInt = parseInt(annee) || new Date().getFullYear();
    const moisInt  = parseInt(mois)  || new Date().getMonth() + 1;
    // Variantes de labels mois (certains dossiers utilisent JANV, JUIL, AOU, SEPT...)
    const MOIS_LABELS_ALL = [
      ['JAN','JANV'],['FEV','FEVR'],['MAR','MARS'],['AVR'],
      ['MAI'],['JUIN','JUN'],['JUIL','JUL'],['AOU','AOUT'],
      ['SEP','SEPT'],['OCT'],['NOV'],['DEC']
    ];
    const moisLabels = MOIS_LABELS_ALL[moisInt - 1]; // tableau de variantes
    const moisLabel  = moisLabels[0]; // label principal

    // Fonction pour tester si un nom de dossier correspond au mois
    function matcheMois(n) {
      return moisLabels.some(function(lbl) {
        return n.indexOf(moisNum + '-') !== -1
            || n.indexOf('-' + lbl) !== -1
            || n === lbl
            || n.startsWith(moisNum + ' ')
            || n.startsWith(moisNum + '-');
      });
    }
    const moisNum   = String(moisInt).padStart(2, '0');

    // Normalisation : supprimer accents, majuscules, caractères spéciaux
    function norm(str) {
      return (str || '').toString().toUpperCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/[^A-Z0-9 ]/g, '').trim();
    }

    // Extraire toutes les variantes d'initiales (2, 3, 4 lettres par mot)
    // Si la chaîne est courte et tout en majuscules -> c'est déjà un code (COL, ACDA, EXI...)
    function initiales(str) {
      var s = norm(str);
      var result = [];
      // Si c'est un code court (ex: "COL", "ACDA", "EXI") -> l'utiliser directement
      if (s.length <= 5 && s === s.replace(/[^A-Z]/g, '')) {
        result.push(s);
        if (s.length >= 3) result.push(s.substring(0, 3));
        if (s.length >= 4) result.push(s.substring(0, 4));
        return result;
      }
      // Sinon générer les initiales de chaque mot
      var mots = s.split(' ').filter(Boolean);
      // Initiales de chaque mot
      mots.forEach(function(m) {
        if (m.length >= 2) result.push(m.substring(0, 2));
        if (m.length >= 3) result.push(m.substring(0, 3));
        if (m.length >= 4) result.push(m.substring(0, 4));
      });
      // Initiales composées (ex: "Au Coeur De l'Athenee" -> "ACDA")
      // Exclure les mots de liaison courts
      var STOP = {'DE':1,'DU':1,'DES':1,'LE':1,'LA':1,'LES':1,'L':1,'AU':1,'AUX':1,'ET':1,'EN':1,'UN':1,'UNE':1};
      var motsSign = mots.filter(function(m) { return m.length >= 2 && !STOP[m]; });
      var initComp = motsSign.map(function(m) { return m[0]; }).join('');
      if (initComp.length >= 2) result.push(initComp);
      if (initComp.length >= 3) result.push(initComp.substring(0, 3));
      if (initComp.length >= 4) result.push(initComp.substring(0, 4));
      return result;
    }

    // Score d'un segment contre une liste d'initiales
    function scorerSeg(seg, initList) {
      var best = 0;
      initList.forEach(function(init) {
        if (seg === init) {
          best = Math.max(best, init.length >= 4 ? 8 : init.length >= 3 ? 6 : 4);
        } else if (seg.startsWith(init) || init.startsWith(seg)) {
          best = Math.max(best, 2);
        }
      });
      return best;
    }

    // Table de correspondance prénom -> initiales nom dans les fichiers BP
    // À compléter pour chaque compagnie selon les salariés réels
    var SALARIE_CODES = {
      // PALM — La Palmera (prénom -> initiales nom dans fichier)
      'PAUL':      'NGU',   // Paul Nguyen
      'NERY':      'BOU',   // Nery Bou... ?
      'QUENTIN':   'CAT',   // Quentin Cat... ?
      'ANGELIQUE': 'ZAI',   // Angélique Zai... ?
      'SAMUEL':    'RAY',   // Samuel Ray... ?
      'CLOE':      'BOU',   // Cloé Bou... ?
      // CLR — Les Ruminantes (à compléter)
      // MAN — Manœuvres (à compléter)
      // OM — Oiseau Manivelle (à compléter)
      // DIS — Disorder (à compléter)
    };

    // Table de correspondance noms longs -> codes fichiers BP
    // Format BP : [CODE_PROJET] [INITIALES_SALARIE]
    // CLR / Les Ruminantes
    // PALM / La Palmera
    // MAN / Manoeuvres : BOU=?, CAT=?, MES=?, LUX=?, KOV=?, CYSE=?, FCT=?
    // OM / Oiseau Manivelle : MIC=?, BAB=?, CIN=?, CHA=?, KAUF=?, FCT=?, PTI=?
    // DIS / Disorder : COL=Colère, ACDA=Au Coeur de l'Athénée, EXI=Exit,
    //                  VEL=Velue, CEN=Cendrillon, HEF=?, LMEC=?, FCT=?
    var PROJET_CODES = {
      // DIS — Disorder
      'AU COEUR': 'ACDA', 'ATHENEE': 'ACDA', 'ACDA': 'ACDA',
      'CENDRILLON': 'CEN', 'COLERE': 'COL', 'VELUE': 'VEL',
      'EXIT': 'EXI', 'VELUE': 'VEL', 'LMEC': 'LMEC', 'HEF': 'HEF',
      // CLR — Les Ruminantes
      'TRISELECTOPS': 'TRI', 'TRISEL': 'TRI',
      'SOUVENIR': 'SOU', 'EMOTIONS': 'EMO', 'ETAIT UNE FOIS': 'EUF',
      'ROUGE GORGE': 'RGO', 'MANIVELLE': 'MAN',
      // PALM — La Palmera
      'ANDROMAQUE': 'AND', 'AND': 'AND',
      'ENTRE DEUX RIVES': 'EDR', 'EDR': 'EDR',
      'MEMOIRE INVISIBLE': 'MI', 'MI VOIX': 'MI', 'AMI': 'AMI',
      // Codes génériques
      'FCT': 'FCT', 'FONCTION': 'FCT',
    };
    // Enrichir initiales projet avec le code si on trouve une correspondance
    function initProjetAvecCode(str) {
      var n    = norm(str);
      var inits = initiales(str);
      // Chercher un code correspondant
      Object.keys(PROJET_CODES).forEach(function(key) {
        if (n.indexOf(key) !== -1) inits.push(PROJET_CODES[key]);
      });
      return inits;
    }

    // Enrichir les initiales salarié :
    // 1. depuis le prénom (ex: "Paul")
    var initSal = initiales(salarie);
    // 2. depuis le nom complet si disponible (ex: "Paul Nguyen" -> NGU, NGUY)
    if (nomComplet && nomComplet !== salarie) {
      initiales(nomComplet).forEach(function(i) {
        if (initSal.indexOf(i) === -1) initSal.push(i);
      });
    }
    // 3. depuis la table de correspondance prénom->code (fallback)
    var salarieNorm = norm(salarie);
    if (SALARIE_CODES[salarieNorm]) {
      var code = SALARIE_CODES[salarieNorm];
      if (initSal.indexOf(code) === -1) initSal.push(code);
    }
    var initProj = initProjetAvecCode(projet);

    // Trouver le dossier du mois
    // Structure variable selon les compagnies :
    //   DIS/MAN : racine/2026/02-FEV-26/
    //   OM      : racine/FDP 2026 OM/05-MAI-26/
    //   PALM    : racine/02-FEV/
    if (!rootFolder) rootFolder = DriveApp.getFolderById(rootFolderId);
    tlog('Dossier racine : "' + rootFolder.getName() + '" (id=' + rootFolder.getId() + ')');
    var yearFolder   = null;
    var targetFolder = null;

    // 1. Chercher le dossier année : exact "2026" OU contient "2026"
    var yearStr = String(anneeInt);
    var allRoot = rootFolder.getFolders();
    var sousDossiersRacine = [];
    while (allRoot.hasNext()) {
      var f = allRoot.next();
      var fn = f.getName();
      sousDossiersRacine.push(fn);
      if (fn === yearStr || fn.toUpperCase().indexOf(yearStr) !== -1) {
        yearFolder = f; break;
      }
    }
    tlog('Sous-dossiers de la racine (' + sousDossiersRacine.length + (yearFolder ? '+' : '') + ') : ' + JSON.stringify(sousDossiersRacine.slice(0, 15)));
    tlog(yearFolder ? 'Dossier année trouvé pour ' + yearStr + ' : "' + yearFolder.getName() + '"' : 'Aucun dossier année contenant "' + yearStr + '"');

    // 2. Chercher le dossier mois dans le dossier année (si trouvé)
    if (yearFolder) {
      var allSubs = yearFolder.getFolders();
      var sousDossiersAnnee = [];
      while (allSubs.hasNext()) {
        var f = allSubs.next();
        var n = f.getName().toUpperCase();
        sousDossiersAnnee.push(f.getName());
        if (matcheMois(n)) {
          targetFolder = f; break;
        }
      }
      // Si le dossier mois exact n'est pas trouvé, ne pas scanner tout le dossier année
      // (évite de proposer des fiches du mauvais mois)
      // On garde yearFolder en mémoire pour le bonus année mais on ne scanne pas tout
      if (!targetFolder) {
        tlog('Pas de dossier mois ' + moisNum + '-' + moisLabel + ' dans "' + yearFolder.getName() + '" (sous-dossiers : ' + JSON.stringify(sousDossiersAnnee.slice(0, 15)) + ')');
        // targetFolder reste null -> on cherchera à la racine ou on retournera vide
      } else {
        tlog('Dossier mois trouvé : "' + targetFolder.getName() + '"');
      }
    }

    // 3. Si pas de dossier année, chercher le dossier mois directement à la racine (PALM)
    if (!targetFolder) {
      var allRoot2 = rootFolder.getFolders();
      while (allRoot2.hasNext()) {
        var f = allRoot2.next();
        var n = f.getName().toUpperCase();
        if (matcheMois(n)) {
          targetFolder = f; break;
        }
      }
      if (targetFolder) tlog('Dossier mois trouvé directement à la racine : "' + targetFolder.getName() + '"');
    }

    // Si aucun dossier mois trouvé nulle part -> retourner vide plutôt que scanner tout
    if (!targetFolder) {
      tlog('Aucun dossier mois trouvé pour ' + moisNum + '-' + moisLabel + ' ' + anneeInt);
      return { success: true, candidats: [], nbTotal: 0, dossier: 'aucun', info: 'Pas de dossier pour ce mois', trace: trace };
    }

    tlog('Initiales salarié cherchées : ' + JSON.stringify(initSal) + ' — Initiales projet : ' + JSON.stringify(initProj));
    const candidats = [];
    const fichiersRejetes = []; // pour le détail : fichiers vus mais écartés (préfixe ou score)

    // Bonus mois/année : +10 si le fichier est dans le bon dossier mois, +5 si dossier année
    // Le nom du dossier parent est passé pour scorer la proximité temporelle
    function scanFolder(folder, folderDepth) {
      const folderName = folder.getName().toUpperCase();

      // Déterminer si ce dossier correspond au bon mois/année
      var bonMois = matcheMois(folderName);
      var bonneAnnee = folderName.indexOf(String(anneeInt)) !== -1
                    || folderName.indexOf(String(anneeInt).slice(2)) !== -1;

      const files = folder.getFiles();
      while (files.hasNext()) {
        const file   = files.next();
        const nomRaw = file.getName();
        // Supprimer l'extension AVANT normalisation pour éviter que ".PDF" soit collé au dernier segment
        const nomSansExt = nomRaw.replace(/\.pdf$/i, '').replace(/\.PDF$/, '');
        const nom    = norm(nomSansExt);

        // Convention "BP ..." (OM/DIS/PALM/MAN) OU "FDP ..."/"OK FDP ..." (CLR,
        // même convention que chercherFDPDuMois/parserNomFDP) — le préfixe "OK "
        // (fichier déjà découpé par le script) est retiré avant de tester.
        const nomSansOK = nom.indexOf('OK ') === 0 ? nom.substring(3) : nom;
        const aPrefixeBP  = nomSansOK.indexOf('BP ') === 0 || nomSansOK.indexOf('BP_') === 0;
        const aPrefixeFDP = nomSansOK.indexOf('FDP ') === 0 || nomSansOK.indexOf('FDP_') === 0;
        if (!aPrefixeBP && !aPrefixeFDP) {
          fichiersRejetes.push(nomRaw + ' (dans "' + folderName + '") → écarté : ne commence pas par "BP " ni "FDP "');
          continue;
        }

        const stripped = nomSansOK.replace(/^(BP|FDP)[ _]+/, '');
        const parts    = stripped.split(' ').filter(Boolean);
        if (parts.length < 1) continue;

        // Ignorer les suffixes numériques (ex: '2' dans 'BP MIC CIN 2.pdf')
        var segs = parts.filter(function(p) { return isNaN(parseInt(p)) || p.length > 2; });
        if (segs.length < 1) continue;

        // Scorer tous les segments pour gérer BP BOUR CL MI.pdf (3+ segments)
        var scoreSal  = 0, scoreProj = 0;
        segs.forEach(function(s) {
          var ss = scorerSeg(s, initSal);  if (ss  > scoreSal)  scoreSal  = ss;
          var sp = scorerSeg(s, initProj); if (sp  > scoreProj) scoreProj = sp;
        });

        var total = scoreSal + scoreProj;
        // Accepter proj seul (sal absent du fichier) si proj score >= 4
        // Cela permet de proposer les fiches du même spectacle quand celle du salarié manque
        if (total < 4) {
          fichiersRejetes.push(nomRaw + ' (dans "' + folderName + '") → écarté : score trop faible (sal:' + scoreSal + ' proj:' + scoreProj + ', segments:' + JSON.stringify(segs) + ')');
          continue;
        }
        // Pénaliser légèrement les fichiers sans match salarié pour les classer après
        if (scoreSal === 0 && scoreProj >= 4) total = scoreProj; // pas de bonus sal

        // Bonus temporel : récompenser le bon dossier mois/année
        var bonusMois  = bonMois   ? 10 : 0;
        var bonusAnnee = bonneAnnee ? 5  : 0;
        total += bonusMois + bonusAnnee;

        var raisons = 'sal:' + scoreSal + ' proj:' + scoreProj + ' [' + segs.join('/') + ']';
        if (bonusMois)  raisons += ' +mois';
        if (bonusAnnee) raisons += ' +annee';

        candidats.push({
          nom:    nomRaw,
          url:    file.getUrl(),
          fileId: file.getId(),
          score:  total,
          scoreSal: scoreSal,
          scoreProj: scoreProj,
          raisons: raisons
        });
      }
      const subs = folder.getFolders();
      while (subs.hasNext()) scanFolder(subs.next(), folderDepth + 1);
    }

    scanFolder(targetFolder, 0);
    candidats.sort(function(a, b) { return b.score - a.score; });
    tlog(candidats.length + ' candidat(s) retenu(s) dans "' + targetFolder.getName() + '" ; ' + fichiersRejetes.length + ' fichier(s) écarté(s)');
    if (candidats.length === 0 && fichiersRejetes.length > 0) trace = trace.concat(fichiersRejetes.slice(0, 20));
    Logger.log('FDP ' + salarie + '/' + projet + ' mois=' + moisInt + ' — ' + candidats.length + ' candidats, dossier=' + targetFolder.getName());
    return { success: true, candidats: candidats.slice(0, 5), nbTotal: candidats.length, dossier: targetFolder.getName(), trace: trace };

  } catch(err) {
    Logger.log('chercherFichesPaie erreur: ' + err.message);
    return { error: err.message, trace: trace };
  }
}

// =============================================================================
// CLASSEMENT AUTOMATIQUE DES FICHES DE PAIE — S9 : DPAE_CLR ajouté pour CLR
// =============================================================================

function classerFichesPaie(entity, annee) {
  const ss = getSheetById(entity);
  if (!ss) return { error: 'Entity introuvable: ' + entity };
  const cfg = getConfigMap(ss);

  // Même priorité que chercherFDPDuMois/chercherFichesPaie : raccourci Drive
  // perso d'abord, CONFIG DRIVE_FICHES_PAIE en repli.
  var rootFolder = null;
  try { rootFolder = resoudreDossierFDPViaRaccourcis(entity); } catch(e) {}
  const rootFolderId = cfg['DRIVE_FICHES_PAIE'];
  if (!rootFolder && !rootFolderId) return { error: 'DRIVE_FICHES_PAIE non configure et aucun raccourci FDP trouvé pour ' + entity };
  const anneeInt = parseInt(annee) || new Date().getFullYear();

  var trace = [];
  function tlog(msg) { Logger.log(msg); trace.push(msg); }
  tlog('Source dossier : ' + (rootFolder ? 'raccourci ' + (entity === 'AMIIS' ? 'FDP' : 'FDP ' + entity) : 'CONFIG DRIVE_FICHES_PAIE (' + rootFolderId + ')'));

  var filesByMois = {};

  function collectFiles(folder, moisContext) {
    var files = folder.getFiles();
    while (files.hasNext()) {
      var f   = files.next();
      var nom = f.getName().toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      // Le pr\u00e9fixe "OK " (fichier d\u00e9j\u00e0 d\u00e9coup\u00e9) est retir\u00e9 avant de tester le
      // format. Deux conventions coexistent, parfois pour la m\u00eame structure sur
      // des mois diff\u00e9rents (ex: OM est pass\u00e9e de "BP <PROJET> <SALARIE>" \u00e0
      // "OK FDP <SALARIE> <PROJET>" \u00e0 partir de juillet 2026) : le format
      // d\u00e9tect\u00e9 est m\u00e9moris\u00e9 par fichier pour que scorerFichier sache dans quel
      // ordre les codes apparaissent.
      var nomSansOK = nom.indexOf('OK ') === 0 ? nom.substring(3) : nom;
      var format = null;
      if (nomSansOK.indexOf('BP ') === 0 || nomSansOK.indexOf('BP_') === 0) format = 'BP';
      else if (nomSansOK.indexOf('FDP ') === 0 || nomSansOK.indexOf('FDP_') === 0) format = 'FDP';
      if (!format) continue;
      if (moisContext !== null) {
        if (!filesByMois[moisContext]) filesByMois[moisContext] = [];
        filesByMois[moisContext].push({ nom: nomSansOK, nomOriginal: f.getName(), url: f.getUrl(), format: format });
      }
    }
    var subs = folder.getFolders();
    while (subs.hasNext()) {
      var sub     = subs.next();
      var subName = sub.getName().toUpperCase();
      var mMatch  = subName.match(/^(\d{2})-/);
      collectFiles(sub, mMatch ? parseInt(mMatch[1]) : null);
    }
  }

  if (!rootFolder) rootFolder = DriveApp.getFolderById(rootFolderId);
  tlog('Dossier racine : "' + rootFolder.getName() + '"');
  // Recherche du dossier année par SOUS-CHAÎNE (pas getFoldersByName, qui exige
  // une égalité exacte) — nécessaire pour des dossiers comme "FDP 2026 OM", sans
  // quoi aucun dossier année n'est jamais trouvé et on retombe sur un scan
  // récursif de TOUT le Drive racine (tous les mois de toutes les années), ce
  // qui dépasse le temps d'exécution et provoque un "Failed to fetch" côté app.
  var yearStr = String(anneeInt);
  var yearFolder = null;
  var allRootFolders = rootFolder.getFolders();
  var sousDossiersRacine = [];
  while (allRootFolders.hasNext()) {
    var yf = allRootFolders.next();
    sousDossiersRacine.push(yf.getName());
    if (yf.getName().toUpperCase().indexOf(yearStr) !== -1) { yearFolder = yf; break; }
  }
  tlog('Sous-dossiers de la racine : ' + JSON.stringify(sousDossiersRacine.slice(0, 15)));
  tlog(yearFolder ? 'Dossier année trouvé pour ' + yearStr + ' : "' + yearFolder.getName() + '"' : 'Aucun dossier année contenant "' + yearStr + '" — scan direct de la racine (mois à plat, ex: PALM)');
  if (yearFolder) collectFiles(yearFolder, null);
  else collectFiles(rootFolder, null);

  var totalFichiers = 0;
  var MOIS_NOMS = ['','JAN','FEV','MAR','AVR','MAI','JUIN','JUIL','AOU','SEP','OCT','NOV','DEC'];
  Object.keys(filesByMois).sort(function(a,b){return a-b;}).forEach(function(m) {
    totalFichiers += filesByMois[m].length;
    tlog('Mois ' + MOIS_NOMS[m] + ' (' + m + ') : ' + filesByMois[m].length + ' fichier(s) BP/FDP');
  });
  if (totalFichiers === 0) return { success: true, message: 'Aucun fichier BP/FDP trouve', lies: 0, aVerifier: 0, nonTrouves: 0, trace: trace };

  var nbLies = 0, nbAVerifier = 0, nbNonTrouves = 0;
  var rapport = [];
  var SCORE_MIN = 4, SCORE_DOMINENT = 3;

  // "BP <PROJET> <SALARIE>.pdf" : le salari\u00e9 est en fin de fichier (score fin
  // fin plus pr\u00e9cis 8/6/3/2), le projet juste apr\u00e8s le pr\u00e9fixe (score fixe +5).
  // "FDP <SALARIE> <PROJET>.pdf" : ordre inverse \u2014 on \u00e9change simplement quel
  // champ est test\u00e9 en fin de fichier et lequel est test\u00e9 juste apr\u00e8s le
  // pr\u00e9fixe, les m\u00eames bar\u00e8mes de points s'appliquant selon la position.
  function scorerFichier(f, salarie, projet) {
    var nom    = f.nom;
    var prefixe = f.format === 'FDP' ? 'FDP' : 'BP';
    var score  = 0;

    function scorerFin(mots) {
      mots.forEach(function(mot) {
        var i3 = mot.substring(0, 3), i4 = mot.substring(0, 4);
        if (nom.endsWith(' ' + i4 + '.PDF'))      score += 8;
        else if (nom.endsWith(' ' + i3 + '.PDF')) score += 6;
        else if (nom.indexOf(' ' + i4) !== -1)    score += 3;
        else if (nom.indexOf(' ' + i3) !== -1)    score += 2;
      });
    }
    function scorerApresPrefixe(mots) {
      mots.forEach(function(mot) {
        var i3 = mot.substring(0, 3), i4 = mot.substring(0, 4);
        if (nom.indexOf(prefixe + ' ' + i4 + ' ') !== -1 || nom.indexOf(prefixe + ' ' + i3 + ' ') !== -1) score += 5;
      });
    }

    var motsSal  = salarie.toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^A-Z\s]/g, '').trim().split(/\s+/).filter(Boolean);
    var motsProj = projet.toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^A-Z\s]/g, '').trim().split(/\s+/).filter(Boolean);
    if (f.format === 'FDP') { scorerApresPrefixe(motsSal); scorerFin(motsProj); }
    else                    { scorerFin(motsSal); scorerApresPrefixe(motsProj); }
    return score;
  }

  function classerLignes(sheet, colSal, colProj, colDate, filesByMois) {
    var lastRow = sheet.getLastRow();
    if (lastRow < 2) return;
    var lastCol = sheet.getLastColumn();
    var headers = sheet.getRange(1, 1, 1, lastCol).getValues()[0];
    function ensureCol(label) {
      for (var h = 0; h < headers.length; h++) {
        if (headers[h].toString().trim() === label) return h;
      }
      var newCol = sheet.getLastColumn() + 1;
      sheet.getRange(1, newCol).setValue(label);
      headers.push(label);
      return headers.length - 1;
    }
    var colFDP     = ensureCol('Fiche de paie');
    var colFDPSt   = ensureCol('FDP_Statut');
    var colFDPCand = ensureCol('FDP_Candidats');
    var data = sheet.getRange(2, 1, lastRow - 1, sheet.getLastColumn()).getValues();
    data.forEach(function(row, i) {
      var rowIndex   = i + 2;
      var currentSt  = (row[colFDPSt] || '').toString().trim();
      if (currentSt === 'CONFIRME') return;
      var salarie = colSal !== -1 ? (row[colSal] || '').toString().trim() : '';
      var projet  = colProj !== -1 ? (row[colProj] || '').toString().trim() : '';
      if (!salarie || /^[a-z]{2,4}-\d{2}$/i.test(salarie)) return;
      var moisLigne = null;
      if (colDate !== -1 && row[colDate]) {
        try { var d = new Date(row[colDate]); if (!isNaN(d)) moisLigne = d.getMonth() + 1; } catch(_) {}
      }
      var fichiersDuMois = moisLigne ? (filesByMois[moisLigne] || []) : [];
      if (fichiersDuMois.length === 0) return;
      var motsSalarie = salarie.trim().split(/\s+/).filter(Boolean);
      var prenomSeul  = motsSalarie.length === 1;
      var SEUIL_MIN   = prenomSeul ? 5   : SCORE_MIN;
      var scores = fichiersDuMois.map(function(f) {
        return { nom: f.nom, nomOriginal: f.nomOriginal, url: f.url, score: scorerFichier(f, salarie, projet) };
      }).filter(function(f) { return f.score >= SEUIL_MIN; }).sort(function(a, b) { return b.score - a.score; });
      // Un nom en un seul mot peut être un prénom générique ambigu ("Marie")
      // ou, comme chez OM, un nom de famille distinctif (BAZIN, KAUFLING —
      // c'est justement le code retrouvé dans le nom du fichier) : on n'exclut
      // plus systématiquement l'auto-liaison dans ce cas, on exige juste un
      // score absolu plus élevé (un vrai match, pas une correspondance partielle).
      var SCORE_AUTO_MIN = prenomSeul ? 8 : SCORE_MIN;
      var ecartSuivant    = scores.length > 1 ? scores[0].score - scores[1].score : Infinity;
      var confiant = scores.length > 0 && scores[0].score >= SCORE_AUTO_MIN
        && (scores.length === 1 || ecartSuivant >= SCORE_DOMINENT);
      if (scores.length === 0) {
        sheet.getRange(rowIndex, colFDPSt   + 1).setValue('NON_TROUVE');
        sheet.getRange(rowIndex, colFDPCand + 1).setValue('');
        nbNonTrouves++;
        rapport.push({ sheet: sheet.getName(), rowIndex, salarie, projet, mois: moisLigne, status: 'NON_TROUVE' });
      } else if (confiant) {
        sheet.getRange(rowIndex, colFDP    + 1).setValue(scores[0].url);
        sheet.getRange(rowIndex, colFDPSt  + 1).setValue('AUTO');
        sheet.getRange(rowIndex, colFDPCand + 1).setValue('');
        nbLies++;
        rapport.push({ sheet: sheet.getName(), rowIndex, salarie, projet, mois: moisLigne, status: 'AUTO', fichier: scores[0].nomOriginal, score: scores[0].score });
      } else {
        var candidatsJson = JSON.stringify(scores.slice(0, 5).map(function(f) { return { nom: f.nomOriginal, url: f.url, score: f.score }; }));
        sheet.getRange(rowIndex, colFDP    + 1).setValue('');
        sheet.getRange(rowIndex, colFDPSt  + 1).setValue('A_VERIFIER');
        sheet.getRange(rowIndex, colFDPCand + 1).setValue(candidatsJson);
        nbAVerifier++;
        rapport.push({ sheet: sheet.getName(), rowIndex, salarie, projet, mois: moisLigne, status: 'A_VERIFIER' });
      }
    });
  }

  // S9 : CLR inclut DPAE_CLR en plus de DECLA
  var ONGLETS_PAR_ENTITE = {
    'CLR':  [
      { nom: 'DECLA',    colSal: -1, colProj: -1, colDate: -1 },
      { nom: 'DPAE_CLR', colSal: -1, colProj: -1, colDate: -1 },
    ],
    'PALM': [
      { nom: 'DECLA',    colSal: -1, colProj: -1, colDate: -1 },
      { nom: 'Contrats', colSal: -1, colProj: -1, colDate: -1 },
    ],
    'MAN':  [
      { nom: 'DAPE',     colSal: 3, colProj: 4, colDate: 6 },
      { nom: 'Contrats', colSal: -1, colProj: -1, colDate: -1 },
    ],
    'OM':   [
      { nom: 'DPAE 2025', colSal: -1, colProj: -1, colDate: -1 },
    ],
    'DIS':  [
      { nom: 'DPAE V2',  colSal: 3, colProj: 7, colDate: 4 },
      { nom: 'Contrats', colSal: -1, colProj: -1, colDate: -1 },
    ],
    'AMIIS': [
      { nom: 'Réponses au formulaire 1', colSal: -1, colProj: -1, colDate: -1 },
    ],
  };

  var COL_SAL_NAMES  = ['Pour qui est fait la déclaration ? ', 'Salarié', 'Salarie', 'pour qui faite vous la déclaration ? ', 'SALARIE'];
  var COL_PROJ_NAMES = ['Projet ', 'Projet', 'Quel projet ? ', 'SPECTACLE'];
  var COL_DATE_NAMES = ['Date début du contrat ', 'Date début', 'Date debut', 'date de début ', 'Date début du contrat'];

  function findCol(headers, names) {
    for (var n = 0; n < names.length; n++) {
      for (var h = 0; h < headers.length; h++) {
        if (headers[h].toString().trim() === names[n].trim()) return h;
      }
    }
    return -1;
  }

  var onglets = ONGLETS_PAR_ENTITE[entity] || [];
  if (onglets.length === 0) tlog('Aucun onglet de déclaration configuré pour ' + entity);
  onglets.forEach(function(cfg) {
    var sheet = ss.getSheetByName(cfg.nom);
    if (!sheet) { tlog('Onglet introuvable : "' + cfg.nom + '"'); return; }
    var colSal = cfg.colSal, colProj = cfg.colProj, colDate = cfg.colDate;
    if (colSal === -1 || colProj === -1 || colDate === -1) {
      var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
      if (colSal  === -1) colSal  = findCol(headers, COL_SAL_NAMES);
      if (colProj === -1) colProj = findCol(headers, COL_PROJ_NAMES);
      if (colDate === -1) colDate = findCol(headers, COL_DATE_NAMES);
    }
    tlog('Onglet "' + cfg.nom + '" : colSal=' + colSal + ' colProj=' + colProj + ' colDate=' + colDate);
    if (colSal === -1) { tlog('  → colonne salarié introuvable, onglet ignoré'); return; }
    var avant = { lies: nbLies, aVerifier: nbAVerifier, nonTrouves: nbNonTrouves };
    classerLignes(sheet, colSal, colProj, colDate, filesByMois);
    tlog('  → ' + (nbLies - avant.lies) + ' liée(s) auto, ' + (nbAVerifier - avant.aVerifier) + ' à vérifier, ' + (nbNonTrouves - avant.nonTrouves) + ' non trouvée(s)');
  });

  tlog('TOTAL : ' + nbLies + ' liée(s) auto, ' + nbAVerifier + ' à vérifier, ' + nbNonTrouves + ' non trouvée(s)');
  return { success: true, annee: anneeInt, entity, nbFichiersScannés: totalFichiers, lies: nbLies, aVerifier: nbAVerifier, nonTrouves: nbNonTrouves, rapport, trace: trace };
}

