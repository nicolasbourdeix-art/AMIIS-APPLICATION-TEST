// =============================================================================
// ENTRY POINTS
// =============================================================================

function doGet(e) {
  const params = e.parameter || {};
  const action = params.action || '';
  if (!action) {
    return HtmlService
      .createHtmlOutputFromFile('index')
      .setTitle('AMIIS Dashboard V2')
      .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
  }
  const result = handleGet(params);
  return ContentService.createTextOutput(JSON.stringify(result)).setMimeType(ContentService.MimeType.JSON);
}

function doPost(e) {
  try {
    const body   = JSON.parse(e.postData.contents);
    const result = handlePost(body);
    return ContentService.createTextOutput(JSON.stringify(result)).setMimeType(ContentService.MimeType.JSON);
  } catch(err) {
    Logger.log('doPost erreur: ' + err.message + '\n' + err.stack);
    return ContentService.createTextOutput(JSON.stringify({ error: true, message: err.message })).setMimeType(ContentService.MimeType.JSON);
  }
}

// =============================================================================
// HANDLE GET
// =============================================================================

function handleGet(params) {
  try {
    const action = (params.action || '').toString().trim();
    const entity = (params.entity || '').toUpperCase();
    const year   = params.year === '0' ? 0 : (parseInt(params.year) || new Date().getFullYear());

    let email = params.email || '';
    try { const se = Session.getEffectiveUser().getEmail(); if (se) email = se; } catch(_) {}
    try { if (!email) { const sa = Session.getActiveUser().getEmail(); if (sa) email = sa; } } catch(_) {}

    if (action === 'ping') {
      return { status: 'ok', version: 'AMIIS-V2-S9', email, role: getRoleForEmail(email) || '', ts: new Date().toISOString() };
    }

    if (action === 'testSheetConnection') return testSheetConnection(params.targetEntity);
    if (action === 'porteurAcces')        return getPorteurCaisse(entity, params.code);
    if (action === 'diffuseurAcces')      return getDiffuseurDevis(params.code);
    if (action === 'getUtilisateursApp')  return getUtilisateursApp();
    if (action === 'getInfoSalariesPaie') return getInfoSalariesPaie();
    if (action === 'getInfoComptesAnalytiques') return getInfoComptesAnalytiques();
    if (action === 'getInfoSocietesPaie') return getInfoSocietesPaie();

    if (action === 'getAllConfig') {
      const cfgSs = getSheetById(entity) || SpreadsheetApp.getActiveSpreadsheet();
      return getAllConfig(cfgSs, entity, email);
    }

    if (action === 'getConsolidated') {
      if (getRoleForEmail(email) !== 'ADMIN') return { error: true, code: 'UNAUTHORIZED', message: 'Admin requis' };
      const results = {};
      const mois = String(new Date().getMonth() + 1).padStart(2, '0');
      Object.entries(ENTITY_SHEET_IDS).forEach(([code, id]) => {
        if (id.startsWith('TODO_')) { results[code] = { status: 'NOT_CONFIGURED' }; return; }
        try {
          const entitySs = getSheetById(code);
          if (!entitySs) { results[code] = { status: 'OPEN_FAILED' }; return; }
          results[code] = { config: getConfigMap(entitySs), dsn: getDSNStatus(entitySs, year, mois), alertes: getAlertes(entitySs, code, year, mois) };
        } catch(err) { results[code] = { status: 'ERROR', message: err.message }; }
      });
      return { consolidated: results, generatedAt: new Date().toISOString() };
    }

    const LIGHT_ACTIONS = ['getAllConfig','getConfig','getAvailableYears','getLicences','testSheetConnection'];
    if (!LIGHT_ACTIONS.includes(action) && !checkAuth(email, entity)) {
      return { error: true, code: 'UNAUTHORIZED', message: 'Acces refuse. Email: "' + email + '" - Entite: ' + entity };
    }

    const ss = getSheetById(entity);
    if (!ss) return { error: true, code: 'ENTITY_NOT_FOUND', message: 'Sheet ID manquant : ' + entity };

    switch (action) {

      case 'dashboard':
        return getDashboardData(ss, entity, email, year);

      case 'getConfig':
        return getConfig(ss);

      // ── DÉCLARATIONS — S9 : DECLA + DPAE_CLR validées + Contrats ──
      case 'declarations':
      case 'getDeclas': {
        var tabName = resolveTabName('DECLA', year, entity);
        var rowsDecla = [];

        // 1. Onglet principal (DECLA, DAPE, DPAE 2025, etc.)
        if (tabName) {
          if (ENTITES_FACTURATION_FDP.indexOf(entity) >= 0) {
            var tabPrincipalPourFacture = ss.getSheetByName(tabName);
            if (tabPrincipalPourFacture) ensureFactureCol(tabPrincipalPourFacture);
          }
          var raw = getTab(ss, tabName);
          if (!raw.error) {
            rowsDecla = raw.rows
              .map(function(r) { return normalizeRow(r, 'DECLA', entity); })
              .filter(function(r) { return r !== null; })
              .filter(function(r) {
                if (!r.debut) return false;
                var parts = r.debut.split('/');
                return parts.length === 3 && parseInt(parts[2]) === year;
              })
              .map(function(r) { r._sourceSheet = tabName; return r; });
          }
        }

        // 2. Toutes entités : ajouter les lignes VALIDÉES (DPAE_OK = TRUE)
        //    depuis l'onglet principal DPAE (Contrats pour MAN/DIS/PALM)
        //    ET depuis l'onglet legacy (DAPE, DPAE V2, DECLA...)

        function chargerDpaeValidees(tabName) {
          if (!tabName || tabName === tabName_decla_already_loaded) return;
          var sheet2 = ss.getSheetByName(tabName);
          if (!sheet2) return;
          ensureDpaeOkColumn(sheet2);
          var raw2 = getTab(ss, tabName);
          if (raw2.error) return;
          var tabBase2 = (tabName === 'Contrats') ? 'CONTRATS' : 'DECLA';
          var valides = raw2.rows
            .filter(function(r) {
              var ok = r['DPAE_OK'];
              return ok === true || ok === 'TRUE' || ok === 'OUI';
            })
            .map(function(r) { return normalizeRow(r, tabBase2, entity); })
            .filter(function(r) { return r !== null; })
            .filter(function(r) {
              if (!r.debut) return false;
              var parts = r.debut.split('/');
              return parts.length === 3 && parseInt(parts[2]) === year;
            })
            .map(function(r) {
              r._sourceSheet = tabName;
              r.dpaeEnvoyee  = true;
              r.envoyee      = true;
              return r;
            });
          rowsDecla = rowsDecla.concat(valides);
        }
        var tabName_decla_already_loaded = tabName; // éviter de recharger l'onglet DECLA déjà chargé

        var dpaeTabForDecla    = resolveTabName('DPAE', year, entity);
        var dpaeLegacyForDecla = resolveTabName('DPAE_LEGACY', year, entity);

        // S'assurer que la colonne FACTURE existe sur Contrats (MAN/PALM), quel que
        // soit le bloc qui va charger cet onglet ci-dessous.
        if (ENTITES_FACTURATION_FDP.indexOf(entity) >= 0) {
          var contratSheetPourFacture = ss.getSheetByName('Contrats');
          if (contratSheetPourFacture) ensureFactureCol(contratSheetPourFacture);
        }

        chargerDpaeValidees(dpaeTabForDecla);
        if (dpaeLegacyForDecla && dpaeLegacyForDecla !== dpaeTabForDecla) {
          chargerDpaeValidees(dpaeLegacyForDecla);
        }

        // 3. Onglet Contrats (CLR, PALM, DIS, MAN)
        // Ne recharge PAS si déjà chargé au bloc 2 ci-dessus (quand DPAE → Contrats,
        // cas de MAN/PALM/DIS) : sinon chaque ligne apparaît deux fois à l'identique.
        var contratSheet = ss.getSheetByName('Contrats');
        // Bloc Contrats : uniquement les lignes DPAE validées (DPAE_OK = TRUE)
        // Les non-validées apparaissent dans le module DPAE
        // Exception : CLR n'utilise pas Contrats pour les DPAE
        if (contratSheet && entity !== 'CLR' && dpaeTabForDecla !== 'Contrats') {
          ensureDpaeOkColumn(contratSheet);
          if (ENTITES_FACTURATION_FDP.indexOf(entity) >= 0) ensureFactureCol(contratSheet);
          var rawC = getTab(ss, 'Contrats');
          if (!rawC.error) {
            var rowsC = rawC.rows
              .filter(function(r) {
                // N'inclure dans Déclarations que les lignes validées DPAE
                var ok = r['DPAE_OK'];
                return ok === true || ok === 'TRUE' || ok === 'OUI';
              })
              .map(function(r) { return normalizeRow(r, 'CONTRATS', entity); })
              .filter(function(r) { return r !== null; })
              .filter(function(r) {
                if (!r.debut) return false;
                var parts = r.debut.split('/');
                return parts.length === 3 && parseInt(parts[2]) === year;
              })
              .map(function(r) { r._sourceSheet = 'Contrats'; return r; });
            rowsDecla = rowsDecla.concat(rowsC);
          }
        }

        rowsDecla = enrichirAvecFDP(ss, rowsDecla);

        // Dédoublonnage : quand une même déclaration existe à la fois dans un onglet
        // historique (DAPE, DPAE V2, DECLA…) et dans Contrats, on ne garde que la
        // version Contrats (colonnes DPAE_OK/FACTURE à jour), qui fait foi.
        rowsDecla = dedupliquerParContrats(rowsDecla);

        // Trier par date de début croissante
        rowsDecla.sort(function(a, b) {
          function toKey(r) {
            var d = r.debut || r.date || '';
            if (!d) return '';
            if (/^\d{4}-\d{2}-\d{2}/.test(d)) return d.substring(0,10);
            var p = d.split('/');
            return p.length === 3 ? p[2]+'-'+p[1]+'-'+p[0] : d;
          }
          return toKey(a).localeCompare(toKey(b));
        });

        return { tab: tabName || 'DECLA', rows: rowsDecla };
      }

      // ── DPAE — toutes entités : lignes NON validées (DPAE_OK vide/false) ──
      case 'dpae':
      case 'getDpae': {
        var allDpaeRows = [];

        // Helper : charger les non-validées d'un onglet
        function chargerDpaeNonValidees(tabName) {
          if (!tabName) return;
          var sheet = ss.getSheetByName(tabName);
          if (!sheet) return;
          ensureDpaeOkColumn(sheet);
          var raw = getTab(ss, tabName);
          if (raw.error) return;
          // Contrats → normaliser comme CONTRATS, sinon comme DECLA
          var tabBase = (tabName === 'Contrats') ? 'CONTRATS' : 'DECLA';
          raw.rows
            .filter(function(r) {
              var ok = r['DPAE_OK'];
              return ok !== true && ok !== 'TRUE' && ok !== 'OUI';
            })
            .map(function(r) { return normalizeRow(r, tabBase, entity); })
            .filter(function(r) { return r !== null; })
            .filter(function(r) {
              if (!r.debut) return false;
              var parts = r.debut.split('/');
              return parts.length === 3 && parseInt(parts[2]) === year;
            })
            .forEach(function(r) {
              r._sourceSheet = tabName;
              r.dpaeEnvoyee  = false;
              r.envoyee      = false;
              allDpaeRows.push(r);
            });
        }

        // Source principale (nouvelles DPAE)
        var dpaeTabName = resolveTabName('DPAE', year, entity);
        chargerDpaeNonValidees(dpaeTabName);

        // Source legacy (anciennes déclarations) — MAN/DIS/PALM uniquement
        var dpaeLegacyTab = resolveTabName('DPAE_LEGACY', year, entity);
        if (dpaeLegacyTab && dpaeLegacyTab !== dpaeTabName) {
          chargerDpaeNonValidees(dpaeLegacyTab);
        }

        return { tab: dpaeTabName || 'DPAE', rows: allDpaeRows };

        // Legacy — comportement original si besoin
        var tabNameDpae = resolveTabName('DPAE', year, entity);
        if (!tabNameDpae) return { tab: 'DPAE', rows: [] };
        var rawDpaeAutres = getTab(ss, tabNameDpae);
        if (rawDpaeAutres.error) return rawDpaeAutres;
        var rowsAutres = rawDpaeAutres.rows
          .map(function(r) { return normalizeRow(r, 'DPAE', entity); })
          .filter(function(r) { return r !== null; })
          .filter(function(r) {
            if (!r.prisePoste) return false;
            var parts = r.prisePoste.split('/');
            return parts.length === 3 && parseInt(parts[2]) === year;
          });
        return { tab: tabNameDpae, rows: rowsAutres };
      }

      case 'ndf':
      case 'getNdf': {
        const tabName = resolveTabName('NOTE DE FRAIS V', year, entity);
        if (!tabName) return { tab: 'NDF', rows: [] };
        const raw = getTab(ss, tabName);
        if (raw.error) return raw;
        const liensPdfNdf = extraireLiensColonne(ss.getSheetByName(tabName), raw.headers, 'Lien PDF');
        const rows = raw.rows
          .map(r => normalizeRow(r, 'NDF', entity, liensPdfNdf[r._rowIndex]))
          .filter(r => r !== null)
          .filter(r => {
            if (!r.date) return false;
            const parts = r.date.split('/');
            return parts.length === 3 && parseInt(parts[2]) === year;
          });
        return { tab: tabName, rows };
      }

      case 'getDevis': {
        var resultDevis = chargerTousLesDevisEntite(ss, entity, year);
        if (!resultDevis.tabName && resultDevis.rows.length === 0) return { tab: 'DEVIS', rows: [], debugAncien: resultDevis.debugAncien };
        return { tab: resultDevis.tabName || 'DEVIS', rows: resultDevis.rows, debugAncien: resultDevis.debugAncien };
      }

      case 'getFacturation': {
        const tabName = resolveTabName('FACTURATION', year, entity);
        var rowsFact = [];

        // Lire l'onglet facturation existant
        if (tabName) {
          const raw = getTab(ss, tabName);
          if (!raw.error) {
            rowsFact = raw.rows
              .map(r => normalizeRow(r, 'FACTURATION', entity))
              .filter(r => r !== null)
              .filter(r => {
                // Garder toutes les années (historique) ou filtrer sur l'année courante
                // On garde tout et on laisse le front trier
                return true;
              });
          }
        }

        // CLR : ajouter les devis signés dont la date de fin est passée et pas encore facturés
        if (entity === 'CLR') {
          const today    = new Date();
          const devisTab = resolveTabName('DEVIS V', year, entity);
          if (devisTab) {
            const devisRaw = getTab(ss, devisTab);
            if (!devisRaw.error) {
              // Récupérer les refs déjà facturées
              const refsFacturees = new Set(rowsFact.map(r => (r.refDevis || r.num || '').toString().trim()).filter(Boolean));

              // Recettes déjà encaissées en compta, par spectacle — un devis dont le
              // montant est déjà couvert par une recette rapprochée ne doit plus
              // réapparaître comme "À facturer" juste parce que personne n'a créé la
              // ligne facture correspondante : l'argent est déjà rentré. Même fonction
              // et même clé de regroupement (normaliserNomProjet) que Balance, Suivi
              // projets et Caisses perso, pour que ces vues s'accordent enfin entre elles.
              var recettesFactParSpectacle = {};
              try {
                var donneesComptaFact = calculerRecetteEtCoutParSpectacle(ss, year);
                Object.keys(donneesComptaFact).forEach(function(cle) {
                  recettesFactParSpectacle[cle] = donneesComptaFact[cle].recette || 0;
                });
              } catch(eFactCompta) { Logger.log('getFacturation recettesFactParSpectacle erreur: ' + eFactCompta.message); }

              // Extraire hyperliens contrat
              var hyperliens = {};
              try {
                const sheet   = ss.getSheetByName(devisTab);
                const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
                const lastRow = sheet.getLastRow();
                if (lastRow >= 2) {
                  [{ nom: 'lien ', cle: 'urlRecap' }, { nom: 'contrat ', cle: 'urlContrat' }, { nom: 'contrat', cle: 'urlContrat' }]
                    .forEach(function(col) {
                      const colIdx = headers.findIndex(h => h.toString().trim() === col.nom.trim());
                      if (colIdx === -1) return;
                      const richValues = sheet.getRange(2, colIdx + 1, lastRow - 1, 1).getRichTextValues();
                      richValues.forEach(function(cellArr, i) {
                        const cell = cellArr[0];
                        if (!cell) return;
                        const runs = cell.getRuns();
                        for (var r = 0; r < runs.length; r++) {
                          const link = runs[r].getLinkUrl();
                          if (link) {
                            const rowIdx = i + 2;
                            if (!hyperliens[rowIdx]) hyperliens[rowIdx] = {};
                            if (!hyperliens[rowIdx][col.cle]) hyperliens[rowIdx][col.cle] = link;
                            break;
                          }
                        }
                      });
                    });
                }
              } catch(e) { Logger.log('Facturation hyperliens erreur: ' + e.message); }

              devisRaw.rows.forEach(function(r) {
                const d = normalizeRow(r, 'DEVIS', entity);
                if (!d) return;
                // Seulement les devis signés
                if (d.statutContrat !== 'Signé') return;
                // Dont la date de fin est passée (ou absente -> utiliser date début)
                const dateFin = d.dateFin || d.dateDebut;
                if (!dateFin) return;
                const parts = dateFin.split('/');
                if (parts.length !== 3) return;
                const fin = new Date(parseInt(parts[2]), parseInt(parts[1])-1, parseInt(parts[0]));
                if (fin > today) return; // pas encore terminé

                // Vérifier si déjà facturé (par ref ou par diffuseur+montant)
                const ref = d.id ? d.id.toString() : '';
                if (ref && refsFacturees.has(ref)) return;

                // Déjà couvert par une recette en compta pour ce spectacle (même si
                // personne n'a créé la ligne facture) : ne pas le compter comme "à
                // facturer", l'argent est déjà rentré. Le montant retrouvé est
                // "consommé" du pool restant pour ce spectacle, pour ne pas couvrir
                // plusieurs devis distincts d'un même spectacle avec la même recette
                // quand plusieurs diffuseurs le partagent.
                const montantDevisFact = d.montantTotal || d.montantPrincipal || d.montantHT || 0;
                const cleSpecFact = normaliserNomProjet((d.spectacle || '').toString().trim(), ss);
                const recetteDisponible = recettesFactParSpectacle[cleSpecFact] || 0;
                if (montantDevisFact > 0 && recetteDisponible >= montantDevisFact - 0.5) {
                  recettesFactParSpectacle[cleSpecFact] = recetteDisponible - montantDevisFact;
                  return;
                }

                // Injecter les URLs hyperliens
                const hl = hyperliens[r._rowIndex] || {};

                // Créer une ligne facturation synthétique
                rowsFact.push({
                  _rowIndex:   r._rowIndex,
                  _sourceSheet: devisTab,
                  _fromDevis:  true,
                  id:          ref || r._rowIndex,
                  num:         ref,
                  refDevis:    ref,
                  diffuseur:   d.diffuseur,
                  spectacle:   d.spectacle,
                  typeDevis:   d.typeDevis,
                  montantHT:   d.montantTotal || d.montantPrincipal || d.montantHT || 0,
                  montantCession: d.montantHT || 0,
                  montantHeures:  d.montantHeures || 0,
                  fraisTotal:  (d.fraisHeberg||0) + (d.fraisRest||0) + (d.fraisDeplac||0) + (d.fraisMat||0),
                  emise:       '',
                  echeance:    '',
                  dateDebut:   d.dateDebut,
                  dateFin:     d.dateFin,
                  statut:      'À facturer',
                  joursRetard: 0,
                  pdfRecap:    hl['urlRecap']   || d.pdfRecap   || '',
                  pdfContrat:  hl['urlContrat'] || d.pdfContrat || '',
                  lienDrive:   hl['urlContrat'] || '',
                  rowIndex:    r._rowIndex,
                });
              });
            }
          }
        }

        return { tab: tabName || 'FACTURATION', rows: rowsFact };
      }

      case 'getBalance': {
        const comptaData = handleGet({ ...params, action: 'getCompta', entity, year });
        if (comptaData.error) return comptaData;

        // Comptes de trésorerie (classe 5 du PCG : Banque, Livret A, Chèques...) —
        // leurs mouvements sont soit le solde d'ouverture, soit des virements
        // internes entre les propres comptes de l'entité (ex: compte courant ->
        // Livret A). Ce ne sont NI des recettes NI des charges : les compter comme
        // tel fait apparaître deux fois le même mouvement (crédit d'un côté, débit
        // de l'autre) et gonfle artificiellement recettes ET charges du même montant.
        function estCompteTresorerie(compte) { return compte.startsWith('5'); }

        const bySpectacle = {};
        comptaData.rows.forEach(r => {
          // Regroupement par nom normalisé (normaliserNomProjet, la même clé que
          // Suivi projets/Facturation/Caisses perso) : "Le Rouge Gorge"/"LE ROUGE
          // GORGE"/"Le rouge Gorge" doivent tomber sur la même ligne, sinon leurs
          // recettes/charges se dispersent sur plusieurs lignes distinctes.
          const spectacleRaw = (r.SPECTACLE || 'GENERAL').toString().trim();
          const spectacle = (!spectacleRaw || spectacleRaw === 'GENERAL') ? 'GENERAL' : normaliserNomProjet(spectacleRaw, ss);
          if (!bySpectacle[spectacle]) bySpectacle[spectacle] = { spectacle, recettes: 0, chargesSal: 0, chargesNDF: 0, chargesDivers: 0, sources: { facturation: 0, compta: 0, ndf: 0 } };
          const s = bySpectacle[spectacle];
          const compte = (r.COMPTE || '').toString().trim();
          if (estCompteTresorerie(compte)) return; // exclu du compte de résultat
          const credit = parseFloat(r.CREDIT) || 0;
          const debit  = parseFloat(r.DEBIT)  || 0;
          if (compte.startsWith('7') || credit > 0) { s.recettes += credit; s.sources.facturation += credit; }
          if (compte.startsWith('64') || compte.startsWith('421')) { s.chargesSal += debit; s.sources.compta += debit; }
          if (compte.startsWith('625') || compte.startsWith('606')) { s.chargesNDF += debit; s.sources.ndf += debit; }
          if (debit > 0 && !compte.startsWith('64') && !compte.startsWith('421') && !compte.startsWith('625') && !compte.startsWith('606') && !compte.startsWith('7')) s.chargesDivers += debit;
        });
        const rows = Object.values(bySpectacle).map(s => ({
          spectacle: s.spectacle,
          recettes:      Math.round(s.recettes * 100) / 100,
          chargesSal:    Math.round(s.chargesSal * 100) / 100,
          chargesNDF:    Math.round(s.chargesNDF * 100) / 100,
          chargesDivers: Math.round(s.chargesDivers * 100) / 100,
          sources: { facturation: Math.round(s.sources.facturation * 100) / 100, compta: Math.round(s.sources.compta * 100) / 100, ndf: Math.round(s.sources.ndf * 100) / 100 },
        }));

        // Détail par compte comptable (grand livre / bilan classique) — en plus du
        // regroupement par spectacle ci-dessus, qui masque toutes les écritures
        // sans spectacle associé (salaires, cotisations, frais bancaires...) sous
        // un seul "GENERAL". Regroupé par COMPTE + LIBELLÉ RÉELLEMENT SAISI sur
        // chaque ligne (r.OP_TYPE) — jamais par un libellé générique deviné depuis
        // CODE COMPTA, car un même compte peut être utilisé pour plusieurs usages
        // réels différents (ex: 442 sert autant pour "Organismes sociaux" que pour
        // "Prélèvements à la source" chez CLR) : afficher un seul libellé pour
        // tout le compte aurait ré-étiqueté à tort des écritures qui n'ont rien
        // à voir entre elles.
        // Si la ligne n'a AUCUN libellé saisi (Opération compta vide), on ne
        // DEVINE jamais lequel des libellés possibles s'applique : seulement si
        // ce compte n'a qu'UN SEUL libellé connu dans tout le plan, on peut s'en
        // servir sans risque d'erreur ; s'il en a plusieurs (comme 442 ou 625.6),
        // impossible de savoir lequel sans l'info — on affiche "à préciser"
        // plutôt que de choisir arbitrairement un des deux et d'induire en erreur.
        // Les comptes de trésorerie sont ventilés à part (voir mouvementsTresorerie),
        // pour ne jamais les mélanger avec le compte de résultat.
        const libellesParCompte = {};
        getListeCodeCompta(ss).forEach(o => {
          if (!libellesParCompte[o.code]) libellesParCompte[o.code] = new Set();
          libellesParCompte[o.code].add(o.label);
        });
        function libelleParDefautSiNonAmbigu(compte) {
          const s = libellesParCompte[compte];
          if (!s || s.size !== 1) return '';
          return Array.from(s)[0];
        }
        // Regroupement par COMPTE SEUL — une vraie balance comptable montre une
        // seule ligne par numéro de compte (total crédit/débit/solde), pas une
        // ligne par nature de dépense. Quand un compte a plusieurs libellés
        // distincts réellement utilisés (ex: 625.6 dépla/repas/hébergement), on
        // les concatène dans la colonne Libellé pour ne pas perdre l'info, mais
        // le total, lui, reste unique par compte.
        const byCompte = {};
        const byCompteTresorerie = {};
        comptaData.rows.forEach(r => {
          const compte = (r.COMPTE || '').toString().trim();
          if (!compte) return; // lignes sans compte affecté (à vérifier), exclues du détail
          const saisi = (r.OP_TYPE || '').toString().trim();
          const libelle = saisi || libelleParDefautSiNonAmbigu(compte) || '(à préciser)';
          const cible = estCompteTresorerie(compte) ? byCompteTresorerie : byCompte;
          if (!cible[compte]) cible[compte] = { compte, libelles: new Set(), credit: 0, debit: 0 };
          // Normalise casse/espaces pour éviter "Service bancaire" et "Service
          // Bancaire" comme deux entrées distinctes dans le libellé concaténé.
          const libelleNorm = libelle.toLowerCase().replace(/\s+/g, ' ');
          if (![...cible[compte].libelles].some(l => l.toLowerCase().replace(/\s+/g, ' ') === libelleNorm)) {
            cible[compte].libelles.add(libelle);
          }
          cible[compte].credit += parseFloat(r.CREDIT) || 0;
          cible[compte].debit  += parseFloat(r.DEBIT)  || 0;
        });
        function finaliserDetail(byC) {
          return Object.values(byC)
            .map(c => ({
              compte:  c.compte,
              libelle: Array.from(c.libelles).join(' / '),
              credit:  Math.round(c.credit * 100) / 100,
              debit:   Math.round(c.debit * 100) / 100,
              solde:   Math.round((c.credit - c.debit) * 100) / 100,
            }))
            .sort((a, b) => {
              const na = parseFloat(a.compte), nb = parseFloat(b.compte);
              if (!isNaN(na) && !isNaN(nb) && na !== nb) return na - nb;
              return a.compte.localeCompare(b.compte);
            });
        }
        const detailCompte = finaliserDetail(byCompte);
        const mouvementsTresorerie = finaliserDetail(byCompteTresorerie);

        // Reste à encaisser : ce qui est prévu par les devis vs les recettes déjà
        // enregistrées en compta pour ce spectacle. Le rapprochement bancaire relie
        // une recette au spectacle, pas à un devis précis quand plusieurs diffuseurs
        // partagent un même spectacle — l'agrégation se fait donc par spectacle.
        // Utilise calculerRecetteEtCoutParSpectacle (même source et même clé de
        // regroupement — normaliserNomProjet — que Suivi projets, Facturation et
        // Caisses perso) au lieu d'un recalcul local, pour que ces vues s'accordent
        // enfin sur la même définition de "reçu".
        var resteAEncaisser = [];
        try {
          var recettesParSpectacleNorm = calculerRecetteEtCoutParSpectacle(ss, year);
          var devisResult = chargerTousLesDevisEntite(ss, entity, year);
          var aujourdhui = new Date(); aujourdhui.setHours(0,0,0,0);
          var attenduParSpectacleNorm = {}; // cle normaliserNomProjet -> { label, total, dateRef (la + tardive des représentations) }
          (devisResult.rows || []).filter(function(d) { return d.type === 'DIFFUSEUR'; }).forEach(function(d) {
            var cle = normaliserNomProjet((d.spectacle || '').toString().trim(), ss);
            if (!cle) return;
            if (!attenduParSpectacleNorm[cle]) attenduParSpectacleNorm[cle] = { label: cle, total: 0, dateRef: null };
            attenduParSpectacleNorm[cle].total += (d.montantTotal || d.montantHT || d.montantPrincipal || 0);
            var dRepr = parserDateFR(d.dateFin || d.dateDebut || '');
            if (dRepr && (!attenduParSpectacleNorm[cle].dateRef || dRepr > attenduParSpectacleNorm[cle].dateRef)) {
              attenduParSpectacleNorm[cle].dateRef = dRepr;
            }
          });
          resteAEncaisser = Object.keys(attenduParSpectacleNorm).map(function(cle) {
            var g = attenduParSpectacleNorm[cle];
            var attendu  = Math.round(g.total * 100) / 100;
            var encaisse = Math.round(((recettesParSpectacleNorm[cle] || {}).recette || 0) * 100) / 100;
            var reste    = Math.max(0, Math.round((attendu - encaisse) * 100) / 100);
            // "Passé" = la dernière date de représentation connue pour ce spectacle
            // est déjà derrière nous (donc l'argent devrait normalement être rentré).
            var estPasse = !!(g.dateRef && g.dateRef <= aujourdhui);
            return { spectacle: g.label, attendu: attendu, encaisse: encaisse, reste: reste, estPasse: estPasse };
          }).sort(function(a, b) { return b.reste - a.reste; });
        } catch(eReste) { Logger.log('getBalance resteAEncaisser erreur: ' + eReste.message); }
        var resteAEncaisserPasse = Math.round(resteAEncaisser.filter(function(l) { return l.estPasse; }).reduce(function(s, l) { return s + l.reste; }, 0) * 100) / 100;

        return { tab: 'BALANCE', rows, detailCompte, mouvementsTresorerie, resteAEncaisser, resteAEncaisserPasse };
      }

      case 'getCompta':
        return getComptaRows(ss, entity, params.year === '0' ? 0 : year, params.statut);

      case 'getSoldesOuvertureBancaire':
        return getSoldesOuvertureBancaire(ss);

      case 'salaries':
      case 'getSalaries':
        return getSalariesData(ss, entity, year);

      case 'getCaisses':         return getCaissesDetail(ss, entity);
      case 'verifierCaissesParSpectacle': return verifierCaissesParSpectacle(ss, entity);
      case 'getAvailableYears':  return getAvailableYears(ss);
      case 'getDSNStatus':       return getDSNStatus(ss, year, params.mois);
      case 'getDevisSpectacles': return getDevisSpectacles(ss, year, entity);
      case 'getComptaPrevu':     return verifierPrevuReel(ss, entity, year);
      case 'getCodes':           return getCodes(ss);
      case 'getStatsSalaries':   return getStatsSalaries(ss, entity, year);
      case 'getLicences':        return getLicences(ss);

      case 'getSuiviProjet':
        if (params.year === 'tous' || params.year === '0' || year === 0) {
          return getSuiviProjetTousExercices(ss, entity);
        }
        return getSuiviProjet(ss, entity, year);

      case 'getCodeCompta': {
        // Réutilise les mêmes fonctions que le rapprochement automatique CSV, pour
        // que le menu déroulant de compte et la reconnaissance à l'import restent
        // TOUJOURS cohérents entre eux (une seule source de vérité).
        var plan      = getCodeComptaMap(ss);   // code -> UN libellé (repli simple)
        var planListe = getListeCodeCompta(ss); // TOUTES les combinaisons {code, label},
                                                 // y compris plusieurs libellés pour un même
                                                 // code (ex: 625.6 chez CLR : dépla/repas/hébergement)
        return { plan: plan, planListe: planListe };
      }

      case 'chercherContratsSigne':
        return chercherContratsSigne(entity, params.salarie, params.projet, params.mois, params.annee);

      case 'getNDFPdfUrl':
        return getNDFPdfUrl(entity, params.nomFichier);

      case 'getPieceComptaUrl': {
        var nomF = params.nomFichier || '';
        if (!nomF) return { error: 'Nom requis' };
        // Si déjà une URL -> retourner directement
        if (nomF.startsWith('http')) return { success: true, url: nomF };
        // Chercher dans DRIVE_PIECES_COMPTA puis DRIVE_NDF en fallback
        var cfgSs = getSheetById(entity);
        if (!cfgSs) return { error: 'Entity introuvable' };
        var cfgMap = getConfigMap(cfgSs);
        var folderIds = [
          cfgMap['DRIVE_PIECES_COMPTA'],
          cfgMap['DRIVE_NDF'],
          cfgMap['DRIVE_FICHES_PAIE'],
        ].filter(Boolean);
        if (folderIds.length === 0) return { error: 'DRIVE_PIECES_COMPTA non configuré pour ' + entity };
        // Recherche Drive par nom
        var nomCherche = nomF.replace(/\.pdf$/i,'').replace(/\.jpg$/i,'').replace(/\.jpeg$/i,'').replace(/\.heic$/i,'').replace(/\.png$/i,'');
        var dateDebutPiece = new Date().getTime();
        var DELAI_MAX_PIECE_MS = 20000; // au-delà, on arrête pour ne pas bloquer l'utilisateur indéfiniment
        for (var fi = 0; fi < folderIds.length; fi++) {
          if (new Date().getTime() - dateDebutPiece > DELAI_MAX_PIECE_MS) break;
          try {
            var folder = DriveApp.getFolderById(folderIds[fi]);
            // Recherche scopée au dossier (rapide) plutôt que sur tout le Drive
            var query = 'title contains "' + nomCherche.replace(/"/g,'').substring(0,50) + '" and trashed = false';
            var files = folder.searchFiles(query);
            while (files.hasNext()) {
              var f = files.next();
              if (f.getName() === nomF || f.getName().toLowerCase() === nomF.toLowerCase()) {
                return { success: true, url: f.getUrl(), fileId: f.getId() };
              }
            }
            // Fallback scan récursif (sous-dossiers), borné dans le temps
            var found = scanForFile(folder, nomF, dateDebutPiece, DELAI_MAX_PIECE_MS);
            if (found) return { success: true, url: found.getUrl(), fileId: found.getId() };
          } catch(e) { Logger.log('getPieceComptaUrl erreur: ' + e.message); }
        }
        return { error: 'Fichier introuvable (ou recherche interrompue après 20s) : ' + nomF };
      }

      case 'chercherFichesPaie':
        return chercherFichesPaie(entity, params.salarie, params.projet, params.mois, params.annee, params.nomComplet);

      default:
        return { error: true, code: 'UNKNOWN_ACTION', message: 'Action inconnue : ' + action };
    }
  } catch(err) {
    Logger.log('handleGet erreur [' + action + ']: ' + err.message + '\n' + err.stack);
    return { error: true, code: 'SERVER_ERROR', message: err.message, stack: err.stack };
  }
}

// =============================================================================
// HANDLE POST
// =============================================================================

function handlePost(body) {
  try {
    const action  = (body.action  || '').toString().trim();
    const entity  = (body.entity  || '').toUpperCase();
    const payload = body.payload  || {};

    let email = body.email || '';
    try { const se = Session.getEffectiveUser().getEmail(); if (se) email = se; } catch(_) {}
    try { if (!email) { const sa = Session.getActiveUser().getEmail(); if (sa) email = sa; } } catch(_) {}

    // Vérification de l'identification simple (utilisateur/mot de passe) —
    // doit fonctionner avant même que l'entité ne soit choisie côté client,
    // donc traitée ici en amont du contrôle d'accès par entité.
    if (action === 'verifierIdentiteApp') return verifierIdentiteApp(payload.nom, payload.motDePasse);

    const CONFIG_ACTIONS = ['saveModulesActifs','saveConfigSheetId','saveConfigDriveIds','saveConfigFinance','saveConfigTarifsPaie','saveConfigPorteurs','saveConfigLicence','updateConfig','validerDSN','validerDSNMensuelle','cloturerMoisNDF','ajouterStructure','ajouterUtilisateurApp','modifierMotDePasseUtilisateurApp','supprimerUtilisateurApp','modifierEntitesUtilisateurApp'];
    if (!CONFIG_ACTIONS.includes(action) && !checkAuth(email, entity)) {
      return { error: true, code: 'UNAUTHORIZED', message: 'Acces refuse. Email: "' + email + '" - Action: ' + action };
    }

    const ss = getSheetById(entity) || SpreadsheetApp.getActiveSpreadsheet();
    const year = parseInt(body.year || payload.year) || new Date().getFullYear();

    switch (action) {
      case 'updateField':
        return updateRowField(ss, payload.tab, payload.rowIndex, payload.colName, payload.value);
      case 'genererVirement':
        return genererVirementGroupe(ss, entity, year, payload.mois, email);
      case 'updateNDF': {
        var ndfTabName = resolveTabName('NOTE DE FRAIS V', year, entity);
        var ndfId2     = payload.id || body.id;
        var ndfStatut  = payload.statut || body.statut || 'Traitée';
        // Trouver la ligne par ID (colonne 1)
        var ndfSheet2  = ss.getSheetByName(ndfTabName);
        if (!ndfSheet2) return { error: 'NDF tab introuvable: ' + ndfTabName };
        var ndfVals    = ndfSheet2.getDataRange().getValues();
        var ndfRowNum  = -1;
        for (var ni2 = 1; ni2 < ndfVals.length; ni2++) {
          if (ndfVals[ni2][0] && ndfVals[ni2][0].toString() === ndfId2.toString()) {
            ndfRowNum = ni2 + 1; break;
          }
        }
        if (ndfRowNum < 0) return { error: 'NDF id non trouvé: ' + ndfId2 };
        var ndfHeaders2 = ndfVals[0];
        // Chercher les colonnes Statut et Traité séparément
        var ndfColStatut = -1, ndfColTraite = -1;
        ndfHeaders2.forEach(function(h, hi) {
          var hh = h ? h.toString().trim().toLowerCase() : '';
          if (hh === 'statut' || hh === 'status') ndfColStatut = hi;
          if (hh === 'traité' || hh === 'traite') ndfColTraite = hi;
        });
        Logger.log('NDF cols: statut=' + ndfColStatut + ' traite=' + ndfColTraite + ' headers=' + JSON.stringify(ndfHeaders2));

        var updated = false;
        // Colonne Statut → texte
        if (ndfColStatut >= 0) {
          ndfSheet2.getRange(ndfRowNum, ndfColStatut + 1).setValue(ndfStatut);
          updated = true;
        }
        // Colonne Traité → checkbox TRUE
        if (ndfColTraite >= 0) {
          ndfSheet2.getRange(ndfRowNum, ndfColTraite + 1).setValue(true);
          updated = true;
        }
        if (!updated) return { error: 'Colonnes Statut et Traité introuvables dans ' + ndfTabName };
        Logger.log('NDF updateNDF: id=' + ndfId2 + ' statut=' + ndfStatut + ' row=' + ndfRowNum);

        // Si passage en Traitée → déduire des caisses perso si colonne CAISSE renseignée
        if (ndfStatut === 'Traitée' || ndfStatut === 'Traitee') {
          var ndfRow2 = ndfVals[ndfRowNum - 1];
          // Trouver les colonnes CAISSE, montant, spectacle, date, libellé
          var iCaisse   = ndfHeaders2.findIndex(function(h) { return h && h.toString().trim().toLowerCase() === 'caisse deduction' || h.toString().trim().toLowerCase() === 'caisse déduction'; });
          var iNomCaisse= ndfHeaders2.findIndex(function(h) { return h && h.toString().trim().toLowerCase() === 'nom caisse'; });
          var iMontant  = ndfHeaders2.findIndex(function(h) { return h && (h.toString().trim().toLowerCase().includes('total') || h.toString().trim().toLowerCase().includes('montant')); });
          var iProjet   = ndfHeaders2.findIndex(function(h) { return h && h.toString().trim().toLowerCase() === 'projet'; });
          var iDate     = ndfHeaders2.findIndex(function(h) { return h && h.toString().trim().toLowerCase().includes('date'); });
          var iComm     = ndfHeaders2.findIndex(function(h) { return h && h.toString().trim().toLowerCase().includes('commentaire'); });

          var caisseVal  = iCaisse   >= 0 ? (ndfRow2[iCaisse]   || '').toString().trim() : '';
          var nomCaisse  = iNomCaisse>= 0 ? (ndfRow2[iNomCaisse]|| '').toString().trim() : '';
          var montantNDF = iMontant  >= 0 ? (parseFloat(ndfRow2[iMontant]) || 0) : 0;
          var projetNDF  = iProjet   >= 0 ? (ndfRow2[iProjet]   || '').toString().trim() : '';
          var dateNDF    = iDate     >= 0 ? ndfRow2[iDate] : '';
          var commNDF    = iComm     >= 0 ? (ndfRow2[iComm]     || '').toString().trim() : '';
          var dateStr    = dateNDF instanceof Date
            ? Utilities.formatDate(dateNDF, 'Europe/Paris', 'dd/MM/yyyy')
            : (dateNDF || new Date()).toString().substring(0, 10);

          // caisseVal = "Oui" ou "Fanny" ou "Fanny et Malorie"
          // nomCaisse = prénom(s) du/des bénéficiaire(s)
          var porteursCaisse = [];
          var textePorteur = nomCaisse || (caisseVal !== 'Oui' && caisseVal !== 'Non' ? caisseVal : '');
          if (textePorteur) {
            porteursCaisse = parserBeneficiairesCaisse(textePorteur);
          }

          if ((caisseVal === 'Oui' || porteursCaisse.length > 0) && montantNDF > 0) {
            var intituleNDF = commNDF || 'NDF ' + ndfId2;
            if (porteursCaisse.length === 0) {
              // Déduire de tous les bénéficiaires du spectacle
              var codeMap2  = getCodeComptaCaisseMap(ss);
              var specInfo2 = codeMap2[(projetNDF || '').toLowerCase()] || {};
              porteursCaisse = specInfo2.beneficiaires || [];
            }
            var partNDF = porteursCaisse.length > 0 ? montantNDF / porteursCaisse.length : montantNDF;
            porteursCaisse.forEach(function(porteur) {
              try {
                deduireCaisse(ss, entity, porteur, partNDF, projetNDF, intituleNDF, dateStr, 'NDF');
                Logger.log('NDF déduction caisse: ' + porteur + ' -' + partNDF + '€ pour ' + projetNDF);
              } catch(ed) { Logger.log('NDF déduction caisse err: ' + ed.message); }
            });
          }
        }

        return { success: true, id: ndfId2, statut: ndfStatut, row: ndfRowNum };
      }
      case 'updateDecla':
        return updateRowField(ss, resolveTabName('DECLA', year, entity), body.id, body.field, body.value);
      case 'updateDPAE':
        return validerDPAE(ss, resolveTabName('DPAE', year, entity), body.id, body.dateEnvoi);
      case 'saisirPieceCompta':
        return saisirPieceCompta(ss, entity, payload, email);
      case 'verifierReleve':
        return verifierReleve(ss, entity, payload, email);
      case 'validerPieceCompta':
        return validerPieceCompta(ss, payload.rowIndex, payload.corrections);
      case 'editerLigneCompta':
        return editerLigneCompta(ss, payload.rowIndex, payload.corrections);

      case 'sauvegarderVentilationLigne':
        return sauvegarderVentilationLigne(ss, payload.rowIndex, payload.ventilations);

      case 'setSoldeOuvertureBancaire':
        return setSoldeOuvertureBancaire(ss, payload.exercice || '', payload.solde);

      case 'repartirLigneComptaSurProjets':
        return repartirLigneComptaSurProjets(ss, payload.rowIndex, payload.repartitions);

      case 'getFDPDuMois': {
        return getFDPDuMois(ss, entity, payload.dateVirement || '', payload.extraireTexte || false);
      }

      case 'analyserReleve': {
        var lignesReleve = payload.lignes || [];
        var comptaCtx = getComptaRows(ss, entity, 0, null);
        var allRows = comptaCtx.rows || [];
        var recentRows = allRows.slice(-50);
        recentRows.plan = getCodeComptaMap(ss);

        // Étape 0 (toutes entités sauf CLR) : rapprochement direct contre l'onglet
        // PIECE COMPTA (date ±7j + montant exact). Seules les lignes non résolues
        // repartent vers le rapprochement IA/Drive existant, en secours.
        var propositionsPieceComptaSheet = [];
        var lignesPourIA = lignesReleve;
        var indexOriginaux = lignesReleve.map(function(_, i) { return i; });
        if (entity !== 'CLR') {
          var piecesSheet = chargerPiecesComptaSheet(ss);
          if (piecesSheet.length > 0) {
            var matchRes = matcherAvecPieceComptaSheet(lignesReleve, piecesSheet, getListeCodeCompta(ss));
            propositionsPieceComptaSheet = matchRes.propositionsMatchees;
            indexOriginaux = matchRes.indexNonMatches;
            lignesPourIA = indexOriginaux.map(function(i) { return lignesReleve[i]; });
            Logger.log('PIECE COMPTA: ' + propositionsPieceComptaSheet.length + ' matchées, ' + lignesPourIA.length + ' restantes pour IA/Drive');
          }
        }

        // Source 1 : pièces extraites des écritures COMPTA existantes (LIEN DRIVE)
        var piecesDrive = [];
        allRows.forEach(function(r) {
          var lien = (r.LIEN_CAT || r.PIECE_PDF || '').toString().trim();
          if (!lien) return;
          var debit  = parseFloat(r.DEBIT)  || 0;
          var credit = parseFloat(r.CREDIT) || 0;
          var montant = debit > 0 ? debit : credit;
          if (montant > 0 && lien) {
            piecesDrive.push({
              nom:     lien,
              url:     r.PIECE_PDF || (lien.startsWith('http') ? lien : ''),
              montant: montant,
            });
          }
        });

        // Source 2 : dossier Drive si configuré
        var cfgMap = getConfigMap(ss);
        var folderIds = [cfgMap['DRIVE_PIECES_COMPTA'], cfgMap['DRIVE_NDF']].filter(Boolean);
        folderIds.forEach(function(fid) {
          try {
            var folder = DriveApp.getFolderById(fid);
            listerFichiersRecursif(folder, piecesDrive, 0, 3);
          } catch(e) { Logger.log('Drive erreur: ' + e.message); }
        });

        Logger.log('Pieces disponibles pour rapprochement: ' + piecesDrive.length);

        var listesImport = getListesImportCompta(ss);

        if (lignesPourIA.length === 0) {
          // Tout a été résolu directement via PIECE COMPTA
          enrichirSpectacleParMontant(ss, entity, year, propositionsPieceComptaSheet, lignesReleve);
          return { success: true, propositions: propositionsPieceComptaSheet, source: 'piece_compta_sheet', listesImport: listesImport };
        }

        var resultatIA = analyserReleveAvecClaude(entity, lignesPourIA, recentRows, piecesDrive);
        // Remapper les index des propositions IA (calculés sur le sous-ensemble non
        // matché) vers les index d'origine dans lignesReleve, puis fusionner.
        if (resultatIA && resultatIA.propositions) {
          var listeCodeComptaPourIA = getListeCodeCompta(ss);
          var codeComptaMapPourIA   = getCodeComptaMap(ss); // fallback simple code->1 libellé
          // Index inverse code -> libellé officiel (ex: "645" -> "Cotisations"), pour
          // le cas où le compte est déjà connu mais le texte d'opération ne matche pas.
          var codeVersLabel = {};
          Object.keys(codeComptaMapPourIA).forEach(function(code) {
            codeVersLabel[code.toString().trim()] = codeComptaMapPourIA[code];
          });
          resultatIA.propositions.forEach(function(p) {
            p.index = indexOriginaux[p.index];
            // L'IA/le fallback local peuvent inventer un libellé d'opération en texte
            // libre (ex: "Charges sociales AUDIENS") qui ne correspond à aucune option
            // de la liste déroulante "Opération compta" du Sheet. On le remplace par le
            // libellé officiel le plus proche trouvé dans CODE COMPTA.
            var matchOp = trouverCompteEtLabelOfficiel(listeCodeComptaPourIA, p.operation);
            if (matchOp.label) {
              p.operation = matchOp.label;
              if (!p.compte) p.compte = matchOp.code;
            } else if (p.compte && codeVersLabel[p.compte.toString().trim()]) {
              // Le texte libre ne matche rien, mais le compte lui-même est connu :
              // on retrouve son libellé officiel directement par le code (ex: 645 -> Cotisations).
              p.operation = codeVersLabel[p.compte.toString().trim()];
            } else {
              p.operation = '';
            }
          });
          resultatIA.propositions = propositionsPieceComptaSheet.concat(resultatIA.propositions);
        }
        if (resultatIA) {
          resultatIA.listesImport = listesImport;
          if (resultatIA.propositions) enrichirSpectacleParMontant(ss, entity, year, resultatIA.propositions, lignesReleve);
        }
        return resultatIA;
