    .map(function(l) { return l.split('\t'); })
    .filter(function(cols) { return cols.length >= 4 && (cols[0] || '').trim(); });
  var rows = lignes
    .filter(function(cols) { return _normaliserNomPersonne(cols[0]) !== 'CODESOCIETE'; }) // ignore l'en-tête
    .map(function(cols) { return [cols[0].trim().toUpperCase(), (cols[2]||'').trim(), (cols[3]||'').trim()]; })
    .filter(function(row) { return row[0] && row[1]; });
  if (rows.length === 0) return { error: 'Aucune ligne compte analytique reconnue dans le fichier' };

  var sheet = ensureComptesAnalytiquesTab();
  var lastRow = sheet.getLastRow();
  if (lastRow > 1) sheet.getRange(2, 1, lastRow - 1, COMPTES_ANALYTIQUES_HEADERS.length).clearContent();
  sheet.getRange(2, 1, rows.length, COMPTES_ANALYTIQUES_HEADERS.length).setValues(rows);
  updateConfig(SpreadsheetApp.openById(ENTITY_SHEET_IDS.AMIIS), 'COMPTES_ANALYTIQUES_DERNIER_IMPORT', new Date().toISOString());
  return { success: true, count: rows.length };
}

function getInfoComptesAnalytiques() {
  var sheet = ensureComptesAnalytiquesTab();
  var count = Math.max(sheet.getLastRow() - 1, 0);
  var dernierImport = '';
  try { dernierImport = getConfigMap(SpreadsheetApp.openById(ENTITY_SHEET_IDS.AMIIS))['COMPTES_ANALYTIQUES_DERNIER_IMPORT'] || ''; } catch(_) {}
  return { success: true, count: count, dernierImport: dernierImport };
}

// Cherche le vrai compte analytique pour ce projet dans cette entité — essaie
// une correspondance exacte contre le Compte ET contre le Libellé (certains
// projets n'ont que le libellé comme "code"). Ne renvoie un résultat QUE si
// la correspondance est unique, jamais un choix arbitraire entre plusieurs.
function trouverCompteAnalytique(entity, projet) {
  if (!projet) return null;
  var sheet = ensureComptesAnalytiquesTab();
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return null;
  var data = sheet.getRange(2, 1, lastRow - 1, COMPTES_ANALYTIQUES_HEADERS.length).getValues();
  var cibleEntity = (entity || '').toUpperCase();
  var cibleProjet = _normaliserNomPersonne(projet);
  var correspondances = data.filter(function(row) {
    if ((row[0] || '').toString().trim().toUpperCase() !== cibleEntity) return false;
    var libelle = _normaliserNomPersonne(row[1]);
    var compte  = _normaliserNomPersonne(row[2]);
    return cibleProjet === libelle || (compte && cibleProjet === compte);
  });
  if (correspondances.length !== 1) return null;
  var libelle = (correspondances[0][1] || '').toString().trim();
  var compte  = (correspondances[0][2] || '').toString().trim() || libelle;
  return { compte: compte, libelle: libelle };
}

