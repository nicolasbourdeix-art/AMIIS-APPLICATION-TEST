// Statut / Récap / Contrat pour une ligne Devis CLR. "Statut" et "Contrat" partagent
// en réalité la MÊME cellule (colonne "contrat") : le texte détermine le statut
// affiché (OUI/Envoyé/📄...), et un lien hypertexte dans cette même cellule fournit
// le badge "Contrat" cliquable. On écrit donc les deux ensemble pour ne pas casser
// l'un en modifiant l'autre. "Récap" est une colonne séparée.
function updateStatutDevisCLR(ss, year, rowIndex, statut, lienRecap, lienContrat, sourceSheet) {
  var sheet = getDevisClrSheet(ss, year, sourceSheet);
  if (!sheet) return { error: 'Onglet DEVIS introuvable pour CLR ' + year };
  var ri = parseInt(rowIndex, 10);
  if (!ri || ri < 2) return { error: 'rowIndex invalide' };

  try {
    // La ligne d'en-tête n'est pas toujours en ligne 1 : l'ancien onglet "DEVIS"
    // a parfois ses vraies colonnes en ligne 2 ou 3 (ligne 1 vide/inutilisée) —
    // même détection que getTabEnTetesDynamiques, sinon la colonne "contrat"
    // n'est jamais trouvée pour ces lignes et rien ne s'écrit silencieusement.
    var headerRowIdx = 1;
    var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    var maxScanStatut = Math.min(sheet.getLastRow(), 5);
    for (var hRow = 1; hRow <= maxScanStatut; hRow++) {
      var candidateStatut = sheet.getRange(hRow, 1, 1, sheet.getLastColumn()).getValues()[0];
      var textCountStatut = candidateStatut.filter(function(v) {
        return v && typeof v === 'string' && v.trim().length > 1 && v !== '#REF!';
      }).length;
      if (textCountStatut >= 3) { headers = candidateStatut; headerRowIdx = hRow; break; }
    }
    var colContrat = findColByHeaderExact(headers, 'contrat');
    var colRecap   = findColByHeaderExact(headers, 'Dépos au format pdf du devis validé');
    if (colContrat < 0 && colRecap < 0) {
      return { error: 'Colonnes "contrat"/"récap" introuvables dans ' + sheet.getName() + ' (en-tête détecté ligne ' + headerRowIdx + ')' };
    }

    if (colContrat > 0) {
      if (lienContrat) {
        // Un lien fourni → cellule cliquable, considérée "Signé" automatiquement
        sheet.getRange(ri, colContrat).setFormula('=HYPERLINK("' + lienContrat + '";"📄 Contrat")');
      } else if (statut === 'Signé') {
        sheet.getRange(ri, colContrat).setValue('OUI');
      } else if (statut === 'Envoyé') {
        sheet.getRange(ri, colContrat).setValue('Envoyé');
      } else {
        sheet.getRange(ri, colContrat).setValue('');
      }
    }
    if (colRecap > 0 && lienRecap) {
      sheet.getRange(ri, colRecap).setFormula('=HYPERLINK("' + lienRecap + '";"📋 Récap")');
    }
    return { success: true };
  } catch(e) {
    return { error: 'Modification statut devis: ' + e.message };
  }
}

// Suppression générique d'une ligne de déclaration, quelle que soit la structure/l'onglet
