function listerFichiersRecursif(folder, result, depth, maxDepth) {
  if (depth > maxDepth) return;
  try {
    var files = folder.getFiles();
    while (files.hasNext() && result.length < 200) {
      var f = files.next();
      var nom = f.getName();
      // Extraire le montant du nom de fichier si présent (ex: "598,61" ou "598.61")
      var montantMatch = nom.match(/(\d+[,.]\d{2})/);
      result.push({
        nom:     nom,
        id:      f.getId(),
        url:     f.getUrl(),
        montant: montantMatch ? parseFloat(montantMatch[1].replace(',','.')) : null,
        date:    f.getDateCreated() ? Utilities.formatDate(f.getDateCreated(), 'Europe/Paris', 'dd/MM/yyyy') : '',
      });
    }
    var subs = folder.getFolders();
    while (subs.hasNext()) {
      listerFichiersRecursif(subs.next(), result, depth + 1, maxDepth);
    }
  } catch(e) { Logger.log('listerFichiers: ' + e.message); }
}

