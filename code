// COMPTABILITÉ
// =============================================================================

const MOIS_LABELS_UP = ['JANVIER','FEVRIER','MARS','AVRIL','MAI','JUIN','JUILLET','AOUT','SEPTEMBRE','OCTOBRE','NOVEMBRE','DECEMBRE','JAN','FEV','MAR','AVR','JUI','JUL','AOU','SEP','OCT','NOV','DEC','JANV','FEVR','JUIL','SEPT'];

function getComptaRows(ss, entity, year, statutFilter) {
  const sheet = ss.getSheetByName('COMPTA');
  if (!sheet) return { error: 'TAB_NOT_FOUND', tab: 'COMPTA' };
  const lastRow = sheet.getLastRow();
  const lastCol = sheet.getLastColumn();
  if (lastRow < 3 || lastCol < 1) return { tab: 'COMPTA', rows: [] };

  // ── Détecter la ligne de headers (ligne 1 ou 2) ──────────────────────
  // La ligne 1 peut être vide, un tiret, ou une année -> chercher la première
  // ligne avec au moins 3 valeurs texte
  var headerRowIdx = 1; // 1-indexed
  var headerRow = null;
  for (var hi = 1; hi <= Math.min(3, lastRow); hi++) {
    var candidate = sheet.getRange(hi, 1, 1, lastCol).getValues()[0];
    var textCount = candidate.filter(function(v) {
      return v && typeof v === 'string' && v.trim().length > 2 && v !== '#REF!';
    }).length;
    if (textCount >= 3) { headerRow = candidate; headerRowIdx = hi; break; }
  }
  if (!headerRow) return { tab: 'COMPTA', rows: [] };

  // ── Construire l'index des colonnes ──────────────────────────────────
  const idx = {};
  headerRow.forEach(function(h, i) {
    if (h && h !== '#REF!' && h.toString().trim()) {
      idx[h.toString().trim()] = i;
    }
  });

  // Colonnes avec variantes selon les compagnies
  function findIdx() {
    for (var a = 0; a < arguments.length; a++) {
      if (idx[arguments[a]] !== undefined) return idx[arguments[a]];
    }
    return undefined;
  }

  const iOp     = findIdx("N° d'opération");
  const iAnnee  = findIdx("Année exercice", "année exercice");
  const iDate   = findIdx("Dates");
  const iOp3    = findIdx("Opération compta");
  const iLib    = findIdx("Descriptions/ Libelles");
  const iSpect  = findIdx("Spectacle");
  const iLien   = findIdx("LIEN DRIVE");
  const iNumFac = findIdx("N° de facture");
  const iMoyen  = findIdx("Moyen de paiement");
  const iDeQui  = findIdx("De qui? Ou pour qui?");
  const iComplem= findIdx("complément d'infos");
  const iCompte = findIdx("Numéro comptable");
  // CLR/PALM/OM/DIS : Produits=crédit, Charges=débit
  // MAN : CREDIT / DEBIT (noms différents)
  const iCredit = findIdx("Produits (Entrées)", "CREDIT");
  const iDebit  = findIdx("Charges (Sorties)",  "DEBIT");
  // Colonnes salaire brut / coût employeur
  const iSal    = findIdx("Salarié", "SALARIE");
  const iBrut   = findIdx("Brut salarial");
  const iEmp    = findIdx("Brut Cout employeur", "EMPLOYEUR");
  const iPiece  = findIdx("PIECE COMPTABLE PDF", "Piéce comptable généré");

  // Toutes les variantes de yearSuffix
  const yearStr    = String(year);
  const yearSuffix2 = 'EX ' + yearStr.slice(2);   // "EX 26"
  const yearSuffix4 = 'EX ' + yearStr;             // "EX 2026"

  function matchYear(val) {
    // year=0 ou null -> pas de filtre, tout accepter
    if (!year || year === 0 || year === '0') return true;
    if (!val && val !== 0) return true; // cellule vide -> on inclut
    const s = val.toString().trim(); // ← trim() critique pour "EX 24 "
    if (!s) return true;
    // Accepter : "2026", "EX 26", "EX 2026", "EX 26 " (avec espace)
    return s === yearStr || s === yearSuffix2 || s === yearSuffix4
        || s.replace(/\s+/g,'') === ('EX' + String(year).slice(-2))
        || s === String(parseInt(yearStr));
  }

  const PLAN = {
    '421':'Personnel - salaires a payer','442':'Organismes sociaux','467':'Comptes transitoires',
    '401':'Fournisseurs','411':'Clients','512':'Banque','5121':'Livret A',
    '604':'Matieres consommables','606':'Fournitures','616':'Assurances',
    '623':'Publicite','625':'Deplacements / repas','627':'Service bancaire',
    '6281':'Cotisations','641':'Salaires bruts','645':'Charges sociales',
    '706':'Prestations de services','74':'Subventions','756':'Cotisations recues','205':'Logiciels',
  };

  // ── Lire les données à partir de headerRowIdx + 1 ────────────────────
  const dataStart = headerRowIdx + 1;
  if (lastRow < dataStart) return { tab: 'COMPTA', rows: [] };
  const allData = sheet.getRange(dataStart, 1, lastRow - headerRowIdx, lastCol).getValues();
  // Lien Drive réel (HYPERLINK()/puce fichier) de la colonne LIEN DRIVE — getValues()
  // au-dessus ne renvoie que le texte affiché (nom de fichier), jamais l'URL.
  const liensDriveCompta = extraireLiensColonne(sheet, headerRow, 'LIEN DRIVE', dataStart);

  const rows = allData
    .map(function(row, i) { return { row: row, _rowIndex: i + dataStart }; })
    .filter(function(obj) {
      const row = obj.row;
      // 1. Ligne vide
      const hasContent = row.some(function(v) { return v !== null && v !== '' && v !== undefined; });
      if (!hasContent) return false;

      // 2. Ligne de séparation de mois/année (col0 = "OCT", "jan-24", 2024...)
      const col0 = row[0];
      // Nombre entier ressemblant à une année
      if (typeof col0 === 'number' && col0 >= 2000 && col0 <= 2100) return false;
      if (typeof col0 === 'string' && col0.trim()) {
        const c0up = col0.trim().toUpperCase().normalize('NFD').replace(/[̀-ͯ]/g,'');
        // Label mois seul (ex: "OCT", "JANVIER", "JAN-24")
        if (MOIS_LABELS_UP.includes(c0up)) return false;
        // Pattern "jan-24", "Jan-25"
        if (/^[A-Z]{2,4}-\d{2}$/i.test(col0.trim())) return false;
      }

      // 3. Filtre année — seulement si la colonne année existe ET contient une valeur
      if (iAnnee !== undefined) {
        const anneeVal = row[iAnnee];
        if (anneeVal !== null && anneeVal !== '' && anneeVal !== undefined) {
          if (!matchYear(anneeVal)) return false;
        }
      }

      // 4. Ligne sans données utiles (pas de montant, pas de compte, pas de date)
      const debit  = iDebit  !== undefined ? (parseFloat(row[iDebit])  || 0) : 0;
      const credit = iCredit !== undefined ? (parseFloat(row[iCredit]) || 0) : 0;
      const compte = iCompte !== undefined ? (row[iCompte] || '').toString().trim() : '';
      const dateV  = iDate   !== undefined ? row[iDate] : '';
      const op     = iOp     !== undefined ? (row[iOp]   || '').toString().trim() : '';
      // Vérifier aussi la colonne EMPLOYEUR avant d'éliminer
      const empVal = iEmp !== undefined ? (parseFloat(row[iEmp]) || 0) : 0;
      if (!compte && !dateV && debit === 0 && credit === 0 && !op && empVal === 0) return false;
      // Lignes de ventilation EMPLOYEUR : pas de compte, pas de date, pas de montant principal
      // -> on les garde avec un flag _isVentilation pour les rattacher côté front
      // (elles seront fusionnées avec la ligne 421 précédente)

      return true;
    })
    .map(function(obj) {
      const row = obj.row;
      const _rowIndex = obj._rowIndex;

      // Date
      const dateRaw = iDate !== undefined ? row[iDate] : '';
      var dateFormatted = '';
      if (dateRaw instanceof Date && !isNaN(dateRaw.getTime())) {
        dateFormatted = String(dateRaw.getDate()).padStart(2,'0') + '/'
          + String(dateRaw.getMonth()+1).padStart(2,'0') + '/' + dateRaw.getFullYear();
      } else if (dateRaw && typeof dateRaw === 'string' && dateRaw.trim()) {
        dateFormatted = dateRaw.trim();
      }
      const dateFormatted_check = dateFormatted; // pour détecter ventilation

      const compte    = iCompte !== undefined ? (row[iCompte] || '').toString().trim() : '';
      const compteNum = compte.replace(/\./g,'').replace(/[^0-9]/g,'');
      const compteBase = compteNum.substring(0, 3);
      const debit     = iDebit  !== undefined ? (parseFloat(row[iDebit])  || 0) : 0;
      const credit    = iCredit !== undefined ? (parseFloat(row[iCredit]) || 0) : 0;
      const brutSal   = iBrut !== undefined ? (parseFloat(row[iBrut]) || 0) : 0;
      const coutEmp   = iEmp  !== undefined ? (parseFloat(row[iEmp])  || 0) : 0;

      // Statut vérification
      var statutVerif = 'VERT';
      if (!compte && (debit > 0 || credit > 0)) statutVerif = 'ORANGE';

      if (statutFilter && statutVerif !== statutFilter) return null;

      // Pièce comptable PDF (URL) ou catégorie LIEN DRIVE (texte)
      var pieceUrl = '';
      var lienCategorie = '';
      if (iPiece !== undefined && row[iPiece]) {
        var pv = row[iPiece].toString().trim();
        if (pv.startsWith('http')) pieceUrl = pv;
      }
      // LIEN DRIVE : URL directe, lien réel embarqué (HYPERLINK/puce fichier), ou catégorie texte
      var lienDirectCompta = liensDriveCompta[_rowIndex];
      if (lienDirectCompta && !pieceUrl) {
        pieceUrl = lienDirectCompta;
      } else if (iLien !== undefined && row[iLien]) {
        var lv = row[iLien].toString().trim();
        if (lv.startsWith('http')) {
          if (!pieceUrl) pieceUrl = lv;
        } else if (lv && lv !== '#REF!') {
          lienCategorie = lv; // "Fonctionnement", "Spectacle", etc.
        }
      }

      // Année réelle de la ligne (pour le sélecteur front)
      const anneeRaw = iAnnee !== undefined ? (row[iAnnee] || '').toString().trim() : '';

      // Détecter les lignes de ventilation EMPLOYEUR :
      // pas de compte, pas de date, pas de débit/crédit, mais EMPLOYEUR rempli
      const isVentilation = !compte && !dateFormatted_check && debit === 0 && credit === 0 && coutEmp > 0;

      return {
        _rowIndex,
        _isVentilation: isVentilation,
        NUM_OP:      iOp     !== undefined ? (row[iOp]     || '').toString().trim() : '',
        OP_TYPE:     iOp3    !== undefined ? (row[iOp3]    || '').toString().trim() : '',
        DATE:        dateFormatted || '—',
        ANNEE:       anneeRaw || yearStr,
        COMPTE:      compte,
        COMPTE_NUM:  compteNum,
        COMPTE_LABEL: PLAN[compteNum] || PLAN[compteBase] || PLAN[compte] || '',
        LIBELLE:     iLib    !== undefined ? (row[iLib]    || '').toString().trim() : '',
        DEBIT:       debit,
        CREDIT:      credit,
        SPECTACLE:   iSpect  !== undefined ? (row[iSpect]  || '').toString().trim() : '',
        SALARIE:     iSal    !== undefined ? (row[iSal]    || '').toString().trim() : '',
        COMMENTAIRE: iComplem!== undefined ? (row[iComplem]|| '').toString().trim() : '',
        DRIVE_URL:   (iLien  !== undefined && row[iLien] && row[iLien].toString().trim().startsWith('http')) ? row[iLien].toString().trim() : '',
        PIECE_PDF:    pieceUrl,
        LIEN_CAT:     lienCategorie,
        NUM_FACTURE:  iNumFac !== undefined ? (row[iNumFac] || '').toString().trim() : '',
        MOYEN:       iMoyen  !== undefined ? (row[iMoyen]  || '').toString().trim() : '',
        DE_QUI:      iDeQui  !== undefined ? (row[iDeQui]  || '').toString().trim() : '',
        BRUT_SAL:    brutSal,
        COUT_EMP:    coutEmp,
        // Pour les lignes de ventilation : Salarié = code (421GAR), Spectacle = projet
        _VENT_SALARIE:  iSal !== undefined ? (row[iSal] || '').toString().trim() : '',
        _VENT_SPECTACLE: iSpect !== undefined ? (row[iSpect] || '').toString().trim() : '',
        STATUT_VERIF: statutVerif,
        SOURCE:      'COMPTA',
      };
    })
    .filter(function(r) { return r !== null; });

  // ── Fusionner les lignes de ventilation EMPLOYEUR avec la ligne 421 précédente ──
  var rowsMerged = [];
  var lastMain = null;
  rows.forEach(function(r) {
    if (!r) return;
    if (r._isVentilation) {
      // Rattacher à la dernière ligne principale
      if (lastMain) {
        if (!lastMain._ventilations) lastMain._ventilations = [];
        lastMain._ventilations.push({
          spectacle: r._VENT_SPECTACLE || r.SPECTACLE,
          salarie:   r._VENT_SALARIE   || r.SALARIE,
          coutEmp:   r.COUT_EMP || r.BRUT_SAL || 0,
          // Lien vers la fiche de paie : écrit soit comme URL directe (rare, cas
          // de secours), soit comme lien =HYPERLINK(url;nomFichier) — dans ce
          // second cas getValues() ne renvoie que le texte affiché (le nom du
          // fichier), pas l'URL ; on transmet donc les deux, le front résout
          // l'URL cliquable à la demande via le nom de fichier si besoin.
          fdpUrl: r.DRIVE_URL || r.PIECE_PDF || '',
          fdpNom: r.LIEN_CAT || '',
        });
      }
      // Ne pas inclure la ligne orpheline dans le résultat
      return;
    }
    lastMain = r;
    rowsMerged.push(r);
  });

  // Log debug ventilations
  var nbVent = 0;
  rowsMerged.forEach(function(r) { if (r._ventilations) nbVent += r._ventilations.length; });
  Logger.log('getComptaRows: ' + rowsMerged.length + ' lignes, ' + nbVent + ' ventilations EMPLOYEUR');

  return { tab: 'COMPTA', rows: rowsMerged, headerLine: headerRowIdx };
}

