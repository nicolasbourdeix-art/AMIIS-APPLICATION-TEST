function getPorteurCaisse(entity, code) {
  if (!code) return { error: 'Code requis' };
  const mainSs   = SpreadsheetApp.getActiveSpreadsheet();
  const codeInfo = findCode(mainSs, code);
  if (!codeInfo) return { error: 'CODE_INVALIDE' };
  if (codeInfo.role !== 'porteur') return { error: 'ROLE_INVALIDE' };
  const targetEntity = entity || codeInfo.compagnies || 'CLR';
  const ss = getSheetById(targetEntity.split(',')[0].trim());
  if (!ss) return { error: 'ENTITY_NOT_FOUND' };
  const caissesData = getCaissesDetail(ss, targetEntity);
  if (caissesData.error) return caissesData;
  const porteurData = caissesData.porteurs.find(p => p.nom.toLowerCase().trim() === codeInfo.nom.toLowerCase().trim());
  return { success: true, porteur: codeInfo.nom, entity: targetEntity, solde: porteurData ? porteurData.solde : 0, spectacles: porteurData ? porteurData.spectacles : {}, historique: porteurData ? porteurData.historique : [], config: caissesData.config };
}

function getDiffuseurDevis(code) {
  if (!code) return { error: 'Code requis' };
  const mainSs   = SpreadsheetApp.getActiveSpreadsheet();
  const codeInfo = findCode(mainSs, code);
  if (!codeInfo) return { error: 'CODE_INVALIDE' };
  if (codeInfo.role !== 'diffuseur') return { error: 'ROLE_INVALIDE' };
  const compagnies = (codeInfo.compagnies || '').split(',').map(s => s.trim()).filter(Boolean);
  const year       = new Date().getFullYear();
  const allDevis   = [];
  compagnies.forEach(entityCode => {
    const ss = getSheetById(entityCode);
    if (!ss) return;
    try {
      const tabName = resolveTabName('DEVIS V', year, entityCode);
      if (!tabName) return;
      const data = getTab(ss, tabName);
      if (data.error) return;
      data.rows.forEach(row => {
        const diffNom = (row['DIFFUSEUR'] || '').toLowerCase();
        if (!diffNom.includes(codeInfo.nom.toLowerCase())) return;
        allDevis.push({ entity: entityCode, ref: row['REFERENCE'] || '', spectacle: row['SPECTACLE'] || '', dateDebut: row['DATE_DEBUT'] || '', dateFin: row['DATE_FIN'] || '', montantHT: parseFloat(row['MONTANT_HT'] || 0), statutContrat: row['STATUT_CONTRAT'] || 'En attente', pdfUrl: row['PDF_URL'] || '', lieu: row['LIEU'] || '' });
      });
    } catch(_) {}
  });
  return { success: true, diffuseur: codeInfo.nom, compagnies, devis: allDevis };
}

