var COTISATION_MONTANT_ANNUEL = 374.5;
var COTISATIONS_TAB = 'COTISATIONS_LOGICIEL';
var COTISATIONS_HEADERS = ['Structure', 'Mode', 'Montant annuel', 'Dernier paiement', 'Prochaine échéance', 'Commentaire'];

function ensureCotisationsTab(ss) {
