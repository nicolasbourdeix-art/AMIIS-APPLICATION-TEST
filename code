function verifierPrevuReel(ss, entity, year) {
  const tabDevis = resolveTabName('DEVIS V', year, entity);
  const prevu = {}, reel = {};
  if (tabDevis) {
    const devisData = getTab(ss, tabDevis);
    if (!devisData.error) {
      devisData.rows.forEach(row => {
        const spectacle = row['SPECTACLE'] || 'GENERAL';
        const salarie   = row['SALARIE'] || row['ARTISTE'] || 'Inconnu';
        const coutPrev  = (parseInt(row['NB_CACHETS'] || 0) * parseFloat(row['TARIF_CACHET'] || 0))
                        + (parseInt(row['NB_SR4'] || 0) * parseFloat(row['TARIF_SR4'] || 0));
        if (!prevu[spectacle]) prevu[spectacle] = {};
        prevu[spectacle][salarie] = (prevu[spectacle][salarie] || 0) + coutPrev;
      });
    }
  }
  const comptaData = getComptaRows(ss, entity, year, null);
  if (!comptaData.error) {
    comptaData.rows.forEach(r => {
      if (!r.COMPTE || !r.COMPTE.startsWith('64')) return;
      const spectacle = r.SPECTACLE || 'GENERAL';
      const m = (r.LIBELLE || '').match(/·\s*([^·]+?)\s*·/);
      const salarie = m ? m[1].trim() : 'Collectif';
      if (!reel[spectacle]) reel[spectacle] = {};
      reel[spectacle][salarie] = (reel[spectacle][salarie] || 0) + (parseFloat(r.DEBIT) || 0);
    });
  }
  const ecarts = [];
  new Set([...Object.keys(prevu), ...Object.keys(reel)]).forEach(spectacle => {
    const prevuSpec = prevu[spectacle] || {}, reelSpec = reel[spectacle] || {};
    new Set([...Object.keys(prevuSpec), ...Object.keys(reelSpec)]).forEach(salarie => {
      const montantPrevu = prevuSpec[salarie] || 0, montantReel = reelSpec[salarie] || 0;
      const ecart = montantReel - montantPrevu;
      const pct   = montantPrevu > 0 ? Math.abs(ecart / montantPrevu * 100) : (montantReel > 0 ? 100 : 0);
      if (Math.abs(ecart) > 2) ecarts.push({ spectacle, salarie, montantPrevu, montantReel, ecart, pct: Math.round(pct), niveau: pct > 15 ? 'DANGER' : 'ATTENTION' });
    });
  });
  return { success: true, year, entity, ecarts, nbEcarts: ecarts.length, hasDanger: ecarts.some(e => e.niveau === 'DANGER') };
}

