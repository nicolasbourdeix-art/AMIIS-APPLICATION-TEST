function getDashboardData(ss, entity, email, year) {
  const mois = String(new Date().getMonth() + 1).padStart(2, '0');
  const kpis = [], alertes = [];
  try {
    const decla = getTab(ss, resolveTabName('DECLA', year, entity));
    if (!decla.error) {
      const enAttente = decla.rows.filter(r => !r['STATUT'] || r['STATUT'] === 'En attente' || r['STATUT'] === '').length;
      kpis.push({ label: 'Declarations en attente', value: String(enAttente), sub: 'ce mois-ci', cls: enAttente > 0 ? 'kpi-orange' : 'kpi-green' });
    }
  } catch(_) { kpis.push({ label: 'Declarations', value: '—', sub: '', cls: 'kpi-grey' }); }

  // CLR : DPAE en attente de validation
  if (entity === 'CLR') {
    try {
      const dpaeClrSheet = ss.getSheetByName('DPAE_CLR');
      if (dpaeClrSheet) {
        ensureDpaeOkColumn(dpaeClrSheet);
        const rawClr = getTab(ss, 'DPAE_CLR');
        if (!rawClr.error) {
          const nbNonValides = rawClr.rows.filter(r => {
            const ok = r['DPAE_OK'];
            return ok !== true && ok !== 'TRUE' && ok !== 'OUI';
          }).length;
          if (nbNonValides > 0) {
            kpis.push({ label: 'DPAE à valider', value: String(nbNonValides), sub: 'dans DPAE_CLR', cls: 'kpi-red' });
            alertes.push({ niveau: 'DANGER', module: 'DPAE', msg: nbNonValides + ' DPAE en attente de validation (DPAE_CLR)', entity });
          }
        }
      }
    } catch(_) {}
  }

  try {
    const dsn = getDSNStatus(ss, year, mois);
    kpis.push({ label: 'DSN validee', value: dsn.valide ? 'OK' : 'Non', sub: dsn.valide ? ('le ' + dsn.value) : 'non envoyee', cls: dsn.valide ? 'kpi-green' : (dsn.alerte ? 'kpi-red' : 'kpi-orange') });
  } catch(_) {}

  try {
    const a = getAlertes(ss, entity, year, mois);
    a.forEach(al => alertes.push({ level: al.niveau === 'DANGER' ? 'danger' : 'warning', text: al.msg, entity: al.entity || entity, module: (al.module || '').toLowerCase() }));
  } catch(_) {}

  const cfg = getConfigMap(ss);
  const modulesActifs = (cfg['MODULES_ACTIFS'] || 'DASHBOARD,DECLAS,DPAE,NDF,DEVIS,FACTURATION,BALANCE,SALARIES,COMPTA,CAISSES').split(',').map(s => s.trim().toLowerCase());
  const ALL_MODS = [
    { id: 'declarations', label: 'Declarations', icon: '📋', num: '02' },
    { id: 'dpae',         label: 'DPAE',         icon: '🔔', num: '03' },
    { id: 'ndf',          label: 'Notes de frais',icon: '🧾', num: '04' },
    { id: 'devis',        label: 'Devis',         icon: '📊', num: '05' },
    { id: 'facturation',  label: 'Facturation',   icon: '💰', num: '06' },
    { id: 'balance',      label: 'Balance',       icon: '⚖️', num: '07' },
    { id: 'salaries',     label: 'Salaries',      icon: '👥', num: '08' },
    { id: 'comptabilite', label: 'Comptabilite',  icon: '📚', num: '09' },
    { id: 'caisses',      label: 'Caisses perso', icon: '💼', num: '10' },
  ];
  const modulesFiltres = ALL_MODS.filter(m => modulesActifs.some(a => m.id.includes(a) || a.includes(m.id.substring(0,4))));

  const result = { entity, year, email, kpis, alerts: alertes, modules: modulesFiltres.length > 0 ? modulesFiltres : ALL_MODS };

  // ── Synthèse AMIIS : compteurs gestionnaires, DPAE manquantes, clients à facturer, finances Paie/Prod ──
  if (entity === 'AMIIS') {
    try {
      result.amiisSynthese = getSyntheseAmiis(ss, entity, year);
    } catch(e) {
      Logger.log('getSyntheseAmiis erreur: ' + e.message);
    }
    try {
      result.cotisationsLogiciel = getCotisationsLogiciel(ss);
    } catch(e) {
      Logger.log('getCotisationsLogiciel erreur: ' + e.message);
    }
  }

  return result;
}

function getSyntheseAmiis(ss, entity, year) {
  var pp = getPaieProduction(ss, entity, year);
  if (pp.error) return { error: pp.error };

  var presta = pp.presta || [];
  var prod   = pp.prod   || [];
  var groupeForfaits = pp.groupeForfaits || {};
  var groupeDetailParGestionnaire = pp.groupeDetailParGestionnaire || {};

  // 1) Compteur gestionnaires unifié (paie 5FDP=1h + comptes groupe forfait 3h/production)
  var compteur = {};
  var detailPaieParGestionnaire = {};
  presta.forEach(function(r) {
    var qui = r.qui || 'Non assigné';
    if (!compteur[qui]) compteur[qui] = { nbFDP: 0, totalPaie: 0, nbProdGroupe: 0, heuresProdGroupe: 0 };
    compteur[qui].nbFDP     += 1;
    compteur[qui].totalPaie += (r.tarif || 12);
    if (!detailPaieParGestionnaire[qui]) detailPaieParGestionnaire[qui] = [];
    detailPaieParGestionnaire[qui].push({ salarie: r.salarie, projet: r.projet, structure: r.structure, debut: r.debut });
  });
  Object.keys(groupeForfaits).forEach(function(g) {
    if (!compteur[g]) compteur[g] = { nbFDP: 0, totalPaie: 0, nbProdGroupe: 0, heuresProdGroupe: 0 };
    compteur[g].nbProdGroupe     = groupeForfaits[g].nb;
    compteur[g].heuresProdGroupe = groupeForfaits[g].heures;
  });
  Object.keys(compteur).forEach(function(g) {
    var c = compteur[g];
    c.amiisPaie   = Math.round(c.totalPaie * 0.5 * 100) / 100;
    c.heuresPaie  = Math.round((c.nbFDP / 5) * 100) / 100;
    c.heuresTotal = Math.round((c.heuresPaie + c.heuresProdGroupe) * 100) / 100;
  });

  // 2) Paies (prestations) dont la DPAE n'a pas été réalisée
  var dpaeManquantes = presta.filter(function(r) { return !r.dpae; }).map(function(r) {
    return { salarie: r.salarie, projet: r.projet, structure: r.structure, debut: r.debut, qui: r.qui };
  });

  // 3) Clients (structures) restant à facturer côté Paie
  var parStructure = {};
  presta.forEach(function(r) {
    var s = r.structure || 'Inconnue';
    if (!parStructure[s]) parStructure[s] = { total: 0, aFacturer: 0, montantDu: 0 };
    parStructure[s].total += 1;
    if (!r.facture) {
      parStructure[s].aFacturer += 1;
      parStructure[s].montantDu += (r.tarif || 12);
    }
  });
  // Entités facturées à la FDP mais dont les fiches vivent dans leur propre Sheet (MAN, PALM)
  ENTITES_FACTURATION_FDP.forEach(function(ent) {
    try {
      var entSs = getSheetById(ent);
      if (!entSs) return;
      var fact = getFacturationEntite(entSs, ent, year);
      if (!fact || !fact.success) return;
      if (!parStructure[ent]) parStructure[ent] = { total: 0, aFacturer: 0, montantDu: 0 };
      parStructure[ent].total     += fact.totaux.nb;
      parStructure[ent].aFacturer += fact.totaux.nbAFacturer;
      parStructure[ent].montantDu += fact.totaux.montantDu;
    } catch(e) {
      Logger.log('clientsAFacturer ' + ent + ': ' + e.message);
    }
  });
  var clientsAFacturer = Object.keys(parStructure)
    .map(function(s) { return Object.assign({ structure: s }, parStructure[s]); })
    .filter(function(s) { return s.aFacturer > 0; });

  // 4) Synthèse financière AMIIS : Paie (part 50%) + Comptes groupe (production réelle, ex KELTAS)
  var totalPaie = presta.reduce(function(s, r) { return s + (r.tarif || 12); }, 0);
  var amiisPaie = Math.round(totalPaie * 0.5 * 100) / 100;

  var compteGroupe = { nbProjets: 0, nbProductions: 0, totalVente: 0, partAmiisTotal: 0, coutCompteurTotal: 0, margeNette: 0 };
  Object.keys(getTousComptesGroupe()).forEach(function(key) {
    try {
      var cg = lireCompteGroupe(key);
      if (cg && cg.success) {
        compteGroupe.nbProjets      += 1;
        compteGroupe.nbProductions  += (cg.rows || []).length;
        compteGroupe.totalVente     += (cg.rows || []).reduce(function(s, r) { return s + (r.tariVente || 0); }, 0);
        compteGroupe.partAmiisTotal += (cg.totaux && cg.totaux.partAmiis) || 0;
        compteGroupe.coutCompteurTotal += (cg.totaux && cg.totaux.coutCompteur) || 0;
      }
    } catch(e) { Logger.log('getSyntheseAmiis compteGroupe ' + key + ': ' + e.message); }
  });
  compteGroupe.totalVente        = Math.round(compteGroupe.totalVente * 100) / 100;
  compteGroupe.partAmiisTotal    = Math.round(compteGroupe.partAmiisTotal * 100) / 100;
  compteGroupe.coutCompteurTotal = Math.round(compteGroupe.coutCompteurTotal * 100) / 100;
  compteGroupe.margeNette        = Math.round((compteGroupe.partAmiisTotal - compteGroupe.coutCompteurTotal) * 100) / 100;

  var totalAmiis = Math.round((amiisPaie + compteGroupe.margeNette) * 100) / 100;

  return {
    compteurGestionnaires: compteur,
    detailPaieParGestionnaire: detailPaieParGestionnaire,
    detailProdParGestionnaire: groupeDetailParGestionnaire,
    dpaeManquantes: dpaeManquantes,
    clientsAFacturer: clientsAFacturer,
    finances: {
      nbPaie: presta.length, totalPaie: Math.round(totalPaie * 100) / 100, amiisPaie: amiisPaie,
      nbProdContrats: prod.length, // contrats salariés Prod AMIIS (info, sans valeur financière propre)
      compteGroupe: compteGroupe,
      totalAmiis: totalAmiis,
    },
  };
}

