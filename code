function getRoleForEmail(email) {
  if (!email) return null;
  const e = email.toLowerCase().trim();
  if (ROLES[e]) return ROLES[e];
  try {
    const ss  = SpreadsheetApp.getActiveSpreadsheet();
    const cfg = getConfigMap(ss);
    const admins = (cfg['ADMIN_EMAILS'] || '').split(',').map(s => s.trim().toLowerCase());
    const gests  = (cfg['GESTIONNAIRE_EMAILS'] || '').split(',').map(s => s.trim().toLowerCase());
    if (admins.includes(e)) return 'ADMIN';
    if (gests.includes(e))  return 'GESTIONNAIRE';
  } catch (_) {}
  return null;
}

function checkAuth(email, entity) {
  if (!email) return false;
  const role = getRoleForEmail(email);
  if (!role) return false;
  if (!entity) return true;
  return (ROLE_PERIMETER[role] || []).includes(entity);
}

function getSheetById(entity) {
  let id = ENTITY_SHEET_IDS[entity];
  if (!id || id.startsWith('TODO_')) {
    try {
      const cfg = getConfigMap(SpreadsheetApp.getActiveSpreadsheet());
      const savedId = cfg['SHEET_ID_' + entity];
      if (savedId && savedId.trim()) id = savedId.trim();
    } catch(_) {}
  }
  if (!id || id.startsWith('TODO_')) return null;
  if (id === SpreadsheetApp.getActiveSpreadsheet().getId()) return SpreadsheetApp.getActiveSpreadsheet();
  try { return SpreadsheetApp.openById(id); } catch(_) { return null; }
}

