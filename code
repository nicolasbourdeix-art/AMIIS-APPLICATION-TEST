  sheet = ss.insertSheet(COTISATIONS_TAB);
  sheet.getRange(1, 1, 1, COTISATIONS_HEADERS.length).setValues([COTISATIONS_HEADERS])
    .setFontWeight('bold').setBackground('#555555').setFontColor('#ffffff');
  sheet.setFrozenRows(1);

  // Pré-remplissage initial d'après les infos données le 14/08/2026 — à vérifier/ajuster manuellement.
  var seed = [
    ['Les Ruminantes (CLR)',      'Forfait annuel', COTISATION_MONTANT_ANNUEL, new Date('2026-01-01'), new Date('2027-01-01'), 'Payé en janvier pour 12 mois'],
    ['Oiseau Manivelle (OM)',     'Forfait annuel', COTISATION_MONTANT_ANNUEL, new Date('2026-01-01'), new Date('2027-01-01'), 'Payé en janvier pour 12 mois'],
    ['Disorders (DIS)',           'Forfait annuel', COTISATION_MONTANT_ANNUEL, new Date('2025-08-01'), new Date('2026-08-01'), 'Renouvellement dû en août pour 12 mois supplémentaires'],
    ['La Palmera (PALM)',         'Forfait annuel', COTISATION_MONTANT_ANNUEL, new Date('2025-12-01'), new Date('2026-12-01'), 'Paiement à terme échu — toujours un an de retard'],
    ['Manœuvres (MAN)',           'Fiche de paie',  '',                        '',                     '',                     'Facturé à la fiche de paie, comme la gestion de paie AMIIS'],
  ];
  sheet.getRange(2, 1, seed.length, COTISATIONS_HEADERS.length).setValues(seed);
  sheet.setColumnWidth(1, 200); sheet.setColumnWidth(2, 120); sheet.setColumnWidth(6, 320);
  return sheet;
}

function getCotisationsLogiciel(ss) {
  try {
    var sheet = ensureCotisationsTab(ss);
    var data  = sheet.getDataRange().getValues();
    var rows  = [];
    var today = new Date();

    for (var i = 1; i < data.length; i++) {
      var row = data[i];
      if (!row[0]) continue;

      var mode = (row[1] || '').toString().trim();
      var dernierPaiement = row[3] instanceof Date ? Utilities.formatDate(row[3], 'Europe/Paris', 'dd/MM/yyyy') : (row[3] || '').toString();
      var prochaineEcheance = row[4] instanceof Date ? row[4] : null;
      var prochaineEcheanceStr = prochaineEcheance ? Utilities.formatDate(prochaineEcheance, 'Europe/Paris', 'dd/MM/yyyy') : (row[4] || '').toString();

      var statut = 'À jour', joursRestants = null;
      if (mode === 'Fiche de paie') {
        statut = 'Facturé à la FDP';
      } else if (prochaineEcheance) {
        joursRestants = Math.round((prochaineEcheance - today) / 86400000);
        if (joursRestants < 0) statut = 'En retard';
        else if (joursRestants <= 30) statut = 'À renouveler bientôt';
        else statut = 'À jour';
      } else {
        statut = 'À préciser';
      }

      rows.push({
        _rowIndex: i + 1,
        structure: (row[0] || '').toString().trim(),
        mode: mode,
        montantAnnuel: row[2] === '' || row[2] === undefined ? null : (parseFloat(row[2]) || 0),
        dernierPaiement: dernierPaiement,
        prochaineEcheance: prochaineEcheanceStr,
        joursRestants: joursRestants,
        commentaire: (row[5] || '').toString().trim(),
        statut: statut,
      });
    }

    var totalAnnuelForfait = rows.filter(function(r) { return r.mode === 'Forfait annuel'; })
      .reduce(function(s, r) { return s + (r.montantAnnuel || 0); }, 0);
    var nbEnRetard = rows.filter(function(r) { return r.statut === 'En retard'; }).length;
    var nbARenouveler = rows.filter(function(r) { return r.statut === 'À renouveler bientôt'; }).length;

    return {
      success: true, rows: rows,
      totaux: { totalAnnuelForfait: Math.round(totalAnnuelForfait * 100) / 100, nbEnRetard: nbEnRetard, nbARenouveler: nbARenouveler },
    };
  } catch(e) {
    return { error: 'Lecture cotisations: ' + e.message };
  }
}

function updateCotisationLogiciel(ss, rowIndex, champ, valeur) {
  var ri = parseInt(rowIndex, 10);
  if (!ri || ri < 2) return { error: 'rowIndex invalide' };

  var colMap = { dernierPaiement: 4, prochaineEcheance: 5, montantAnnuel: 3, commentaire: 6, mode: 2 };
  var col = colMap[champ];
  if (!col) return { error: 'Champ inconnu: ' + champ };

  try {
    var sheet = ensureCotisationsTab(ss);
    var val = valeur;
    if (champ === 'dernierPaiement' || champ === 'prochaineEcheance') {
      var parts = (valeur || '').split('/');
      val = parts.length === 3 ? new Date(parts[2] + '-' + parts[1] + '-' + parts[0]) : '';
    } else if (champ === 'montantAnnuel') {
      val = valeur === '' ? '' : (parseFloat(valeur) || 0);
    }
    sheet.getRange(ri, col).setValue(val);
    return { success: true };
  } catch(e) {
    return { error: 'Ecriture cotisation: ' + e.message };
  }
}

function ajouterCotisationLogiciel(ss, structure, mode, montant, dernierPaiement, prochaineEcheance, commentaire) {
  structure = (structure || '').toString().trim();
  if (!structure) return { error: 'Nom de structure requis' };
  mode = (mode || 'Forfait annuel').toString().trim();

  try {
    var sheet = ensureCotisationsTab(ss);
    function toDate(str) {
      var parts = (str || '').split('/');
      return parts.length === 3 ? new Date(parts[2] + '-' + parts[1] + '-' + parts[0]) : '';
    }
    var row = [
      structure,
      mode,
      mode === 'Fiche de paie' ? '' : (parseFloat(montant) || COTISATION_MONTANT_ANNUEL),
      mode === 'Fiche de paie' ? '' : toDate(dernierPaiement),
      mode === 'Fiche de paie' ? '' : toDate(prochaineEcheance),
      commentaire || '',
    ];
    sheet.appendRow(row);
    return { success: true };
  } catch(e) {
    return { error: 'Ajout structure: ' + e.message };
  }
}

function supprimerCotisationLogiciel(ss, rowIndex) {
  var ri = parseInt(rowIndex, 10);
  if (!ri || ri < 2) return { error: 'rowIndex invalide' };
  try {
    var sheet = ensureCotisationsTab(ss);
    sheet.deleteRow(ri);
    return { success: true };
  } catch(e) {
    return { error: 'Suppression structure: ' + e.message };
  }
}

function getAlertes(ss, entity, year, mois) {
  const alertes = [], today = new Date();
  try {
    const ndfTabName = resolveTabName('NOTE DE FRAIS V', year, entity);
    if (ndfTabName) {
      const ndfData = getTab(ss, ndfTabName);
      if (!ndfData.error) {
        ndfData.rows.forEach(row => {
          if (row['STATUT'] === 'Non traitee' && row['DATE']) {
            const age = (today - new Date(row['DATE'])) / 86400000;
            if (age > 7) alertes.push({ niveau: 'ATTENTION', module: 'NDF', msg: 'NDF non traitee > 7j : ' + (row['SALARIE'] || ''), entity });
          }
        });
      }
    }
  } catch (_) {}
  try { const dsnStatus = getDSNStatus(ss, year, mois); if (dsnStatus.alerte) alertes.push({ niveau: 'ATTENTION', module: 'DSN', msg: 'DSN non validee apres le 5 du mois', entity }); } catch (_) {}
  try {
    const cfg = getConfigMap(ss);
    if (cfg['LICENCE_EXPIRATION']) {
      const exp = new Date(cfg['LICENCE_EXPIRATION']);
      const j   = (exp - today) / 86400000;
      if (j < 60 && j > 0) alertes.push({ niveau: 'ATTENTION', module: 'CONFIG', msg: 'Licence expirante dans ' + Math.round(j) + 'j', entity });
    }
  } catch (_) {}
  return alertes;
}

