    if (lastRow >= 2) {
      var col = sheet.getRange(2, 1, lastRow - 1, 1).getValues();
      for (var i = 0; i < col.length; i++) {
        if ((col[i][0] || '').toString().trim() === exercice) { ligneExistante = i + 2; break; }
