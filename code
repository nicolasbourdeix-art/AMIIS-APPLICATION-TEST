// Trouve l'index 1-based de la colonne portant EXACTEMENT ce nom d'en-tête (avec ou sans espace final)
function findColByHeaderExact(headers, nom) {
  for (var i = 0; i < headers.length; i++) {
    var h = (headers[i] || '').toString();
    if (h === nom || h.trim() === nom.trim()) return i + 1;
  }
  return -1;
}

function ensureSourceCol(sheet) {
  var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  var idx = findColByHeaderExact(headers, 'SOURCE');
  if (idx > 0) return idx;
  var newCol = sheet.getLastColumn() + 1;
  var cell = sheet.getRange(1, newCol);
  cell.setValue('SOURCE');
  cell.setFontWeight('bold');
  cell.setBackground('#8E44AD');
  cell.setFontColor('#ffffff');
  return newCol;
}

