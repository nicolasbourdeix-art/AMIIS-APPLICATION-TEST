function saisirPieceCompta(ss, entity, payload, email) {
  const ligne = {
    DATE: payload.date || new Date().toISOString().split('T')[0],
    ANNEE: payload.annee || new Date().getFullYear(),
    COMPTE: (payload.compte || '').toString().trim(),
    LIBELLE: (payload.libelle || '').trim(),
    DEBIT:  payload.debit  ? parseFloat(payload.debit)  : '',
    CREDIT: payload.credit ? parseFloat(payload.credit) : '',
    SPECTACLE: (payload.spectacle || 'GENERAL').trim(),
    SALARIE: (payload.salarie || '').toString().trim(),
    MOYEN: (payload.moyen || '').toString().trim(),
    NUM_FACTURE: (payload.numFacture || '').toString().trim(),
    SOURCE: 'MANUEL', SAISI_PAR: email, STATUT_VERIF: 'EN_COURS', COMMENTAIRE: '',
  };
  const comptaExist = getComptaRows(ss, entity, null, null);
  const doublons = (comptaExist.rows || []).filter(r =>
    r['COMPTE'] === ligne.COMPTE &&
    Math.abs(parseFloat(r['DEBIT'] || r['CREDIT'] || 0) - parseFloat(ligne.DEBIT || ligne.CREDIT || 0)) <= 2 &&
    r['DATE'] === ligne.DATE
  );
  // Saisie manuelle : l'utilisateur a déjà choisi compte/montant/date en connaissance
  // de cause, contrairement à un import CSV où l'IA doit interpréter un libellé
  // bancaire ambigu. Seule la détection de doublon (locale, sans appel API) a
  // vraiment de la valeur ici.
  ligne.STATUT_VERIF = doublons.length > 0 ? 'ORANGE' : 'VERT';
  ligne.COMMENTAIRE  = doublons.length > 0 ? 'Doublon potentiel : une ligne avec le meme compte, montant et date existe deja' : '';
  ensureComptaTab(ss);
  const result = insertComptaLigne(ss, ligne);
  return { success: true, statut: ligne.STATUT_VERIF, message: ligne.COMMENTAIRE, rowInserted: result.insertedRow };
}

function verifierReleve(ss, entity, payload, email) {
  if (!payload.piecesCompta || payload.piecesCompta.length === 0) return { error: 'Aucune piece a verifier' };
  const verif = callClaudeReleveVerif({ piecesCompta: payload.piecesCompta, pdfBase64: payload.pdfBase64 || null, annee: payload.annee, mois: payload.mois, entity });
  return { success: true, resultats: verif.resultats || [], resume: verif.resumé || '', nbVert: verif.nbVert || 0, nbOrange: verif.nbOrange || 0, nbRouge: verif.nbRouge || 0 };
}

function validerPieceCompta(ss, rowIndex, corrections) {
  ensureComptaTab(ss);
  const sheet   = ss.getSheetByName('COMPTA');
  const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  if (corrections) {
    Object.entries(corrections).forEach(([colName, value]) => {
      const colIndex = headers.indexOf(colName);
      if (colIndex !== -1) sheet.getRange(rowIndex, colIndex + 1).setValue(value);
    });
  }
  const statutCol = headers.indexOf('STATUT_VERIF');
  if (statutCol !== -1) sheet.getRange(rowIndex, statutCol + 1).setValue('VERT');
  return { success: true, rowIndex };
}

function editerLigneCompta(ss, rowIndex, corrections) {
  const sheet = ss.getSheetByName('COMPTA');
  if (!sheet) return { error: 'Onglet COMPTA introuvable' };
  try {
    const lastCol   = sheet.getLastColumn();
    // Détection de la ligne d'en-tête (1, 2 ou 3) — même logique que getComptaRows,
    // car selon les feuilles les en-têtes ne sont pas toujours en ligne 2. On
    // prend la première ligne comportant au moins 3 libellés texte.
    const lastRowHdr = sheet.getLastRow();
    let headerRow = null;
    for (let hi = 1; hi <= Math.min(3, lastRowHdr); hi++) {
      const candidate = sheet.getRange(hi, 1, 1, lastCol).getValues()[0];
      const textCount = candidate.filter(function(v) {
        return v && typeof v === 'string' && v.trim().length > 2 && v !== '#REF!';
      }).length;
      if (textCount >= 3) { headerRow = candidate; break; }
    }
    if (!headerRow) headerRow = sheet.getRange(2, 1, 1, lastCol).getValues()[0];
    // Recherche de colonne insensible à la casse et aux espaces superflus, pour
    // tolérer les variantes ("Année exercice" / "année exercice ", etc.).
    function trouverColonne(nom) {
      const cible = nom.toString().trim().toLowerCase();
      return headerRow.findIndex(h => h && h.toString().trim().toLowerCase() === cible);
    }

    // Garde-fou : la colonne "Opération compta" a une validation stricte (liste
    // déroulante en mode rejet, voir getListeValidationOperationCompta) — y
    // écrire une valeur absente de cette liste fait échouer tout
    // Range.setValue(), ce qui peut remonter côté client comme une erreur peu
    // claire (page d'erreur au lieu du JSON attendu). Même filet de sécurité que
    // pour l'import de relevé : on tente de caler sur la valeur valide la plus
    // proche, et à défaut on n'écrit rien dans cette colonne plutôt que de
    // risquer de faire échouer TOUTE la sauvegarde (y compris les autres champs
    // de la ligne, comme la date ou le montant).
    if (corrections['Opération compta']) {
      var listeValidation = getListeValidationOperationCompta(ss);
      if (listeValidation) {
        var valOp = corrections['Opération compta'].toString().trim();
        var estValide = !!listeValidation.set[valOp.toLowerCase()];
        if (!estValide) {
          var calee = trouverMeilleureCorrespondance(valOp, listeValidation.list);
          if (calee) {
            corrections['Opération compta'] = calee;
          } else {
            delete corrections['Opération compta'];
          }
        }
      }
    }

    Object.entries(corrections).forEach(([colName, value]) => {
      if (value === undefined || value === null) return;
      const colIndex = trouverColonne(colName);
      if (colIndex === -1) return;
      if (colName === 'Dates' && value && /^\d{4}-\d{2}-\d{2}$/.test(value)) {
        sheet.getRange(rowIndex, colIndex + 1).setValue(new Date(value));
      } else {
        sheet.getRange(rowIndex, colIndex + 1).setValue(value);
      }
    });
    return { success: true, rowIndex, message: 'Ligne mise a jour' };
  } catch(err) {
    return { error: true, message: err.message };
  }
}

// Remplace le bloc de ventilation EMPLOYEUR (répartition du coût employeur par
// salarié/projet) rattaché à une écriture 421 existante — permet de créer une
// ventilation manuelle sur une ligne qui n'en a pas, ou de corriger le projet /
// le coût employeur d'une ventilation déjà générée automatiquement (ex: FDP non
// retrouvée dans le Drive au moment de l'import).
// ventilations: [{ salarie, spectacle, coutEmp, fdp, fdpUrl }, ...]
function sauvegarderVentilationLigne(ss, rowIndex, ventilations) {
  const sheet = ss.getSheetByName('COMPTA');
  if (!sheet) return { error: 'Onglet COMPTA introuvable' };
  try {
    const lastCol = sheet.getLastColumn();
    const lastRowHdr = sheet.getLastRow();
    let headerRow = null;
    for (let hi = 1; hi <= Math.min(3, lastRowHdr); hi++) {
      const candidate = sheet.getRange(hi, 1, 1, lastCol).getValues()[0];
      const textCount = candidate.filter(function(v) {
        return v && typeof v === 'string' && v.trim().length > 2 && v !== '#REF!';
      }).length;
      if (textCount >= 3) { headerRow = candidate; break; }
    }
    if (!headerRow) headerRow = sheet.getRange(2, 1, 1, lastCol).getValues()[0];
    function trouverColonne() {
      var candidats = Array.prototype.slice.call(arguments);
      for (var a = 0; a < candidats.length; a++) {
        var cible = normaliserTexteCompta(candidats[a]);
        var i = headerRow.findIndex(function(h) { return h && normaliserTexteCompta(h) === cible; });
        if (i >= 0) return i;
      }
      return -1;
    }
    const iAnnee = trouverColonne('Année exercice');
    const iCpt   = trouverColonne('Numéro comptable');
    const iDate  = trouverColonne('Dates');
    const iOp    = trouverColonne("N° d'opération");
    const iSal   = trouverColonne('Salarié');
    const iSpec  = trouverColonne('Spectacle');
    const iEmp   = trouverColonne('Brut Cout employeur', 'EMPLOYEUR', 'EMPLOYEUR ');
    const iLien  = trouverColonne('LIEN DRIVE');
    if (iSal < 0 && iEmp < 0) return { error: 'Colonnes Salarié/Coût employeur introuvables' };

    const anneeLigne = iAnnee >= 0 ? sheet.getRange(rowIndex, iAnnee + 1).getValue() : '';

    // Repère le bloc de ventilation déjà rattaché à cette ligne : les lignes
    // juste en dessous, tant qu'elles n'ont ni compte, ni date, ni n° d'opération
    // (même critère que getComptaRows pour les identifier à la lecture).
    const lastRow = sheet.getLastRow();
    let finBloc = rowIndex; // dernière ligne du bloc existant (exclusif : finBloc+1 = 1re ligne libre)
    for (let r = rowIndex + 1; r <= lastRow; r++) {
      const compteR = iCpt  >= 0 ? (sheet.getRange(r, iCpt  + 1).getValue() || '').toString().trim() : '';
      const dateR   = iDate >= 0 ? sheet.getRange(r, iDate + 1).getValue() : '';
      const opR     = iOp   >= 0 ? (sheet.getRange(r, iOp   + 1).getValue() || '').toString().trim() : '';
      if (compteR || dateR || opR) break;
      finBloc = r;
    }
    const nbLignesExistantes = finBloc - rowIndex;
    if (nbLignesExistantes > 0) sheet.deleteRows(rowIndex + 1, nbLignesExistantes);

    const ventilationsUtiles = (ventilations || []).filter(function(v) { return v && (v.salarie || (parseFloat(v.coutEmp) || 0) > 0); });
    let posInsertion = rowIndex + 1;
    ventilationsUtiles.forEach(function(v) {
      const ventRow = new Array(lastCol).fill('');
      if (iAnnee >= 0) ventRow[iAnnee] = anneeLigne;
      if (iSal   >= 0) ventRow[iSal]   = v.salarie   || '';
      if (iSpec  >= 0) ventRow[iSpec]  = v.spectacle || '';
      if (iEmp   >= 0) ventRow[iEmp]   = parseFloat(v.coutEmp) || 0;
      assurerLignesSuffisantes(sheet, posInsertion);
      sheet.insertRowBefore(posInsertion);
      nettoyerValidationLigne(sheet, posInsertion, lastCol);
      sheet.getRange(posInsertion, 1, 1, ventRow.length).setValues([ventRow]);
      if (iLien >= 0 && v.fdp) {
        const libelleLien = v.fdp.toString().replace(/"/g, "'");
        if (v.fdpUrl) {
          try { sheet.getRange(posInsertion, iLien + 1).setFormula('=HYPERLINK("' + v.fdpUrl + '";"' + libelleLien + '")'); }
          catch(e) { sheet.getRange(posInsertion, iLien + 1).setValue(v.fdp); }
        } else {
          sheet.getRange(posInsertion, iLien + 1).setValue(v.fdp);
        }
      }
      posInsertion++;
    });

    return { success: true, rowIndex, nbVentilations: ventilationsUtiles.length };
  } catch(err) {
    return { error: true, message: err.message };
  }
}

// Répartit le montant (Débit ou Crédit) d'une écriture COMPTA existante sur
// plusieurs projets/spectacles, sous forme de plusieurs écritures distinctes
// (même date/compte/libellé, chacune avec son propre N° d'opération) plutôt
// qu'une seule ligne — nécessaire pour que le montant remonte correctement
// dans le rapport de CHAQUE projet concerné (ex: un virement de prestation
// couvrant deux spectacles différents).
// repartitions: [{ montant, spectacle }, ...] — la 1re répartition remplace la
// ligne existante (même N° d'opération), les suivantes sont insérées juste après.
function repartirLigneComptaSurProjets(ss, rowIndex, repartitions) {
  const sheet = ss.getSheetByName('COMPTA');
  if (!sheet) return { error: 'Onglet COMPTA introuvable' };
  try {
    const lastCol = sheet.getLastColumn();
    const lastRowHdr = sheet.getLastRow();
    let headerRow = null;
    for (let hi = 1; hi <= Math.min(3, lastRowHdr); hi++) {
      const candidate = sheet.getRange(hi, 1, 1, lastCol).getValues()[0];
      const textCount = candidate.filter(function(v) {
        return v && typeof v === 'string' && v.trim().length > 2 && v !== '#REF!';
      }).length;
      if (textCount >= 3) { headerRow = candidate; break; }
    }
    if (!headerRow) headerRow = sheet.getRange(2, 1, 1, lastCol).getValues()[0];
    function trouverColonne() {
      var candidats = Array.prototype.slice.call(arguments);
      for (var a = 0; a < candidats.length; a++) {
        var cible = normaliserTexteCompta(candidats[a]);
        var i = headerRow.findIndex(function(h) { return h && normaliserTexteCompta(h) === cible; });
        if (i >= 0) return i;
      }
      return -1;
    }
    const iAnnee  = trouverColonne('Année exercice');
    const iOp     = trouverColonne("N° d'opération");
    const iSpec   = trouverColonne('Spectacle');
    const iCpt    = trouverColonne('Numéro comptable');
    const iDate   = trouverColonne('Dates');
    const iCredit = trouverColonne('Produits (Entrées)', 'CREDIT', 'CREDIT ');
    const iDebit  = trouverColonne('Charges (Sorties)', 'DEBIT', 'DEBIT ');
    const iLien   = trouverColonne('LIEN DRIVE');

    const splits = (repartitions || []).map(function(r) {
      return { montant: Math.abs(parseFloat(r.montant) || 0), spectacle: (r.spectacle || '').toString().trim() };
    }).filter(function(r) { return r.montant > 0; });
    if (splits.length < 2) return { error: 'Au moins deux répartitions avec un montant sont nécessaires' };

    const rowValues = sheet.getRange(rowIndex, 1, 1, lastCol).getValues()[0];
    const estCredit = iCredit >= 0 && parseFloat(rowValues[iCredit]) > 0;
    const colMontant = estCredit ? iCredit : iDebit;
    if (colMontant < 0) return { error: 'Colonne Débit/Crédit introuvable' };

    // Formule LIEN DRIVE existante (pièce justificative) : les répartitions
    // décrivent la même opération bancaire, donc la même pièce s'y rapporte —
    // on la recopie telle quelle sur chaque nouvelle écriture.
    var formuleLien = '';
    if (iLien >= 0) {
      try { formuleLien = sheet.getRange(rowIndex, iLien + 1).getFormula(); } catch(e) {}
    }

    const anneeLigne = (iAnnee >= 0 ? rowValues[iAnnee] : '').toString().trim();

    // Numérotation "N° d'opération" des écritures ajoutées : continue la série
    // de l'exercice de la ligne d'origine, même logique que appendLignesCompta.
    var maxOp = 0;
    if (iOp >= 0 && iAnnee >= 0) {
      var nbLignes = Math.max(1, sheet.getLastRow() - 2);
      var opsData = sheet.getRange(3, 1, nbLignes, lastCol).getValues();
      opsData.forEach(function(r) {
        var n = parseInt(r[iOp]);
        if (isNaN(n)) return;
        if ((r[iAnnee] || '').toString().trim() === anneeLigne && n > maxOp) maxOp = n;
      });
    }

    // 1) La ligne existante devient la 1re répartition (même N° d'opération,
    //    seuls le projet et le montant changent).
    if (iSpec >= 0) sheet.getRange(rowIndex, iSpec + 1).setValue(splits[0].spectacle);
    sheet.getRange(rowIndex, colMontant + 1).setValue(splits[0].montant);

    // 2) Repère la fin du bloc déjà rattaché à cette ligne (ex: ventilation
    //    salariale sous une écriture 421) pour ne jamais insérer au milieu —
    //    même critère que sauvegarderVentilationLigne / getComptaRows.
    const lastRow = sheet.getLastRow();
    let finBloc = rowIndex;
    for (let r = rowIndex + 1; r <= lastRow; r++) {
      const compteR = iCpt  >= 0 ? (sheet.getRange(r, iCpt  + 1).getValue() || '').toString().trim() : '';
      const dateR   = iDate >= 0 ? sheet.getRange(r, iDate + 1).getValue() : '';
      const opR     = iOp   >= 0 ? (sheet.getRange(r, iOp   + 1).getValue() || '').toString().trim() : '';
      if (compteR || dateR || opR) break;
      finBloc = r;
    }

    // 3) Insère une nouvelle écriture pour chaque répartition supplémentaire,
    //    juste après le bloc existant — même date/compte/libellé/moyen de
    //    paiement que l'écriture d'origine (copiés depuis rowValues), avec son
    //    propre N° d'opération.
    var posInsertion = finBloc + 1;
    for (var s = 1; s < splits.length; s++) {
      maxOp++;
      var newRow = rowValues.slice();
      if (iOp   >= 0) newRow[iOp]   = maxOp;
      if (iSpec >= 0) newRow[iSpec] = splits[s].spectacle;
      newRow[colMontant] = splits[s].montant;
      if (iLien >= 0) newRow[iLien] = ''; // le lien est reposé via setFormula juste après
      assurerLignesSuffisantes(sheet, posInsertion);
      sheet.insertRowBefore(posInsertion);
      nettoyerValidationLigne(sheet, posInsertion, lastCol);
      sheet.getRange(posInsertion, 1, 1, newRow.length).setValues([newRow]);
      if (iLien >= 0 && formuleLien) {
        try { sheet.getRange(posInsertion, iLien + 1).setFormula(formuleLien); } catch(e) {}
      }
      posInsertion++;
      finBloc++;
    }

    return { success: true, rowIndex, nbEcritures: splits.length };
  } catch(err) {
    return { error: true, message: err.message };
  }
}

// Les feuilles COMPTA existantes (créées à la main avant l'appli) ont des
// en-têtes en français ("Dates", "Numéro comptable", "Descriptions/
// Libelles"...), pas les noms génériques utilisés par le reste de cette
// fonction (DATE, COMPTE, LIBELLE...) — ceux-ci ne correspondent qu'au
// schéma que créerait ensureComptaTab pour un onglet TOUT NEUF, jamais
// utilisé en pratique. Sans ce mapping, headers.map(h => ligne[h]) ne
// trouvait aucune correspondance et insérait une ligne quasi vide. On
// reprend ici les mêmes noms de colonnes (et variantes) que getComptaRows,
// qui lit ces feuilles de façon fiable depuis longtemps.
var INSERT_COMPTA_COLONNES = {
  NUM_OP:      ["N° d'opération"],
  DATE:        ['Dates'],
  ANNEE:       ['Année exercice', 'année exercice'],
  COMPTE:      ['Numéro comptable'],
  LIBELLE:     ['Descriptions/ Libelles'],
  DEBIT:       ['Charges (Sorties)', 'DEBIT', 'DEBIT '],
  CREDIT:      ['Produits (Entrées)', 'CREDIT', 'CREDIT '],
  SPECTACLE:   ['Spectacle'],
  SALARIE:     ['Salarié', 'SALARIE'],
  MOYEN:       ['Moyen de paiement'],
  NUM_FACTURE: ['N° de facture'],
  COMMENTAIRE: ["complément d'infos"],
};

function insertComptaLigne(ss, ligne) {
  ensureComptaTab(ss);
  const sheet = ss.getSheetByName('COMPTA');
  const lastCol = sheet.getLastColumn();
  const lastRowHdr = sheet.getLastRow();
  // Même détection de la ligne d'en-tête (1 à 3) que editerLigneCompta/getComptaRows,
  // car elle n'est pas toujours en ligne 1.
  let headerRow = null;
  for (let hi = 1; hi <= Math.min(3, lastRowHdr); hi++) {
    const candidate = sheet.getRange(hi, 1, 1, lastCol).getValues()[0];
    const textCount = candidate.filter(function(v) {
      return v && typeof v === 'string' && v.trim().length > 2 && v !== '#REF!';
    }).length;
    if (textCount >= 3) { headerRow = candidate; break; }
  }
  if (!headerRow) headerRow = sheet.getRange(1, 1, 1, lastCol).getValues()[0];
  function trouverColonne() {
    var candidats = Array.prototype.slice.call(arguments);
    for (var a = 0; a < candidats.length; a++) {
      var cible = candidats[a].toString().trim().toLowerCase();
      var i = headerRow.findIndex(function(h) { return h && h.toString().trim().toLowerCase() === cible; });
      if (i >= 0) return i;
    }
    return -1;
  }
  const lastRow = sheet.getLastRow();
  const numOp   = 'OP-' + new Date().getFullYear() + '-' + String(lastRow).padStart(4, '0');
  if (!ligne['NUM_OP']) ligne['NUM_OP'] = numOp;
  const row = new Array(lastCol).fill('');
  Object.keys(INSERT_COMPTA_COLONNES).forEach(function(cle) {
    if (ligne[cle] === undefined || ligne[cle] === null || ligne[cle] === '') return;
    var idx = trouverColonne.apply(null, INSERT_COMPTA_COLONNES[cle]);
    if (idx < 0) return;
    var val = ligne[cle];
    if (cle === 'DATE' && typeof val === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(val)) val = new Date(val);
    row[idx] = val;
  });
  sheet.appendRow(row);
  const insertedRow = sheet.getLastRow();
  const statutVal   = ligne['STATUT_VERIF'] || 'VERT';
  const couleur     = statutVal === 'VERT' ? '#E8F8EE' : statutVal === 'ORANGE' ? '#FEF3DC' : '#FDEAEA';
  sheet.getRange(insertedRow, 1, 1, lastCol).setBackground(couleur);
  return { success: true, insertedRow, numOp };
}

// =============================================================================
// IMPORT RELEVE BANCAIRE
// =============================================================================

// Abréviations de mois utilisées dans la colonne A comme titres de section
// ("JAN", "FEV", "MARS"...). Confirmées par le contenu réel du Sheet : JAN, FEV,
// MARS, MAI, SEP, OCT, NOV, DEC. Les autres (AVR, JUIN, JUIL, AOUT) sont déduites
// par cohérence de style (pas encore d'écriture dans ces mois pour vérifier) — à
// corriger si le libellé réel diffère.
var MOIS_LABELS = ['JAN','FEV','MARS','AVR','MAI','JUIN','JUIL','AOUT','SEP','OCT','NOV','DEC'];

// insertRowBefore(position) échoue avec l'erreur Google "Ces lignes sont hors
// limites" si position dépasse le nombre physique de lignes de la feuille
// (sheet.getMaxRows()) — ce qui arrive dès que l'insertion doit se faire tout
// à la fin d'une feuille qui n'a pas de lignes vides en réserve après ses
// données (cas fréquent quand on importe les écritures les plus récentes).
// On agrandit la feuille au besoin avant d'insérer, pour que insertRowBefore
// se comporte toujours comme prévu quelle que soit la position visée.
function assurerLignesSuffisantes(sheet, position) {
  var maxRows = sheet.getMaxRows();
  if (position > maxRows) {
    sheet.insertRowsAfter(maxRows, position - maxRows);
  }
}

// Détermine la ligne (1-indexée, feuille) juste APRÈS laquelle insérer une nouvelle
// écriture pour qu'elle reste triée chronologiquement à l'intérieur du bloc de son
// année d'exercice — sans se baser sur les libellés de mois pour le TRI (trop
// fragiles d'une année à l'autre) : on compare directement les dates réelles des
// lignes déjà présentes. On repère cependant, au passage, si le mois de la ligne à
// insérer a déjà une écriture cette année, pour savoir s'il faut créer une nouvelle
// ligne-titre de mois. Retourne { position: -1 } si l'année n'existe pas encore dans
// la feuille : dans ce cas, retour à l'ajout en fin de feuille (comportement
// précédent), car créer un nouveau bloc d'année de toutes pièces sortirait du cadre
// de cette correction.
function trouverPositionInsertionChrono(sheet, iDate, iAnnee, annee, dateCible, lastDataRow, iOp) {
  if (iDate < 0 || iAnnee < 0 || !dateCible) return { position: -1, moisPresent: true };
  var nbLignes = Math.max(1, lastDataRow - 2);
  var lastCol = Math.max(iDate, iAnnee, (iOp !== undefined ? iOp : 0)) + 1;
  var data = sheet.getRange(3, 1, nbLignes, lastCol).getValues();

  var premiereLigneAnnee = -1;  // index 0-based dans data
  var dernierMatchAvant   = -1; // dernière ligne de l'année avec date <= dateCible
  var moisCible = dateCible.getMonth(); // 0-11
  var moisPresent = false;

  for (var i = 0; i < data.length; i++) {
    var rowAnnee = (data[i][iAnnee] || '').toString().trim();
    if (rowAnnee !== annee) continue;
    if (premiereLigneAnnee < 0) premiereLigneAnnee = i;

    var rowDateVal = data[i][iDate];
    var rowDate = (rowDateVal instanceof Date) ? rowDateVal : parserDateFR(rowDateVal ? rowDateVal.toString() : '');
    if (rowDate) {
      if (rowDate.getTime() <= dateCible.getTime()) dernierMatchAvant = i;
      if (rowDate.getMonth() === moisCible) moisPresent = true;
    }
  }

  // Les lignes de ventilation salariale (421MAR, 421LUX...) sont posées juste
  // APRÈS la dernière écriture datée de leur bloc, mais SANS date ni N° d'opération.
  // Elles appartiennent logiquement à l'écriture datée qui les précède : il ne
  // faut donc jamais insérer une nouvelle écriture au milieu d'elles (ça décale
  // tout le bloc et fait échouer la validation de la colonne "Opération compta").
  // Quand la position visée tombe juste après une ligne datée, on avance au-delà
  // de la grappe de lignes rattachées (même exercice, pas de date, pas de n° d'op)
  // qui la suivent immédiatement.
  function estLigneRattachee(i) {
    if (i < 0 || i >= data.length) return false;
    var a = (data[i][iAnnee] || '').toString().trim();
    if (a !== annee) return false;
    var dVal = data[i][iDate];
    var d = (dVal instanceof Date) ? dVal : parserDateFR(dVal ? dVal.toString() : '');
    if (d) return false; // une ligne datée n'est pas une ligne rattachée
    var op = (iOp !== undefined && iOp >= 0) ? (data[i][iOp] || '').toString().trim() : '';
    if (op) return false; // une ligne avec n° d'opération est une vraie écriture
    return true;
  }

  var position;
  if (dernierMatchAvant >= 0) {
    var apres = dernierMatchAvant;
    while (estLigneRattachee(apres + 1)) apres++;
    position = apres + 3 + 1; // insérer juste après cette ligne (ventilation comprise)
  }
  else if (premiereLigneAnnee >= 0) position = premiereLigneAnnee + 3; // toutes les dates de l'année sont postérieures
  else position = -1; // année introuvable

  return { position: position, moisPresent: moisPresent };
}

// Détermine où AJOUTER une nouvelle écriture dans l'onglet COMPTA, en se basant
// UNIQUEMENT sur les titres physiques de la colonne A (jamais sur la colonne
// "Année exercice", car une ligne peut porter EX 25 tout en étant rangée
// physiquement dans le bloc 2026 — cas des mouvements réaffectés à un exercice
// antérieur). Structure de la feuille :
//   - titre d'ANNÉE  = un nombre 4 chiffres 2000-2100 en colonne A (ex: 2026)
//   - titre de MOIS  = un nom de mois en colonne A (ex: JANVIER, MARS, Jan)
//   - le bloc d'une année va de son titre jusqu'au titre d'année suivant (ou la fin)
//   - à l'intérieur, les mois sont dans l'ordre chronologique (Jan → Déc)
//
// L'écriture se pose À LA FIN du mois cible (après ses écritures, sa ventilation
// de paies et d'éventuelles lignes réaffectées), sans jamais s'insérer au milieu.
//
// Renvoie :
//  - position        : ligne (1-indexée) où faire insertRowBefore ; -1 si l'année
//                      cible n'existe pas physiquement (l'appelant ajoute en fin).
//  - creerTitreMois  : true si le titre du mois cible n'existe pas encore et doit
//                      être créé à cette position AVANT d'écrire la donnée.
function trouverPositionMoisDansAnnee(sheet, anneeNum, moisCible, lastDataRow) {
  var nbLignes = Math.max(1, lastDataRow - 2);
  // Colonne A uniquement suffit pour les titres, mais on lit un peu large au cas où.
  var data = sheet.getRange(3, 1, nbLignes, 1).getValues();

  // Variantes de libellé par mois (0-11) — reconnaît un titre quelle que soit
  // l'abréviation, sans confondre Juin et Juillet.
  var MOIS_VARIANTES = [
    ['JAN','JANV','JANVIER'], ['FEV','FEVR','FEVRIER'], ['MAR','MARS'],
    ['AVR','AVRIL'], ['MAI'], ['JUIN'], ['JUIL','JUILLET'], ['AOU','AOUT'],
    ['SEP','SEPT','SEPTEMBRE'], ['OCT','OCTOBRE'], ['NOV','NOVEMBRE'], ['DEC','DECEMBRE']
  ];
  function norm(v) {
    // Tol\u00e8re le suffixe ann\u00e9e de certains classeurs historiques (ex: "Jan-26",
    // "Mar-26" chez DIS) \u2014 sans \u00e7a, ces titres de mois sont invisibles pour
    // cette fonction alors que getComptaRows les reconna\u00eet d\u00e9j\u00e0 comme tels
    // (m\u00eame pattern /^[A-Z]{2,4}-\d{2}$/ ailleurs), ce qui fait ins\u00e9rer les
    // nouvelles \u00e9critures avant des blocs mois pourtant d\u00e9j\u00e0 pr\u00e9sents.
    return (v || '').toString().trim().toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')
      .replace(/-\d{2,4}$/, '');
  }
  function estTitreAnnee(v) {
    if (typeof v === 'number') return v >= 2000 && v <= 2100;
    var s = (v || '').toString().trim();
    return /^\d{4}$/.test(s) && parseInt(s, 10) >= 2000 && parseInt(s, 10) <= 2100;
  }
  function estTitreMois(v) { return MOIS_LABELS_UP.indexOf(norm(v)) >= 0; }
  function moisDuTitre(v) {
    var u = norm(v);
    for (var m = 0; m < 12; m++) { if (MOIS_VARIANTES[m].indexOf(u) >= 0) return m; }
    return -1;
  }

  // 1) Bornes du bloc de l'année cible : [debut, fin) en index 0-based.
  var debutBloc = -1, finBloc = data.length;
  for (var i = 0; i < data.length; i++) {
    var v = data[i][0];
    if (estTitreAnnee(v) && parseInt((v || '').toString(), 10) === anneeNum) {
      debutBloc = i;
    } else if (debutBloc >= 0 && estTitreAnnee(v)) {
      finBloc = i; break;
    }
  }
  if (debutBloc < 0) return { position: -1, creerTitreMois: false }; // année absente → ajout en fin

  // 2) Lister les titres de mois présents dans le bloc, dans l'ordre.
  var moisPresents = [];
  for (var j = debutBloc + 1; j < finBloc; j++) {
    if (estTitreMois(data[j][0])) moisPresents.push({ idx: j, mois: moisDuTitre(data[j][0]) });
  }

  // 3) Le mois cible existe-t-il ?
  for (var k = 0; k < moisPresents.length; k++) {
    if (moisPresents[k].mois === moisCible) {
      // Fin du mois = début du mois suivant, ou fin du bloc année.
      var finMois = (k + 1 < moisPresents.length) ? moisPresents[k + 1].idx : finBloc;
      return { position: finMois + 3, creerTitreMois: false }; // +3 car data[0] = ligne 3
    }
  }

  // 4) Mois absent : créer son titre après la fin du dernier mois ANTÉRIEUR présent
  //    (pour garder l'ordre chronologique). Si aucun mois antérieur, juste après le
  //    titre d'année. Si tous les mois présents sont postérieurs, on se place avant
  //    le premier d'entre eux.
  var idxCreation = debutBloc + 1; // par défaut, juste après le titre d'année
  var dernierMoisAvantIdx = -1;    // index (dans moisPresents) du dernier mois < cible
  var premierMoisApresIdx = -1;    // index du premier mois > cible
  for (var p = 0; p < moisPresents.length; p++) {
    if (moisPresents[p].mois < moisCible) dernierMoisAvantIdx = p;
    if (moisPresents[p].mois > moisCible && premierMoisApresIdx < 0) premierMoisApresIdx = p;
  }
  if (dernierMoisAvantIdx >= 0) {
    // Fin du dernier mois antérieur = début du mois suivant, ou fin du bloc.
    idxCreation = (dernierMoisAvantIdx + 1 < moisPresents.length)
      ? moisPresents[dernierMoisAvantIdx + 1].idx
      : finBloc;
  } else if (premierMoisApresIdx >= 0) {
    // Aucun mois antérieur mais des mois postérieurs : se placer avant le premier.
    idxCreation = moisPresents[premierMoisApresIdx].idx;
  } else {
    // Aucun titre de mois du tout dans le bloc : juste après le titre d'année.
    idxCreation = debutBloc + 1;
  }
  return { position: idxCreation + 3, creerTitreMois: true };
}

// Retire la validation de données (listes déroulantes strictes) sur toute une ligne.
// Nécessaire après insertRowBefore : la ligne créée hérite de la validation de la
// ligne voisine (dont la liste stricte de "Opération compta"), ce qui fait échouer
// setValues si la valeur écrite n'est pas dans la liste — ou si la validation
// refuse une cellule vide. On ne touche QUE la ligne passée (jamais les existantes).
function nettoyerValidationLigne(sheet, rowIndex, nbCols) {
  try {
    var nb = nbCols || sheet.getLastColumn();
    sheet.getRange(rowIndex, 1, 1, nb).clearDataValidations();
  } catch(e) {
    Logger.log('nettoyerValidationLigne erreur ligne ' + rowIndex + ': ' + e.message);
  }
}

function appendLignesCompta(ss, entity, lignes) {
  Logger.log('appendLignesCompta: entity=' + entity + ' nb lignes=' + (lignes||[]).length);
  if (!lignes || lignes.length === 0) { Logger.log('Aucune ligne'); return { success: true, ajoutees: 0 }; }
  try {
  var sheet = ss.getSheetByName('COMPTA');
  if (!sheet) return { error: 'Onglet COMPTA introuvable' };

  var lastCol = sheet.getLastColumn();
  var headers = sheet.getRange(2, 1, 1, lastCol).getValues()[0];

  function findCol() {
    var candidats = Array.prototype.slice.call(arguments);
    for (var a = 0; a < candidats.length; a++) {
      // Comparaison normalisée (casse/accents/ponctuation) plutôt qu'exacte : le
      // libellé réel d'une colonne peut varier légèrement d'un classeur à l'autre
      // (ex: "Année Exercice" vs "Année exercice"), ce qui faisait échouer
      // silencieusement la colonne pour certaines compagnies (ex: DIS, colonne
      // Année exercice jamais renseignée à l'import).
      var cible = normaliserTexteCompta(candidats[a]);
      var i = headers.findIndex(function(h) { return h && normaliserTexteCompta(h) === cible; });
      if (i >= 0) return i;
    }
    return -1;
  }
  // Alias pour utiliser dans le closure des ventilations
  var findColFn = findCol;

  var iOp       = findCol("N° d'opération");
  var iAnnee    = findCol('Année exercice');
  var iOpCompta = findCol('Opération compta');
  var iDesc     = findCol('Descriptions/ Libelles');
  var iSpec     = findCol('Spectacle');
  var iCpt      = findCol('Numéro comptable');
  var iDate     = findCol('Dates');
  var iMoy      = findCol('Moyen de paiement');
  // Colonnes montant : "Produits (Entrées)"/"Charges (Sorties)" pour CLR/PALM/OM/DIS,
  // "CREDIT"/"DEBIT" pour MAN (noms différents selon la compagnie).
  var iCredit   = findCol('Produits (Entrées)', 'CREDIT', 'CREDIT ');
  var iDebit    = findCol('Charges (Sorties)', 'DEBIT', 'DEBIT ');
  var iLien     = findCol('LIEN DRIVE');

  // Trouver la dernière ligne non vide.
  // IMPORTANT : on ne peut PAS se fier à la seule colonne "N° d'opération", car les
  // lignes de ventilation salariale (421MAR, 421LUX...) posées en fin de bloc n'ont
  // pas de N° d'opération — s'arrêter à la dernière ligne numérotée ferait ignorer
  // toute cette zone par le calcul de position d'insertion (trouverPositionInsertionChrono),
  // et une nouvelle écriture s'insérerait alors EN PLEIN MILIEU de la ventilation
  // (décalage du bloc + rejet de la validation "Opération compta"). On balaye donc
  // plusieurs colonnes-témoins et on retient la dernière ligne où AU MOINS une est remplie.
  var lastRow = 2;
  var nbScan = Math.max(1, sheet.getLastRow() - 2);
  var colsTemoins = [iOp, iAnnee, iDate, iCpt, iDesc, iCredit, iDebit, iLien]
    .filter(function(c) { return c >= 0; });
  if (colsTemoins.length === 0) colsTemoins = [0];
  var maxColScan = Math.max.apply(null, colsTemoins) + 1;
  var scanData = sheet.getRange(3, 1, nbScan, maxColScan).getValues();
  for (var ri = scanData.length - 1; ri >= 0; ri--) {
    var ligneRemplie = false;
    for (var ci = 0; ci < colsTemoins.length; ci++) {
      var v = scanData[ri][colsTemoins[ci]];
      if (v !== '' && v !== null && v !== undefined) { ligneRemplie = true; break; }
    }
    if (ligneRemplie) { lastRow = ri + 3; break; }
  }

  // Trouver le dernier N° d'opération de l'année d'exercice EN COURS uniquement :
  // la numérotation redémarre à 1 à chaque nouvel exercice (EX 21, EX 22, EX 26...),
  // donc on ne doit pas prendre le max toutes années confondues (qui ferait
  // continuer une ancienne série au lieu de repartir sur celle de l'année en cours).
  var now   = new Date();
  var annee = 'EX ' + String(now.getFullYear()).slice(2);

  var maxOp = 0;
  if (iOp >= 0 && iAnnee >= 0) {
    var ops = sheet.getRange(3, iOp+1, Math.max(1, lastRow-2), 1).getValues();
    var anneesCheck = sheet.getRange(3, iAnnee+1, Math.max(1, lastRow-2), 1).getValues();
    ops.forEach(function(r, i) {
      var n = parseInt(r[0]);
      if (isNaN(n)) return;
      var anneeLigne = (anneesCheck[i][0] || '').toString().trim();
      if (anneeLigne === annee && n > maxOp) maxOp = n;
    });
  } else if (iOp >= 0) {
    // Colonne "Année exercice" introuvable : comportement précédent en secours
    // (max toutes lignes confondues) pour ne pas casser si la structure diffère.
    var opsSecours = sheet.getRange(3, iOp+1, Math.max(1, lastRow-2), 1).getValues();
    opsSecours.forEach(function(r) {
      var n = parseInt(r[0]);
      if (!isNaN(n) && n > maxOp) maxOp = n;
    });
  }

  var ajoutees = 0;

  // Filet de sécurité pour la colonne "Opération compta" : si une ligne arrive avec
  // un compte comptable connu (l.compte) mais pas de libellé d'opération (l.operation
  // vide), on le retrouve via CODE COMPTA — quel que soit le chemin qui a construit
  // la ligne (IA, rapprochement PIECE COMPTA, etc.), plutôt que de compter sur chaque
  // appelant pour l'avoir déjà fait.
  var codeVersLabelSecours = {};
  try {
    codeVersLabelSecours = getCodeComptaMap(ss); // déjà code -> libellé, pas d'inversion nécessaire
  } catch(eSecours) { Logger.log('codeVersLabelSecours erreur: ' + eSecours.message); }

  // Liste réelle des valeurs autorisées par la validation de données de la colonne
  // "Opération compta" (liste déroulante en mode rejet) — sert à ne JAMAIS écrire
  // un libellé qui ferait échouer tout le Range.setValues() de la ligne (et donc
  // tout l'import restant). null si aucune règle détectée = pas de vérification.
  var listeValidationOp = getListeValidationOperationCompta(ss);
  function operationEstValide(op) {
    if (!op) return true; // cellule vide toujours acceptée
    if (!listeValidationOp) return true; // pas de règle détectée, rien à vérifier
    return !!listeValidationOp.set[op.toString().trim().toLowerCase()];
  }
  // Si le libellé retenu n'est pas dans la liste, tente de le caler sur la valeur
  // valide la plus proche (plutôt que de laisser la cellule vide directement).
  function caserOperationSurListeValidee(op) {
    if (!listeValidationOp || !listeValidationOp.list.length) return '';
    return trouverMeilleureCorrespondance(op, listeValidationOp.list);
  }

  // Trier les lignes par date croissante AVANT de les traiter. Sans ça, un CSV
  // trié du plus récent au plus ancien (cas fréquent des exports bancaires) ferait
  // numéroter et positionner les titres de mois dans le désordre : le n° d'opération
  // est attribué au fil du traitement (donc dans l'ordre du CSV) mais la ligne est
  // ensuite insérée à sa position chronologique — d'où des numéros affichés dans le
  // désordre et un titre de mois qui atterrit après des lignes de ce même mois déjà
  // insérées avant lui dans le lot.
  var lignesTriees = lignes.slice().sort(function(a, b) {
    var da = (a.date && a.date !== '—') ? parserDateFR(a.date) : null;
    var db = (b.date && b.date !== '—') ? parserDateFR(b.date) : null;
    if (!da && !db) return 0;
    if (!da) return 1;  // lignes sans date valide : à la fin
    if (!db) return -1;
    return da.getTime() - db.getTime();
  });

  lignesTriees.forEach(function(l) {
    var row = new Array(lastCol).fill('');
    maxOp++;
    if (iOp       >= 0) row[iOp]       = maxOp;
    if (iAnnee    >= 0) row[iAnnee]    = annee;
    var operationFinale = l.operation || '';
    if (!operationFinale && l.compte) {
      var compteClean = l.compte.toString().trim();
      if (codeVersLabelSecours[compteClean]) operationFinale = codeVersLabelSecours[compteClean];
    }
    // Garde-fou final : si le libellé retenu (quelle que soit sa provenance) ne
    // fait pas partie de la liste déroulante autorisée, on tente d'abord de le
    // caler sur la valeur valide la plus proche (ex: "Charges sociales patronales"
    // -> "Cotisations" si c'est la seule option proche dans la liste réelle), et
    // seulement si rien de proche n'est trouvé on efface — pour ne jamais risquer
    // un rejet de tout le Range.setValues() de la ligne par la validation du Sheet.
    if (!operationEstValide(operationFinale)) {
      var caleeSur = caserOperationSurListeValidee(operationFinale || l.libelle || '');
      if (caleeSur) {
        Logger.log('Opération compta calée sur la liste : "' + operationFinale + '" -> "' + caleeSur + '"');
        operationFinale = caleeSur;
      } else {
        Logger.log('Opération compta rejetée (hors liste, aucune correspondance) : "' + operationFinale + '" pour compte ' + (l.compte||'') + ' — cellule laissée vide');
        operationFinale = '';
      }
    }
    if (iOpCompta >= 0) row[iOpCompta] = operationFinale;
    if (iDesc     >= 0) row[iDesc]     = l.libelle   || '';
    if (iSpec     >= 0) row[iSpec]     = l.spectacle || '';
    if (iCpt      >= 0) row[iCpt]      = l.compte    || '';
    if (iMoy      >= 0) row[iMoy]      = 'Virement';
    if (iDate     >= 0 && l.date && l.date !== '—') {
      // Convertir JJ/MM/AAAA en Date
      var parts = l.date.split('/');
      if (parts.length === 3) row[iDate] = new Date(parseInt(parts[2]), parseInt(parts[1])-1, parseInt(parts[0]));
    }
    if (l.montant > 0 && iCredit >= 0) row[iCredit] = Math.abs(l.montant);
    if (l.montant < 0 && iDebit  >= 0) row[iDebit]  = Math.abs(l.montant);
    // Pièce justificative dans LIEN DRIVE (texte brut pour l'instant — le lien
    // cliquable avec libellé court est posé juste après, via setFormula)
    if (iLien >= 0 && !l.piece_url && l.piece_nom) row[iLien] = l.piece_nom;

    // Placement basé sur les TITRES PHYSIQUES (colonne A) : bloc de l'année de la
    // DATE de l'écriture (position physique dans la feuille, indépendante de la
    // colonne "Année exercice" qui peut être réaffectée), puis fin du mois cible.
    // Aucune insertion au milieu → ni décalage de ventilation ni rejet de validation.
    var dateCibleLigne = (l.date && l.date !== '—') ? parserDateFR(l.date) : null;
    var moisCibleLigne  = dateCibleLigne ? dateCibleLigne.getMonth() : -1;
    var anneeCibleLigne = dateCibleLigne ? dateCibleLigne.getFullYear() : -1;
    var resPosition = (moisCibleLigne >= 0 && anneeCibleLigne > 0)
      ? trouverPositionMoisDansAnnee(sheet, anneeCibleLigne, moisCibleLigne, lastRow)
      : { position: -1, creerTitreMois: false };
    var posInsertion = resPosition.position;
    var posEcrite;
    if (posInsertion >= 0) {
      // Créer le titre du mois s'il n'existe pas encore dans le bloc année
      // (1re écriture d'un mois pas encore ouvert). Le titre se pose à la position
      // chronologique calculée, la donnée juste après.
      if (resPosition.creerTitreMois && moisCibleLigne >= 0) {
        var libelleMois = MOIS_LABELS[moisCibleLigne];
        var rowMois = new Array(lastCol).fill('');
        rowMois[0] = libelleMois;
        assurerLignesSuffisantes(sheet, posInsertion);
        sheet.insertRowBefore(posInsertion);
        // La ligne insérée hérite de la validation de données de la ligne adjacente
        // (notamment la liste stricte de la colonne "Opération compta"). On la retire
        // sur la ligne-titre pour pouvoir y écrire librement.
        nettoyerValidationLigne(sheet, posInsertion, lastCol);
        sheet.getRange(posInsertion, 1, 1, rowMois.length).setValues([rowMois]);
        lastRow++;
        posInsertion++; // la donnée s'insère juste après le titre qu'on vient de créer
      }
      assurerLignesSuffisantes(sheet, posInsertion);
      sheet.insertRowBefore(posInsertion);
      // Idem : retirer la validation de données héritée sur la ligne d'écriture, sinon
      // un setValues avec une valeur non prévue par la liste (ou une cellule vide dont
      // la validation refuse le vide) fait échouer toute la ligne (erreur "les données
      // ne respectent pas les règles de validation" — c'est ce qui bloquait l'import).
      nettoyerValidationLigne(sheet, posInsertion, lastCol);
      sheet.getRange(posInsertion, 1, 1, row.length).setValues([row]);
      posEcrite = posInsertion;
    } else {
      // Année introuvable physiquement dans la feuille (ou pas de date exploitable) :
      // ajout en toute fin de feuille (comportement de secours).
      sheet.appendRow(row);
      posEcrite = sheet.getLastRow();
      nettoyerValidationLigne(sheet, posEcrite, lastCol);
      // Réécrire les valeurs au cas où la validation aurait bloqué l'appendRow initial.
      try { sheet.getRange(posEcrite, 1, 1, row.length).setValues([row]); } catch(eAppend) {}
    }
    lastRow++;
    ajoutees++;

    // Lien Drive sous forme de lien cliquable avec un nom court (ex: "F26-2026...")
    // plutôt que l'URL complète en texte brut, pour rester cohérent avec les lignes
    // saisies manuellement.
    if (iLien >= 0 && l.piece_url) {
      var libelleLien = (l.piece_nom || 'Pièce').toString().replace(/"/g, "'");
      if (libelleLien.length > 30) libelleLien = libelleLien.substring(0, 30) + '…';
      try {
        sheet.getRange(posEcrite, iLien + 1).setFormula('=HYPERLINK("' + l.piece_url + '";"' + libelleLien + '")');
      } catch(eLien) {
        sheet.getRange(posEcrite, iLien + 1).setValue(l.piece_url);
      }
    }

    // Ligne rapprochée à un lot de virement groupé NDF (cf. enrichirSpectacleParMontant
    // étape 3) : marquer le lot "Rapproché" maintenant que l'import est VALIDÉ (pas
    // juste prévisualisé) — évite de marquer un lot rapproché sur un import annulé.
    if (l.matchMontant && l.matchMontant.type === 'lot-ndf' && l.matchMontant.lotRowIndex) {
      try {
        marquerLotVirementNDFRapproche(ss, l.matchMontant.lotRowIndex, l.date ? parserDateFR(l.date) : new Date());
        Logger.log('Lot virement NDF ' + l.matchMontant.lotId + ' marqué Rapproché (ligne compta ' + posEcrite + ')');
      } catch(eLot) { Logger.log('marquerLotVirementNDFRapproche erreur: ' + eLot.message); }
    }

    // Répartition automatique caisse perso si compte 706 (recette)
    var compte706 = (l.compte || '').toString();
    if (compte706.startsWith('706') || compte706.startsWith('74')) {
      var montantRecette = Math.abs(parseFloat(l.montant) || 0);
      var spectacle706   = l.spectacle || '';
      if (montantRecette > 0 && spectacle706) {
        try {
          // Coût employeur = charges 64x/421 déjà saisies en compta pour ce
          // spectacle (tous exercices confondus) — sans ça la caisse prenait 20%
          // du montant brut de la recette, sans jamais déduire les cachets/charges
          // sociales réellement dus, ce qui gonflait fortement les montants.
          var coutEmployeur706 = getCoutEmployeurSpectacle(ss, spectacle706);
          var resC = repartirCaisse(ss, entity, spectacle706, montantRecette, coutEmployeur706, undefined, undefined, undefined, undefined);
          Logger.log('Auto caisse: ' + spectacle706 + ' ' + montantRecette + '€ (coût employeur déduit: ' + coutEmployeur706 + '€) → ' + JSON.stringify(resC));
        } catch(ec) {
          Logger.log('Auto caisse erreur: ' + ec.message);
        }
      }
    }

    // Ajouter les lignes de ventilation EMPLOYEUR si présentes, juste après la ligne
    // principale qu'on vient d'écrire (posEcrite), pour garder le même bloc groupé
    // que dans les écritures saisies manuellement.
    if (l._ventilations && l._ventilations.length > 0) {
      var iSal   = findCol('Salarié');
      // "EMPLOYEUR" chez certaines compagnies, "Brut Cout employeur" chez DIS —
      // même liste de variantes que getComptaRows (L2505) pour rester cohérent
      // entre lecture et écriture.
      var iEmp   = findCol('Brut Cout employeur', 'EMPLOYEUR', 'EMPLOYEUR ');
      var posSuivanteVent = posEcrite + 1;
      l._ventilations.forEach(function(v) {
        if (!v.salarie && !v.coutEmp) return;
        var ventRow = new Array(lastCol).fill('');
        if (iAnnee >= 0) ventRow[iAnnee] = annee;
        if (iSal   >= 0) ventRow[iSal]   = v.salarie  || '';
        if (iSpec  >= 0) ventRow[iSpec]  = v.spectacle || '';
        if (iEmp   >= 0) ventRow[iEmp]   = parseFloat(v.coutEmp) || 0;
        assurerLignesSuffisantes(sheet, posSuivanteVent);
        sheet.insertRowBefore(posSuivanteVent);
        // La ligne de ventilation insérée hérite elle aussi de la validation de
        // données de la ligne du dessus (liste stricte "Opération compta") — c'est
        // ce qui provoquait le rejet "règles de validation" sur la dernière ligne
        // (ex: D1827). On la retire avant d'écrire, comme pour les écritures.
        nettoyerValidationLigne(sheet, posSuivanteVent, lastCol);
        sheet.getRange(posSuivanteVent, 1, 1, ventRow.length).setValues([ventRow]);
        var posVentEcrite = posSuivanteVent;
        posSuivanteVent++;
        lastRow++;
        ajoutees++;

        // Lien Drive cliquable vers la FDP, cohérent avec le reste de la fonction
        // (avant : le nom du fichier était écrit en texte brut, sans lien).
        if (iLien >= 0 && v.fdp) {
          var libelleLienVent = v.fdp.toString().replace(/"/g, "'");
          if (libelleLienVent.length > 30) libelleLienVent = libelleLienVent.substring(0, 30) + '…';
          if (v.fdpUrl) {
            try {
              sheet.getRange(posVentEcrite, iLien + 1).setFormula('=HYPERLINK("' + v.fdpUrl + '";"' + libelleLienVent + '")');
            } catch(eLienVent) {
              sheet.getRange(posVentEcrite, iLien + 1).setValue(v.fdp);
            }
          } else {
            sheet.getRange(posVentEcrite, iLien + 1).setValue(v.fdp);
          }
        }
        // Déduction auto caisse perso pour les salaires : DÉSACTIVÉE À NOUVEAU (18/08).
        // Le gate par "Caisse perso" du DAPE (essayé juste avant) continuait de créer
        // des lignes "Salaire..." dans les caisses perso alors que Nicolas ne
        // comprenait/voulait pas ce comportement. Plutôt que de re-deviner une
        // condition, ce mécanisme est désactivé entièrement : aucune ligne "Salaire"
        // ne doit apparaître automatiquement dans une caisse perso. Code conservé en
